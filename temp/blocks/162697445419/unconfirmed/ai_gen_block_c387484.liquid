{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-layout-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.spacing }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-editorial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: {{ block.settings.spacing }}px;
  }

  .ai-editorial-featured-{{ ai_gen_id }} {
    grid-column: span 8;
    position: relative;
    overflow: hidden;
  }

  .ai-editorial-featured-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-editorial-featured-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 2;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-editorial-featured-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-featured-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.content_padding }}px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
    color: {{ block.settings.featured_text_color }};
  }

  .ai-editorial-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_size }}px;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 8px;
    font-weight: 600;
  }

  .ai-editorial-featured-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.featured_title_size }}px;
    line-height: 1.2;
    margin: 0 0 12px;
    font-weight: 700;
  }

  .ai-editorial-featured-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_size }}px;
    line-height: 1.5;
    margin: 0;
    opacity: 0.9;
  }

  .ai-editorial-sidebar-{{ ai_gen_id }} {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-editorial-article-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    padding-bottom: {{ block.settings.grid_gap }}px;
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-editorial-article-{{ ai_gen_id }}:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .ai-editorial-article-image-{{ ai_gen_id }} {
    width: 120px;
    height: 120px;
    flex-shrink: 0;
    overflow: hidden;
  }

  .ai-editorial-article-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-editorial-article-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-article-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-article-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ai-editorial-article-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.small_category_size }}px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 6px;
    color: {{ block.settings.category_color }};
    font-weight: 600;
  }

  .ai-editorial-article-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.article_title_size }}px;
    line-height: 1.3;
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
  }

  .ai-editorial-article-meta-{{ ai_gen_id }} {
    font-size: {{ block.settings.meta_size }}px;
    color: {{ block.settings.meta_color }};
  }

  .ai-editorial-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .ai-editorial-link-{{ ai_gen_id }}:hover .ai-editorial-featured-title-{{ ai_gen_id }},
  .ai-editorial-link-{{ ai_gen_id }}:hover .ai-editorial-article-title-{{ ai_gen_id }} {
    opacity: 0.8;
  }

  .ai-editorial-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .ai-editorial-featured-{{ ai_gen_id }} {
      grid-column: span 12;
    }

    .ai-editorial-sidebar-{{ ai_gen_id }} {
      grid-column: span 12;
    }

    .ai-editorial-featured-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.featured_title_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-layout-{{ ai_gen_id }} {
      padding: {{ block.settings.spacing | times: 0.6 }}px;
    }

    .ai-editorial-grid-{{ ai_gen_id }} {
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-editorial-featured-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.7 }}px;
    }

    .ai-editorial-featured-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.featured_title_size }}px * 0.6);
    }

    .ai-editorial-article-image-{{ ai_gen_id }} {
      width: 80px;
      height: 80px;
    }

    .ai-editorial-article-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.article_title_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-editorial-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-grid-{{ ai_gen_id }}">
    <div class="ai-editorial-featured-{{ ai_gen_id }}">
      {% if block.settings.featured_article != blank %}
        <a href="{{ block.settings.featured_article.url }}" class="ai-editorial-link-{{ ai_gen_id }}">
          {% if block.settings.featured_article.image %}
            <img
              src="{{ block.settings.featured_article.image | image_url: width: 1200 }}"
              alt="{{ block.settings.featured_article.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.featured_article.image.width }}"
              height="{{ block.settings.featured_article.image.height }}"
              class="ai-editorial-featured-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-editorial-featured-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
          <div class="ai-editorial-featured-content-{{ ai_gen_id }}">
            {% if block.settings.show_category and block.settings.featured_category != blank %}
              <div class="ai-editorial-category-{{ ai_gen_id }}">{{ block.settings.featured_category }}</div>
            {% endif %}
            <h2 class="ai-editorial-featured-title-{{ ai_gen_id }}">
              {{ block.settings.featured_article.title }}
            </h2>
            {% if block.settings.show_excerpt and block.settings.featured_article.excerpt != blank %}
              <p class="ai-editorial-featured-excerpt-{{ ai_gen_id }}">
                {{ block.settings.featured_article.excerpt | strip_html | truncate: 150 }}
              </p>
            {% endif %}
          </div>
        </a>
      {% else %}
        <div class="ai-editorial-featured-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-editorial-empty-state-{{ ai_gen_id }}">
            Next, add a featured article
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-editorial-sidebar-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign article_key = 'article_' | append: i
          assign category_key = 'category_' | append: i
          assign article = block.settings[article_key]
          assign category = block.settings[category_key]
        %}

        <div class="ai-editorial-article-{{ ai_gen_id }}">
          {% if article != blank %}
            <a href="{{ article.url }}" class="ai-editorial-link-{{ ai_gen_id }}" style="display: flex; gap: 16px; flex: 1;">
              <div class="ai-editorial-article-image-{{ ai_gen_id }}">
                {% if article.image %}
                  <img
                    src="{{ article.image | image_url: width: 240 }}"
                    alt="{{ article.image.alt | escape }}"
                    loading="lazy"
                    width="240"
                    height="240"
                  >
                {% else %}
                  <div class="ai-editorial-article-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <div class="ai-editorial-article-content-{{ ai_gen_id }}">
                {% if block.settings.show_category and category != blank %}
                  <div class="ai-editorial-article-category-{{ ai_gen_id }}">{{ category }}</div>
                {% endif %}
                <h3 class="ai-editorial-article-title-{{ ai_gen_id }}">{{ article.title }}</h3>
                {% if block.settings.show_date %}
                  <div class="ai-editorial-article-meta-{{ ai_gen_id }}">
                    {{ article.published_at | date: '%B %d, %Y' }}
                  </div>
                {% endif %}
              </div>
            </a>
          {% else %}
            <div class="ai-editorial-article-image-{{ ai_gen_id }}">
              <div class="ai-editorial-article-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            </div>
            <div class="ai-editorial-article-content-{{ ai_gen_id }}">
              <div class="ai-editorial-article-category-{{ ai_gen_id }}">Category</div>
              <h3 class="ai-editorial-article-title-{{ ai_gen_id }}">Article title</h3>
              <div class="ai-editorial-article-meta-{{ ai_gen_id }}">Date</div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Magazine editorial layout",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Featured article"
    },
    {
      "type": "article",
      "id": "featured_article",
      "label": "Featured article"
    },
    {
      "type": "text",
      "id": "featured_category",
      "label": "Featured category",
      "default": "Featured"
    },
    {
      "type": "header",
      "content": "Sidebar articles"
    },
    {
      "type": "article",
      "id": "article_1",
      "label": "Article 1"
    },
    {
      "type": "text",
      "id": "category_1",
      "label": "Category 1",
      "default": "Lifestyle"
    },
    {
      "type": "article",
      "id": "article_2",
      "label": "Article 2"
    },
    {
      "type": "text",
      "id": "category_2",
      "label": "Category 2",
      "default": "Wellness"
    },
    {
      "type": "article",
      "id": "article_3",
      "label": "Article 3"
    },
    {
      "type": "text",
      "id": "category_3",
      "label": "Category 3",
      "default": "Tips"
    },
    {
      "type": "header",
      "content": "Display options"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show categories",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show featured excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show article dates",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 100,
      "unit": "px",
      "label": "Maximum width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Section spacing",
      "default": 40
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Grid gap",
      "default": 30
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Content padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "featured_title_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Featured title size",
      "default": 48
    },
    {
      "type": "range",
      "id": "article_title_size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Article title size",
      "default": 18
    },
    {
      "type": "range",
      "id": "category_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Category size",
      "default": 12
    },
    {
      "type": "range",
      "id": "small_category_size",
      "min": 8,
      "max": 14,
      "step": 1,
      "unit": "px",
      "label": "Small category size",
      "default": 10
    },
    {
      "type": "range",
      "id": "excerpt_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Excerpt size",
      "default": 16
    },
    {
      "type": "range",
      "id": "meta_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Meta text size",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "featured_text_color",
      "label": "Featured text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "category_color",
      "label": "Category",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta text",
      "default": "#999999"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#e0e0e0"
    }
  ],
  "presets": [
    {
      "name": "Magazine editorial layout"
    }
  ]
}
{% endschema %}