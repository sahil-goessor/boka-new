{% doc %}
  @prompt
    can you create a section where I can have product and it's data, I want to match the design and feel of my current product page so can you copy that code and create it, so that this product section I can use in any page
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-display-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-product-display__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-display__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }

  @media screen and (min-width: 750px) {
    .ai-product-display__grid-{{ ai_gen_id }} {
      grid-template-columns: {% if block.settings.image_position == 'left' %}1fr 1fr{% else %}1fr 1fr{% endif %};
      gap: 60px;
    }

    .ai-product-display__grid-{{ ai_gen_id }}--image-right {
      direction: rtl;
    }

    .ai-product-display__grid-{{ ai_gen_id }}--image-right > * {
      direction: ltr;
    }
  }

  .ai-product-display__media-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-product-display__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-display__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-display__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-product-display__info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-product-display__vendor-{{ ai_gen_id }} {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    margin: 0;
  }

  .ai-product-display__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 400;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-product-display__price-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-display__price-regular-{{ ai_gen_id }} {
    font-weight: 400;
  }

  .ai-product-display__price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    font-size: 0.9em;
  }

  .ai-product-display__price-sale-{{ ai_gen_id }} {
    color: {{ block.settings.sale_color }};
  }

  .ai-product-display__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
  }

  .ai-product-display__description-{{ ai_gen_id }} p {
    margin: 0 0 1em;
  }

  .ai-product-display__description-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-product-display__variants-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .ai-product-display__variant-label-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 500;
    color: {{ block.settings.text_color }};
    margin-bottom: 8px;
    display: block;
  }

  .ai-product-display__variant-options-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ai-product-display__variant-option-{{ ai_gen_id }} {
    padding: 10px 20px;
    border: 1px solid {{ block.settings.text_color }};
    background: transparent;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 14px;
    border-radius: {{ block.settings.variant_border_radius }}px;
  }

  .ai-product-display__variant-option-{{ ai_gen_id }}:hover {
    background: {{ block.settings.text_color }};
    color: {{ block.settings.background_color }};
  }

  .ai-product-display__variant-option-{{ ai_gen_id }}.active {
    background: {{ block.settings.text_color }};
    color: {{ block.settings.background_color }};
  }

  .ai-product-display__variant-option-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-product-display__quantity-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-product-display__quantity-label-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 500;
    color: {{ block.settings.text_color }};
  }

  .ai-product-display__quantity-input-{{ ai_gen_id }} {
    width: 80px;
    padding: 10px;
    border: 1px solid {{ block.settings.text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    text-align: center;
    font-size: 14px;
  }

  .ai-product-display__button-{{ ai_gen_id }} {
    width: 100%;
    padding: 15px 30px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: 1px solid {{ block.settings.button_background }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ai-product-display__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_background }};
  }

  .ai-product-display__button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-product-display__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-product-display__empty-state-{{ ai_gen_id }} p {
    margin: 10px 0 0;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-display__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-product-display__price-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.price_size }}px * 0.9);
    }
  }
{% endstyle %}

<product-display-{{ ai_gen_id }}
  class="ai-product-display-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-display__container-{{ ai_gen_id }}">
    {% if block.settings.product != blank %}
      {% assign product = block.settings.product %}
      
      <div class="ai-product-display__grid-{{ ai_gen_id }} {% if block.settings.image_position == 'right' %}ai-product-display__grid-{{ ai_gen_id }}--image-right{% endif %}">
        <div class="ai-product-display__media-{{ ai_gen_id }}">
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 1000 }}"
              alt="{{ product.featured_image.alt | escape }}"
              class="ai-product-display__image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
            >
          {% else %}
            <div class="ai-product-display__image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-product-display__info-{{ ai_gen_id }}">
          {% if block.settings.show_vendor and product.vendor != blank %}
            <p class="ai-product-display__vendor-{{ ai_gen_id }}">{{ product.vendor }}</p>
          {% endif %}

          <h2 class="ai-product-display__title-{{ ai_gen_id }}">{{ product.title }}</h2>

          {% if block.settings.show_price %}
            <div class="ai-product-display__price-{{ ai_gen_id }}">
              {% if product.compare_at_price > product.price %}
                <span class="ai-product-display__price-sale-{{ ai_gen_id }}">
                  {{ product.price | money }}
                </span>
                <span class="ai-product-display__price-compare-{{ ai_gen_id }}">
                  {{ product.compare_at_price | money }}
                </span>
              {% else %}
                <span class="ai-product-display__price-regular-{{ ai_gen_id }}">
                  {{ product.price | money }}
                </span>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.show_description and product.description != blank %}
            <div class="ai-product-display__description-{{ ai_gen_id }}">
              {{ product.description }}
            </div>
          {% endif %}

          {% if block.settings.show_variants and product.has_only_default_variant == false %}
            <div class="ai-product-display__variants-{{ ai_gen_id }}">
              {% for option in product.options_with_values %}
                <div class="ai-product-display__variant-group-{{ ai_gen_id }}">
                  <label class="ai-product-display__variant-label-{{ ai_gen_id }}">
                    {{ option.name }}
                  </label>
                  <div class="ai-product-display__variant-options-{{ ai_gen_id }}">
                    {% for value in option.values %}
                      <button
                        type="button"
                        class="ai-product-display__variant-option-{{ ai_gen_id }}"
                        data-option-name="{{ option.name }}"
                        data-option-value="{{ value }}"
                      >
                        {{ value }}
                      </button>
                    {% endfor %}
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}

          {% if block.settings.show_quantity %}
            <div class="ai-product-display__quantity-{{ ai_gen_id }}">
              <label class="ai-product-display__quantity-label-{{ ai_gen_id }}" for="quantity-{{ ai_gen_id }}">
                Quantity
              </label>
              <input
                type="number"
                id="quantity-{{ ai_gen_id }}"
                class="ai-product-display__quantity-input-{{ ai_gen_id }}"
                value="1"
                min="1"
              >
            </div>
          {% endif %}

          {% if block.settings.show_add_to_cart %}
            <button
              type="button"
              class="ai-product-display__button-{{ ai_gen_id }}"
              data-product-id="{{ product.id }}"
            >
              {% if product.available %}
                {{ block.settings.button_text }}
              {% else %}
                Sold out
              {% endif %}
            </button>
          {% endif %}
        </div>
      </div>
    {% else %}
      <div class="ai-product-display__empty-state-{{ ai_gen_id }}">
        <div class="ai-product-display__image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
        <p>Select a product to display</p>
      </div>
    {% endif %}
  </div>
</product-display-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductDisplay{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.variantButtons = this.querySelectorAll('.ai-product-display__variant-option-{{ ai_gen_id }}');
        this.addToCartButton = this.querySelector('.ai-product-display__button-{{ ai_gen_id }}');
        this.quantityInput = this.querySelector('.ai-product-display__quantity-input-{{ ai_gen_id }}');
        this.selectedOptions = {};
      }

      connectedCallback() {
        this.setupVariantSelection();
        this.setupAddToCart();
      }

      setupVariantSelection() {
        if (!this.variantButtons.length) return;

        this.variantButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const optionName = button.dataset.optionName;
            const optionValue = button.dataset.optionValue;

            this.querySelectorAll(`[data-option-name="${optionName}"]`).forEach((btn) => {
              btn.classList.remove('active');
            });

            button.classList.add('active');
            this.selectedOptions[optionName] = optionValue;
          });
        });

        this.querySelectorAll('.ai-product-display__variant-group-{{ ai_gen_id }}').forEach((group) => {
          const firstButton = group.querySelector('.ai-product-display__variant-option-{{ ai_gen_id }}');
          if (firstButton) {
            firstButton.click();
          }
        });
      }

      setupAddToCart() {
        if (!this.addToCartButton) return;

        this.addToCartButton.addEventListener('click', () => {
          const productId = this.addToCartButton.dataset.productId;
          const quantity = this.quantityInput ? parseInt(this.quantityInput.value) : 1;

          const formData = {
            items: [{
              id: productId,
              quantity: quantity
            }]
          };

          fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(formData)
          })
          .then(response => response.json())
          .then(data => {
            window.location.href = '/cart';
          })
          .catch((error) => {
            console.error('Error:', error);
          });
        });
      }
    }

    customElements.define('product-display-{{ ai_gen_id }}', ProductDisplay{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product display",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Display options"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_variants",
      "label": "Show variants",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart button",
      "default": true
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Add to cart"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#090909"
    },
    {
      "type": "color",
      "id": "sale_color",
      "label": "Sale price color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 32
    },
    {
      "type": "range",
      "id": "price_size",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Price size",
      "default": 24
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 2000,
      "step": 100,
      "unit": "px",
      "label": "Container width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "variant_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Variant border radius",
      "default": 0
