{% doc %}
  @prompt
    Create a small moving text with icon , should be able to upload atleast 6 content
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ticker-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
  }

  .ai-ticker-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_spacing }}px;
    animation: ai-ticker-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-ticker-{{ ai_gen_id }}:hover .ai-ticker-track-{{ ai_gen_id }} {
    animation-play-state: paused;
  }

  .ai-ticker-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_text_gap }}px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ai-ticker-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-ticker-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-ticker-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: {{ block.settings.text_weight }};
  }

  @keyframes ai-ticker-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-ticker-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.85 }}px;
    }

    .ai-ticker-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.85 }}px;
      height: {{ block.settings.icon_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<ticker-component-{{ ai_gen_id }} class="ai-ticker-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ticker-track-{{ ai_gen_id }}">
    {% liquid
      assign visible_items = 0
      for i in (1..6)
        assign text_key = 'item_' | append: i | append: '_text'
        assign icon_key = 'item_' | append: i | append: '_icon'
        assign enabled_key = 'item_' | append: i | append: '_enabled'
        
        if block.settings[enabled_key] and block.settings[text_key] != blank
          assign visible_items = visible_items | plus: 1
        endif
      endfor
    %}

    {% if visible_items > 0 %}
      {% for repeat in (1..2) %}
        {% for i in (1..6) %}
          {% liquid
            assign text_key = 'item_' | append: i | append: '_text'
            assign icon_key = 'item_' | append: i | append: '_icon'
            assign enabled_key = 'item_' | append: i | append: '_enabled'
            
            assign item_text = block.settings[text_key]
            assign item_icon = block.settings[icon_key]
            assign item_enabled = block.settings[enabled_key]
          %}

          {% if item_enabled and item_text != blank %}
            <div class="ai-ticker-item-{{ ai_gen_id }}">
              {% if item_icon %}
                <div class="ai-ticker-icon-{{ ai_gen_id }}">
                  <img
                    src="{{ item_icon | image_url: width: 100 }}"
                    alt=""
                    loading="lazy"
                    width="100"
                    height="100"
                  >
                </div>
              {% endif %}
              <span class="ai-ticker-text-{{ ai_gen_id }}">{{ item_text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% else %}
      <div class="ai-ticker-item-{{ ai_gen_id }}">
        <span class="ai-ticker-text-{{ ai_gen_id }}">Add your ticker content in the block settings</span>
      </div>
    {% endif %}
  </div>
</ticker-component-{{ ai_gen_id }}>

<script>
  (function() {
    class TickerComponent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-ticker-track-{{ ai_gen_id }}');
        this.adjustAnimation();
      }

      adjustAnimation() {
        if (!this.track) return;
        
        const trackWidth = this.track.scrollWidth / 2;
        const containerWidth = this.offsetWidth;
        
        if (trackWidth < containerWidth) {
          this.track.style.animation = 'none';
        }
      }
    }

    customElements.define('ticker-component-{{ ai_gen_id }}', TickerComponent{{ ai_gen_id }});
  })();
</script>

