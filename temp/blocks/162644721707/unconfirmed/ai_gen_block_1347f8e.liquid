    },
    {
      "type": "range",
      "id": "button_height",
      "min": 40,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Height",
      "default": 52
    },
    {
      "type": "header",
      "content": "Button size - Mobile"
    },
    {
      "type": "range",
