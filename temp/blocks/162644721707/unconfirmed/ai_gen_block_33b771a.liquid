{% doc %}
  @prompt
    Create a fully customizable Image + Text Section with these features:
    
    1. Layout & Image
    
    Option to place image left or right.
    
    Image upload field.
    
    Image container adapts to natural image size (no cropping unless selected).
    
    2. Text Block
    
    Headline field.
    
    Two subheadline fields below headline.
    
    Option to change subheadline container background color.
    
    Subheadline container with 36px border radius.
    
    Paragraph field below subheadlines.
    
    3. Customer Reviews Slider
    
    Upload up to 5 reviews. Each review includes:
    
    Bold highlight text (short key quote)
    
    Full review text
    
    Star rating selector
    
    Customer name + “Verified Buyer” label
    
    Optional checkmark badge upload
    
    Slider features: Next/Previous arrows, dot navigation, auto-adjust spacing/height.
    
    4. Section Styling
    
    Option to change overall section background color.
    
    Clean, balanced, responsive layout for both mobile & desktop views
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-reviews-{{ ai_gen_id }} {
    background-color: {{ block.settings.section_bg_color }};
    padding: 60px 20px;
  }

  .ai-image-text-reviews-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .ai-image-text-reviews-container-{{ ai_gen_id }}.image-right {
    grid-template-columns: 1fr 1fr;
  }

  .ai-image-text-reviews-container-{{ ai_gen_id }}.image-left {
    grid-template-columns: 1fr 1fr;
  }

  .ai-image-text-reviews-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    {% if block.settings.image_layout == 'left' %}
      order: 1;
    {% else %}
      order: 2;
    {% endif %}
  }

  .ai-image-text-reviews-image-container-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    position: relative;
  }

  .ai-image-text-reviews-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    {% if block.settings.image_fit == 'cover' %}
      object-fit: cover;
      aspect-ratio: 1 / 1;
    {% else %}
      object-fit: contain;
    {% endif %}
  }

  .ai-image-text-reviews-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-text-reviews-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-image-text-reviews-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-text-reviews-content-wrapper-{{ ai_gen_id }} {
    {% if block.settings.image_layout == 'left' %}
      order: 2;
    {% else %}
      order: 1;
    {% endif %}
  }

  .ai-image-text-reviews-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    margin: 0 0 20px;
    color: {{ block.settings.text_color }};
    line-height: 1.2;
  }

  .ai-image-text-reviews-subheadlines-{{ ai_gen_id }} {
    background-color: {{ block.settings.subheadline_bg_color }};
    border-radius: 36px;
    padding: 24px 32px;
    margin-bottom: 24px;
  }

  .ai-image-text-reviews-subheadline-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheadline_size }}px;
    font-weight: 600;
    margin: 0 0 12px;
    color: {{ block.settings.text_color }};
    line-height: 1.4;
  }

  .ai-image-text-reviews-subheadline-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-image-text-reviews-paragraph-{{ ai_gen_id }} {
    font-size: {{ block.settings.paragraph_size }}px;
    line-height: 1.6;
    margin: 0 0 32px;
    color: {{ block.settings.text_color }};
  }

  .ai-image-text-reviews-slider-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-image-text-reviews-slides-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s ease;
  }

  .ai-image-text-reviews-slide-{{ ai_gen_id }} {
    min-width: 100%;
    flex-shrink: 0;
    padding: 24px;
    background-color: {{ block.settings.review_bg_color }};
    border-radius: 12px;
    box-sizing: border-box;
  }

  .ai-image-text-reviews-highlight-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_highlight_size }}px;
    font-weight: 700;
    margin: 0 0 12px;
    color: {{ block.settings.text_color }};
    line-height: 1.3;
  }

  .ai-image-text-reviews-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    line-height: 1.6;
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
  }

  .ai-image-text-reviews-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
  }

  .ai-image-text-reviews-star-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.star_color }};
  }

  .ai-image-text-reviews-customer-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-image-text-reviews-customer-name-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-image-text-reviews-verified-{{ ai_gen_id }} {
    font-size: 12px;
    color: #666;
  }

  .ai-image-text-reviews-badge-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .ai-image-text-reviews-controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
  }

  .ai-image-text-reviews-arrows-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
  }

  .ai-image-text-reviews-arrow-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border: 1px solid {{ block.settings.text_color }};
    background-color: transparent;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-image-text-reviews-arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.text_color }};
  }

  .ai-image-text-reviews-arrow-{{ ai_gen_id }}:hover svg {
    stroke: {{ block.settings.section_bg_color }};
  }

  .ai-image-text-reviews-arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-image-text-reviews-arrow-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.text_color }};
    transition: stroke 0.3s ease;
  }

  .ai-image-text-reviews-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-image-text-reviews-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #ccc;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
    padding: 0;
  }

  .ai-image-text-reviews-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-image-text-reviews-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-image-text-reviews-image-wrapper-{{ ai_gen_id }},
    .ai-image-text-reviews-content-wrapper-{{ ai_gen_id }} {
      order: unset;
    }

    .ai-image-text-reviews-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.8 }}px;
    }

    .ai-image-text-reviews-subheadline-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheadline_size | times: 0.9 }}px;
    }

    .ai-image-text-reviews-subheadlines-{{ ai_gen_id }} {
      padding: 20px 24px;
    }
  }
{% endstyle %}

<image-text-reviews-{{ ai_gen_id }} class="ai-image-text-reviews-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-reviews-container-{{ ai_gen_id }} {% if block.settings.image_layout == 'right' %}image-right{% else %}image-left{% endif %}">
    <div class="ai-image-text-reviews-image-wrapper-{{ ai_gen_id }}">
      <div class="ai-image-text-reviews-image-container-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 1200 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-image-text-reviews-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-image-text-reviews-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-image-text-reviews-empty-state-{{ ai_gen_id }}">
              Add an image to get started
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-image-text-reviews-content-wrapper-{{ ai_gen_id }}">
      {% if block.settings.headline != blank %}
        <h2 class="ai-image-text-reviews-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      {% endif %}

      {% if block.settings.subheadline_1 != blank or block.settings.subheadline_2 != blank %}
        <div class="ai-image-text-reviews-subheadlines-{{ ai_gen_id }}">
          {% if block.settings.subheadline_1 != blank %}
            <div class="ai-image-text-reviews-subheadline-{{ ai_gen_id }}">{{ block.settings.subheadline_1 }}</div>
          {% endif %}
          {% if block.settings.subheadline_2 != blank %}
            <div class="ai-image-text-reviews-subheadline-{{ ai_gen_id }}">{{ block.settings.subheadline_2 }}</div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.paragraph != blank %}
        <div class="ai-image-text-reviews-paragraph-{{ ai_gen_id }}">{{ block.settings.paragraph }}</div>
      {% endif %}

      <div class="ai-image-text-reviews-slider-{{ ai_gen_id }}">
        <div class="ai-image-text-reviews-slides-{{ ai_gen_id }}">
          {% for i in (1..5) %}
            {% liquid
              assign highlight_key = 'review_' | append: i | append: '_highlight'
              assign text_key = 'review_' | append: i | append: '_text'
              assign stars_key = 'review_' | append: i | append: '_stars'
              assign name_key = 'review_' | append: i | append: '_name'
              assign badge_key = 'review_' | append: i | append: '_badge'

              assign highlight = block.settings[highlight_key]
              assign text = block.settings[text_key]
              assign stars = block.settings[stars_key]
              assign name = block.settings[name_key]
              assign badge = block.settings[badge_key]
            %}

            {% if highlight != blank or text != blank %}
              <div class="ai-image-text-reviews-slide-{{ ai_gen_id }}" data-slide="{{ i }}">
                {% if highlight != blank %}
                  <div class="ai-image-text-reviews-highlight-{{ ai_gen_id }}">{{ highlight }}</div>
                {% endif %}

                {% if text != blank %}
                  <div class="ai-image-text-reviews-text-{{ ai_gen_id }}">{{ text }}</div>
                {% endif %}

                <div class="ai-image-text-reviews-stars-{{ ai_gen_id }}">
                  {% for star in (1..stars) %}
                    <svg class="ai-image-text-reviews-star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {% endfor %}
                </div>

                <div class="ai-image-text-reviews-customer-{{ ai_gen_id }}">
                  {% if name != blank %}
                    <span class="ai-image-text-reviews-customer-name-{{ ai_gen_id }}">{{ name }}</span>
                  {% endif %}
                  <span class="ai-image-text-reviews-verified-{{ ai_gen_id }}">Verified Buyer</span>
                  {% if badge %}
                    <img
                      src="{{ badge | image_url: width: 40 }}"
                      alt="Verified badge"
                      class="ai-image-text-reviews-badge-{{ ai_gen_id }}"
                      loading="lazy"
                      width="20"
                      height="20"
                    >
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="ai-image-text-reviews-controls-{{ ai_gen_id }}">
          <div class="ai-image-text-reviews-arrows-{{ ai_gen_id }}">
            <button class="ai-image-text-reviews-arrow-{{ ai_gen_id }} ai-image-text-reviews-prev-{{ ai_gen_id }}" aria-label="Previous review">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            <button class="ai-image-text-reviews-arrow-{{ ai_gen_id }} ai-image-text-reviews-next-{{ ai_gen_id }}" aria-label="Next review">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
          <div class="ai-image-text-reviews-dots-{{ ai_gen_id }}"></div>
        </div>
      </div>
    </div>
  </div>
</image-text-reviews-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageTextReviews{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
      }

      connectedCallback() {
        this.slidesContainer = this.querySelector('.ai-image-text-reviews-slides-{{ ai_gen_id }}');
        this.slides = Array.from(this.querySelectorAll('.ai-image-text-reviews-slide-{{ ai_gen_id }}'));
        this.prevButton = this.querySelector('.ai-image-text-reviews-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-image-text-reviews-next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-image-text-reviews-dots-{{ ai_gen_id }}');

        if (this.slides.length === 0) return;

        this.createDots();
        this.updateSlider();
        this.setupEventListeners();
      }

      createDots() {
        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.classList.add('ai-image-text-reviews-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to review ${index + 1}`);
          dot.addEventListener('click', () => this.goToSlide(index));
          this.dotsContainer.appendChild(dot);
        });
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.prevSlide());
        this.nextButton.addEventListener('click', () => this.nextSlide());
      }

      updateSlider() {
        const offset = -this.currentSlide * 100;
        this.slidesContainer.style.transform = `translateX(${offset}%)`;

        this.prevButton.disabled = this.currentSlide === 0;
        this.nextButton.disabled = this.currentSlide === this.slides.length - 1;

        const dots = this.dotsContainer.querySelectorAll('.ai-image-text-reviews-dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateSlider();
      }

      prevSlide() {
        if (this.currentSlide > 0) {
          this.currentSlide--;
          this.updateSlider();
        }
      }

      nextSlide() {
        if (this.currentSlide < this.slides.length - 1) {
          this.currentSlide++;
          this.updateSlider();
        }
      }
    }

    customElements.define('image-text-reviews-{{ ai_gen_id }}', ImageTextReviews{{ ai_gen_id }});
  })();
</script>

