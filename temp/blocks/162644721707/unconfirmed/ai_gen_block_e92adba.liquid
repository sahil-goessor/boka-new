{% doc %}
  @prompt
    Create a Hero Banner section. On the left side, include a small customer reviews rating with the text “3,700+ Reviews” below it, followed by a headline and body text. Below the text, display two small claim icons with accompanying text, aligned inline-block. Underneath the icons, include a CTA button. On the right side, provide an option to upload an image or video. The uploaded hero banner asset should automatically adapt based on its size, supporting small, medium, or tall heights as needed. The entire hero banner should have an option to update the background color and be fully responsive for both mobile and desktop views., In the media section please add option to select adopt image/video size , Please have option to update the content alignment for mobile view , On mobile view, The CTA button on mobile view should be fully responsive, automatically adjusting its width based on the screen size while maintaining appropriate margins.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-banner-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: 60px 20px;
  }

  .ai-hero-banner-container-{{ ai_gen_id }} {
    max-width: 1800px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .ai-hero-banner-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-hero-banner-reviews-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-hero-banner-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    color: {{ block.settings.star_color }};
  }

  .ai-hero-banner-stars-{{ ai_gen_id }} svg {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: currentColor;
  }

  .ai-hero-banner-review-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
  }

  .ai-hero-banner-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-hero-banner-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-hero-banner-claims-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .ai-hero-banner-claim-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .ai-hero-banner-claim-icon-{{ ai_gen_id }} {
    width: {{ block.settings.claim_icon_size }}px;
    height: {{ block.settings.claim_icon_size }}px;
    flex-shrink: 0;
  }

  .ai-hero-banner-claim-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-hero-banner-claim-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-hero-banner-claim-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-hero-banner-claim-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.claim_text_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-hero-banner-cta-wrapper-{{ ai_gen_id }} {
    display: inline-block;
  }

  .ai-hero-banner-cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: background-color 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-hero-banner-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-hero-banner-media-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-hero-banner-media-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.media_border_radius }}px;
  }

  .ai-hero-banner-media-wrapper-{{ ai_gen_id }}.ai-hero-banner-height-small-{{ ai_gen_id }} {
    height: 400px;
  }

  .ai-hero-banner-media-wrapper-{{ ai_gen_id }}.ai-hero-banner-height-medium-{{ ai_gen_id }} {
    height: 550px;
  }

  .ai-hero-banner-media-wrapper-{{ ai_gen_id }}.ai-hero-banner-height-tall-{{ ai_gen_id }} {
    height: 700px;
  }

  .ai-hero-banner-media-wrapper-{{ ai_gen_id }}.ai-hero-banner-height-adapt-{{ ai_gen_id }} {
    height: auto;
  }

  .ai-hero-banner-media-wrapper-{{ ai_gen_id }} img,
  .ai-hero-banner-media-wrapper-{{ ai_gen_id }} video {
    width: 100%;
    height: 100%;
  }

  .ai-hero-banner-media-wrapper-{{ ai_gen_id }}.ai-hero-banner-height-adapt-{{ ai_gen_id }} img,
  .ai-hero-banner-media-wrapper-{{ ai_gen_id }}.ai-hero-banner-height-adapt-{{ ai_gen_id }} video {
    height: auto;
    object-fit: contain;
  }

  .ai-hero-banner-media-wrapper-{{ ai_gen_id }}:not(.ai-hero-banner-height-adapt-{{ ai_gen_id }}) img,
  .ai-hero-banner-media-wrapper-{{ ai_gen_id }}:not(.ai-hero-banner-height-adapt-{{ ai_gen_id }}) video {
    object-fit: cover;
  }

  .ai-hero-banner-media-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-banner-media-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-hero-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .ai-hero-banner-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-hero-banner-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-hero-banner-headline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.headline_size }}px * 0.8);
    }

    .ai-hero-banner-body-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.body_text_size }}px * 0.9);
    }

    .ai-hero-banner-media-wrapper-{{ ai_gen_id }}.ai-hero-banner-height-small-{{ ai_gen_id }} {
      height: 300px;
    }

    .ai-hero-banner-media-wrapper-{{ ai_gen_id }}.ai-hero-banner-height-medium-{{ ai_gen_id }} {
      height: 400px;
    }

    .ai-hero-banner-media-wrapper-{{ ai_gen_id }}.ai-hero-banner-height-tall-{{ ai_gen_id }} {
      height: 500px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-hero-banner-content-{{ ai_gen_id }} {
      align-items: {{ block.settings.mobile_content_alignment }};
      text-align: {{ block.settings.mobile_content_alignment }};
    }

    .ai-hero-banner-reviews-{{ ai_gen_id }} {
      align-items: {{ block.settings.mobile_content_alignment }};
    }

    .ai-hero-banner-stars-{{ ai_gen_id }} {
      {% if block.settings.mobile_content_alignment == 'center' %}
        justify-content: center;
      {% elsif block.settings.mobile_content_alignment == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
    }

    .ai-hero-banner-claims-{{ ai_gen_id }} {
      {% if block.settings.mobile_content_alignment == 'center' %}
        justify-content: center;
      {% elsif block.settings.mobile_content_alignment == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
    }

    .ai-hero-banner-headline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.headline_size }}px * 0.65);
    }

    .ai-hero-banner-claims-{{ ai_gen_id }} {
      gap: 16px;
    }

    .ai-hero-banner-claim-icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.claim_icon_size }}px * 0.8);
      height: calc({{ block.settings.claim_icon_size }}px * 0.8);
    }

    .ai-hero-banner-cta-wrapper-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-hero-banner-cta-{{ ai_gen_id }} {
      width: 100%;
      text-align: center;
      box-sizing: border-box;
    }
  }
{% endstyle %}

<div class="ai-hero-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-banner-container-{{ ai_gen_id }}">
    <div class="ai-hero-banner-content-{{ ai_gen_id }}">
      {% if block.settings.show_reviews %}
        <div class="ai-hero-banner-reviews-{{ ai_gen_id }}">
          <div class="ai-hero-banner-stars-{{ ai_gen_id }}">
            {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endfor %}
          </div>
          <div class="ai-hero-banner-review-text-{{ ai_gen_id }}">
            {{ block.settings.review_text }}
          </div>
        </div>
      {% endif %}

      {% if block.settings.headline != blank %}
        <h1 class="ai-hero-banner-headline-{{ ai_gen_id }}">
          {{ block.settings.headline }}
        </h1>
      {% endif %}

      {% if block.settings.body_text != blank %}
        <div class="ai-hero-banner-body-{{ ai_gen_id }}">
          {{ block.settings.body_text }}
        </div>
      {% endif %}

      <div class="ai-hero-banner-claims-{{ ai_gen_id }}">
        {% if block.settings.show_claim_1 %}
          <div class="ai-hero-banner-claim-{{ ai_gen_id }}">
            <div class="ai-hero-banner-claim-icon-{{ ai_gen_id }}">
              {% if block.settings.claim_1_icon %}
                <img
                  src="{{ block.settings.claim_1_icon | image_url: width: 100 }}"
                  alt="{{ block.settings.claim_1_icon.alt | escape }}"
                  loading="lazy"
                  width="100"
                  height="100"
                >
              {% else %}
                <div class="ai-hero-banner-claim-icon-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            {% if block.settings.claim_1_text != blank %}
              <span class="ai-hero-banner-claim-text-{{ ai_gen_id }}">
                {{ block.settings.claim_1_text }}
              </span>
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.show_claim_2 %}
          <div class="ai-hero-banner-claim-{{ ai_gen_id }}">
            <div class="ai-hero-banner-claim-icon-{{ ai_gen_id }}">
              {% if block.settings.claim_2_icon %}
                <img
                  src="{{ block.settings.claim_2_icon | image_url: width: 100 }}"
                  alt="{{ block.settings.claim_2_icon.alt | escape }}"
                  loading="lazy"
                  width="100"
                  height="100"
                >
              {% else %}
                <div class="ai-hero-banner-claim-icon-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            {% if block.settings.claim_2_text != blank %}
              <span class="ai-hero-banner-claim-text-{{ ai_gen_id }}">
                {{ block.settings.claim_2_text }}
              </span>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% if block.settings.button_text != blank %}
        <div class="ai-hero-banner-cta-wrapper-{{ ai_gen_id }}">
          <a
            href="{{ block.settings.button_link }}"
            class="ai-hero-banner-cta-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        </div>
      {% endif %}
    </div>

    <div class="ai-hero-banner-media-{{ ai_gen_id }}">
      <div class="ai-hero-banner-media-wrapper-{{ ai_gen_id }} ai-hero-banner-height-{{ block.settings.media_height }}-{{ ai_gen_id }}">
        {% if block.settings.hero_image %}
          <img
            src="{{ block.settings.hero_image | image_url: width: 1200 }}"
            alt="{{ block.settings.hero_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.hero_image.width }}"
            height="{{ block.settings.hero_image.height }}"
          >
        {% elsif block.settings.hero_video %}
          <video
            autoplay
            muted
            loop
            playsinline
          >
            <source src="{{ block.settings.hero_video }}" type="video/mp4">
          </video>
        {% else %}
          <div class="ai-hero-banner-media-placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-hero-banner-empty-state-{{ ai_gen_id }}">
              Next, add an image or video
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show reviews",
      "default": true
    },
    {
      "type": "text",
      "id": "review_text",
      "label": "Review text",
      "default": "3,700+ Reviews"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#FFD700"
    },
    {
      "type": "range",
      "id": "star_size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Star size",
      "default": 20
    },
    {
      "type": "range",
      "id": "review_text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Review text size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Transform Your Smile"
    },
    {
      "type": "range",
      "id": "headline_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Headline size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Body text"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Discover premium oral care products designed for a healthier, brighter smile."
    },
    {
      "type": "range",
      "id": "body_text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Body text size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Claim 1"
    },
    {
      "type": "checkbox",
      "id": "show_claim_1",
      "label": "Show claim 1",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "claim_1_icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "claim_1_text",
      "label": "Text",
      "default": "Natural Ingredients"
    },
    {
      "type": "header",
      "content": "Claim 2"
    },
    {
      "type": "checkbox",
      "id": "show_claim_2",
      "label": "Show claim 2",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "claim_2_icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "claim_2_text",
      "label": "Text",
      "default": "Dentist Approved"
    },
    {
      "type": "range",
      "id": "claim_icon_size",
      "min": 24,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 40
    },
    {
      "type": "range",
      "id": "claim_text_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Hover background color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_text_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Image"
    },
    {
      "type": "video_url",
      "id": "hero_video",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "select",
      "id": "media_height",
      "label": "Height",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image/video"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "tall",
          "label": "Tall"
        }
      ],
      "default": "medium",
      "info": "Adapt will maintain the original aspect ratio"
    },
    {
      "type": "range",
      "id": "media_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
