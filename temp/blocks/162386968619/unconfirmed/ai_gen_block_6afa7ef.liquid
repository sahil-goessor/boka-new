{% doc %}
  @prompt
    Create a fully customizable Image + Text Section with the following functionalities and layout:
    
    1. Layout Options
    
    Provide an option to place the image either on the left or on the right side.
    
    Include an image upload field.
    
    The image container must be adaptive to the uploaded image’s natural size (no cropping unless chosen).
    
    2. Text Content Block (right or left depending on layout choice)
    Headline
    
    Add a field to input a main headline.
    
    Two Subheadlines
    
    Below the headline, add two separate subheadline fields.
    
    Provide an option to change the background color of the subheadline container.
    
    The subheadline container should have a 36px border radius.
    
    Paragraph
    
    Below the subheadlines, add a field for a paragraph text block.
    
    3. Customer Reviews Slider
    
    Place this below the paragraph text.
    
    For each review, allow the following fields:
    
    Bold highlight text (short summary or key review quote)
    
    Full review text
    
    Star rating selector
    
    Customer name
    
    “Verified Buyer” label next to the name
    
    Checkmark badge upload option
    
    Slider Requirements:
    
    Ability to upload up to 5 reviews
    
    Include Next and Previous arrows
    
    Include dot navigation indicators at the bottom
    
    Slider should auto-adjust spacing and height based on content.
    
    4. Section Styling
    
    Add an option to change the overall section background color.
    
    Container spacing and layout should remain clean, balanced, and responsive for both mobile & desktop views
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.section_bg_color }};
    padding: 60px 20px;
  }

  .ai-image-text-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: 60px;
    align-items: center;
    {% if block.settings.image_position == 'right' %}
      flex-direction: row-reverse;
    {% endif %}
  }

  .ai-image-text-image-wrapper-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-image-text-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-text-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-image-text-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-image-text-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-text-content-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-image-text-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    margin: 0 0 24px;
    color: {{ block.settings.text_color }};
    line-height: 1.2;
  }

  .ai-image-text-subheadlines-{{ ai_gen_id }} {
    background-color: {{ block.settings.subheadline_bg_color }};
    border-radius: 36px;
    padding: 24px 32px;
    margin-bottom: 24px;
  }

  .ai-image-text-subheadline-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheadline_size }}px;
    font-weight: 600;
    margin: 0;
    color: {{ block.settings.text_color }};
    line-height: 1.4;
  }

  .ai-image-text-subheadline-{{ ai_gen_id }}:first-child {
    margin-bottom: 12px;
  }

  .ai-image-text-paragraph-{{ ai_gen_id }} {
    font-size: {{ block.settings.paragraph_size }}px;
    line-height: 1.6;
    margin: 0 0 32px;
    color: {{ block.settings.text_color }};
  }

  .ai-image-text-reviews-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-image-text-slider-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-image-text-slides-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s ease;
  }

  .ai-image-text-slide-{{ ai_gen_id }} {
    min-width: 100%;
    flex-shrink: 0;
  }

  .ai-image-text-review-{{ ai_gen_id }} {
    padding: 24px;
    background-color: {{ block.settings.review_bg_color }};
    border-radius: {{ block.settings.review_border_radius }}px;
  }

  .ai-image-text-review-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .ai-image-text-review-highlight-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_highlight_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0;
    flex: 1;
  }

  .ai-image-text-review-badge-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .ai-image-text-review-badge-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-image-text-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
  }

  .ai-image-text-star-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    color: {{ block.settings.star_color }};
  }

  .ai-image-text-star-{{ ai_gen_id }}.empty {
    color: #d1d5db;
  }

  .ai-image-text-review-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    line-height: 1.6;
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
  }

  .ai-image-text-review-footer-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-image-text-customer-name-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-image-text-verified-{{ ai_gen_id }} {
    font-size: 12px;
    color: #6b7280;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .ai-image-text-verified-{{ ai_gen_id }}::before {
    content: "✓";
    display: inline-block;
    width: 16px;
    height: 16px;
    background-color: {{ block.settings.verified_badge_color }};
    color: white;
    border-radius: 50%;
    text-align: center;
    line-height: 16px;
    font-size: 12px;
    font-weight: 700;
  }

  .ai-image-text-controls-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 24px;
  }

  .ai-image-text-arrows-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
  }

  .ai-image-text-arrow-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ block.settings.arrow_bg_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
    color: {{ block.settings.arrow_color }};
  }

  .ai-image-text-arrow-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-image-text-arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-image-text-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-image-text-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-image-text-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 768px) {
    .ai-image-text-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 40px;
    }

    .ai-image-text-headline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.headline_size }}px * 0.8);
    }

    .ai-image-text-subheadline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheadline_size }}px * 0.9);
    }

    .ai-image-text-paragraph-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.paragraph_size }}px * 0.95);
    }

    .ai-image-text-subheadlines-{{ ai_gen_id }} {
      padding: 20px 24px;
    }
  }
{% endstyle %}

<image-text-section-{{ ai_gen_id }} class="ai-image-text-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-container-{{ ai_gen_id }}">
    <div class="ai-image-text-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-image-text-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-image-text-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-image-text-empty-state-{{ ai_gen_id }}">
            Add an image
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-image-text-content-{{ ai_gen_id }}">
      {% if block.settings.headline != blank %}
        <h2 class="ai-image-text-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      {% endif %}

      {% if block.settings.subheadline_1 != blank or block.settings.subheadline_2 != blank %}
        <div class="ai-image-text-subheadlines-{{ ai_gen_id }}">
          {% if block.settings.subheadline_1 != blank %}
            <p class="ai-image-text-subheadline-{{ ai_gen_id }}">{{ block.settings.subheadline_1 }}</p>
          {% endif %}
          {% if block.settings.subheadline_2 != blank %}
            <p class="ai-image-text-subheadline-{{ ai_gen_id }}">{{ block.settings.subheadline_2 }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.paragraph != blank %}
        <div class="ai-image-text-paragraph-{{ ai_gen_id }}">{{ block.settings.paragraph }}</div>
      {% endif %}

      <div class="ai-image-text-reviews-{{ ai_gen_id }}">
        <div class="ai-image-text-slider-{{ ai_gen_id }}">
          <div class="ai-image-text-slides-{{ ai_gen_id }}" data-slider-track>
            {% for i in (1..5) %}
              {% liquid
                assign review_enabled_key = 'review_' | append: i | append: '_enabled'
                assign review_highlight_key = 'review_' | append: i | append: '_highlight'
                assign review_text_key = 'review_' | append: i | append: '_text'
                assign review_stars_key = 'review_' | append: i | append: '_stars'
                assign review_name_key = 'review_' | append: i | append: '_name'
                assign review_badge_key = 'review_' | append: i | append: '_badge'

                assign review_enabled = block.settings[review_enabled_key]
                assign review_highlight = block.settings[review_highlight_key]
                assign review_text = block.settings[review_text_key]
                assign review_stars = block.settings[review_stars_key]
                assign review_name = block.settings[review_name_key]
                assign review_badge = block.settings[review_badge_key]
              %}

              {% if review_enabled %}
                <div class="ai-image-text-slide-{{ ai_gen_id }}" data-slide>
                  <div class="ai-image-text-review-{{ ai_gen_id }}">
                    <div class="ai-image-text-review-header-{{ ai_gen_id }}">
                      {% if review_highlight != blank %}
                        <h3 class="ai-image-text-review-highlight-{{ ai_gen_id }}">{{ review_highlight }}</h3>
                      {% endif %}
                      {% if review_badge %}
                        <div class="ai-image-text-review-badge-{{ ai_gen_id }}">
                          <img src="{{ review_badge | image_url: width: 48 }}" alt="Badge" loading="lazy">
                        </div>
                      {% endif %}
                    </div>

                    <div class="ai-image-text-stars-{{ ai_gen_id }}">
                      {% for star in (1..5) %}
                        <svg class="ai-image-text-star-{{ ai_gen_id }} {% if star > review_stars %}empty{% endif %}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                      {% endfor %}
                    </div>

                    {% if review_text != blank %}
                      <p class="ai-image-text-review-text-{{ ai_gen_id }}">{{ review_text }}</p>
                    {% endif %}

                    <div class="ai-image-text-review-footer-{{ ai_gen_id }}">
                      {% if review_name != blank %}
                        <span class="ai-image-text-customer-name-{{ ai_gen_id }}">{{ review_name }}</span>
                      {% endif %}
                      <span class="ai-image-text-verified-{{ ai_gen_id }}">Verified Buyer</span>
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <div class="ai-image-text-controls-{{ ai_gen_id }}">
          <div class="ai-image-text-arrows-{{ ai_gen_id }}">
            <button class="ai-image-text-arrow-{{ ai_gen_id }}" data-prev aria-label="Previous review">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button class="ai-image-text-arrow-{{ ai_gen_id }}" data-next aria-label="Next review">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
          <div class="ai-image-text-dots-{{ ai_gen_id }}" data-dots></div>
        </div>
      </div>
    </div>
  </div>
</image-text-section-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageTextSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
      }

      connectedCallback() {
        this.track = this.querySelector('[data-slider-track]');
        this.slides = Array.from(this.querySelectorAll('[data-slide]'));
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dotsContainer = this.querySelector('[data-dots]');

        if (this.slides.length === 0) return;

        this.createDots();
        this.updateSlider();
        this.setupEventListeners();
      }

      createDots() {
        this.dotsContainer.innerHTML = '';
        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.className = 'ai-image-text-dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', 'Go to review ' + (index + 1));
          dot.addEventListener('click', () => this.goToSlide(index));
          this.dotsContainer.appendChild(dot);
        });
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.prevSlide());
        this.nextButton.addEventListener('click', () => this.nextSlide());
      }

      updateSlider() {
        const offset = -this.currentSlide * 100;
        this.track.style.transform = 'translateX(' + offset + '%)';

        this.prevButton.disabled = this.currentSlide === 0;
        this.nextButton.disabled = this.currentSlide === this.slides.length - 1;

        const dots = this.dotsContainer.querySelectorAll('.ai-image-text-dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateSlider();
      }

      nextSlide() {
        if (this.currentSlide < this.slides.length - 1) {
          this.currentSlide++;
          this.updateSlider();
        }
      }

      prevSlide() {
        if (this.currentSlide > 0) {
          this.currentSlide--;
          this.updateSlider();
        }
      }
    }

    customElements.define('image-text-section-{{ ai_gen_id }}', ImageTextSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Image + Text with Reviews",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Section style"
    },
