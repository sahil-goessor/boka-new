{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-science-feature-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-science-feature__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-science-feature__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-science-feature__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-science-feature__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-science-feature__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-science-feature__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-science-feature__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-science-feature__eyebrow-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: {{ block.settings.eyebrow_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.eyebrow_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-science-feature__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-science-feature__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    line-height: 1.6;
    color: {{ block.settings.description_color }};
  }

  .ai-science-feature__reviews-section-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-science-feature__reviews-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.reviews_headline_size }}px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-science-feature__slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-science-feature__slider-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s ease;
  }

  .ai-science-feature__review-{{ ai_gen_id }} {
    min-width: 100%;
    padding: {{ block.settings.review_padding }}px;
    background-color: {{ block.settings.review_background }};
    border-radius: {{ block.settings.review_border_radius }}px;
    border: 1px solid {{ block.settings.review_border_color }};
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-science-feature__review-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-science-feature__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
  }

  .ai-science-feature__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    color: {{ block.settings.star_color }};
  }

  .ai-science-feature__star-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .ai-science-feature__reviewer-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.reviewer_name_size }}px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
  }

  .ai-science-feature__review-quote-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_quote_size }}px;
    line-height: 1.6;
    color: {{ block.settings.description_color }};
    font-style: italic;
  }

  .ai-science-feature__slider-controls-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    margin-top: 16px;
    align-items: center;
  }

  .ai-science-feature__slider-button-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ block.settings.button_background }};
    border: 1px solid {{ block.settings.button_border }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-science-feature__slider-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-science-feature__slider-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-science-feature__slider-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.button_icon_color }};
    fill: none;
  }

  .ai-science-feature__slider-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-science-feature__slider-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .ai-science-feature__slider-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 989px) {
    .ai-science-feature__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-science-feature__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_font_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-science-feature-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px {{ block.settings.section_padding_horizontal | times: 0.6 }}px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-science-feature__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_font_size }}px * 0.7);
    }

    .ai-science-feature__description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_font_size }}px * 0.9);
    }
  }
{% endstyle %}

<review-slider-{{ ai_gen_id }} class="ai-science-feature-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-science-feature__container-{{ ai_gen_id }}">
    <div class="ai-science-feature__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-science-feature__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-science-feature__image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
          <div class="ai-science-feature__empty-state-{{ ai_gen_id }}">
            Add a product image
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-science-feature__content-{{ ai_gen_id }}">
      {% if block.settings.eyebrow_text != blank %}
        <div class="ai-science-feature__eyebrow-{{ ai_gen_id }}">
          {{ block.settings.eyebrow_text }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-science-feature__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-science-feature__description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      <div class="ai-science-feature__reviews-section-{{ ai_gen_id }}">
        {% if block.settings.reviews_headline != blank %}
          <h3 class="ai-science-feature__reviews-headline-{{ ai_gen_id }}">
            {{ block.settings.reviews_headline }}
          </h3>
        {% endif %}

        <div class="ai-science-feature__slider-wrapper-{{ ai_gen_id }}">
          <div class="ai-science-feature__slider-{{ ai_gen_id }}" data-slider>
            {% if block.settings.review_1_enabled %}
              <div class="ai-science-feature__review-{{ ai_gen_id }}">
                <div class="ai-science-feature__review-header-{{ ai_gen_id }}">
                  <div class="ai-science-feature__stars-{{ ai_gen_id }}">
                    {% for i in (1..block.settings.review_1_rating) %}
                      <span class="ai-science-feature__star-{{ ai_gen_id }}">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                      </span>
                    {% endfor %}
                  </div>
                  {% if block.settings.review_1_name != blank %}
                    <div class="ai-science-feature__reviewer-name-{{ ai_gen_id }}">
                      {{ block.settings.review_1_name }}
                    </div>
                  {% endif %}
                </div>
                {% if block.settings.review_1_quote != blank %}
                  <div class="ai-science-feature__review-quote-{{ ai_gen_id }}">
                    "{{ block.settings.review_1_quote }}"
                  </div>
                {% endif %}
              </div>
            {% endif %}

            {% if block.settings.review_2_enabled %}
              <div class="ai-science-feature__review-{{ ai_gen_id }}">
                <div class="ai-science-feature__review-header-{{ ai_gen_id }}">
                  <div class="ai-science-feature__stars-{{ ai_gen_id }}">
                    {% for i in (1..block.settings.review_2_rating) %}
                      <span class="ai-science-feature__star-{{ ai_gen_id }}">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                      </span>
                    {% endfor %}
                  </div>
                  {% if block.settings.review_2_name != blank %}
                    <div class="ai-science-feature__reviewer-name-{{ ai_gen_id }}">
                      {{ block.settings.review_2_name }}
                    </div>
                  {% endif %}
                </div>
                {% if block.settings.review_2_quote != blank %}
                  <div class="ai-science-feature__review-quote-{{ ai_gen_id }}">
                    "{{ block.settings.review_2_quote }}"
                  </div>
                {% endif %}
              </div>
            {% endif %}

            {% if block.settings.review_3_enabled %}
              <div class="ai-science-feature__review-{{ ai_gen_id }}">
                <div class="ai-science-feature__review-header-{{ ai_gen_id }}">
                  <div class="ai-science-feature__stars-{{ ai_gen_id }}">
                    {% for i in (1..block.settings.review_3_rating) %}
                      <span class="ai-science-feature__star-{{ ai_gen_id }}">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                      </span>
                    {% endfor %}
                  </div>
                  {% if block.settings.review_3_name != blank %}
                    <div class="ai-science-feature__reviewer-name-{{ ai_gen_id }}">
                      {{ block.settings.review_3_name }}
                    </div>
                  {% endif %}
                </div>
                {% if block.settings.review_3_quote != blank %}
                  <div class="ai-science-feature__review-quote-{{ ai_gen_id }}">
                    "{{ block.settings.review_3_quote }}"
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>

        <div class="ai-science-feature__slider-controls-{{ ai_gen_id }}">
          <button
            class="ai-science-feature__slider-button-{{ ai_gen_id }}"
            data-prev
            aria-label="Previous review"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <div class="ai-science-feature__slider-dots-{{ ai_gen_id }}" data-dots></div>
          <button
            class="ai-science-feature__slider-button-{{ ai_gen_id }}"
            data-next
            aria-label="Next review"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</review-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class ReviewSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.slider = this.querySelector('[data-slider]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dotsContainer = this.querySelector('[data-dots]');
        this.reviews = this.slider.querySelectorAll('.ai-science-feature__review-{{ ai_gen_id }}');
        this.totalReviews = this.reviews.length;
      }

      connectedCallback() {
        if (this.totalReviews <= 1) {
          this.querySelector('.ai-science-feature__slider-controls-{{ ai_gen_id }}').style.display = 'none';
          return;
        }

        this.createDots();
        this.updateSlider();
        this.attachEventListeners();
      }

      createDots() {
        for (let i = 0; i < this.totalReviews; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-science-feature__slider-dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Go to review ${i + 1}`);
          if (i === 0) dot.classList.add('active');
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      attachEventListeners() {
        this.prevButton.addEventListener('click', () => this.prev());
        this.nextButton.addEventListener('click', () => this.next());
      }

      prev() {
        this.currentIndex = this.currentIndex > 0 ? this.currentIndex - 1 : this.totalReviews - 1;
        this.updateSlider();
      }

      next() {
        this.currentIndex = this.currentIndex < this.totalReviews - 1 ? this.currentIndex + 1 : 0;
        this.updateSlider();
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateSlider();
      }

      updateSlider() {
        const offset = -this.currentIndex * 100;
        this.slider.style.transform = `translateX(${offset}%)`;

        const dots = this.dotsContainer.querySelectorAll('.ai-science-feature__slider-dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });

        this.prevButton.disabled = false;
        this.nextButton.disabled = false;
      }
    }

    customElements.define('review-slider-{{ ai_gen_id }}', ReviewSlider{{ ai_gen_id }});
  })();
</script>

