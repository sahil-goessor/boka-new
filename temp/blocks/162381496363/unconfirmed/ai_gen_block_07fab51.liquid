{% doc %}
  @prompt
    Follow this design I screenshot in the snipboard link: https://snipboard.io/0klH4B.jpg
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-terms-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
  }

  .ai-promo-terms__eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: {{ block.settings.eyebrow_spacing }}px;
    color: {{ block.settings.eyebrow_color }};
  }

  .ai-promo-terms__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-promo-terms__content-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
    color: {{ block.settings.body_color }};
  }

  .ai-promo-terms__content-{{ ai_gen_id }} p {
    margin-bottom: 16px;
  }

  .ai-promo-terms__content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-promo-terms__content-{{ ai_gen_id }} strong {
    font-weight: 700;
  }

  .ai-promo-terms__content-{{ ai_gen_id }} em {
    font-style: italic;
  }

  .ai-promo-terms__content-{{ ai_gen_id }} ul,
  .ai-promo-terms__content-{{ ai_gen_id }} ol {
    margin-bottom: 16px;
    padding-left: 24px;
  }

  .ai-promo-terms__content-{{ ai_gen_id }} li {
    margin-bottom: 8px;
  }

  @media screen and (max-width: 749px) {
    .ai-promo-terms-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-promo-terms__eyebrow-{{ ai_gen_id }} {
      font-size: {{ block.settings.eyebrow_size | times: 0.9 }}px;
    }

    .ai-promo-terms__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-promo-terms__content-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-promo-terms-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.eyebrow_text != blank %}
    <div class="ai-promo-terms__eyebrow-{{ ai_gen_id }}">
      {{ block.settings.eyebrow_text }}
    </div>
  {% endif %}

  {% if block.settings.heading != blank %}
    <h2 class="ai-promo-terms__heading-{{ ai_gen_id }}">
      {{ block.settings.heading }}
    </h2>
  {% endif %}

  {% if block.settings.content != blank %}
    <div class="ai-promo-terms__content-{{ ai_gen_id }}">
      {{ block.settings.content }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Promotional terms",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "Promotional Terms & Conditions"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Promotional Terms & Conditions"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Terms content",
      "default": "<p>Enter your promotional terms and conditions here. You can include multiple paragraphs, lists, and formatting as needed.</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Maximum width",
      "default": 900
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 12
    },
    {
      "type": "range",
      "id": "eyebrow_spacing",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 15
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Color",
      "default": "#090909"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 25
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#090909"
    },
    {
      "type": "header",
      "content": "Body text"
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Color",
      "default": "#090909"
    }
  ],
  "presets": [
    {
      "name": "Promotional terms"
    }
  ]
}
{% endschema %}
