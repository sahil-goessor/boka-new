{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.section_bg_color }};
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-feature-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-feature-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-feature-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-feature-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-feature-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-feature-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-feature-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    color: {{ block.settings.headline_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-feature-eyebrow-{{ ai_gen_id }} {
    display: inline-block;
    font-size: {{ block.settings.eyebrow_size }}px;
    font-weight: 600;
    color: {{ block.settings.eyebrow_text_color }};
    background-color: {{ block.settings.eyebrow_bg_color }};
    padding: {{ block.settings.eyebrow_padding_vertical }}px {{ block.settings.eyebrow_padding_horizontal }}px;
    border-radius: 36px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    align-self: flex-start;
  }

  .ai-feature-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-feature-slider-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-feature-slider-wrapper-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s ease-in-out;
  }

  .ai-feature-review-slide-{{ ai_gen_id }} {
    min-width: 100%;
    flex-shrink: 0;
    background-color: {{ block.settings.review_bg_color }};
    padding: {{ block.settings.review_padding }}px;
    border-radius: 36px;
    box-sizing: border-box;
  }

  .ai-feature-review-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_headline_size }}px;
    font-weight: 700;
    color: {{ block.settings.review_headline_color }};
    margin: 0 0 12px 0;
  }

  .ai-feature-review-meta-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .ai-feature-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-feature-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-feature-star-empty-{{ ai_gen_id }} {
    fill: {{ block.settings.star_empty_color }};
  }

  .ai-feature-reviewer-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.reviewer_name_size }}px;
    font-weight: 600;
    color: {{ block.settings.reviewer_name_color }};
  }

  .ai-feature-review-quote-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_quote_size }}px;
    line-height: 1.6;
    color: {{ block.settings.review_quote_color }};
    margin: 0;
  }

  .ai-feature-slider-controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
    gap: 16px;
  }

  .ai-feature-slider-nav-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
  }

  .ai-feature-nav-button-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_bg_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
    flex-shrink: 0;
  }

  .ai-feature-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_bg_color }};
  }

  .ai-feature-nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.nav_button_icon_color }};
  }

  .ai-feature-slider-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ai-feature-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease;
    flex-shrink: 0;
  }

  .ai-feature-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-feature-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-feature-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-feature-content-{{ ai_gen_id }} {
      padding: 0 20px;
    }

    .ai-feature-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.85 }}px;
    }

    .ai-feature-eyebrow-{{ ai_gen_id }} {
      font-size: {{ block.settings.eyebrow_size | times: 0.95 }}px;
      padding: {{ block.settings.eyebrow_padding_vertical | times: 0.9 }}px {{ block.settings.eyebrow_padding_horizontal | times: 0.9 }}px;
    }

    .ai-feature-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.95 }}px;
    }

    .ai-feature-review-slide-{{ ai_gen_id }} {
      padding: {{ block.settings.review_padding | times: 0.85 }}px;
    }

    .ai-feature-review-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.review_headline_size | times: 0.9 }}px;
    }

    .ai-feature-review-quote-{{ ai_gen_id }} {
      font-size: {{ block.settings.review_quote_size | times: 0.95 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-feature-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 20px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-feature-container-{{ ai_gen_id }} {
      gap: 32px;
    }

    .ai-feature-content-{{ ai_gen_id }} {
      gap: {{ block.settings.content_gap | times: 0.8 }}px;
      padding: 0 16px;
    }

    .ai-feature-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.7 }}px;
    }

    .ai-feature-eyebrow-{{ ai_gen_id }} {
      font-size: {{ block.settings.eyebrow_size | times: 0.85 }}px;
      padding: {{ block.settings.eyebrow_padding_vertical | times: 0.75 }}px {{ block.settings.eyebrow_padding_horizontal | times: 0.75 }}px;
    }

    .ai-feature-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-feature-review-slide-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-feature-review-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.review_headline_size | times: 0.85 }}px;
      margin-bottom: 10px;
    }

    .ai-feature-review-meta-{{ ai_gen_id }} {
      gap: 10px;
      margin-bottom: 10px;
    }

    .ai-feature-star-{{ ai_gen_id }} {
      width: {{ block.settings.star_size | times: 0.9 }}px;
      height: {{ block.settings.star_size | times: 0.9 }}px;
    }

    .ai-feature-reviewer-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.reviewer_name_size | times: 0.9 }}px;
    }

    .ai-feature-review-quote-{{ ai_gen_id }} {
      font-size: {{ block.settings.review_quote_size | times: 0.9 }}px;
    }

    .ai-feature-slider-controls-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 16px;
      margin-top: 16px;
    }

    .ai-feature-slider-nav-{{ ai_gen_id }} {
      order: 2;
      width: 100%;
      justify-content: center;
    }

    .ai-feature-slider-dots-{{ ai_gen_id }} {
      order: 1;
    }

    .ai-feature-nav-button-{{ ai_gen_id }} {
      width: 36px;
      height: 36px;
    }

    .ai-feature-nav-button-{{ ai_gen_id }} svg {
      width: 18px;
      height: 18px;
    }

    .ai-feature-dot-{{ ai_gen_id }} {
      width: 8px;
      height: 8px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-feature-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.5 }}px 16px {{ block.settings.section_padding_bottom | times: 0.5 }}px;
    }

    .ai-feature-content-{{ ai_gen_id }} {
      padding: 0 12px;
    }

    .ai-feature-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.65 }}px;
    }

    .ai-feature-eyebrow-{{ ai_gen_id }} {
      font-size: {{ block.settings.eyebrow_size | times: 0.8 }}px;
      padding: 6px 14px;
    }

    .ai-feature-review-slide-{{ ai_gen_id }} {
      padding: 18px;
    }

    .ai-feature-review-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.review_headline_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<feature-slider-{{ ai_gen_id }} class="ai-feature-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-container-{{ ai_gen_id }}">
    <div class="ai-feature-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.product_image %}
        <img
          src="{{ block.settings.product_image | image_url: width: 1000 }}"
          alt="{{ block.settings.product_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.product_image.width }}"
          height="{{ block.settings.product_image.height }}"
          class="ai-feature-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-feature-image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
          <div class="ai-feature-empty-state-{{ ai_gen_id }}">
            Add a product image
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-feature-content-{{ ai_gen_id }}">
      {% if block.settings.headline != blank %}
        <h2 class="ai-feature-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      {% endif %}

      {% if block.settings.eyebrow_text != blank %}
        <span class="ai-feature-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow_text }}</span>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-feature-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}

      <div class="ai-feature-slider-container-{{ ai_gen_id }}">
        <div class="ai-feature-slider-wrapper-{{ ai_gen_id }}" data-slider-wrapper>
          {% liquid
            assign active_reviews = 0
            for i in (1..3)
              assign review_enabled_key = 'review_' | append: i | append: '_enabled'
              if block.settings[review_enabled_key]
                assign active_reviews = active_reviews | plus: 1
              endif
            endfor
          %}

          {% for i in (1..3) %}
            {% liquid
              assign review_enabled_key = 'review_' | append: i | append: '_enabled'
              assign review_headline_key = 'review_' | append: i | append: '_headline'
              assign review_stars_key = 'review_' | append: i | append: '_stars'
              assign review_name_key = 'review_' | append: i | append: '_name'
              assign review_quote_key = 'review_' | append: i | append: '_quote'

              assign review_enabled = block.settings[review_enabled_key]
              assign review_headline = block.settings[review_headline_key]
              assign review_stars = block.settings[review_stars_key]
              assign review_name = block.settings[review_name_key]
              assign review_quote = block.settings[review_quote_key]
            %}

            {% if review_enabled %}
              <div class="ai-feature-review-slide-{{ ai_gen_id }}">
                {% if review_headline != blank %}
                  <h3 class="ai-feature-review-headline-{{ ai_gen_id }}">{{ review_headline }}</h3>
                {% endif %}

                <div class="ai-feature-review-meta-{{ ai_gen_id }}">
                  <div class="ai-feature-stars-{{ ai_gen_id }}">
                    {% for star in (1..5) %}
                      {% if star <= review_stars %}
                        <svg class="ai-feature-star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                      {% else %}
                        <svg class="ai-feature-star-{{ ai_gen_id }} ai-feature-star-empty-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                      {% endif %}
                    {% endfor %}
                  </div>

                  {% if review_name != blank %}
                    <span class="ai-feature-reviewer-name-{{ ai_gen_id }}">{{ review_name }}</span>
                  {% endif %}
                </div>

                {% if review_quote != blank %}
                  <p class="ai-feature-review-quote-{{ ai_gen_id }}">{{ review_quote }}</p>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% if active_reviews > 1 %}
          <div class="ai-feature-slider-controls-{{ ai_gen_id }}">
            <div class="ai-feature-slider-nav-{{ ai_gen_id }}">
              <button class="ai-feature-nav-button-{{ ai_gen_id }}" data-prev aria-label="Previous review">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
                </svg>
              </button>
              <button class="ai-feature-nav-button-{{ ai_gen_id }}" data-next aria-label="Next review">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
                </svg>
              </button>
            </div>

            <div class="ai-feature-slider-dots-{{ ai_gen_id }}" data-dots>
              {% for i in (1..active_reviews) %}
                <button 
                  class="ai-feature-dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}" 
                  data-dot="{{ i | minus: 1 }}"
                  aria-label="Go to review {{ i }}"
                ></button>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</feature-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slider = this.querySelector('[data-slider-wrapper]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dots = this.querySelectorAll('[data-dot]');
        this.slides = this.slider.querySelectorAll('.ai-feature-review-slide-{{ ai_gen_id }}');
        this.totalSlides = this.slides.length;
      }

      connectedCallback() {
        if (this.totalSlides <= 1) return;

        this.prevButton.addEventListener('click', () => this.goToPrev());
        this.nextButton.addEventListener('click', () => this.goToNext());

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToSlide(index));
        });

        this.updateSlider();
      }

      goToNext() {
        this.currentSlide = (this.currentSlide + 1) % this.totalSlides;
        this.updateSlider();
      }

      goToPrev() {
        this.currentSlide = (this.currentSlide - 1 + this.totalSlides) % this.totalSlides;
        this.updateSlider();
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateSlider();
      }

      updateSlider() {
        const offset = -this.currentSlide * 100;
        this.slider.style.transform = `translateX(${offset}%)`;

        this.dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('feature-slider-{{ ai_gen_id }}', FeatureSlider{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
