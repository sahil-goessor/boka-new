{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-section-{{ ai_gen_id }} {
    display: flex;
    flex-direction: {% if block.settings.image_position == 'right' %}row-reverse{% else %}row{% endif %};
    gap: {{ block.settings.content_gap }}px;
    align-items: center;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    max-width: 100%;
  }

  .ai-image-text-section__image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.image_width }}%;
    max-width: {{ block.settings.image_width }}%;
  }

  .ai-image-text-section__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    {% if block.settings.image_fit == 'cover' %}
      object-fit: cover;
      aspect-ratio: {{ block.settings.image_aspect_ratio }};
    {% else %}
      object-fit: contain;
    {% endif %}
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-text-section__image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    {% if block.settings.image_fit == 'cover' %}
      aspect-ratio: {{ block.settings.image_aspect_ratio }};
    {% else %}
      min-height: 400px;
    {% endif %}
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-image-text-section__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-image-text-section__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-text-section__content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_gap }}px;
  }

  .ai-image-text-section__headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: {{ block.settings.headline_weight }};
    color: {{ block.settings.headline_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-image-text-section__subheadlines-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.subheadline_gap }}px;
    background-color: {{ block.settings.subheadline_bg_color }};
    padding: {{ block.settings.subheadline_padding }}px;
    border-radius: 36px;
  }

  .ai-image-text-section__subheadline-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheadline_size }}px;
    font-weight: {{ block.settings.subheadline_weight }};
    color: {{ block.settings.subheadline_color }};
    margin: 0;
    line-height: 1.4;
  }

  .ai-image-text-section__paragraph-{{ ai_gen_id }} {
    font-size: {{ block.settings.paragraph_size }}px;
    color: {{ block.settings.paragraph_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-section-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.mobile_content_gap }}px;
      padding: {{ block.settings.mobile_section_padding }}px {{ block.settings.mobile_section_padding_horizontal }}px;
    }

    .ai-image-text-section__image-wrapper-{{ ai_gen_id }} {
      flex: 0 0 100%;
      max-width: 100%;
    }

    .ai-image-text-section__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_headline_size }}px;
    }

    .ai-image-text-section__subheadline-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subheadline_size }}px;
    }

    .ai-image-text-section__paragraph-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_paragraph_size }}px;
    }
  }
{% endstyle %}

<div class="ai-image-text-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-section__image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 2000 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="ai-image-text-section__image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-image-text-section__image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-image-text-section__empty-state-{{ ai_gen_id }}">
          Add an image to get started
        </div>
      </div>
    {% endif %}
  </div>

  <div class="ai-image-text-section__content-{{ ai_gen_id }}">
    {% if block.settings.headline != blank %}
      <h2 class="ai-image-text-section__headline-{{ ai_gen_id }}">
        {{ block.settings.headline }}
      </h2>
    {% endif %}

    {% if block.settings.subheadline_1 != blank or block.settings.subheadline_2 != blank %}
      <div class="ai-image-text-section__subheadlines-{{ ai_gen_id }}">
        {% if block.settings.subheadline_1 != blank %}
          <h3 class="ai-image-text-section__subheadline-{{ ai_gen_id }}">
            {{ block.settings.subheadline_1 }}
          </h3>
        {% endif %}
        {% if block.settings.subheadline_2 != blank %}
          <h3 class="ai-image-text-section__subheadline-{{ ai_gen_id }}">
            {{ block.settings.subheadline_2 }}
          </h3>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.paragraph != blank %}
      <div class="ai-image-text-section__paragraph-{{ ai_gen_id }}">
        {{ block.settings.paragraph }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Image + text",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Image width",
      "default": 50
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Content gap",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_content_gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Mobile content gap",
      "default": 30
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "natural",
          "label": "Natural size"
        },
        {
          "value": "cover",
          "label": "Crop to fit"
        }
      ],
      "default": "natural"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Aspect ratio (crop mode)",
      "options": [
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "4/3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "16/9",
          "label": "Wide (16:9)"
        },
        {
          "value": "3/4",
          "label": "Portrait (3:4)"
        }
      ],
      "default": "4/3"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Image with text"
    },
    {
      "type": "range",
      "id": "headline_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Size",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_headline_size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Mobile size",
      "default": 28
    },
    {
      "type": "select",
      "id": "headline_weight",
      "label": "Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Subheadlines"
    },
    {
      "type": "text",
      "id": "subheadline_1",
      "label": "Subheadline 1",
      "default": "First subheadline"
    },
    {
      "type": "text",
      "id": "subheadline_2",
      "label": "Subheadline 2",
      "default": "Second subheadline"
    },
    {
      "type": "range",
      "id": "subheadline_size",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Size",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_subheadline_size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Mobile size",
      "default": 16
    },
    {
      "type": "select",
      "id": "subheadline_weight",
      "label": "Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "subheadline_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subheadline_bg_color",
      "label": "Background color",
      "default": "#fae5db"
    },
    {
      "type": "range",
      "id": "subheadline_padding",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "subheadline_gap",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "label": "Gap between subheadlines",
      "default": 10
    },
    {
      "type": "header",
      "content": "Paragraph"
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraph",
      "default": "<p>Use this section to highlight key features or benefits of your products.</p>"
    },
    {
      "type": "range",
      "id": "paragraph_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_paragraph_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Mobile size",
      "default": 14
    },
    {
      "type": "color",
      "id": "paragraph_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "text_gap",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Gap between text elements",
      "default": 20
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_section_padding",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Mobile padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_section_padding_horizontal",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Mobile horizontal padding",
      "default": 20
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Image + text"
    }
  ]
}
{% endschema %}