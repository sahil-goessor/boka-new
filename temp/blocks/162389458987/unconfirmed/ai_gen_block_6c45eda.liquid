{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-section-{{ ai_gen_id }} {
    display: flex;
    flex-direction: {% if block.settings.image_position == 'right' %}row-reverse{% else %}row{% endif %};
    gap: {{ block.settings.content_gap }}px;
    align-items: center;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    max-width: 100%;
  }

  .ai-image-text-section__image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.image_width }}%;
    max-width: {{ block.settings.image_width }}%;
  }

  .ai-image-text-section__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    {% if block.settings.image_fit == 'cover' %}
      object-fit: cover;
      aspect-ratio: {{ block.settings.image_aspect_ratio }};
    {% else %}
      object-fit: contain;
    {% endif %}
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-text-section__image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    {% if block.settings.image_fit == 'cover' %}
      aspect-ratio: {{ block.settings.image_aspect_ratio }};
    {% else %}
      min-height: 400px;
    {% endif %}
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-image-text-section__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-image-text-section__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-text-section__content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_gap }}px;
  }

  .ai-image-text-section__headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: {{ block.settings.headline_weight }};
    color: {{ block.settings.headline_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-image-text-section__subheadlines-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.subheadline_gap }}px;
    background-color: {{ block.settings.subheadline_bg_color }};
    padding: {{ block.settings.subheadline_padding }}px;
    border-radius: 36px;
  }

  .ai-image-text-section__subheadline-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheadline_size }}px;
    font-weight: {{ block.settings.subheadline_weight }};
    color: {{ block.settings.subheadline_color }};
    margin: 0;
    line-height: 1.4;
  }

  .ai-image-text-section__paragraph-{{ ai_gen_id }} {
    font-size: {{ block.settings.paragraph_size }}px;
    color: {{ block.settings.paragraph_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-reviews-slider-{{ ai_gen_id }} {
    margin-top: {{ block.settings.reviews_margin_top }}px;
  }

  .ai-reviews-slider__container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    padding: 0 50px;
  }

  .ai-reviews-slider__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s ease;
  }

  .ai-reviews-slider__slide-{{ ai_gen_id }} {
    min-width: 100%;
    padding: {{ block.settings.review_padding }}px;
    background-color: {{ block.settings.review_bg_color }};
    border-radius: {{ block.settings.review_border_radius }}px;
    box-sizing: border-box;
  }

  .ai-reviews-slider__highlight-{{ ai_gen_id }} {
    font-size: {{ block.settings.highlight_size }}px;
    font-weight: 700;
    color: {{ block.settings.highlight_color }};
    margin: 0 0 {{ block.settings.review_element_gap }}px;
    line-height: 1.3;
  }

  .ai-reviews-slider__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    color: {{ block.settings.review_text_color }};
    line-height: 1.6;
    margin: 0 0 {{ block.settings.review_element_gap }}px;
  }

  .ai-reviews-slider__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: {{ block.settings.review_element_gap }}px;
  }

  .ai-reviews-slider__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-reviews-slider__star--empty-{{ ai_gen_id }} {
    fill: {{ block.settings.star_empty_color }};
  }

  .ai-reviews-slider__footer-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-reviews-slider__name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_size }}px;
    font-weight: 600;
    color: {{ block.settings.name_color }};
    margin: 0;
  }

  .ai-reviews-slider__verified-{{ ai_gen_id }} {
    font-size: {{ block.settings.verified_size }}px;
    color: {{ block.settings.verified_color }};
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ai-reviews-slider__badge-{{ ai_gen_id }} {
    width: {{ block.settings.badge_size }}px;
    height: {{ block.settings.badge_size }}px;
    flex-shrink: 0;
  }

  .ai-reviews-slider__arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.arrow_bg_color }};
    color: {{ block.settings.arrow_color }};
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background-color 0.3s ease;
  }

  .ai-reviews-slider__arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_bg_color }};
  }

  .ai-reviews-slider__arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-reviews-slider__arrow--prev-{{ ai_gen_id }} {
    left: 0;
  }

  .ai-reviews-slider__arrow--next-{{ ai_gen_id }} {
    right: 0;
  }

  .ai-reviews-slider__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
  }

  .ai-reviews-slider__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease;
  }

  .ai-reviews-slider__dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-section-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.mobile_content_gap }}px;
      padding: {{ block.settings.mobile_section_padding }}px {{ block.settings.mobile_section_padding_horizontal }}px;
    }

    .ai-image-text-section__image-wrapper-{{ ai_gen_id }} {
      flex: 0 0 100%;
      max-width: 100%;
    }

    .ai-image-text-section__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_headline_size }}px;
    }

    .ai-image-text-section__subheadline-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subheadline_size }}px;
    }

    .ai-image-text-section__paragraph-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_paragraph_size }}px;
    }

    .ai-reviews-slider__container-{{ ai_gen_id }} {
      padding: 0 40px;
    }

    .ai-reviews-slider__arrow-{{ ai_gen_id }} {
      width: 32px;
      height: 32px;
    }

    .ai-reviews-slider__highlight-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_highlight_size }}px;
    }

    .ai-reviews-slider__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_review_text_size }}px;
    }
  }
{% endstyle %}

<review-slider-{{ ai_gen_id }} class="ai-image-text-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-section__image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 2000 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="ai-image-text-section__image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-image-text-section__image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-image-text-section__empty-state-{{ ai_gen_id }}">
          Add an image to get started
        </div>
      </div>
    {% endif %}
  </div>

  <div class="ai-image-text-section__content-{{ ai_gen_id }}">
    {% if block.settings.headline != blank %}
      <h2 class="ai-image-text-section__headline-{{ ai_gen_id }}">
        {{ block.settings.headline }}
      </h2>
    {% endif %}

    {% if block.settings.subheadline_1 != blank or block.settings.subheadline_2 != blank %}
      <div class="ai-image-text-section__subheadlines-{{ ai_gen_id }}">
        {% if block.settings.subheadline_1 != blank %}
          <h3 class="ai-image-text-section__subheadline-{{ ai_gen_id }}">
            {{ block.settings.subheadline_1 }}
          </h3>
        {% endif %}
        {% if block.settings.subheadline_2 != blank %}
          <h3 class="ai-image-text-section__subheadline-{{ ai_gen_id }}">
            {{ block.settings.subheadline_2 }}
          </h3>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.paragraph != blank %}
      <div class="ai-image-text-section__paragraph-{{ ai_gen_id }}">
        {{ block.settings.paragraph }}
      </div>
    {% endif %}

    {% assign has_reviews = false %}
    {% for i in (1..5) %}
      {% assign review_text_key = 'review_' | append: i | append: '_text' %}
      {% if block.settings[review_text_key] != blank %}
        {% assign has_reviews = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_reviews %}
      <div class="ai-reviews-slider-{{ ai_gen_id }}">
        <div class="ai-reviews-slider__container-{{ ai_gen_id }}">
          <button class="ai-reviews-slider__arrow-{{ ai_gen_id }} ai-reviews-slider__arrow--prev-{{ ai_gen_id }}" aria-label="Previous review">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="ai-reviews-slider__track-{{ ai_gen_id }}">
            {% for i in (1..5) %}
              {% assign review_text_key = 'review_' | append: i | append: '_text' %}
              {% assign review_highlight_key = 'review_' | append: i | append: '_highlight' %}
              {% assign review_rating_key = 'review_' | append: i | append: '_rating' %}
              {% assign review_name_key = 'review_' | append: i | append: '_name' %}
              {% assign review_badge_key = 'review_' | append: i | append: '_badge' %}

              {% if block.settings[review_text_key] != blank %}
                <div class="ai-reviews-slider__slide-{{ ai_gen_id }}">
                  {% if block.settings[review_highlight_key] != blank %}
                    <p class="ai-reviews-slider__highlight-{{ ai_gen_id }}">
                      "{{ block.settings[review_highlight_key] }}"
                    </p>
                  {% endif %}

                  <p class="ai-reviews-slider__text-{{ ai_gen_id }}">
                    {{ block.settings[review_text_key] }}
                  </p>

                  <div class="ai-reviews-slider__stars-{{ ai_gen_id }}">
                    {% for star in (1..5) %}
                      <svg class="ai-reviews-slider__star-{{ ai_gen_id }} {% if star > block.settings[review_rating_key] %}ai-reviews-slider__star--empty-{{ ai_gen_id }}{% endif %}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                      </svg>
                    {% endfor %}
                  </div>

                  <div class="ai-reviews-slider__footer-{{ ai_gen_id }}">
                    {% if block.settings[review_name_key] != blank %}
                      <p class="ai-reviews-slider__name-{{ ai_gen_id }}">
                        {{ block.settings[review_name_key] }}
                      </p>
                    {% endif %}
                    <div class="ai-reviews-slider__verified-{{ ai_gen_id }}">
                      {% if block.settings[review_badge_key] %}
                        <img
                          src="{{ block.settings[review_badge_key] | image_url: width: 100 }}"
                          alt="Verified badge"
                          class="ai-reviews-slider__badge-{{ ai_gen_id }}"
                          loading="lazy"
                        >
                      {% endif %}
                      <span>Verified Buyer</span>
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          <button class="ai-reviews-slider__arrow-{{ ai_gen_id }} ai-reviews-slider__arrow--next-{{ ai_gen_id }}" aria-label="Next review">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>

        <div class="ai-reviews-slider__dots-{{ ai_gen_id }}"></div>
      </div>
    {% endif %}
  </div>
</review-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class ReviewSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-reviews-slider__track-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-reviews-slider__arrow--prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-reviews-slider__arrow--next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-reviews-slider__dots-{{ ai_gen_id }}');

        if (!this.track) return;

        this.slides = Array.from(this.track.querySelectorAll('.ai-reviews-slider__slide-{{ ai_gen_id }}'));
        
        if (this.slides.length === 0) return;

        this.createDots();
        this.setupEventListeners();
        this.updateSlider();
      }

      createDots() {
        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.classList.add('ai-reviews-slider__dot-{{ ai_gen_id }}');
          if (index === 0) dot.classList.add('active');
          dot.setAttribute('aria-label', `Go to review ${index + 1}`);
          dot.addEventListener('click', () => this.goToSlide(index));
          this.dotsContainer.appendChild(dot);
        });
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.prevSlide());
        this.nextButton.addEventListener('click', () => this.nextSlide());
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateSlider();
      }

      prevSlide() {
        this.currentSlide = this.currentSlide > 0 ? this.currentSlide - 1 : this.slides.length - 1;
        this.updateSlider();
      }

      nextSlide() {
        this.currentSlide = this.currentSlide < this.slides.length - 1 ? this.currentSlide + 1 : 0;
        this.updateSlider();
      }

      updateSlider() {
        this.track.style.transform = `translateX(-${this.currentSlide * 100}%)`;

        const dots = this.dotsContainer.querySelectorAll('.ai-reviews-slider__dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });

        this.prevButton.disabled = false;
        this.nextButton.disabled = false;
      }
    }

    customElements.define('review-slider-{{ ai_gen_id }}', ReviewSlider{{ ai_gen_id }});
  })();
</script>

