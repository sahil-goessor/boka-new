{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-feature-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-feature-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-feature-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-feature-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-feature-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-feature-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-feature-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    color: {{ block.settings.headline_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-feature-eyebrow-{{ ai_gen_id }} {
    display: inline-block;
    font-size: {{ block.settings.eyebrow_size }}px;
    font-weight: 600;
    color: {{ block.settings.eyebrow_color }};
    background-color: {{ block.settings.eyebrow_bg_color }};
    padding: 8px 16px;
    border-radius: {{ block.settings.eyebrow_border_radius }}px;
    margin-top: 16px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-feature-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-feature-slider-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    margin-top: 8px;
  }

  .ai-feature-slider-wrapper-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
  }

  .ai-feature-review-slide-{{ ai_gen_id }} {
    min-width: 100%;
    flex-shrink: 0;
  }

  .ai-feature-review-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.review_bg_color }};
    padding: 20px;
    border-radius: {{ block.settings.review_border_radius }}px;
  }

  .ai-feature-review-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .ai-feature-review-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
    color: {{ block.settings.star_color }};
    font-size: 16px;
  }

  .ai-feature-review-name-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.review_name_color }};
  }

  .ai-feature-review-text-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.5;
    color: {{ block.settings.review_text_color }};
    font-style: italic;
  }

  .ai-feature-slider-controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 16px;
  }

  .ai-feature-slider-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.slider_button_color }};
    color: {{ block.settings.slider_button_text_color }};
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-feature-slider-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.slider_button_hover_color }};
  }

  .ai-feature-slider-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-feature-slider-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 12px;
  }

  .ai-feature-slider-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_inactive_color }};
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-feature-slider-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-feature-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-feature-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.8 }}px;
    }

    .ai-feature-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<feature-section-{{ ai_gen_id }} class="ai-feature-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-container-{{ ai_gen_id }}">
    <div class="ai-feature-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.product_image %}
        <img
          src="{{ block.settings.product_image | image_url: width: 800 }}"
          alt="{{ block.settings.product_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.product_image.width }}"
          height="{{ block.settings.product_image.height }}"
          class="ai-feature-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-feature-image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-feature-content-{{ ai_gen_id }}">
      {% if block.settings.headline != blank %}
        <h2 class="ai-feature-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      {% endif %}

      {% if block.settings.eyebrow_text != blank %}
        <span class="ai-feature-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow_text }}</span>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-feature-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}

      <div class="ai-feature-slider-{{ ai_gen_id }}">
        <div class="ai-feature-slider-wrapper-{{ ai_gen_id }}">
          {% for i in (1..3) %}
            {% liquid
              assign review_enabled_key = 'review_' | append: i | append: '_enabled'
              assign review_headline_key = 'review_' | append: i | append: '_headline'
              assign review_rating_key = 'review_' | append: i | append: '_rating'
              assign review_name_key = 'review_' | append: i | append: '_name'
              assign review_text_key = 'review_' | append: i | append: '_text'

              assign review_enabled = block.settings[review_enabled_key]
              assign review_headline = block.settings[review_headline_key]
              assign review_rating = block.settings[review_rating_key]
              assign review_name = block.settings[review_name_key]
              assign review_text = block.settings[review_text_key]
            %}

            {% if review_enabled %}
              <div class="ai-feature-review-slide-{{ ai_gen_id }}" data-slide="{{ i }}">
                <div class="ai-feature-review-card-{{ ai_gen_id }}">
                  {% if review_headline != blank %}
                    <h3 style="font-size: 16px; font-weight: 600; margin: 0 0 12px 0; color: {{ block.settings.review_headline_color }};">{{ review_headline }}</h3>
                  {% endif %}
                  <div class="ai-feature-review-header-{{ ai_gen_id }}">
                    <div class="ai-feature-review-stars-{{ ai_gen_id }}">
                      {% for star in (1..review_rating) %}
                        ★
                      {% endfor %}
                    </div>
                    {% if review_name != blank %}
                      <span class="ai-feature-review-name-{{ ai_gen_id }}">{{ review_name }}</span>
                    {% endif %}
                  </div>
                  {% if review_text != blank %}
                    <p class="ai-feature-review-text-{{ ai_gen_id }}">"{{ review_text }}"</p>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="ai-feature-slider-controls-{{ ai_gen_id }}">
          <button class="ai-feature-slider-button-{{ ai_gen_id }} ai-feature-prev-{{ ai_gen_id }}" aria-label="Previous review">
            ‹
          </button>
          <button class="ai-feature-slider-button-{{ ai_gen_id }} ai-feature-next-{{ ai_gen_id }}" aria-label="Next review">
            ›
          </button>
        </div>

        <div class="ai-feature-slider-dots-{{ ai_gen_id }}"></div>
      </div>
    </div>
  </div>
</feature-section-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
      }

      connectedCallback() {
        this.slider = this.querySelector('.ai-feature-slider-wrapper-{{ ai_gen_id }}');
        this.slides = Array.from(this.querySelectorAll('.ai-feature-review-slide-{{ ai_gen_id }}'));
        this.prevButton = this.querySelector('.ai-feature-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-feature-next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-feature-slider-dots-{{ ai_gen_id }}');

        if (this.slides.length > 0) {
          this.createDots();
          this.setupEventListeners();
          this.updateSlider();
        }
      }

      createDots() {
        this.slides.forEach((slide, index) => {
          const dot = document.createElement('span');
          dot.classList.add('ai-feature-slider-dot-{{ ai_gen_id }}');
          if (index === 0) dot.classList.add('active');
          dot.addEventListener('click', () => this.goToSlide(index));
          this.dotsContainer.appendChild(dot);
        });
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.previousSlide());
        this.nextButton.addEventListener('click', () => this.nextSlide());
      }

      updateSlider() {
        this.slider.style.transform = `translateX(-${this.currentSlide * 100}%)`;
        
        this.querySelectorAll('.ai-feature-slider-dot-{{ ai_gen_id }}').forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });

        this.prevButton.disabled = this.currentSlide === 0;
        this.nextButton.disabled = this.currentSlide === this.slides.length - 1;
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateSlider();
      }

      previousSlide() {
        if (this.currentSlide > 0) {
          this.currentSlide--;
          this.updateSlider();
        }
      }

      nextSlide() {
        if (this.currentSlide < this.slides.length - 1) {
          this.currentSlide++;
          this.updateSlider();
        }
      }
    }

    customElements.define('feature-section-{{ ai_gen_id }}', FeatureSection{{ ai_gen_id }});
  })();
</script>

