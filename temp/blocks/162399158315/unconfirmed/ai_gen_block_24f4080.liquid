{% doc %}
  @prompt
    Create a fully customizable Moving Text / Marquee Section with the following features:
    
    1. Text Items
    
    Allow the merchant to add at least 10 text items.
    
    Each text item can optionally include an icon.
    
    Text items should scroll continuously (marquee effect).
    
    2. Speed Control
    
    Include an option to set the scrolling speed (in seconds, e.g., full scroll duration).
    
    Allow merchants to adjust the speed based on preference.
    
    3. Background Styling
    
    Option to change the background color of the moving text container.
    
    Ensure background color can be applied independently of page background.
    
    4. Responsiveness
    
    The moving text must be fully responsive for both desktop and mobile views.
    
    Text and icons should scale appropriately on smaller screens.
    
    5. Additional Design Options
    
    Optionally allow:
    
    Padding adjustments around the scrolling text
    
    Text color customization
    
    Icon size customization
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-container-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    overflow: hidden;
    width: 100%;
  }

  .ai-marquee-wrapper-{{ ai_gen_id }} {
    display: flex;
    width: fit-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-marquee-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    white-space: nowrap;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-marquee-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_text_gap }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
  }

  .ai-marquee-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-marquee-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ai-marquee-wrapper-{{ ai_gen_id }}:hover {
    {% if block.settings.pause_on_hover %}
      animation-play-state: paused;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-container-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px 0 {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-marquee-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.85 }}px;
    }

    .ai-marquee-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.85 }}px;
      height: {{ block.settings.icon_size | times: 0.85 }}px;
    }

    .ai-marquee-content-{{ ai_gen_id }} {
      gap: {{ block.settings.item_spacing | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="ai-marquee-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-marquee-wrapper-{{ ai_gen_id }}">
    <div class="ai-marquee-content-{{ ai_gen_id }}">
      {% for i in (1..10) %}
        {% liquid
          assign text_key = 'text_' | append: i
          assign icon_key = 'icon_' | append: i
          assign text_value = block.settings[text_key]
          assign icon_value = block.settings[icon_key]
        %}

        {% if text_value != blank %}
          <div class="ai-marquee-item-{{ ai_gen_id }}">
            {% if icon_value != blank %}
              <div class="ai-marquee-icon-{{ ai_gen_id }}">
                <img
                  src="{{ icon_value | image_url: width: 100 }}"
                  alt="{{ text_value | escape }}"
                  loading="lazy"
                  width="100"
                  height="100"
                >
              </div>
            {% endif %}
            <span>{{ text_value }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-marquee-content-{{ ai_gen_id }}" aria-hidden="true">
      {% for i in (1..10) %}
        {% liquid
          assign text_key = 'text_' | append: i
          assign icon_key = 'icon_' | append: i
          assign text_value = block.settings[text_key]
          assign icon_value = block.settings[icon_key]
        %}

        {% if text_value != blank %}
          <div class="ai-marquee-item-{{ ai_gen_id }}">
            {% if icon_value != blank %}
              <div class="ai-marquee-icon-{{ ai_gen_id }}">
                <img
                  src="{{ icon_value | image_url: width: 100 }}"
                  alt=""
                  loading="lazy"
                  width="100"
                  height="100"
                >
              </div>
            {% endif %}
            <span>{{ text_value }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

