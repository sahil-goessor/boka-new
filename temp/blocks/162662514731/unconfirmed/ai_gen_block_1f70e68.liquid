{% doc %}
  @prompt
    Create a as seen on section marquee should be able to add a headline and upload atleast 8 media logos
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-as-seen-on-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-as-seen-on-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-as-seen-on-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-as-seen-on-marquee-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-as-seen-on-marquee-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.logo_spacing }}px;
    animation: ai-as-seen-on-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-as-seen-on-marquee-{{ ai_gen_id }}:hover {
    animation-play-state: paused;
  }

  .ai-as-seen-on-logo-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: {{ block.settings.logo_height }}px;
  }

  .ai-as-seen-on-logo-item-{{ ai_gen_id }} img {
    max-height: 100%;
    width: auto;
    max-width: {{ block.settings.logo_max_width }}px;
    object-fit: contain;
    {% if block.settings.grayscale %}
      filter: grayscale(100%);
      opacity: {{ block.settings.logo_opacity | divided_by: 100.0 }};
      transition: filter 0.3s ease, opacity 0.3s ease;
    {% endif %}
  }

  {% if block.settings.grayscale %}
    .ai-as-seen-on-logo-item-{{ ai_gen_id }}:hover img {
      filter: grayscale(0%);
      opacity: 1;
    }
  {% endif %}

  .ai-as-seen-on-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_max_width }}px;
    height: {{ block.settings.logo_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-as-seen-on-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @keyframes ai-as-seen-on-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-as-seen-on-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-as-seen-on-logo-item-{{ ai_gen_id }} {
      height: {{ block.settings.logo_height | times: 0.7 }}px;
    }

    .ai-as-seen-on-logo-item-{{ ai_gen_id }} img {
      max-width: {{ block.settings.logo_max_width | times: 0.7 }}px;
    }
  }
{% endstyle %}

<as-seen-on-{{ ai_gen_id }} class="ai-as-seen-on-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-as-seen-on-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-as-seen-on-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-as-seen-on-marquee-wrapper-{{ ai_gen_id }}">
      <div class="ai-as-seen-on-marquee-{{ ai_gen_id }}">
        {% liquid
          assign logos_array = ''
          for i in (1..8)
            assign logo_key = 'logo_' | append: i
            assign logo = block.settings[logo_key]
            if logo != blank
              assign logos_array = logos_array | append: i | append: ','
            endif
          endfor
          assign logos_array = logos_array | split: ','
          assign logos_count = logos_array.size
        %}

        {% if logos_count > 0 %}
          {% for j in (1..2) %}
            {% for i in (1..8) %}
              {% assign logo_key = 'logo_' | append: i %}
              {% assign logo = block.settings[logo_key] %}
              {% if logo != blank %}
                <div class="ai-as-seen-on-logo-item-{{ ai_gen_id }}">
                  <img
                    src="{{ logo | image_url: width: 400 }}"
                    alt="{{ logo.alt | escape }}"
                    loading="lazy"
                    width="{{ logo.width }}"
                    height="{{ logo.height }}"
                  >
                </div>
              {% endif %}
            {% endfor %}
          {% endfor %}
        {% else %}
          {% for j in (1..2) %}
            {% for i in (1..8) %}
              <div class="ai-as-seen-on-logo-item-{{ ai_gen_id }}">
                <div class="ai-as-seen-on-logo-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              </div>
            {% endfor %}
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</as-seen-on-{{ ai_gen_id }}>

<script>
  (function() {
    class AsSeenOn{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.marquee = this.querySelector('.ai-as-seen-on-marquee-{{ ai_gen_id }}');
        this.adjustMarqueeSpeed();
      }

      adjustMarqueeSpeed() {
        if (!this.marquee) return;
        
        const marqueeWidth = this.marquee.scrollWidth / 2;
        const speed = {{ block.settings.animation_speed }};
        
        this.marquee.style.animationDuration = speed + 's';
      }
    }

    customElements.define('as-seen-on-{{ ai_gen_id }}', AsSeenOn{{ ai_gen_id }});
  })();
</script>

