<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {% if seo_media -%}
      "image": [
        {{ seo_media | image_url: width: 1920 | prepend: "https:" | json }}
      ],
    {%- endif %}
    "description": {{ product.description | strip_html | json }},
    {% if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif %}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          {%- if variant.barcode.size == 12 -%}
              "gtin12": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 13 -%}
            "gtin13": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 14 -%}
            "gtin14": {{ variant.barcode }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "url" : {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function isIE() {
      const ua = window.navigator.userAgent;
      const msie = ua.indexOf('MSIE ');
      const trident = ua.indexOf('Trident/');

      return msie > 0 || trident > 0;
    }

    if (!isIE()) {
      // Initialize media gallery for featured product section
      const featuredSection = document.querySelector('.featured-product');
      if (featuredSection) {
        const mediaGallery = featuredSection.querySelector('media-gallery');
        
        if (mediaGallery && typeof MediaGallery !== 'undefined') {
          // Force re-initialization of the media gallery
          const event = new Event('DOMContentLoaded');
          mediaGallery.dispatchEvent(event);
        }
        
        // Manual thumbnail click handler as backup
        const thumbnails = featuredSection.querySelectorAll('.thumbnail-list__item button');
        const mediaItems = featuredSection.querySelectorAll('.product__media-item');
        
        thumbnails.forEach(function(thumbnail) {
          thumbnail.addEventListener('click', function(e) {
            e.preventDefault();
            
            // Get the target media ID
            const parentLi = this.closest('.thumbnail-list__item');
            const targetId = parentLi ? parentLi.getAttribute('data-target') : null;
            
            if (!targetId) return;
            
            // Find the corresponding media item
            const targetMedia = featuredSection.querySelector('[data-media-id="' + targetId + '"]');
            
            if (targetMedia) {
              // Remove all active classes
              mediaItems.forEach(function(item) {
                item.classList.remove('is-active');
              });
              
              thumbnails.forEach(function(t) {
                t.classList.remove('is-active');
                t.removeAttribute('aria-current');
              });
              
              // Add active class to target
              targetMedia.classList.add('is-active');
              this.classList.add('is-active');
              this.setAttribute('aria-current', 'true');
              
              // Scroll the main gallery to the active item
              const mainSlider = featuredSection.querySelector('.product__media-list');
              if (mainSlider) {
                targetMedia.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
              }
            }
          });
        });
        
        console.log('Featured gallery initialized:', thumbnails.length, 'thumbnails');
      }
      
      return;
    }
    
    // IE fallback code
    const hiddenInput = document.querySelector('#{{ product_form_id }} input[data-name="id"]'); 
    const noScriptInputWrapper = document.createElement('div');
    const variantSwitcher =
      document.querySelector('variant-radios[data-section="{{ section.id }}"]') ||
      document.querySelector('variant-selects[data-section="{{ section.id }}"]');
    
    if (variantSwitcher && hiddenInput) {
      noScriptInputWrapper.innerHTML = document.querySelector(
        '.product-form__noscript-wrapper-{{ section.id }}'
      ).textContent;
      variantSwitcher.outerHTML = noScriptInputWrapper.outerHTML;

      document.querySelector('#Variants-{{ section.id }}').addEventListener('change', function (event) {
        hiddenInput.value = event.currentTarget.value;
      });
    }
  });
</script>

