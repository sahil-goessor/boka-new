        <path d="M55.2883 59.7583V55.7209C41.8128 55.7209 27.5771 58.6048 27.5771 74.4922C27.5771 82.5408 31.7456 87.9939 38.9028 87.9939C44.1461 87.9939 48.8389 84.7692 51.8015 79.5258C55.4718 73.0765 55.2883 67.0204 55.2883 59.7583ZM74.0858 105.192C72.8536 106.293 71.0708 106.372 69.6813 105.638C63.4942 100.499 62.3931 98.1136 58.9849 93.211C48.7603 103.645 41.5245 106.765 28.2587 106.765C12.581 106.765 0.364014 97.0911 0.364014 77.7169C0.364014 62.5898 8.56988 52.2865 20.2364 47.2529C30.3561 42.796 44.487 42.0095 55.2883 40.7773V38.3654C55.2883 33.9347 55.6291 28.6914 53.0337 24.8637C50.7528 21.4293 46.4008 20.0136 42.5731 20.0136C35.4684 20.0136 29.1239 23.6577 27.5771 31.2082C27.2625 32.8861 26.0303 34.5377 24.3524 34.6164L6.2628 32.6763C4.74222 32.3355 3.06434 31.1033 3.48381 28.77C7.65229 6.85275 27.446 0.246094 45.1686 0.246094C54.2396 0.246094 66.0896 2.65804 73.2468 9.52685C82.3179 17.9949 81.4527 29.2944 81.4527 41.5901V70.6383C81.4527 79.3685 85.0706 83.1962 88.4788 87.9152C89.6848 89.5931 89.947 91.6118 88.4264 92.8702C84.6249 96.0425 77.861 101.941 74.1382 105.245L74.0858 105.192Z" fill="white"/>
      </svg>
    `;
    buttonContainerEl.appendChild(amazonBtn);
  }

  // ── Amazon-only mode (no buy_buttons block) ──
  function updateStickyAmazonOnly() {
    // Update media
    let activeMediaImg = document.querySelector('.featured-product .product__media-item.is-active img') ||
                         document.querySelector('.featured-product .product__media-list img') ||
                         document.querySelector('.featured-product img[src*="products"]');
    if (activeMediaImg && activeMediaImg.src) {
      mediaEl.src = activeMediaImg.src;
      mediaEl.alt = activeMediaImg.alt || '';
    }

    // Set title from Liquid
    titleEl.textContent = '{{ section.settings.product.title | escape }}';
    variantEl.style.display = 'none';

    // Set price from Liquid
    const productPrice = {{ section.settings.product.selected_or_first_available_variant.price | default: 0 }};
    if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
      priceEl.innerHTML = Shopify.formatMoney(productPrice, "{{ shop.money_format }}");
    } else {
      priceEl.innerHTML = '$' + (productPrice / 100).toFixed(2);
    }

    // Render the Amazon button
    renderAmazonButton();
  }

  // ── Custom button mode (clones the on-page custom button) ──
  function updateStickyCustomButton(sourceBtn) {
    // Update media
    let activeMediaImg = document.querySelector('.featured-product .product__media-item.is-active img') ||
                         document.querySelector('.featured-product .product__media-list img') ||
                         document.querySelector('.featured-product img[src*="products"]');
    if (activeMediaImg && activeMediaImg.src) {
      mediaEl.src = activeMediaImg.src;
      mediaEl.alt = activeMediaImg.alt || '';
    }

    // Set title from Liquid
    titleEl.textContent = '{{ section.settings.product.title | escape }}';
    variantEl.style.display = 'none';

    // Set price from Liquid
    const productPrice = {{ section.settings.product.selected_or_first_available_variant.price | default: 0 }};
    if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
      priceEl.innerHTML = Shopify.formatMoney(productPrice, "{{ shop.money_format }}");
    } else {
      priceEl.innerHTML = '$' + (productPrice / 100).toFixed(2);
    }

    // Clone the actual custom button (keeps text, href, onclick, everything)
    buttonContainerEl.innerHTML = '';
    const clonedBtn = sourceBtn.cloneNode(true);
    clonedBtn.id = 'sticky-custom-button-featured';
    clonedBtn.style.cssText = 'width:100%; height:100%; margin-top:0;';
    buttonContainerEl.appendChild(clonedBtn);
  }

  // ── Main updateSticky ──
  // ── Main updateSticky ──
  function updateSticky() {
    console.log('Featured Product - Updating sticky bar...');

    // Custom button takes top priority if present on the page
    const customButtonSource = document.querySelector('.featured-product .boka-custom-button');
    if (customButtonSource) {
      updateStickyCustomButton(customButtonSource);
      return;
    }

    // Amazon-only mode — no form on the page
    if (!mainForm && amazonUrl) {
      updateStickyAmazonOnly();
      return;
    }

    if (!mainForm) {
      console.error('Featured Product - Form not available');
      return;
    }

    // Try different selectors for variant ID input
    let variantIdInput = mainForm.querySelector('[name="id"]');
    if (!variantIdInput) variantIdInput = mainForm.querySelector('input[data-name="id"]');
    if (!variantIdInput) variantIdInput = mainForm.querySelector('select[name="id"]');

    console.log('Featured Product - Variant input:', variantIdInput);

    if (!variantIdInput) {
      console.error('Featured Product - Variant input not found');
      return;
    }

    const variantId = variantIdInput.value;
    console.log('Featured Product - Current variant ID:', variantId);

    // Update media
    let activeMediaImg = document.querySelector('.featured-product .product__media-item.is-active img') ||
                         document.querySelector('.featured-product .product__media-list img') ||
                         document.querySelector('.featured-product img[src*="products"]');
    if (activeMediaImg && activeMediaImg.src) {
      mediaEl.src = activeMediaImg.src;
      mediaEl.alt = activeMediaImg.alt || '';
    }

    // Fetch product data if we don't have it
    if (!currentProduct) {
      const productHandle = '{{ section.settings.product.handle }}';
      console.log('Featured Product - Fetching product data for:', productHandle);
      fetch(`/products/${productHandle}.js`)
        .then(response => response.json())
        .then(product => {
          console.log('Featured Product - Product data received:', product);
          currentProduct = product;
          updateProductInfo(product, variantId);
        })
        .catch(error => console.error('Featured Product - Error fetching product:', error));
    } else {
      updateProductInfo(currentProduct, variantId);
    }
  }

  function updateProductInfo(product, variantId) {
    console.log('Featured Product - Updating product info for variant:', variantId);

    const variant = product.variants.find(v => v.id == variantId);
    if (!variant) {
      console.error('Featured Product - Variant not found:', variantId);
      return;
    }

    titleEl.textContent = product.title;

    if (variant.options && variant.options.some(opt => opt !== 'Default Title')) {
      variantEl.style.display = 'block';
      variantEl.textContent = variant.options.join(', ');
    } else {
      variantEl.style.display = 'none';
    }

    // Update price
    let priceHtml = '';
    if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
      priceHtml = Shopify.formatMoney(variant.price, window.theme?.moneyFormat || "{{ shop.money_format }}");
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        priceHtml += `<span class="sticky-atc__compare">${Shopify.formatMoney(variant.compare_at_price, window.theme?.moneyFormat || "{{ shop.money_format }}")}</span>`;
      }
    } else {
      priceHtml = '$' + (variant.price / 100).toFixed(2);
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        priceHtml += `<span class="sticky-atc__compare">$${(variant.compare_at_price / 100).toFixed(2)}</span>`;
      }
    }
    priceEl.innerHTML = priceHtml;

    // If amazon URL exists, show Amazon button instead of ATC
    if (amazonUrl) {
      renderAmazonButton();
      return;
    }

    // Original ATC button logic
    let originalButton = mainForm.querySelector('.product-form__submit') ||
                         mainForm.querySelector('button[type="submit"]') ||
                         mainForm.querySelector('.shopify-payment-button button') ||
                         mainForm.querySelector('button[name="add"]');

    console.log('Featured Product - Original button found:', originalButton);

    if (originalButton) {
      const clonedButton = originalButton.cloneNode(true);
      clonedButton.id = 'sticky-buy-button-featured';
      clonedButton.removeAttribute('form');
      buttonContainerEl.innerHTML = '';
      buttonContainerEl.appendChild(clonedButton);

      clonedButton.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        originalButton.click();
      });
    } else {
      console.error('Featured Product - Original button not found');
      const fallbackButton = document.createElement('button');
      fallbackButton.type = 'button';
      fallbackButton.className = 'button button--full-width button--primary';
      fallbackButton.textContent = 'Add to Cart';
      fallbackButton.id = 'sticky-buy-button-featured';
      fallbackButton.addEventListener('click', function(e) {
        e.preventDefault();
        const formData = new FormData(mainForm);
        const variantId = formData.get('id');
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: 1 })
        })
        .then(response => response.json())
        .then(data => { window.location.reload(); })
        .catch(error => console.error('Featured Product - Error adding to cart:', error));
      });
      buttonContainerEl.innerHTML = '';
      buttonContainerEl.appendChild(fallbackButton);
    }
  }

  // ── Show/hide sticky bar on scroll ──
function handleScroll() {
  let anchorEl = document.querySelector('.product-form__buttons') ||
                 document.querySelector(`#price-${sectionId}`) ||
                 document.querySelector(`#ProductInfo-${sectionId}`) ||
                 document.querySelector('.featured-product .product__info-wrapper') ||
                 document.querySelector('.featured-product');

  if (!anchorEl) return;

  const isMobile = window.innerWidth < 750;

  // ── Mobile: always show sticky bar from page load ──
  if (isMobile) {
    if (sticky.classList.contains('hidden')) {
      sticky.classList.remove('hidden');
      updateSticky();
    }
    return;
  }

  // ── Desktop: original logic unchanged ──
  const anchorRect = anchorEl.getBoundingClientRect();
  const wasHidden = sticky.classList.contains('hidden');

  const heroBannerCta = document.querySelector('.boka-hero__container');
  let heroBannerInView = false;
  if (heroBannerCta) {
    const heroBannerRect = heroBannerCta.getBoundingClientRect();
    heroBannerInView = heroBannerRect.top < window.innerHeight && heroBannerRect.bottom > 0;
  }

  const anchorOffScreen = anchorRect.bottom < 0 || anchorRect.top > window.innerHeight;

  if (anchorOffScreen && !heroBannerInView) {
    if (wasHidden) {
      sticky.classList.remove('hidden');
      updateSticky();
    }
  } else {
    sticky.classList.add('hidden');
  }
}
  window.addEventListener('scroll', handleScroll);

  // ── Variant change listeners ──
  const productContainer = document.querySelector('.featured-product');
  if (productContainer) {
    productContainer.addEventListener('change', function(e) {
      if (e.target.name === 'id' ||
          e.target.type === 'radio' ||
          e.target.tagName === 'SELECT' ||
          e.target.classList.contains('product-form__input')) {
        setTimeout(updateSticky, 150);
      }
    });
    productContainer.addEventListener('click', function(e) {
      if (e.target.matches('.product-form__input input[type="radio"]') ||
          e.target.matches('.product-form__input label') ||
          e.target.closest('.product-form__input')) {
        setTimeout(updateSticky, 150);
      }
    });
  }

  if (mainForm) {
    mainForm.addEventListener('change', function(e) {
      setTimeout(updateSticky, 150);
    });
  }

  document.addEventListener('variant:change', function(e) { updateSticky(); });
  document.addEventListener('product:variant-change', function(e) { updateSticky(); });

  // MutationObserver for variant changes
  if (mainForm) {
    const variantIdInput = mainForm.querySelector('[name="id"]') || mainForm.querySelector('input[data-name="id"]');
    if (variantIdInput) {
      const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
          if (mutation.type === 'attributes' && mutation.attributeName === 'value') {
            updateSticky();
          }
        });
      });
      observer.observe(variantIdInput, { attributes: true, attributeFilter: ['value'] });

      let lastValue = variantIdInput.value;
      setInterval(function() {
        if (variantIdInput.value !== lastValue) {
          lastValue = variantIdInput.value;
          updateSticky();
        }
      }, 500);
    }
  }

  // Initial updates
// Initial updates — show immediately on mobile without waiting for scroll
if (window.innerWidth < 750) {
  sticky.classList.remove('hidden');
  updateSticky();
}

setTimeout(() => { updateSticky(); }, 500);
setTimeout(() => { updateSticky(); }, 1500);
});
</script>

