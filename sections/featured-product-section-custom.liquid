                    </svg>
                  </a>
                {% endif %}
                {%- when 'walmart_button' -%}
                {% if block.settings.walmart_url != blank %}
                  <a href="{{ block.settings.walmart_url }}" target="_blank" rel="noopener" class="boka-featured-walmart-btn" {{ block.shopify_attributes }}>
                    <strong>Buy on</strong>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2.4a1.1 1.1 0 0 1 1.1 1.1v3.3a1.1 1.1 0 0 1-2.2 0V3.5A1.1 1.1 0 0 1 12 2.4Z" fill="#FFC220"/>
                      <path d="M12 16.1a1.1 1.1 0 0 1 1.1 1.1v3.3a1.1 1.1 0 0 1-2.2 0v-3.3a1.1 1.1 0 0 1 1.1-1.1Z" fill="#FFC220"/>
                      <path d="M21.6 12a1.1 1.1 0 0 1-1.1 1.1h-3.3a1.1 1.1 0 0 1 0-2.2h3.3A1.1 1.1 0 0 1 21.6 12Z" fill="#FFC220"/>
                      <path d="M7.9 12a1.1 1.1 0 0 1-1.1 1.1H3.5a1.1 1.1 0 0 1 0-2.2h3.3A1.1 1.1 0 0 1 7.9 12Z" fill="#FFC220"/>
                      <path d="M18.98 5.02a1.1 1.1 0 0 1 0 1.556l-2.334 2.334a1.1 1.1 0 1 1-1.556-1.556L17.424 5.02a1.1 1.1 0 0 1 1.556 0Z" fill="#FFC220"/>
                      <path d="M8.91 15.09a1.1 1.1 0 0 1 0 1.556L6.576 18.98a1.1 1.1 0 1 1-1.556-1.556L7.354 15.09a1.1 1.1 0 0 1 1.556 0Z" fill="#FFC220"/>
                      <path d="M5.02 5.02a1.1 1.1 0 0 1 1.556 0L8.91 7.354a1.1 1.1 0 1 1-1.556 1.556L5.02 6.576a1.1 1.1 0 0 1 0-1.556Z" fill="#FFC220"/>
                      <path d="M15.09 15.09a1.1 1.1 0 0 1 1.556 0l2.334 2.334a1.1 1.1 0 1 1-1.556 1.556L15.09 16.646a1.1 1.1 0 0 1 0-1.556Z" fill="#FFC220"/>
                    </svg>
                    <strong>Walmart</strong>
                  </a>
                {% endif %}
              {%- when 'custom_button' -%}
                {% if block.settings.button_text != blank %}
                  
                   <a href="{{ block.settings.button_url | default: '#' }}"
                    onclick="window.trbClick('B0CQPPDQM9')"
                    class="button button--full-width button--primary boka-custom-button"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.button_text }}
                  </a>
                {% endif %}
              {%- when 'promo_banner' -%}
                <div
                  class="promo-banner-{{ section.id }}"
                  style="
                    background-color: {{ block.settings.background_color }};
                    border-radius: {{ block.settings.border_radius }}px;
                    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
                    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;
                    display: flex;
                    justify-content: center;
                    gap: {{ block.settings.icon_gap }}px;
                    text-align: center;
                  "
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.icon_image %}
                    <img
                      src="{{ block.settings.icon_image | image_url: width: 80 }}"
                      alt="{{ block.settings.icon_image.alt | escape }}"
                      width="{{ block.settings.icon_size }}"
                      height="{{ block.settings.icon_size }}"
                      style="width: {{ block.settings.icon_size }}px; height: {{ block.settings.icon_size }}px; object-fit: contain; flex-shrink: 0;"
                      loading="lazy"
                    >
                  {% endif %}
                  {% if block.settings.promo_text != blank %}
                    <span
                      class="promo_banner_text"
                      style="
                        font-size: {{ block.settings.text_size }}px;
                        color: {{ block.settings.text_color }};
                        font-weight: {{ block.settings.font_weight }};
                        line-height: 27px;
                      "
                    >
                      {{ block.settings.promo_text }}
                    </span>
                  {% endif %}
                </div>
              {%- when 'rating' -%}
                {%- if product.metafields.reviews.rating.value != blank -%}
                  {% liquid
                    assign rating_decimal = 0
                    assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
                    if decimal >= 0.3 and decimal <= 0.7
                      assign rating_decimal = 0.5
                    elsif decimal > 0.7
                      assign rating_decimal = 1
                    endif
                  %}
                  <div
                    class="rating"
                    role="img"
                    aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
                  >
                    <span
                      aria-hidden="true"
                      class="rating-star color-icon-{{ settings.accent_icons }}"
                      style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
                    ></span>
                  </div>
                  <p class="rating-text caption">
                    <span aria-hidden="true">
                      {{- product.metafields.reviews.rating.value }} /
                      {{ product.metafields.reviews.rating.value.scale_max -}}
                    </span>
                  </p>
                  <p class="rating-count caption">
                    <span aria-hidden="true">({{ product.metafields.reviews.rating_count }})</span>
                    <span class="visually-hidden">
                      {{- product.metafields.reviews.rating_count }}
                      {{ 'accessibility.total_reviews' | t -}}
                    </span>
                  </p>
                {%- endif -%}
              {%- when 'icon-with-text' -%}
                {% render 'icon-with-text', block: block %}
                {%- when 'icon_text_row' -%}
                <div class="icon-text-container" {{ block.shopify_attributes }}>
                  {% if block.settings.icon_1_image != blank or block.settings.icon_1_text != blank %}
                    <div class="icon-text">
                      {% if block.settings.icon_1_image != blank %}
                        <img 
                          src="{{ block.settings.icon_1_image | image_url: width: 48 }}" 
                          alt="{{ block.settings.icon_1_text | escape }}"
                          width="24"
                          height="24"
                          loading="lazy"
                        >
                      {% endif %}
                      {% if block.settings.icon_1_text != blank %}
                        <span>{{ block.settings.icon_1_text }}</span>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% if block.settings.icon_2_image != blank or block.settings.icon_2_text != blank %}
                    <div class="icon-text">
                      {% if block.settings.icon_2_image != blank %}
                        <img 
                          src="{{ block.settings.icon_2_image | image_url: width: 48 }}" 
                          alt="{{ block.settings.icon_2_text | escape }}"
                          width="24"
                          height="24"
                          loading="lazy"
                        >
                      {% endif %}
                      {% if block.settings.icon_2_text != blank %}
                        <span>{{ block.settings.icon_2_text }}</span>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% if block.settings.icon_3_image != blank or block.settings.icon_3_text != blank %}
                    <div class="icon-text">
                      {% if block.settings.icon_3_image != blank %}
                        <img 
                          src="{{ block.settings.icon_3_image | image_url: width: 48 }}" 
                          alt="{{ block.settings.icon_3_text | escape }}"
                          width="24"
                          height="24"
                          loading="lazy"
                        >
                      {% endif %}
                      {% if block.settings.icon_3_text != blank %}
                        <span>{{ block.settings.icon_3_text }}</span>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% if block.settings.icon_4_image != blank or block.settings.icon_4_text != blank %}
                    <div class="icon-text">
                      {% if block.settings.icon_4_image != blank %}
                        <img 
                          src="{{ block.settings.icon_4_image | image_url: width: 48 }}" 
                          alt="{{ block.settings.icon_4_text | escape }}"
                          width="24"
                          height="24"
                          loading="lazy"
                        >
                      {% endif %}
                      {% if block.settings.icon_4_text != blank %}
                        <span>{{ block.settings.icon_4_text }}</span>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              {%- when 'collapsible_tab' -%}
                {%- liquid
                  assign has_content = false
                  if block.settings.content != blank or block.settings.page.content != blank
                    assign has_content = true
                  endif
                -%}
                {%- if has_content -%}
                <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
                  <details id="Details-{{ block.id }}-{{ section.id }}">
                    <summary>
                      <div class="summary__title">
                        {% render 'icon-accordion', icon: block.settings.icon %}
                        <h2 class="h4 accordion__title inline-richtext">
                          {{ block.settings.heading | default: block.settings.page.title }}
                        </h2>
                      </div>
                      {% render 'icon-caret' %}
                    </summary>
                    <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
                      {{ block.settings.content }}
                      {{ block.settings.page.content }}
                    </div>
                  </details>
                </div>
                {%- endif -%}
              {%- when 'complementary' -%}
                <product-recommendations class="complementary-products quick-add-hidden no-js-hidden{% if block.settings.make_collapsible_row %} is-accordion{% endif %}{% if block.settings.enable_quick_add %} complementary-products-contains-quick-add{% endif %}" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ block.settings.product_list_limit }}&intent=complementary">
                  {%- if recommendations.performed and recommendations.products_count > 0 -%}
                    <aside role="none" {{ block.shopify_attributes }}{% if block.settings.make_collapsible_row %} class="product__accordion accordion"{% endif %}>
                      <div class="complementary-products__container">
                        {%- if block.settings.make_collapsible_row -%}
                          <details id="Details-{{ block.id }}-{{ section.id }}" open>
                            <summary>
                        {%- endif %}
                        <div class="summary__title">
                          {%- if block.settings.make_collapsible_row -%}
                            {% render 'icon-accordion', icon: block.settings.icon %}
                            <h2 class="h4 accordion__title">{{ block.settings.block_heading }}</h2>
                          {%- else -%}
                            <h2 class="h3 accordion__title">{{ block.settings.block_heading }}</h2>
                          {%- endif -%}
                        </div>
                        {%- if block.settings.make_collapsible_row -%}
                            {% render 'icon-caret' %}
                          </summary>
                        {%- endif -%}
                        <slideshow-component class="slider-mobile-gutter">
                          {%- assign number_of_slides = recommendations.products_count | plus: 0.0 | divided_by: block.settings.products_per_page | ceil -%}
                          <div id="Slider-{{ block.id }}" class="contains-card contains-card--product complementary-slider grid grid--1-col slider slider--everywhere" {% if number_of_slides > 1 %}role="list" aria-label="{{ 'general.slider.name' | t }}"{% endif %}>
                            {%- for i in (1..number_of_slides) -%}
                              <div id="Slide-{{ block.id }}-{{ forloop.index }}" class="complementary-slide complementary-slide--{{ settings.card_style }} grid__item slider__slide slideshow__slide" tabindex="-1" role="group"{% if number_of_slides > 1 %} aria-roledescription="{{ 'sections.slideshow.slide' | t }}" aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"{% endif %}>
                                <ul class="list-unstyled" role="list">
                                  {%- for product in recommendations.products limit: block.settings.products_per_page offset: continue -%}
                                    <li>
                                      {% render 'card-product',
                                        card_product: product,
                                        media_aspect_ratio: block.settings.image_ratio,
                                        show_secondary_image: false,
                                        lazy_load: false,
                                        show_quick_add: block.settings.enable_quick_add,
                                        section_id: section.id,
                                        horizontal_class: true,
                                        horizontal_quick_add: true,
                                        is_complementary_block: true
                                      %}
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </div>
                            {%- endfor -%}
                          </div>
                          {%- if number_of_slides > 1 -%}
                            <div class="slider-buttons no-js-hidden">
                              <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">{% render 'icon-caret' %}</button>
                              <div class="slider-counter slider-counter--{{ block.settings.pagination_style }}{% if block.settings.pagination_style == 'counter' or block.settings.pagination_style == 'numbers' %} caption{% endif %}">
                                {%- if block.settings.pagination_style == 'counter' -%}
                                  <span class="slider-counter--current">1</span>
                                  <span aria-hidden="true"> / </span>
                                  <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                                  <span class="slider-counter--total">{{ number_of_slides }}</span>
                                {%- else -%}
                                  <div class="slideshow__control-wrapper">
                                    {%- for i in (1..number_of_slides) -%}
                                      <button class="slider-counter__link slider-counter__link--{{ block.settings.pagination_style }} link" aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}" aria-controls="Slider-{{ block.id }}">
                                        {%- if block.settings.pagination_style == 'numbers' -%}{{ forloop.index }}{% else %}<span class="dot"></span>{%- endif -%}
                                      </button>
                                    {%- endfor -%}
                                  </div>
                                {%- endif -%}
                              </div>
                              <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">{% render 'icon-caret' %}</button>
                            </div>
                          {%- endif -%}
                        </slideshow-component>
                        {%- if block.settings.make_collapsible_row -%}
                          </details>
                        {%- endif -%}
                      </div>
                    </aside>
                  {%- endif -%}
                  {{ 'component-card.css' | asset_url | stylesheet_tag }}
                  {{ 'component-complementary-products.css' | asset_url | stylesheet_tag }}
                  {%- if block.settings.enable_quick_add -%}
                    {{ 'quick-add.css' | asset_url | stylesheet_tag }}
                    <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
                  {%- endif -%}
                </product-recommendations>
            {%- endcase -%}
          {%- endfor -%}
          <a
            {% if product == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ product.url }}"
            {% endif %}
            class="link product__view-details animate-arrow"
          >
            {{ 'products.product.view_full_details' | t }}
            {% render 'icon-arrow' %}
          </a>
        </product-info>
      </div>
      {%- if section.settings.media_position == 'right' -%}
        <div class="grid__item product__media-wrapper small-hide">
          {% render 'product-media-gallery', 
            variant_images: variant_images, 
            is_duplicate: true,
            lazyload: section.settings.lazyload,
            thumbnail_position: section.settings.thumbnail_position,
            is_featured: true,
            section_id: section.id,
            product: product,
            gallery_layout: section.settings.gallery_layout,
            media_size: section.settings.media_size,
            media_position: section.settings.media_position,
            image_zoom: section.settings.image_zoom,
            mobile_thumbnails: section.settings.mobile_thumbnails,
            constrain_to_viewport: section.settings.constrain_to_viewport,
            media_fit: section.settings.media_fit
            %}
        </div>
      {%- endif -%}
    </div>
    {% render 'product-media-modal', product: product, variant_images: variant_images %}
  </div>

  <style>
  /* Ensure only active media is visible in featured product */
  .featured-product .product__media-item {
    display: none;
  }
  
  .featured-product .product__media-item.is-active {
    display: block;
  }
  
  /* Active thumbnail styling */
  .featured-product .thumbnail-list__item button.is-active,
  .featured-product .thumbnail-list__item button[aria-current="true"] {
    border-color: rgb(var(--color-foreground));
    opacity: 1;
  }
  
  .featured-product .thumbnail-list__item button {
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }
  
  .featured-product .thumbnail-list__item button:hover {
    opacity: 1;
  }

