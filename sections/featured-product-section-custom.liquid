<style>
/* Sticky ATC for Featured Product */
.sticky-atc-featured {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: var(--color-foreground);
  box-shadow: 0 -2px 8px rgba(0,0,0,0.1);
  z-index: 999;
  transition: transform 0.3s ease;
}

.sticky-atc-featured.hidden {
  transform: translateY(100%);
}

.sticky-atc-featured .sticky-atc__inner {
  background-color: #FAFAF5;
