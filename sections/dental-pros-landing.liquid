
<style>
:root {
  --dp-ink: #222721;
  --dp-forest: #737c5b;
  --dp-sage: #a5bc8b;
  --dp-mint: #bfd6a5;
  --dp-pale: #d3e7c0;
  --dp-frost: #e6f4d4;
  --dp-cream: #fafaf5;
  --dp-porcelain: #f7f7f0;
  --dp-white: #ffffff;
  --dp-petal: #f9e5db;
  --dp-rose: #efd5ca;
  --dp-terracotta: #aa7a6b;
  --dp-stone: #c1beb0;
  --dp-warm-gray: #8c8773;
  --dp-line: rgba(34, 39, 33, 0.10);
  --dp-line-warm: rgba(170, 122, 107, 0.28);
  --dp-tint-sage: rgba(211, 231, 192, 0.20);
  --dp-tint-warm: rgba(249, 229, 219, 0.24);
  --dp-shadow: 0 18px 50px rgba(34, 39, 33, 0.06);
  --dp-shadow-sm: 0 10px 30px rgba(34, 39, 33, 0.045);
  --dp-radius: 20px;
  --dp-radius-sm: 14px;
  --dp-max: 1120px;
  --dp-font-sans: var(--font-body-family), 'Neue Haas Unica W1G', Helvetica, Arial, sans-serif;
  --dp-font-heading: var(--font-heading-family), var(--dp-font-sans);
  --dp-font-serif: Georgia, 'Times New Roman', serif;
}

.dp-page, .dp-page * { box-sizing: border-box; }

.dp-page {
  margin: 0;
  overflow: hidden;
  color: var(--dp-ink);
  font-family: var(--dp-font-sans);
  letter-spacing: -0.01em;
  background:
    radial-gradient(circle at 88% 3%, rgba(191, 214, 165, 0.14), transparent 42%),
    radial-gradient(circle at 5% 26%, rgba(249, 229, 219, 0.16), transparent 38%),
    var(--dp-cream);
}

.dp-page :where(h1, h2, h3, h4, h5, h6, p, span, a, li, label, input, select, textarea, button) {
  font-family: var(--dp-font-sans);
}
.dp-page :where(.dp-h1, .dp-h2, .dp-h3) { font-family: var(--dp-font-heading); }
.dp-page a { color: inherit; }

.dp-wrap { width: min(var(--dp-max), calc(100% - 44px)); margin-inline: auto; }
.dp-section { padding: clamp(56px, 5.8vw, 92px) 0; }

/* ---- SECTION RHYTHM: alternating tint bands ----
   Light → tint → light → warm-tint, with b2b/pricing/faq
   carrying their own contained panels for contrast. */
#what-is-boka { background: var(--dp-tint-sage); }
.dp-signup    { background: var(--dp-tint-warm); }   /* warm accent moment */

.dp-kicker {
  display: inline-flex; align-items: center; gap: 10px;
  margin: 0 0 16px;
  font-size: 11px; font-weight: 600; line-height: 1;
  letter-spacing: 0.18em; color: var(--dp-forest); text-transform: uppercase;
}
.dp-kicker::before { content: ""; width: 28px; height: 1px; background: var(--dp-terracotta); opacity: 0.6; }

.dp-h1, .dp-h2, .dp-h3, .dp-page p { margin-block-start: 0; }
.dp-h1, .dp-h2, .dp-h3 { font-family: var(--dp-font-heading); letter-spacing: -0.045em; font-weight: 300; }

.dp-h1 { max-width: 760px; margin-bottom: 22px; font-size: clamp(44px, 6vw, 80px); line-height: 0.96; }
.dp-h2 { margin-bottom: 16px; font-size: clamp(30px, 3.4vw, 46px); line-height: 1.05; }
.dp-h3 { margin-bottom: 12px; font-size: clamp(21px, 2vw, 30px); line-height: 1.12; }

.dp-em { font-family: var(--dp-font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.04em; color: var(--dp-terracotta); }

.dp-copy { max-width: 640px; margin-bottom: 22px; color: rgba(34, 39, 33, 0.70); font-size: clamp(15px, 1.15vw, 17px); font-weight: 300; line-height: 1.68; }
.dp-copy--sm { font-size: 14px; line-height: 1.62; }

/* Buttons */
.dp-btn-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
.dp-btn {
  display: inline-flex; min-height: 48px; align-items: center; justify-content: center; gap: 8px;
  border: 1px solid var(--dp-ink); border-radius: 999px; padding: 14px 26px;
  background: transparent; color: var(--dp-ink);
  font-size: 12px; font-weight: 600; letter-spacing: 0.11em; line-height: 1; text-transform: uppercase; text-decoration: none;
  transition: transform 160ms ease, background 160ms ease, color 160ms ease, border-color 160ms ease;
}
.dp-btn:hover, .dp-btn:focus-visible { transform: translateY(-1px); background: var(--dp-ink); color: var(--dp-cream) !important; }
.dp-btn:hover *, .dp-btn:focus-visible * { color: var(--dp-cream) !important; }
.dp-btn--primary { border-color: var(--dp-sage); background: var(--dp-sage); color: var(--dp-ink); }
.dp-btn--primary:hover, .dp-btn--primary:focus-visible { border-color: var(--dp-ink); background: var(--dp-ink); color: var(--dp-cream) !important; }
.dp-btn--primary:hover *, .dp-btn--primary:focus-visible * { color: var(--dp-cream) !important; }
.dp-btn--light { border-color: rgba(255, 255, 255, 0.7); color: var(--dp-white); }
.dp-btn--light:hover { border-color: var(--dp-white); background: var(--dp-white); color: var(--dp-ink); }

.dp-pill {
  display: inline-flex; align-items: center; min-height: 32px;
  border: 1px solid var(--dp-line); border-radius: 999px; padding: 7px 14px;
  background: rgba(255, 255, 255, 0.5); color: rgba(34, 39, 33, 0.7); font-size: 12px; line-height: 1;
}

/* ---------- HERO ---------- */
.dp-hero { position: relative; padding-top: clamp(48px, 6vw, 88px); background: transparent; }
.dp-hero::before {
  content: ""; position: absolute; z-index: 0;
  width: 460px; height: 460px; top: 6%; right: -160px;
  border: 1px solid rgba(115, 124, 91, 0.16);
  border-radius: 999px 999px 999px 28px; transform: rotate(18deg); pointer-events: none;
}
.dp-hero__grid {
  position: relative; z-index: 1; display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.8fr);
  gap: clamp(34px, 5vw, 72px); align-items: center;
}
.dp-hero__content { padding-top: 28px; }
.dp-hero__sub { max-width: 660px; margin-bottom: 26px; color: rgba(34, 39, 33, 0.74); font-size: clamp(16px, 1.4vw, 20px); font-weight: 300; line-height: 1.6; }
.dp-hero__trust { display: flex; flex-wrap: wrap; gap: 10px; margin: 28px 0 0; }
.dp-hero__visual { position: relative; }
.dp-hero__media-card {
  position: relative; overflow: hidden; min-height: 540px; border-radius: 30px;
  background: radial-gradient(circle at 50% 28%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 70%), var(--dp-sage);
  box-shadow: 0 30px 70px rgba(34, 39, 33, 0.13);
}
.dp-hero__image { display: block; width: 100%; height: 100%; min-height: 540px; object-fit: contain; object-position: center; padding: 22px; }
.dp-hero__placeholder { position: absolute; inset: 0; display: grid; place-items: center; padding: 38px; text-align: center; }
.dp-logo-mark {
  display: inline-flex; align-items: center; justify-content: center;
  width: min(75%, 300px); aspect-ratio: 1 / 1;
  border: 1px solid rgba(255, 255, 255, 0.48); border-radius: 42% 58% 48% 52% / 56% 44% 56% 44%;
  background: rgba(250, 250, 245, 0.18); color: var(--dp-white);
  font-size: clamp(34px, 4vw, 54px); font-weight: 300; letter-spacing: 0.36em; text-indent: 0.36em;
}
.dp-hero__note { display: none !important; }

/* ---------- PROOF BAND ---------- */
.dp-proof-band {
  margin-top: 36px; border-radius: 24px; padding: clamp(22px, 3vw, 32px);
  background: rgba(255, 255, 255, 0.55); border: 1px solid var(--dp-line); box-shadow: var(--dp-shadow-sm);
}
.dp-proof-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
.dp-proof-item { border-left: 1px solid var(--dp-line-warm); padding-left: 18px; }
.dp-proof-item:first-child { border-left: 0; padding-left: 0; }
.dp-proof-item strong { display: block; margin-bottom: 6px; color: var(--dp-forest); font-size: clamp(21px, 2.4vw, 34px); font-weight: 400; letter-spacing: -0.045em; line-height: 1; }
.dp-proof-item span { display: block; color: rgba(34, 39, 33, 0.62); font-size: 12px; font-weight: 500; letter-spacing: 0.06em; line-height: 1.4; text-transform: uppercase; }
.dp-disclaimer { margin-top: 14px; color: rgba(34, 39, 33, 0.48); font-size: 11px; line-height: 1.45; }

/* ---------- PATIENT DEMAND → horizontal editorial rows ---------- */
.dp-why { background: transparent; }
.dp-why .dp-solution-header,
.dp-why > .dp-wrap > .dp-copy { max-width: 760px; }
.dp-card-grid {
  display: grid;
  grid-template-columns: 1fr;     /* one column of full-width rows */
  gap: 0;
  margin-top: 36px;
}
.dp-info-card {
  background: none; border: 0; box-shadow: none; border-radius: 0;
  display: grid;
  grid-template-columns: 56px minmax(0, 1fr);
  column-gap: clamp(20px, 3vw, 40px);
  align-items: start;
  padding: clamp(24px, 3vw, 34px) 0;
  border-top: 1px solid var(--dp-line);
}
.dp-info-card:first-child { border-top: 0; }
.dp-info-card__icon {
  grid-row: 1 / span 2; align-self: start;
  display: grid; place-items: center; width: 44px; height: 44px; margin: 0;
  border-radius: 999px; background: var(--dp-frost); color: var(--dp-forest);
  font-family: var(--dp-font-serif); font-style: italic; font-size: 20px;
}
.dp-info-card__title { grid-column: 2; margin: 0 0 8px; font-size: clamp(20px, 2vw, 26px); font-weight: 300; letter-spacing: -0.03em; line-height: 1.15; }
.dp-info-card__copy { grid-column: 2; margin: 0; max-width: 640px; color: rgba(34, 39, 33, 0.66); font-size: 15px; line-height: 1.62; }

/* ---------- WHAT IS BOKA → succinct two-column solution flow ---------- */
#what-is-boka {
  background:
    radial-gradient(circle at 84% 18%, rgba(211, 231, 192, 0.22), transparent 34%),
    radial-gradient(circle at 8% 88%, rgba(249, 229, 219, 0.14), transparent 32%),
    transparent;
}

.dp-solution-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.98fr) minmax(340px, 0.92fr);
  gap: clamp(38px, 6vw, 88px);
  align-items: center;
}

.dp-solution-copy { min-width: 0; }
.dp-solution-header {
  max-width: 700px;
  margin: 0 0 clamp(28px, 4vw, 44px);
}
.dp-solution-header .dp-h2 {
  max-width: 680px;
  margin-bottom: 18px;
  font-size: clamp(36px, 4.7vw, 64px);
  line-height: 0.98;
}
.dp-solution-header .dp-copy {
  max-width: 640px;
  margin-bottom: 0;
}

.dp-mini-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
  max-width: 640px;
}
.dp-mini {
  position: relative;
  display: grid;
  grid-template-columns: 74px minmax(0, 1fr);
  grid-template-areas:
    "icon title"
    "icon copy";
  column-gap: clamp(18px, 2.5vw, 30px);
  align-items: center;
  padding: clamp(20px, 2.7vw, 30px) 0;
  border-top: 1px solid rgba(34, 39, 33, 0.11);
  background: none;
  border-radius: 0;
  box-shadow: none;
}
.dp-mini:first-child { border-top: 0; padding-top: 0; }
.dp-mini::before {
  content: "✓";
  grid-area: icon;
  display: grid;
  place-items: center;
  width: 58px;
  height: 58px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.58);
  border: 1px solid rgba(115, 124, 91, 0.13);
  color: var(--dp-forest);
  font-size: 22px;
  font-weight: 500;
  line-height: 1;
}
.dp-mini:nth-child(2)::before { content: "↔"; }
.dp-mini:nth-child(3)::before { content: "✦"; }
.dp-mini:nth-child(4)::before { content: "•"; }
.dp-mini__title {
  grid-area: title;
  margin: 0 0 8px;
  color: var(--dp-ink);
  font-size: clamp(17px, 1.55vw, 21px);
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.18;
  text-transform: none;
}
.dp-mini__copy {
  grid-area: copy;
  margin: 0;
  max-width: 520px;
  color: rgba(34, 39, 33, 0.66);
  font-size: 15px;
  font-weight: 300;
  line-height: 1.55;
}

.dp-card,
.dp-ingredient-card {
  background: var(--dp-pale);
  border: 0;
  border-radius: var(--dp-radius);
  box-shadow: none;
}
.dp-ingredient-card {
  position: relative;
  overflow: hidden;
  min-height: clamp(520px, 48vw, 620px);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(36px, 5.2vw, 70px);
  background:
    radial-gradient(circle at 18% 12%, rgba(255, 255, 255, 0.52), transparent 34%),
    radial-gradient(circle at 92% 8%, rgba(255, 255, 255, 0.28), transparent 30%),
    var(--dp-pale);
  border-radius: clamp(22px, 2.5vw, 34px);
}
.dp-ingredient-card::after {
  content: "";
  position: absolute;
  width: 300px;
  height: 300px;
  right: -118px;
  bottom: -118px;
  border: 1px solid rgba(255, 255, 255, 0.55);
  border-radius: 999px;
  box-shadow:
    -34px -34px 0 -1px transparent,
    -34px -34px 0 0 rgba(255, 255, 255, 0.28),
    -68px -68px 0 -1px transparent,
    -68px -68px 0 0 rgba(255, 255, 255, 0.22);
  pointer-events: none;
}
.dp-ingredient-card > * {
  position: relative;
  z-index: 1;
}
.dp-ingredient-card .dp-kicker {
  margin-bottom: clamp(22px, 3vw, 34px);
}
.dp-ingredient-card .dp-h3 {
  max-width: 460px;
  margin-bottom: clamp(26px, 4vw, 42px);
  font-size: clamp(30px, 3.35vw, 48px);
  line-height: 1.04;
}

.dp-check-list {
  display: grid;
  gap: 14px;
  margin: 0;
  padding: 0;
  list-style: none;
}
.dp-check-list li {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  color: rgba(34, 39, 33, 0.76);
  font-size: 14px;
  line-height: 1.55;
}
.dp-check-list li::before {
  content: "";
  flex: 0 0 8px;
  width: 8px;
  height: 8px;
  margin-top: 7px;
  border-radius: 999px;
  background: var(--dp-forest);
}
.dp-ingredient-card .dp-check-list {
  gap: 0;
  max-width: 520px;
}
.dp-ingredient-card .dp-check-list li {
  gap: 18px;
  align-items: center;
  min-height: 62px;
  padding: 14px 0;
  border-top: 1px solid rgba(34, 39, 33, 0.10);
  color: rgba(34, 39, 33, 0.74);
  font-size: clamp(14px, 1.18vw, 16px);
  font-weight: 300;
  line-height: 1.38;
}
.dp-ingredient-card .dp-check-list li:first-child { border-top: 0; }
.dp-ingredient-card .dp-check-list li::before {
  content: "✓";
  display: grid;
  place-items: center;
  flex: 0 0 34px;
  width: 34px;
  height: 34px;
  margin-top: 0;
  border-radius: 999px;
  background: var(--dp-forest);
  color: var(--dp-white);
  font-size: 17px;
  font-weight: 700;
  line-height: 1;
}



/* ---------- BOKA SOLUTION / PRACTICE VALUE MOCKUP ---------- */
#what-is-boka {
  background:
    radial-gradient(circle at 50% 0%, rgba(211, 231, 192, 0.18), transparent 42%),
    var(--dp-cream);
}
.dp-solution-panel {
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(34, 39, 33, 0.10);
  border-radius: clamp(24px, 3vw, 36px);
  padding: clamp(34px, 5vw, 64px);
  background:
    radial-gradient(circle at 88% 2%, rgba(211, 231, 192, 0.18), transparent 34%),
    rgba(255, 255, 255, 0.66);
  box-shadow: var(--dp-shadow);
}
.dp-solution-panel__header {
  max-width: 820px;
  margin: 0 auto clamp(34px, 5vw, 56px);
  text-align: center;
}
.dp-solution-panel__header .dp-kicker {
  justify-content: center;
  margin-bottom: 16px;
}
.dp-solution-panel__header .dp-kicker::before { background: var(--dp-terracotta); }
.dp-solution-panel__title {
  max-width: 920px;
  margin: 0 auto 14px;
  color: var(--dp-ink);
  font-family: var(--dp-font-heading);
  font-size: clamp(38px, 5.4vw, 72px);
  font-weight: 300;
  letter-spacing: -0.055em;
  line-height: 0.98;
}
.dp-solution-panel__sub {
  max-width: 720px;
  margin: 0 auto;
  color: rgba(34, 39, 33, 0.64);
  font-size: clamp(16px, 1.45vw, 20px);
  font-weight: 300;
  line-height: 1.55;
}
.dp-solution-columns {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
  margin: 0 0 clamp(28px, 4vw, 44px);
}
.dp-solution-feature {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: clamp(20px, 3vw, 34px) clamp(20px, 3.2vw, 46px);
  border-left: 1px solid rgba(34, 39, 33, 0.10);
}
.dp-solution-feature:first-child { border-left: 0; padding-left: 0; }
.dp-solution-feature:last-child { padding-right: 0; }
.dp-solution-feature__icon {
  display: grid;
  place-items: center;
  width: clamp(58px, 6vw, 78px);
  height: clamp(58px, 6vw, 78px);
  margin: 0 0 24px;
  border-radius: 999px;
  background: var(--dp-frost);
  color: var(--dp-forest);
  font-size: clamp(27px, 3vw, 36px);
  font-weight: 400;
  line-height: 1;
}
.dp-solution-feature__title {
  margin: 0 0 16px;
  color: var(--dp-ink);
  font-size: clamp(24px, 2.45vw, 34px);
  letter-spacing: -0.055em;
  line-height: 1.06;
}
.dp-solution-feature__copy {
  margin: 0 0 22px;
  color: rgba(34, 39, 33, 0.66);
  font-size: clamp(14px, 1.15vw, 16px);
  font-weight: 300;
  line-height: 1.55;
}
.dp-solution-feature__checks {
  display: grid;
  gap: 12px;
  margin: auto 0 0;
  padding: 0;
  list-style: none;
}
.dp-solution-feature__checks li,
.dp-solution-strip__item {
  display: grid;
  grid-template-columns: 22px minmax(0, 1fr);
  gap: 11px;
  align-items: start;
  color: rgba(34, 39, 33, 0.72);
  font-size: 13px;
  line-height: 1.35;
}
.dp-solution-feature__checks li::before,
.dp-solution-strip__item::before {
  content: "✓";
  display: grid;
  place-items: center;
  width: 18px;
  height: 18px;
  margin-top: 1px;
  border-radius: 999px;
  background: var(--dp-forest);
  color: var(--dp-white);
  font-size: 12px;
  font-weight: 700;
  line-height: 1;
}
.dp-solution-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0;
  margin: 0 0 24px;
  border: 1px solid rgba(115, 124, 91, 0.14);
  border-radius: 18px;
  background: rgba(230, 244, 212, 0.30);
}
.dp-solution-strip__item {
  padding: 18px 24px;
  border-left: 1px solid rgba(34, 39, 33, 0.08);
  font-size: 14px;
  font-weight: 500;
}
.dp-solution-strip__item:first-child { border-left: 0; }
.dp-solution-cta {
  position: relative;
  overflow: hidden;
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(380px, 1.1fr);
  gap: clamp(22px, 4vw, 48px);
  align-items: center;
  border-radius: 22px;
  padding: clamp(24px, 3.5vw, 38px);
  background:
    radial-gradient(circle at 96% 50%, rgba(255,255,255,0.52), transparent 26%),
    linear-gradient(135deg, rgba(211, 231, 192, 0.72), rgba(230, 244, 212, 0.36));
}
.dp-solution-cta::after {
  content: "";
  position: absolute;
  width: 260px;
  height: 260px;
  right: -80px;
  bottom: -120px;
  border: 1px solid rgba(255, 255, 255, 0.55);
  border-radius: 999px;
  box-shadow:
    -34px -34px 0 -1px transparent,
    -34px -34px 0 0 rgba(255, 255, 255, 0.24),
    -68px -68px 0 -1px transparent,
    -68px -68px 0 0 rgba(255, 255, 255, 0.20);
  pointer-events: none;
}
.dp-solution-cta > * { position: relative; z-index: 1; }
.dp-solution-cta__title {
  margin: 0 0 8px;
  color: var(--dp-ink);
  font-size: clamp(22px, 2.1vw, 30px);
  font-weight: 650;
  letter-spacing: -0.045em;
  line-height: 1.08;
}
.dp-solution-cta__copy {
  max-width: 440px;
  margin: 0;
  color: rgba(34, 39, 33, 0.66);
  font-size: 14px;
  line-height: 1.5;
}
.dp-solution-cta__actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 0.72fr);
  gap: 18px;
  align-items: center;
}
.dp-solution-cta__btn {
  display: inline-flex;
  min-height: 58px;
  align-items: center;
  justify-content: center;
  gap: 16px;
  border: 1px solid rgba(115, 124, 91, 0.92);
  border-radius: 999px;
  padding: 18px 28px;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1;
  text-decoration: none;
  transition: transform 160ms ease, background 160ms ease, color 160ms ease;
}
.dp-solution-cta__btn--primary {
  background: var(--dp-sage);
  color: var(--dp-white);
  border-color: var(--dp-sage);
  box-shadow: 0 14px 30px rgba(115, 124, 91, 0.20);
}
.dp-solution-cta__btn--secondary {
  background: rgba(255, 255, 255, 0.42);
  color: var(--dp-forest);
}
.dp-solution-cta__btn:hover,
.dp-solution-cta__btn:focus-visible {
  transform: translateY(-1px);
  background: var(--dp-ink);
  border-color: var(--dp-ink);
  color: var(--dp-white) !important;
}
.dp-solution-fine {
  grid-column: 1 / -1;
  margin: 0;
  color: rgba(34, 39, 33, 0.50);
  font-size: 12px;
  line-height: 1.4;
  text-align: center;
}
/* ---------- TESTIMONIALS / ADVISORY COMMITTEE PROOF ---------- */
.dp-testimonials {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 0%, rgba(211, 231, 192, 0.34), transparent 42%),
    linear-gradient(180deg, rgba(211, 231, 192, 0.16), rgba(250, 250, 245, 0));
  text-align: center;
}
.dp-testimonials .dp-wrap { max-width: 1180px; }
.dp-testimonials .dp-kicker {
  justify-content: center;
  color: var(--dp-terracotta);
  font-size: 12px;
  letter-spacing: 0.20em;
}
.dp-testimonials .dp-kicker::before { display: none; }
.dp-testimonials .dp-h2 {
  max-width: 980px;
  margin-inline: auto;
  margin-bottom: 18px;
  font-size: clamp(36px, 4.5vw, 64px);
  line-height: 1.02;
}
.dp-testimonials__intro {
  max-width: 740px;
  margin: 0 auto;
  color: rgba(34, 39, 33, 0.62);
  font-size: clamp(18px, 2.1vw, 27px);
  font-weight: 300;
  line-height: 1.48;
}
.dp-quote-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(24px, 4vw, 44px);
  margin-top: clamp(48px, 7vw, 82px);
  text-align: left;
}
.dp-quote {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: clamp(330px, 28vw, 420px);
  padding: clamp(30px, 4vw, 52px);
  border: 1px solid rgba(34, 39, 33, 0.10);
  border-radius: 30px;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 22px 58px rgba(34, 39, 33, 0.08);
}
.dp-quote::before {
  content: "\201C";
  display: block;
  margin: 0 0 20px;
  color: rgba(170, 122, 107, 0.28);
  font-family: var(--dp-font-serif);
  font-style: italic;
  font-size: clamp(58px, 5vw, 82px);
  line-height: 0.7;
}
.dp-quote-grid .dp-quote:nth-child(even) { margin-top: 0; }
.dp-quote__text {
  margin: 0;
  color: rgba(34, 39, 33, 0.90);
  font-family: var(--dp-font-serif);
  font-size: clamp(21px, 2vw, 30px);
  font-style: italic;
  font-weight: 600;
  line-height: 1.44;
  letter-spacing: -0.025em;
}
.dp-quote__person {
  display: grid;
  grid-template-columns: 72px minmax(0, 1fr);
  gap: 20px;
  align-items: center;
  margin-top: auto;
  padding-top: clamp(28px, 4vw, 42px);
}
.dp-quote__avatar {
  display: grid;
  place-items: center;
  width: 72px;
  height: 72px;
  border-radius: 999px;
  background: var(--dp-frost);
  color: var(--dp-forest);
  font-family: var(--dp-font-serif);
  font-size: 27px;
  font-style: italic;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -0.04em;
}
.dp-quote__name {
  margin: 0 0 5px;
  color: var(--dp-ink);
  font-size: clamp(17px, 1.45vw, 22px);
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.18;
  text-transform: none;
}
.dp-quote__role {
  margin: 0;
  color: rgba(34, 39, 33, 0.60);
  font-size: clamp(14px, 1.25vw, 18px);
  line-height: 1.35;
}
.dp-testimonials__footer {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 18px;
  margin-top: clamp(34px, 5vw, 54px);
  color: rgba(34, 39, 33, 0.62);
  font-size: clamp(14px, 1.45vw, 18px);
  line-height: 1.4;
}
.dp-testimonials__link {
  color: var(--dp-forest);
  font-weight: 700;
  text-decoration: underline;
  text-underline-offset: 5px;
  text-decoration-thickness: 1px;
}
.dp-testimonials__link:hover,
.dp-testimonials__link:focus-visible { color: var(--dp-ink); }

/* ---------- B2B / PRACTICE (contained panel, kept distinct) ---------- */
.dp-b2b { position: relative; background: transparent; }
.dp-hero + .dp-b2b { position: relative; z-index: 3; margin-top: clamp(-64px, -4.5vw, -44px); padding-top: 0; padding-bottom: clamp(46px, 5vw, 72px); }
.dp-b2b-box {
  display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
  gap: clamp(28px, 5vw, 64px); align-items: start;
  border-radius: 28px; padding: clamp(28px, 5vw, 54px);
  background: rgba(255, 255, 255, 0.72); border: 1px solid var(--dp-line); box-shadow: var(--dp-shadow);
}
.dp-b2b + #what-is-boka { padding-top: clamp(52px, 6vw, 84px); }
.dp-note { margin-top: 18px; border-left: 2px solid var(--dp-terracotta); padding-left: 16px; color: rgba(34, 39, 33, 0.6); font-size: 12px; line-height: 1.58; }

.dp-process { display: grid; gap: 0; counter-reset: prostep; }
.dp-process__item {
  position: relative; background: none; border: 0; box-shadow: none; border-radius: 0; min-height: 0;
  padding: 18px 8px 18px 64px; counter-increment: prostep; border-top: 1px solid var(--dp-line);
}
.dp-process__item:first-child { border-top: 0; padding-top: 4px; }
.dp-process__item::before {
  content: counter(prostep, decimal-leading-zero);
  position: absolute; top: 16px; left: 8px; display: grid; place-items: center;
  width: 34px; height: 34px; border-radius: 999px; background: var(--dp-frost); color: var(--dp-forest);
  font-family: var(--dp-font-serif); font-style: italic; font-size: 15px;
}
.dp-process__item:first-child::before { top: 2px; }
.dp-process__title { margin: 0 0 5px; font-size: 15px; font-weight: 600; }
.dp-process__copy { margin: 0; color: rgba(34, 39, 33, 0.64); font-size: 13px; line-height: 1.5; }

/* ---------- HOW IT WORKS / PRICING (anchor moment) ---------- */
.dp-how-pricing { position: relative; }
.dp-how-pricing__shell {
  position: relative; overflow: hidden; border-radius: 30px; padding: clamp(32px, 5vw, 64px);
  background: radial-gradient(circle at 90% 8%, rgba(211, 231, 192, 0.28), transparent 30%), rgba(255, 255, 255, 0.62);
  border: 1px solid var(--dp-line); box-shadow: var(--dp-shadow);
}
.dp-pricing-intro { max-width: 840px; margin-bottom: clamp(26px, 4vw, 42px); }
.dp-pricing-intro__copy { max-width: 840px; }
.dp-pricing-intro__copy .dp-copy { max-width: 740px; margin-bottom: 0; }

.dp-pricing-benefit-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(18px, 2.5vw, 30px); align-items: start; }
.dp-pricing-benefit-card {
  position: relative; overflow: visible; min-height: 0; border: 0; border-top: 1px solid var(--dp-line);
  border-radius: 0; padding: 20px 0 0; background: none; box-shadow: none;
}
.dp-pricing-benefit-card:hover { transform: none; box-shadow: none; border-color: var(--dp-line); }
.dp-pricing-benefit-card strong:not(.dp-pricing-benefit-card__stat) { display: block; margin-bottom: 10px; color: var(--dp-ink); font-size: 13px; font-style: normal; font-weight: 700; letter-spacing: 0.08em; line-height: 1.25; text-transform: uppercase; }
.dp-pricing-benefit-card span:not(.dp-pricing-benefit-card__eyebrow):not(.dp-pricing-benefit-card__caption) { display: block; color: rgba(34, 39, 33, 0.64); font-size: 14px; line-height: 1.56; }
.dp-pricing-fine { margin: 18px 0 0; color: rgba(34, 39, 33, 0.46); font-size: 11px; line-height: 1.5; }
.dp-pricing-divider { width: 100%; height: 1px; margin: clamp(32px, 5vw, 54px) 0; background: var(--dp-line); }

.dp-how-compact__header { display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(260px, 0.58fr); gap: clamp(22px, 4vw, 54px); align-items: end; margin-bottom: clamp(22px, 3vw, 34px); }
.dp-how-compact__header .dp-copy { max-width: 520px; margin-bottom: 0; }
.dp-how-compact__title { max-width: 600px; }
.dp-how-compact__title .dp-h3 { margin-bottom: 0; font-size: clamp(24px, 2.6vw, 38px); font-weight: 300; letter-spacing: -0.045em; }

.dp-how-steps-compact { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(18px, 2.5vw, 32px); }
.dp-how-step-compact { position: relative; border: 0; border-top: 1px solid var(--dp-line); border-radius: 0; padding: 20px 0 0; background: none; box-shadow: none; }
.dp-how-step-compact:hover { transform: none; box-shadow: none; border-color: var(--dp-line); }
.dp-how-step-compact__num { display: grid; place-items: center; width: 38px; height: 38px; margin-bottom: 18px; border-radius: 999px; background: var(--dp-frost); color: var(--dp-forest); font-family: var(--dp-font-serif); font-size: 17px; font-style: italic; line-height: 1; }
.dp-how-step-compact__title { margin: 0 0 8px; color: var(--dp-ink); font-size: 17px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; }
.dp-how-step-compact__copy { margin: 0; color: rgba(34, 39, 33, 0.64); font-size: 13px; line-height: 1.56; }

/* ---------- SIGNUP (warm-tinted band) ---------- */
.dp-form-shell { display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr); gap: clamp(30px, 5vw, 64px); align-items: start; min-width: 0; }
.dp-form {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid var(--dp-line);
  border-radius: 28px;
  box-shadow: var(--dp-shadow);
  padding: clamp(24px, 4vw, 42px);
}
.dp-form :where(input, select, textarea, button, label, p, span, a, div) { font-family: var(--dp-font-sans) !important; }
.dp-form .klaviyo-form-VvZypp,
.dp-form .klaviyo-form,
.dp-form form,
.dp-form form > div,
.dp-form [data-testid="klaviyo-form"],
.dp-form [class*="kl-private-reset-css"] {
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;
  box-sizing: border-box !important;
}
.dp-form input,
.dp-form select,
.dp-form textarea,
.dp-form button {
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;
  box-sizing: border-box !important;
}

/* ---------- FAQ ---------- */
.dp-faq .dp-wrap { padding: clamp(28px, 4vw, 50px); border-radius: 28px; background: rgba(255, 255, 255, 0.5); border: 1px solid var(--dp-line); }
.dp-faq-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px clamp(24px, 4vw, 44px); margin-top: 34px; }
.dp-faq-item { border-top: 1px solid var(--dp-line); padding-top: 20px; }
.dp-faq-item h3 { margin: 0 0 8px; font-size: 17px; font-weight: 500; letter-spacing: -0.02em; }
.dp-faq-item p { margin: 0; color: rgba(34, 39, 33, 0.64); font-size: 14px; line-height: 1.6; }

/* ---------- FINAL CTA ---------- */
.dp-final { position: relative; padding: clamp(60px, 6.5vw, 96px) 0; background: var(--dp-cream); color: var(--dp-ink); text-align: center; }
.dp-final .dp-wrap { max-width: 860px; padding: clamp(36px, 5vw, 60px); border: 1px solid var(--dp-line-warm); border-radius: 28px; background: rgba(255, 255, 255, 0.55); box-shadow: var(--dp-shadow); }
.dp-final .dp-copy { margin-inline: auto; color: rgba(34, 39, 33, 0.66); }
.dp-final .dp-btn--light { border-color: var(--dp-forest); background: var(--dp-forest); color: var(--dp-white); }
.dp-final .dp-btn--light:hover { border-color: var(--dp-ink); background: var(--dp-ink); color: var(--dp-white); }

/* ---------- MOTION (progressive + reduced-motion safe) ---------- */
@media (prefers-reduced-motion: no-preference) {
  /* Hero load-in stagger */
  .dp-hero__content .dp-kicker,
  .dp-hero__content .dp-h1,
  .dp-hero__content .dp-hero__sub,
  .dp-hero__content .dp-btn-row,
  .dp-hero__content .dp-hero__trust,
  .dp-hero__visual { animation: dp-fade 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .dp-hero__content .dp-h1 { animation-delay: 0.06s; }
  .dp-hero__content .dp-hero__sub { animation-delay: 0.12s; }
  .dp-hero__content .dp-btn-row { animation-delay: 0.18s; }
  .dp-hero__content .dp-hero__trust { animation-delay: 0.24s; }
  .dp-hero__visual { animation-delay: 0.1s; }

  @keyframes dp-fade { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
}

/* Scroll-reveal — only where supported; everywhere else content just shows */
@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    .dp-info-card,
    .dp-mini,
    .dp-quote,
    .dp-process__item,
    .dp-pricing-benefit-card,
    .dp-how-step-compact,
    .dp-faq-item {
      animation: dp-rise linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 40%;
    }
    @keyframes dp-rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  }
}

/* ---------- RESPONSIVE ---------- */
@media (max-width: 990px) {
  .dp-hero__grid, .dp-b2b-box, .dp-form-shell { grid-template-columns: 1fr; }
  .dp-hero__media-card, .dp-hero__image { min-height: 420px; height: 420px; }
  .dp-solution-grid { grid-template-columns: 1fr; }
}
@media (max-width: 1100px) {
  .dp-pricing-benefit-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .dp-how-steps-compact { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 990px) {
  .dp-how-compact__header { grid-template-columns: 1fr; align-items: start; }
  .dp-proof-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .dp-proof-item:nth-child(3) { border-left: 0; padding-left: 0; }
}
@media (max-width: 680px) {
  .dp-wrap { width: min(100% - 28px, var(--dp-max)); }
  .dp-h1 { font-size: clamp(40px, 13vw, 60px); }
  .dp-h2 { line-height: 1.06; }
  .dp-btn-row, .dp-btn { width: 100%; }

  .dp-hero { padding-top: 40px; padding-bottom: 58px; }

  /* On mobile: eyebrow + heading, then image, then paragraph/buttons. */
  .dp-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  .dp-hero__content { display: contents; }
  .dp-hero__content .dp-kicker { order: 1; }
  .dp-hero__content .dp-h1 { order: 2; margin-bottom: 2px; }
  .dp-hero__visual { order: 3; }
  .dp-hero__content .dp-hero__sub { order: 4; margin: 4px 0 20px; }
  .dp-hero__content .dp-btn-row { order: 5; }
  .dp-hero__content .dp-hero__trust { order: 6; }

  .dp-hero + .dp-b2b { margin-top: -36px; padding-bottom: 50px; }
  .dp-hero__media-card, .dp-hero__image { min-height: 300px; height: 300px; border-radius: 24px; }
  .dp-hero__image { padding: 14px; }
  .dp-logo-mark { font-size: 34px; }

  .dp-section { padding: 52px 0; }
  .dp-solution-header { margin-bottom: 26px; }
  .dp-b2b-box, .dp-form, .dp-faq .dp-wrap, .dp-final .dp-wrap, .dp-how-pricing__shell, .dp-ingredient-card { border-radius: 22px; }
  .dp-how-pricing__shell { padding: 30px 18px; }

  .dp-quote-grid, .dp-faq-grid, .dp-pricing-benefit-grid, .dp-how-steps-compact { grid-template-columns: 1fr; }
  .dp-quote-grid .dp-quote:nth-child(even) { margin-top: 0; }
  .dp-testimonials .dp-wrap { width: min(100% - 28px, var(--dp-max)); }
  .dp-testimonials .dp-h2 { font-size: clamp(34px, 10vw, 46px); }
  .dp-testimonials__intro { font-size: 17px; line-height: 1.5; }
  .dp-quote-grid { margin-top: 34px; gap: 18px; }
  .dp-quote { min-height: 0; padding: 28px 22px; border-radius: 24px; }
  .dp-quote::before { margin-bottom: 14px; font-size: 60px; }
  .dp-quote__text { font-size: clamp(20px, 6vw, 25px); line-height: 1.42; }
  .dp-quote__person { grid-template-columns: 58px minmax(0, 1fr); gap: 14px; padding-top: 28px; }
  .dp-quote__avatar { width: 58px; height: 58px; font-size: 22px; }
  .dp-testimonials__footer { display: grid; gap: 10px; margin-top: 30px; font-size: 14px; }

  /* Mobile proof band: compact 2x2 cards instead of tall stacked rows. */
  .dp-proof-band {
    margin-top: 22px;
    padding: 14px;
    border-radius: 20px;
  }
  .dp-proof-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .dp-proof-item,
  .dp-proof-item:nth-child(3) {
    min-width: 0;
    border: 1px solid rgba(170, 122, 107, 0.18);
    border-radius: 16px;
    padding: 13px 12px;
    background: rgba(255, 255, 255, 0.46);
  }
  .dp-proof-item:first-child { border: 1px solid rgba(170, 122, 107, 0.18); padding: 13px 12px; }
  .dp-proof-item strong {
    margin-bottom: 5px;
    font-size: clamp(18px, 5.2vw, 22px);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  .dp-proof-item span {
    font-size: 10px;
    line-height: 1.28;
    letter-spacing: 0.025em;
    text-transform: none;
  }

  /* Patient-demand rows: keep number + text aligned on small screens */
  .dp-info-card { grid-template-columns: 44px minmax(0, 1fr); column-gap: 16px; padding: 22px 0; }

  /* Signup form: prevent Klaviyo's embedded widths from pushing past the viewport. */
  .dp-signup .dp-wrap { width: min(100% - 24px, var(--dp-max)); }
  .dp-form-shell { gap: 24px; }
  .dp-form { padding: 18px 12px; overflow: hidden; }
  .dp-form .klaviyo-form-VvZypp,
  .dp-form .klaviyo-form,
  .dp-form form,
  .dp-form form > div,
  .dp-form [data-testid="klaviyo-form"],
  .dp-form [class*="kl-private-reset-css"] {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }
  .dp-form [style*="width"] { max-width: 100% !important; }
  .dp-form [style*="min-width"] { min-width: 0 !important; }
  .dp-form input,
  .dp-form select,
  .dp-form textarea,
  .dp-form button {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
  }

  .dp-final { padding: 52px 0; }
  .dp-final .dp-wrap { width: min(100% - 28px, var(--dp-max)); padding: 32px 22px; }
}

@media (max-width: 390px) {
  .dp-proof-band { padding: 12px; }
  .dp-proof-grid { gap: 8px; }
  .dp-proof-item,
  .dp-proof-item:first-child,
  .dp-proof-item:nth-child(3) { padding: 12px 10px; }
  .dp-proof-item strong { font-size: 17px; }
  .dp-proof-item span { font-size: 9.5px; line-height: 1.24; }
  .dp-quote { padding: 24px 18px; }
  .dp-quote__person { grid-template-columns: 52px minmax(0, 1fr); gap: 12px; }
  .dp-quote__avatar { width: 52px; height: 52px; font-size: 20px; }
  .dp-form { padding: 16px 10px; }
}



@media (max-width: 990px) {
  .dp-solution-panel { padding: 34px 22px; }
  .dp-solution-columns { grid-template-columns: 1fr; }
  .dp-solution-feature,
  .dp-solution-feature:first-child,
  .dp-solution-feature:last-child {
    border-left: 0;
    border-top: 1px solid rgba(34, 39, 33, 0.10);
    padding: 26px 0;
  }
  .dp-solution-feature:first-child { border-top: 0; padding-top: 0; }
  .dp-solution-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .dp-solution-strip__item:nth-child(odd) { border-left: 0; }
  .dp-solution-strip__item:nth-child(n+3) { border-top: 1px solid rgba(34, 39, 33, 0.08); }
  .dp-solution-cta { grid-template-columns: 1fr; }
  .dp-solution-cta__actions { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 680px) {
  .dp-solution-panel__header { text-align: left; margin-bottom: 28px; }
  .dp-solution-panel__header .dp-kicker { justify-content: flex-start; }
  .dp-solution-panel__title { font-size: clamp(36px, 11vw, 52px); }
  .dp-solution-panel__sub { font-size: 16px; }
  .dp-solution-feature__icon { width: 58px; height: 58px; margin-bottom: 18px; }
  .dp-solution-feature__title { font-size: 26px; }
  .dp-solution-strip { grid-template-columns: 1fr; }
  .dp-solution-strip__item,
  .dp-solution-strip__item:nth-child(odd) {
    border-left: 0;
    border-top: 1px solid rgba(34, 39, 33, 0.08);
  }
  .dp-solution-strip__item:first-child { border-top: 0; }
  .dp-solution-cta { padding: 24px 18px; }
  .dp-solution-cta__actions { grid-template-columns: 1fr; gap: 12px; }
  .dp-solution-cta__btn { width: 100%; min-height: 54px; font-size: 15px; }
  .dp-solution-fine { text-align: left; }
}


/* ---------- FULL-WIDTH BOKA SOLUTION REFINEMENT ----------
   Removes the outer card/box while keeping the clear mockup hierarchy. */
#what-is-boka {
  background:
    radial-gradient(circle at 50% 0%, rgba(211, 231, 192, 0.18), transparent 42%),
    radial-gradient(circle at 4% 82%, rgba(249, 229, 219, 0.12), transparent 30%),
    var(--dp-cream);
}
#what-is-boka .dp-wrap {
  width: min(100% - clamp(28px, 6vw, 96px), 1320px);
  max-width: 1320px;
}
.dp-solution-panel {
  overflow: visible !important;
  border: 0 !important;
  border-radius: 0 !important;
  padding: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
}
.dp-solution-panel__header {
  max-width: 940px;
  margin-bottom: clamp(36px, 5vw, 64px);
}
.dp-solution-columns {
  gap: clamp(24px, 3.2vw, 52px);
  margin-bottom: clamp(26px, 4vw, 42px);
}
.dp-solution-feature {
  padding: clamp(14px, 2.4vw, 28px) clamp(18px, 2.8vw, 42px);
  border-left: 1px solid rgba(34, 39, 33, 0.10);
}
.dp-solution-feature:first-child { padding-left: 0; }
.dp-solution-feature:last-child { padding-right: 0; }
.dp-solution-feature__icon {
  background: rgba(230, 244, 212, 0.72);
  box-shadow: 0 10px 24px rgba(34, 39, 33, 0.035);
}
.dp-solution-strip {
  margin-bottom: clamp(22px, 3vw, 34px);
  background: rgba(230, 244, 212, 0.36);
}
.dp-solution-cta {
  border: 1px solid rgba(115, 124, 91, 0.14);
  border-radius: clamp(22px, 2.5vw, 30px);
  box-shadow: 0 16px 46px rgba(34, 39, 33, 0.05);
}

@media (max-width: 990px) {
  #what-is-boka .dp-wrap {
    width: min(100% - 36px, 1320px);
  }
  .dp-solution-panel { padding: 0 !important; }
  .dp-solution-panel__header {
    max-width: 760px;
    margin-bottom: 30px;
  }
  .dp-solution-columns {
    gap: 0;
    margin-bottom: 24px;
  }
  .dp-solution-feature,
  .dp-solution-feature:first-child,
  .dp-solution-feature:last-child {
    border-left: 0;
    border-top: 1px solid rgba(34, 39, 33, 0.10);
    padding: 28px 0;
  }
  .dp-solution-feature:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .dp-solution-feature__checks {
    gap: 10px;
  }
  .dp-solution-cta {
    grid-template-columns: 1fr;
    gap: 20px;
  }
}

@media (max-width: 680px) {
  #what-is-boka .dp-wrap {
    width: min(100% - 28px, 1320px);
  }
  .dp-solution-panel__header {
    text-align: left;
    margin-bottom: 24px;
  }
  .dp-solution-panel__header .dp-kicker {
    justify-content: flex-start;
    font-size: 10px;
    letter-spacing: 0.16em;
    line-height: 1.25;
  }
  .dp-solution-panel__title {
    font-size: clamp(36px, 11vw, 50px);
    line-height: 1;
  }
  .dp-solution-panel__sub {
    max-width: 100%;
    font-size: 15.5px;
    line-height: 1.55;
  }
  .dp-solution-feature__icon {
    width: 54px;
    height: 54px;
    margin-bottom: 16px;
    font-size: 25px;
  }
  .dp-solution-feature__title {
    margin-bottom: 10px;
    font-size: clamp(24px, 7.2vw, 30px);
  }
  .dp-solution-feature__copy {
    margin-bottom: 18px;
    font-size: 14.5px;
  }
  .dp-solution-strip {
    grid-template-columns: 1fr;
    border-radius: 16px;
  }
  .dp-solution-strip__item {
    padding: 15px 16px;
    font-size: 13.5px;
  }
  .dp-solution-cta {
    padding: 22px 16px;
  }
  .dp-solution-cta__title {
    font-size: 24px;
  }
  .dp-solution-cta__actions {
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .dp-solution-cta__btn {
    width: 100%;
    min-height: 54px;
    font-size: 15px;
  }
  .dp-solution-fine {
    text-align: left;
    font-size: 11px;
  }
}

</style>





<main class="dp-page" id="dental-pros-page">
  <section class="dp-hero" aria-label="Boka Dental Pros Program">
    <div class="dp-wrap">
      <div class="dp-hero__grid">
        <div class="dp-hero__content">
          {% if section.settings.hero_kicker != blank %}
            <span class="dp-kicker">{{ section.settings.hero_kicker }}</span>
          {% endif %}

          {% if section.settings.hero_heading != blank %}
            <h1 class="dp-h1">{{ section.settings.hero_heading }}</h1>
          {% endif %}

          {% if section.settings.hero_text != blank %}
            <p class="dp-hero__sub">{{ section.settings.hero_text }}</p>
          {% endif %}

          <div class="dp-btn-row">
            {% if section.settings.hero_primary_label != blank %}
              <a class="dp-btn dp-btn--primary" href="{{ section.settings.hero_primary_link }}">
                {{ section.settings.hero_primary_label }}
              </a>
            {% endif %}

            {% if section.settings.hero_secondary_label != blank %}
              <a class="dp-btn" href="{{ section.settings.hero_secondary_link }}">
                {{ section.settings.hero_secondary_label }}
              </a>
            {% endif %}
          </div>

          <div class="dp-hero__trust" aria-label="Program highlights">
            {% for block in section.blocks %}
              {% if block.type == 'hero_pill' %}
                <span class="dp-pill" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </span>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <div class="dp-hero__visual">
          <div class="dp-hero__media-card">
            {% if section.settings.hero_image != blank %}
              {{
                section.settings.hero_image
                | image_url: width: 1400
                | image_tag:
                  class: 'dp-hero__image',
                  loading: 'eager',
                  fetchpriority: 'high',
                  alt: section.settings.hero_image_alt
              }}
            {% elsif section.settings.hero_image_url != blank %}
              <img
                class="dp-hero__image"
                src="{{ section.settings.hero_image_url }}"
                alt="{{ section.settings.hero_image_alt | escape }}"
                loading="eager"
                fetchpriority="high"
                width="900"
                height="1100"
              >
            {% else %}
              <div class="dp-hero__placeholder" aria-hidden="true">
                <div class="dp-logo-mark">BOKA</div>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
      <div class="dp-proof-band" aria-label="Boka Dental Pros core proof points">
        <div class="dp-proof-grid">
          <div class="dp-proof-item">
            <strong>#1 Toothpaste</strong>
            <span>On Amazon (Growing at Target, Walmart, CVS)</span>
          </div>

          <div class="dp-proof-item">
            <strong>Up to 55% Off</strong>
            <span>The More you buy, the more you save</span>
          </div>

          <div class="dp-proof-item">
            <strong>n-Ha Powered</strong>
            <span>The Premier Fluoride-Free Alternative</span>
          </div>

          <div class="dp-proof-item">
            <strong>Free Samples</strong>
            <span>Processed Instantly for Approved Teams</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="dp-section dp-why" id="patient-demand" aria-label="Why patients are asking about Boka">
    <div class="dp-wrap">
      {% if section.settings.why_kicker != blank %}
        <span class="dp-kicker">{{ section.settings.why_kicker }}</span>
      {% endif %}

      {% if section.settings.why_heading != blank %}
        <h2 class="dp-h2">{{ section.settings.why_heading }}</h2>
      {% endif %}

      {% if section.settings.why_text != blank %}
        <p class="dp-copy">{{ section.settings.why_text }}</p>
      {% endif %}

      <div class="dp-card-grid">
        {% for block in section.blocks %}
          {% if block.type == 'why_card' %}
            <article class="dp-info-card" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <div class="dp-info-card__icon">{{ block.settings.icon }}</div>
              {% endif %}
              {% if block.settings.title != blank %}
                <h3 class="dp-info-card__title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="dp-info-card__copy">{{ block.settings.text }}</p>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="dp-section" id="what-is-boka" aria-label="Why practices choose Boka">
    <div class="dp-wrap">
      <div class="dp-solution-panel">
        <div class="dp-solution-panel__header">
          <span class="dp-kicker">The Boka Solution for Dental Professionals</span>
          <h2 class="dp-solution-panel__title">Why practices choose Boka</h2>
