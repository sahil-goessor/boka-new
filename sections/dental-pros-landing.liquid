<style>
  :root {
    --dp-ink: #222721;
    --dp-forest: #737c5b;
    --dp-sage: #a5bc8b;
    --dp-mint: #bfd6a5;
    --dp-pale: #d3e7c0;
    --dp-frost: #e6f4d4;
    --dp-cream: #fafaf5;
    --dp-porcelain: #f7f7f0;
    --dp-white: #ffffff;
    --dp-petal: #f9e5db;
    --dp-rose: #efd5ca;
    --dp-terracotta: #aa7a6b;
    --dp-stone: #c1beb0;
    --dp-warm-gray: #8c8773;
    --dp-line: rgba(34, 39, 33, 0.12);
    --dp-shadow: 0 22px 70px rgba(34, 39, 33, 0.08);
    --dp-radius: 22px;
    --dp-radius-sm: 14px;
    --dp-max: 1180px;
    --dp-font-sans: var(--font-body-family), 'Neue Haas Unica W1G', Helvetica, Arial, sans-serif;
    --dp-font-heading: var(--font-heading-family), var(--dp-font-sans);
    --dp-font-serif: Georgia, 'Times New Roman', serif;
  }

  .dp-page,
  .dp-page * {
    box-sizing: border-box;
  }

  .dp-page {
    margin: 0;
    overflow: hidden;
    color: var(--dp-ink);
    font-family: var(--dp-font-sans);
    letter-spacing: -0.01em;
    background:
      radial-gradient(circle at 85% 8%, rgba(191, 214, 165, 0.28), transparent 28%),
      radial-gradient(circle at 12% 36%, rgba(249, 229, 219, 0.28), transparent 30%),
      linear-gradient(180deg, var(--dp-cream) 0%, var(--dp-porcelain) 48%, var(--dp-cream) 100%);
  }

  .dp-page :where(h1, h2, h3, h4, h5, h6, p, span, a, li, label, input, select, textarea, button) {
    font-family: var(--dp-font-sans);
  }

  .dp-page :where(.dp-h1, .dp-h2, .dp-h3) {
    font-family: var(--dp-font-heading);
  }

  .dp-page a {
    color: inherit;
  }

  .dp-wrap {
    width: min(var(--dp-max), calc(100% - 40px));
    margin-inline: auto;
  }

  .dp-section {
    padding: clamp(34px, 4.5vw, 64px) 0;
  }

  .dp-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.17em;
    color: var(--dp-forest);
    text-transform: uppercase;
  }

  .dp-kicker::before {
    content: "";
    width: 32px;
    height: 1px;
    background: currentColor;
    opacity: 0.55;
  }

  .dp-h1,
  .dp-h2,
  .dp-h3,
  .dp-page p {
    margin-block-start: 0;
  }

  .dp-h1,
  .dp-h2,
  .dp-h3 {
    font-family: var(--dp-font-heading);
    letter-spacing: -0.045em;
    font-weight: 300;
  }

  .dp-h1 {
    max-width: 780px;
    margin-bottom: 24px;
    font-size: clamp(46px, 7vw, 92px);
    line-height: 0.94;
  }

  .dp-h2 {
    margin-bottom: 18px;
    font-size: clamp(34px, 4.2vw, 54px);
    line-height: 1.05;
  }

  .dp-h3 {
    margin-bottom: 12px;
    font-size: clamp(22px, 2.2vw, 34px);
    line-height: 1.08;
  }

  .dp-em {
    font-family: var(--dp-font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.055em;
  }

  .dp-copy {
    max-width: 650px;
    margin-bottom: 24px;
    color: rgba(34, 39, 33, 0.72);
    font-size: clamp(16px, 1.3vw, 18px);
    font-weight: 300;
    line-height: 1.66;
  }

  .dp-btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .dp-btn {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid var(--dp-ink);
    border-radius: 999px;
    padding: 14px 24px;
    background: transparent;
    color: var(--dp-ink);
    font-family: var(--dp-font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.11em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 160ms ease, background 160ms ease, color 160ms ease, border-color 160ms ease;
  }

  .dp-btn:hover {
    transform: translateY(-1px);
    background: var(--dp-ink);
    color: var(--dp-cream) !important;
  }

  .dp-btn--primary {
    border-color: var(--dp-sage);
    background: var(--dp-sage);
    color: var(--dp-ink);
  }

  .dp-btn--primary:hover {
    border-color: var(--dp-ink);
    background: var(--dp-ink);
    color: var(--dp-cream) !important;
  }

  .dp-btn--light {
    border-color: rgba(255, 255, 255, 0.7);
    color: var(--dp-white);
  }

  .dp-btn--light:hover {
    border-color: var(--dp-white);
    background: var(--dp-white);
    color: var(--dp-ink);
  }

  .dp-pill {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    border: 1px solid rgba(34, 39, 33, 0.10);
    border-radius: 999px;
    padding: 8px 13px;
    background: rgba(255, 255, 255, 0.62);
    color: rgba(34, 39, 33, 0.72);
    font-size: 12px;
    line-height: 1;
    backdrop-filter: blur(10px);
  }

  .dp-card,
  .dp-info-card,
  .dp-mini,
  .dp-step,
  .dp-quote,
  .dp-process__item,
  .dp-form {
    background: rgba(255, 255, 255, 0.64);
    border: 1px solid rgba(34, 39, 33, 0.09);
    border-radius: var(--dp-radius);
    box-shadow: 0 18px 54px rgba(34, 39, 33, 0.055);
    backdrop-filter: blur(10px);
  }

  .dp-hero {
    position: relative;
    padding-top: clamp(42px, 5vw, 76px);
    padding-bottom: 0 !important;
  }

  .dp-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.75fr);
    gap: clamp(24px, 4vw, 54px);
    align-items: center;
  }

  .dp-hero__media-card {
    position: relative;
    overflow: hidden;
    min-height: 480px;
    border-radius: 34px;
    background: var(--dp-sage);
  }

  .dp-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 480px;
    object-fit: contain;
    padding: 20px;
  }

  .dp-hero + #what-is-boka {
    padding-top: clamp(24px, 4vw, 44px) !important;
  }

  .dp-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  .dp-split--reverse {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  }

  .dp-ingredient-card {
    padding: clamp(24px, 3.5vw, 44px);
    background: var(--dp-pale);
  }

  .dp-check-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dp-check-list li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: rgba(34, 39, 33, 0.82);
    font-size: 14px;
    line-height: 1.5;
  }

  .dp-check-list li::before {
    content: "";
    flex: 0 0 8px;
    width: 8px;
    height: 8px;
    margin-top: 6px;
    border-radius: 999px;
    background: var(--dp-forest);
  }

  .dp-mini-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 24px;
  }

  .dp-mini {
    border-radius: 14px;
    padding: 18px;
  }

  .dp-mini__title {
    margin: 0 0 6px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dp-mini__copy {
    margin: 0;
    color: rgba(34, 39, 33, 0.70);
    font-size: 13px;
    line-height: 1.5;
  }

  .dp-retail-badge-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .dp-retail-badge {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    background: rgba(34, 39, 33, 0.05);
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--dp-ink);
    letter-spacing: 0.02em;
  }

  .dp-retail-badge--highlight {
    background: var(--dp-mint);
    color: var(--dp-ink);
  }

  .dp-video-card {
    position: relative;
    overflow: hidden;
    border-radius: 34px;
    background: var(--dp-forest);
    box-shadow: 0 30px 80px rgba(34, 39, 33, 0.12);
  }

  .dp-video-card::before {
    content: "";
    display: block;
    padding-bottom: 56.25%;
  }

  .dp-video-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 28px;
    background: var(--dp-sage);
    text-align: center;
  }

  .dp-play {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin: 0 auto 14px;
    border-radius: 999px;
    background: rgba(250, 250, 245, 0.9);
    color: var(--dp-forest);
  }

  .dp-play svg {
    width: 24px;
    height: 24px;
    margin-left: 3px;
    fill: currentColor;
  }

  .dp-video-placeholder p {
    max-width: 320px;
    margin: 0 auto;
    color: var(--dp-white);
    font-size: 14px;
    line-height: 1.4;
  }

  .dp-advisor {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-top: 20px;
    border: 1px solid rgba(170, 122, 107, 0.20);
    border-radius: 16px;
    padding: 14px;
    background: rgba(255, 255, 255, 0.56);
  }

  .dp-advisor__avatar {
    display: grid;
    place-items: center;
    flex: 0 0 46px;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    background: var(--dp-rose);
    color: var(--dp-terracotta);
    font-family: var(--dp-font-serif);
    font-style: italic;
  }

  .dp-advisor__name {
    margin: 0 0 2px;
    font-size: 14px;
    font-weight: 600;
  }

  .dp-advisor__role {
    margin: 0;
    color: rgba(34, 39, 33, 0.62);
    font-size: 12px;
  }

  .dp-commission {
    margin-top: 28px;
    border-radius: 28px;
    padding: clamp(24px, 4vw, 48px);
    background: linear-gradient(135deg, #737c5b 0%, #5f684d 100%);
    color: var(--dp-white);
    text-align: center;
  }

  .dp-commission .dp-h3 {
    color: var(--dp-cream);
    font-size: clamp(28px, 3.5vw, 46px);
    font-weight: 400;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }

  .dp-commission__copy {
    max-width: 580px;
    margin: 0 auto;
    color: rgba(250, 250, 245, 0.85);
    font-size: clamp(15px, 1.2vw, 18px);
    line-height: 1.5;
  }

  .dp-quote-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 32px;
  }

  .dp-quote {
    padding: clamp(20px, 2.5vw, 32px);
  }

  .dp-quote__text {
    margin: 0 0 18px;
    color: rgba(34, 39, 33, 0.82);
    font-family: var(--dp-font-serif);
    font-size: 18px;
    font-style: italic;
    line-height: 1.45;
  }

  .dp-quote__name {
    margin: 0 0 2px;
    color: var(--dp-forest);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .dp-quote__role {
    margin: 0;
    color: rgba(34, 39, 33, 0.56);
    font-size: 12px;
  }

  .dp-b2b-box {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(24px, 4vw, 54px);
    align-items: start;
    border-radius: 28px;
    padding: clamp(24px, 4vw, 44px);
    background: rgba(250, 250, 245, 0.88);
    border: 1px solid rgba(115, 124, 91, 0.14);
  }

  .dp-process {
    display: grid;
    gap: 10px;
    counter-reset: prostep;
  }

  .dp-process__item {
    position: relative;
    padding: 16px 16px 16px 64px;
    counter-increment: prostep;
  }

  .dp-process__item::before {
    content: counter(prostep, decimal-leading-zero);
    position: absolute;
    top: 14px;
    left: 14px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--dp-pale);
    color: var(--dp-forest);
    font-family: var(--dp-font-serif);
    font-style: italic;
    font-size: 14px;
  }

  .dp-process__title {
    margin: 0 0 4px;
    font-size: 14px;
    font-weight: 600;
  }

  .dp-process__copy {
    margin: 0;
    color: rgba(34, 39, 33, 0.66);
    font-size: 13px;
    line-height: 1.45;
  }

  .dp-note {
    margin-top: 14px;
    border-left: 1px solid var(--dp-terracotta);
    padding-left: 14px;
    color: rgba(34, 39, 33, 0.64);
    font-size: 12px;
    line-height: 1.5;
  }

  .dp-form-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(24px, 4vw, 54px);
    align-items: start;
  }

  .dp-form {
    border-radius: 28px;
    padding: clamp(20px, 3vw, 38px);
  }

  .dp-faq .dp-wrap {
    padding: clamp(24px, 3.5vw, 44px);
    border-radius: 28px;
    background: rgba(211, 231, 192, 0.36);
    border: 1px solid rgba(115, 124, 91, 0.14);
  }

  .dp-faq-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 18px;
    margin-top: 28px;
  }

  .dp-faq-item {
    border-top: 1px solid rgba(34, 39, 33, 0.14);
    padding-top: 16px;
  }

  .dp-faq-item h3 {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 500;
  }

  .dp-faq-item p {
    margin: 0;
    color: rgba(34, 39, 33, 0.66);
    font-size: 13px;
    line-height: 1.55;
  }

  .dp-final {
    position: relative;
    padding: clamp(44px, 5vw, 76px) 0;
    background: var(--dp-cream);
    text-align: center;
  }

  .dp-final .dp-wrap {
    max-width: 900px;
    padding: clamp(28px, 4vw, 54px);
    border: 1px solid rgba(115, 124, 91, 0.16);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.58);
  }

  .dp-final .dp-copy {
    margin-inline: auto;
    color: rgba(34, 39, 33, 0.68);
  }

  @media (max-width: 990px) {
    .dp-hero__grid,
    .dp-split,
    .dp-split--reverse,
    .dp-b2b-box,
    .dp-form-shell {
      grid-template-columns: 1fr;
    }

    .dp-hero__media-card,
    .dp-hero__image {
      min-height: 380px;
      height: 380px;
    }

    .dp-quote-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .dp-wrap {
      width: min(100% - 28px, var(--dp-max));
    }

    .dp-h1 {
      font-size: clamp(38px, 12vw, 54px);
    }

    .dp-btn-row,
    .dp-btn {
      width: 100%;
    }

    .dp-hero {
      padding-top: 32px;
    }

    .dp-hero__media-card,
    .dp-hero__image {
      min-height: 320px;
      height: 320px;
      border-radius: 22px;
    }

    .dp-section {
      padding: 44px 0;
    }

    .dp-hero + #what-is-boka {
      padding-top: 14px !important;
    }

    .dp-b2b-box,
    .dp-commission,
    .dp-form,
    .dp-faq .dp-wrap,
    .dp-final .dp-wrap {
      border-radius: 22px;
    }

    .dp-process__item {
      padding: 14px 14px 14px 54px;
    }

    .dp-mini-grid,
    .dp-quote-grid,
    .dp-faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<main class="dp-page" id="dental-pros-page">
  
  <section class="dp-hero" aria-label="Boka Dental Pros Program">
    <div class="dp-wrap">
      <div class="dp-hero__grid">
        <div class="dp-hero__content">
          <span class="dp-kicker">Boka Dental Pros</span>
          <h1 class="dp-h1">The Answer for <span class="dp-em">Fluoride-Free</span> Patient Demands.</h1>
          <p class="dp-hero__sub">Every week, more patients are sitting in your chairs asking for conscious, fluoride-free alternatives. The Boka Dental Pros Program makes it simple for hygienists and dental professionals to confidently guide these conversations while unlocking exclusive practice perks. <strong>Claim your complimentary samples below.</strong></p>
          
          <div class="dp-btn-row">
            <a class="dp-btn dp-btn--primary" href="#signup">Apply for Samples</a>
            <a href="#how-it-works" class="dp-btn">See Practice Savings</a>
          </div>

          <div class="dp-hero__trust" aria-label="Program highlights">
            <span class="dp-pill">Complimentary Trial Kits</span>
            <span class="dp-pill">Up to 55% Off Materials</span>
            <span class="dp-pill">U.S. & Canada Only</span>
          </div>
        </div>

        <div class="dp-hero__visual">
          <div class="dp-hero__media-card">
            <img src="//www.boka.com/cdn/shop/files/81BTsIMEbTL._AC_SL1500.jpg?v=1777991528&amp;width=1400" alt="Boka oral care n-Ha toothpaste collection layout" width="1400" height="1400" loading="eager" class="dp-hero__image" fetchpriority="high">
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="dp-section" id="what-is-boka" aria-label="The Boka Market Solution">
    <div class="dp-wrap">
      <div class="dp-split">
        <div>
          <span class="dp-kicker">Why Boka</span>
          <h2 class="dp-h2">The #1 Toothpaste on Amazon. <br><span class="dp-em">Trusted Everywhere</span>.</h2>
          <p class="dp-copy">Patients are already buying Boka for their homes because it is the <strong>number one toothpaste on Amazon</strong> and growing rapidly inside primary retail channels including <strong>Walmart, Target, and CVS</strong>. By bringing Boka into your office suites, you meet patient expectations with a household brand name they trust.</p>
          
          <div class="dp-retail-badge-grid">
            <span class="dp-retail-badge dp-retail-badge--highlight">#1 on Amazon</span>
            <span class="dp-retail-badge">Available at Walmart</span>
            <span class="dp-retail-badge">Available at Target</span>
            <span class="dp-retail-badge">Available at CVS</span>
          </div>

          <div class="dp-mini-grid">
            <div class="dp-mini">
              <p class="dp-mini__title">Science-Backed Wellness</p>
              <p class="dp-mini__copy">Clear clinical integrity regarding ingredients, systemic tissue benefits, and safe regular compliance.</p>
            </div>
            <div class="dp-mini">
              <p class="dp-mini__title">Elevated Experience</p>
              <p class="dp-mini__copy">Clean formulas, sustainable presentation layers, and flavor varieties your patients will love using.</p>
            </div>
          </div>
        </div>

        <div class="dp-card dp-ingredient-card">
          <span class="dp-kicker">The Science of n-Ha</span>
          <h3 class="dp-h3">Advanced remineralization, explicitly fluoride-free.</h3>
          <p class="dp-copy" style="font-size: 14px; line-height: 1.5; margin-bottom: 20px;">Our proprietary formula relies on Nano-Hydroxyapatite (n-Ha)—a biocompatible, biomimetic mineral that naturally makes up 97% of human enamel and 70% of dentin tissue frameworks. It remineralizes securely without toxic preservatives.</p>
          
          <ul class="dp-check-list">
            <li>100% Fluoride-free n-Ha structural toothpastes</li>
            <li>SLS-free and paraben-free premium clean bases</li>
            <li>Low-foaming, highly therapeutic tactile experience</li>
            <li>Reduces sensitive tooth pain safely at home</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="dp-section dp-video" id="advisory-video" aria-label="Dental Advisory Committee Video Verification">
    <div class="dp-wrap">
      <div class="dp-split dp-split--reverse">
        <div>
          <div class="dp-video-card">
            <div class="dp-video-placeholder">
              <div>
                <span class="dp-play" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                </span>
                <p>Short clip from our Dental Advisory Committee describing clinical outcomes with n-Ha.</p>
              </div>
            </div>
          </div>
        </div>

        <div>
          <span class="dp-kicker">Dental Committee Guided</span>
          <h2 class="dp-h2">Clinically verified by your professional peers.</h2>
          <p class="dp-copy">Boka is actively guided by our internal Dental Advisory Committee of practicing dentists, hygienists, and scientific researchers. We maintain clinical benchmarks so you can field natural product preferences safely without diluting professional standard benchmarks.</p>
          
          <div class="dp-advisor">
            <div class="dp-advisor__avatar">Dr.</div>
            <div>
              <p class="dp-advisor__name">Boka Clinical Advisory Group</p>
              <p class="dp-advisor__role">Active Dental Surgeons & Registered Hygiene Experts</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="dp-section dp-testimonials" aria-label="Dentist and Hygienist Peer Endorsements">
    <div class="dp-wrap">
      <span class="dp-kicker">Practitioner Endorsements</span>
