      {% if section.settings.faq_kicker != blank %}
        <span class="dp-kicker">{{ section.settings.faq_kicker }}</span>
      {% endif %}
      {% if section.settings.faq_heading != blank %}
        <h2 class="dp-h2">{{ section.settings.faq_heading }}</h2>
      {% endif %}

      <div class="dp-faq-grid">
        {% for block in section.blocks %}
          {% if block.type == 'faq' %}
            <div class="dp-faq-item" {{ block.shopify_attributes }}>
              {% if block.settings.question != blank %}
                <h3>{{ block.settings.question }}</h3>
              {% endif %}
              {% if block.settings.answer != blank %}
                <p>{{ block.settings.answer }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
