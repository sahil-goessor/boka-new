
<style>
  :root {
    --dp-ink: #222721;
    --dp-forest: #737c5b;
    --dp-sage: #a5bc8b;
    --dp-mint: #bfd6a5;
    --dp-pale: #d3e7c0;
    --dp-frost: #e6f4d4;
    --dp-cream: #fafaf5;
    --dp-porcelain: #f7f7f0;
    --dp-white: #ffffff;
    --dp-petal: #f9e5db;
    --dp-rose: #efd5ca;
    --dp-terracotta: #aa7a6b;
    --dp-stone: #c1beb0;
    --dp-warm-gray: #8c8773;
    --dp-line: rgba(34, 39, 33, 0.12);
    --dp-shadow: 0 22px 70px rgba(34, 39, 33, 0.08);
    --dp-radius: 22px;
    --dp-radius-sm: 14px;
    --dp-max: 1180px;
    --dp-font-sans: var(--font-body-family), 'Neue Haas Unica W1G', Helvetica, Arial, sans-serif;
    --dp-font-heading: var(--font-heading-family), var(--dp-font-sans);
    --dp-font-serif: Georgia, 'Times New Roman', serif;
  }

  .dp-page,
  .dp-page * {
    box-sizing: border-box;
  }

  .dp-page {
    margin: 0;
    overflow: hidden;
    color: var(--dp-ink);
    font-family: var(--dp-font-sans);
    letter-spacing: -0.01em;
    background:
      radial-gradient(circle at 85% 8%, rgba(191, 214, 165, 0.28), transparent 28%),
      radial-gradient(circle at 12% 36%, rgba(249, 229, 219, 0.28), transparent 30%),
      linear-gradient(180deg, var(--dp-cream) 0%, var(--dp-porcelain) 48%, var(--dp-cream) 100%);
  }

  .dp-page :where(h1, h2, h3, h4, h5, h6, p, span, a, li, label, input, select, textarea, button) {
    font-family: var(--dp-font-sans);
  }

  .dp-page :where(.dp-h1, .dp-h2, .dp-h3) {
    font-family: var(--dp-font-heading);
  }

  .dp-page a {
    color: inherit;
  }

  .dp-wrap {
    width: min(var(--dp-max), calc(100% - 40px));
    margin-inline: auto;
  }

  .dp-section {
    padding: clamp(58px, 6.5vw, 104px) 0;
  }

  .dp-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.17em;
    color: var(--dp-forest);
    text-transform: uppercase;
  }

  .dp-kicker::before {
    content: "";
    width: 32px;
    height: 1px;
    background: currentColor;
    opacity: 0.55;
  }

  .dp-h1,
  .dp-h2,
  .dp-h3,
  .dp-page p {
    margin-block-start: 0;
  }

  .dp-h1,
  .dp-h2,
  .dp-h3 {
    font-family: var(--dp-font-heading);
    letter-spacing: -0.045em;
    font-weight: 300;
  }

  .dp-h1 {
    max-width: 780px;
    margin-bottom: 24px;
    font-size: clamp(46px, 7vw, 92px);
    line-height: 0.94;
  }

  .dp-h2 {
    margin-bottom: 18px;
    font-size: clamp(34px, 4.2vw, 62px);
    line-height: 1.02;
  }

  .dp-h3 {
    margin-bottom: 12px;
    font-size: clamp(22px, 2.2vw, 34px);
    line-height: 1.08;
  }

  .dp-em {
    font-family: var(--dp-font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.055em;
  }

  .dp-copy {
    max-width: 650px;
    margin-bottom: 24px;
    color: rgba(34, 39, 33, 0.72);
    font-size: clamp(16px, 1.3vw, 18px);
    font-weight: 300;
    line-height: 1.66;
  }

  .dp-copy--sm {
    font-size: 14px;
    line-height: 1.62;
  }

  .dp-btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .dp-btn {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid var(--dp-ink);
    border-radius: 999px;
    padding: 14px 24px;
    background: transparent;
    color: var(--dp-ink);
    font-family: var(--dp-font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.11em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 160ms ease, background 160ms ease, color 160ms ease, border-color 160ms ease;
  }

  .dp-btn:hover,
  .dp-btn:focus-visible {
    transform: translateY(-1px);
    background: var(--dp-ink);
    color: var(--dp-cream) !important;
  }

  .dp-btn:hover *,
  .dp-btn:focus-visible * {
    color: var(--dp-cream) !important;
  }

  .dp-btn--primary {
    border-color: var(--dp-sage);
    background: var(--dp-sage);
    color: var(--dp-ink);
  }

  .dp-btn--primary:hover,
  .dp-btn--primary:focus-visible {
    border-color: var(--dp-ink);
    background: var(--dp-ink);
    color: var(--dp-cream) !important;
  }

  .dp-btn--primary:hover *,
  .dp-btn--primary:focus-visible * {
    color: var(--dp-cream) !important;
  }

  .dp-btn--light {
    border-color: rgba(255, 255, 255, 0.7);
    color: var(--dp-white);
  }

  .dp-btn--light:hover {
    border-color: var(--dp-white);
    background: var(--dp-white);
    color: var(--dp-ink);
  }

  .dp-pill {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    border: 1px solid rgba(34, 39, 33, 0.10);
    border-radius: 999px;
    padding: 8px 13px;
    background: rgba(255, 255, 255, 0.62);
    color: rgba(34, 39, 33, 0.72);
    font-size: 12px;
    line-height: 1;
    backdrop-filter: blur(10px);
  }

  .dp-card,
  .dp-info-card,
  .dp-mini,
  .dp-step,
  .dp-quote,
  .dp-process__item,
  .dp-form {
    background: rgba(255, 255, 255, 0.64);
    border: 1px solid rgba(34, 39, 33, 0.09);
    border-radius: var(--dp-radius);
    box-shadow: 0 18px 54px rgba(34, 39, 33, 0.055);
    backdrop-filter: blur(10px);
  }

  .dp-info-card,
  .dp-mini,
  .dp-step,
  .dp-quote,
  .dp-process__item {
    transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
  }

  .dp-info-card:hover,
  .dp-mini:hover,
  .dp-step:hover,
  .dp-quote:hover,
  .dp-process__item:hover {
    transform: translateY(-2px);
    border-color: rgba(115, 124, 91, 0.18);
    box-shadow: 0 24px 68px rgba(34, 39, 33, 0.075);
  }

  .dp-hero {
     position: relative;
    min-height: auto;
    padding-top: clamp(52px, 7vw, 96px);
    background:
      radial-gradient(circle at 78% 14%, rgba(191, 214, 165, 0.42), transparent 34%),
    radial-gradient(circle at 12% 72%, rgba(249, 229, 219, 0.18), transparent 28%),
    transparent;
  }

  .dp-hero::before,
  .dp-hero::after {
    content: "";
    position: absolute;
    z-index: 0;
    border: 1px solid rgba(115, 124, 91, 0.22);
    border-radius: 999px 999px 999px 24px;
    pointer-events: none;
  }

  .dp-hero::before {
    width: 470px;
    height: 470px;
    top: 8%;
    right: -150px;
    transform: rotate(18deg);
  }

  .dp-hero::after {
    width: 280px;
    height: 280px;
    left: -115px;
    bottom: 12%;
    transform: rotate(-16deg);
  }

  .dp-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(360px, 0.78fr);
    gap: clamp(34px, 5vw, 72px);
    align-items: center;
  }

  .dp-hero__content {
    padding-top: 34px;
  }

  .dp-hero__sub {
    max-width: 680px;
    margin-bottom: 28px;
    color: rgba(34, 39, 33, 0.76);
    font-size: clamp(17px, 1.55vw, 21px);
    font-weight: 300;
    line-height: 1.58;
  }

  .dp-hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 30px 0 0;
  }

  .dp-hero__visual {
    position: relative;
  }

  .dp-hero__media-card {
    position: relative;
    overflow: hidden;
    min-height: 560px;
    border-radius: 34px;
    background:
      radial-gradient(circle at 50% 30%, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.12) 52%, rgba(255, 255, 255, 0) 78%),
      var(--dp-sage);
    box-shadow: 0 38px 90px rgba(34, 39, 33, 0.16);
  }

  .dp-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 560px;
    object-fit: contain;
    object-position: center center;
    padding: 24px;
  }

  .dp-hero__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 38px;
    text-align: center;
  }

  .dp-logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: min(75%, 310px);
    aspect-ratio: 1 / 1;
    border: 1px solid rgba(255, 255, 255, 0.48);
    border-radius: 42% 58% 48% 52% / 56% 44% 56% 44%;
    background: rgba(250, 250, 245, 0.18);
    color: var(--dp-white);
    font-size: clamp(34px, 4vw, 54px);
    font-weight: 300;
    letter-spacing: 0.36em;
    text-indent: 0.36em;
  }

  .dp-hero__note {
    display: none !important;
  }

  .dp-hero__note-title {
    margin: 0 0 7px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--dp-forest);
    text-transform: uppercase;
  }

  .dp-hero__note-copy {
    margin: 0;
    color: rgba(34, 39, 33, 0.72);
    font-size: 13px;
    line-height: 1.55;
  }

  .dp-hero + .dp-b2b {
     position: relative;
  z-index: 3;
  margin-top: clamp(-72px, -5vw, -48px);
  padding-top: 0;
  padding-bottom: clamp(46px, 5vw, 76px);
  background: transparent;
  }

  .dp-b2b {
    position: relative;
    background: transparent;
  }

  .dp-b2b-box {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(26px, 5vw, 70px);
    align-items: start;
    border-radius: 34px;
    padding: clamp(28px, 5vw, 58px);
    background: rgba(250, 250, 245, 0.88);
    border: 1px solid rgba(115, 124, 91, 0.14);
    box-shadow: 0 20px 64px rgba(34, 39, 33, 0.065);
    backdrop-filter: blur(12px);
    }

  .dp-b2b + #what-is-boka {
    padding-top: clamp(54px, 6vw, 86px);
  }

  .dp-process {
    display: grid;
    gap: 12px;
    counter-reset: prostep;
  }

  .dp-process__item {
    position: relative;
    min-height: 70px;
    border-radius: 18px;
    padding: 20px 20px 20px 72px;
    counter-increment: prostep;
  }

  .dp-process__item::before {
    content: counter(prostep, decimal-leading-zero);
    position: absolute;
    top: 18px;
    left: 18px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--dp-pale);
    color: var(--dp-forest);
    font-family: var(--dp-font-serif);
    font-style: italic;
    font-size: 15px;
  }

  .dp-process__title {
    margin: 0 0 5px;
    font-size: 15px;
    font-weight: 600;
  }

  .dp-process__copy {
    margin: 0;
    color: rgba(34, 39, 33, 0.66);
    font-size: 13px;
    line-height: 1.5;
  }

  .dp-note {
    margin-top: 18px;
    border-left: 1px solid var(--dp-terracotta);
    padding-left: 18px;
    color: rgba(34, 39, 33, 0.64);
    font-size: 12px;
    line-height: 1.58;
  }

  .dp-split {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: clamp(36px, 6vw, 92px);
    align-items: center;
  }

  .dp-split--reverse {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  }

  .dp-solution-header {
    max-width: 900px;
    margin: 0 0 clamp(30px, 4vw, 52px);
  }

  .dp-solution-header .dp-copy {
    max-width: 780px;
  }

  .dp-solution-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(22px, 4vw, 56px);
    align-items: stretch;
  }

  .dp-solution-panel {
    display: flex;
    align-items: stretch;
  }

  .dp-solution-panel .dp-mini-grid {
    width: 100%;
    margin-top: 0;
  }

  .dp-solution-grid .dp-ingredient-card {
    min-height: 100%;
  }

  .dp-ingredient-card {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 4vw, 54px);
    background:
      radial-gradient(circle at 90% 0%, rgba(255, 255, 255, 0.50), transparent 32%),
      var(--dp-pale);
  }

  .dp-ingredient-card::after {
    content: "";
    position: absolute;
    width: 230px;
    height: 230px;
    right: -70px;
    bottom: -70px;
    border: 1px solid rgba(115, 124, 91, 0.25);
    border-radius: 44% 56% 42% 58%;
    transform: rotate(20deg);
  }

  .dp-check-list {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dp-check-list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    color: rgba(34, 39, 33, 0.76);
    font-size: 14px;
    line-height: 1.55;
  }

  .dp-check-list li::before {
    content: "";
    flex: 0 0 9px;
    width: 9px;
    height: 9px;
    margin-top: 7px;
    border-radius: 999px;
    background: var(--dp-forest);
  }

  .dp-mini-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 28px;
  }

  .dp-mini {
    border-radius: 18px;
    padding: 22px;
  }

  .dp-mini__title {
    margin: 0 0 8px;
    color: var(--dp-ink);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .dp-mini__copy {
    margin: 0;
    color: rgba(34, 39, 33, 0.70);
    font-size: 13px;
    line-height: 1.55;
  }

  .dp-why,
  .dp-video,
  .dp-testimonials,
  .dp-signup {
    background: transparent;
  }

  .dp-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 44px;
  }

  .dp-info-card {
    padding: clamp(24px, 3vw, 34px);
  }

  .dp-info-card__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-bottom: 20px;
    border-radius: 999px;
    background: var(--dp-frost);
    color: var(--dp-forest);
    font-family: var(--dp-font-serif);
    font-style: italic;
    font-size: 22px;
  }

  .dp-info-card__title {
    margin: 0 0 11px;
    font-size: 20px;
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .dp-info-card__copy {
    margin: 0;
    color: rgba(34, 39, 33, 0.68);
    font-size: 14px;
    line-height: 1.62;
  }

  .dp-video-card {
    position: relative;
    overflow: hidden;
    border-radius: 34px;
    background: var(--dp-forest);
    box-shadow: 0 30px 80px rgba(34, 39, 33, 0.12);
  }

  .dp-video-card::before {
    content: "";
    display: block;
    padding-bottom: 56.25%;
  }

  .dp-video-card iframe,
  .dp-video-card video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .dp-video-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 28px;
    background:
      linear-gradient(180deg, rgba(34, 39, 33, 0.08), rgba(34, 39, 33, 0.54)),
      radial-gradient(circle at 25% 10%, rgba(211, 231, 192, 0.55), transparent 36%),
      var(--dp-sage);
    text-align: center;
  }

  .dp-play {
    display: grid;
    place-items: center;
    width: 78px;
    height: 78px;
    margin: 0 auto 20px;
    border-radius: 999px;
    background: rgba(250, 250, 245, 0.88);
    color: var(--dp-forest);
  }

  .dp-play svg {
    width: 28px;
    height: 28px;
    margin-left: 4px;
    fill: currentColor;
  }

  .dp-video-placeholder p {
    max-width: 360px;
    margin: 0 auto;
    color: var(--dp-cream);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.5;
  }

  .dp-advisor {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-top: 26px;
    border: 1px solid rgba(170, 122, 107, 0.20);
    border-radius: 20px;
    padding: 16px;
    background: rgba(255, 255, 255, 0.56);
  }

  .dp-advisor__avatar {
    display: grid;
    place-items: center;
    flex: 0 0 52px;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    background: var(--dp-rose);
    color: var(--dp-terracotta);
    font-family: var(--dp-font-serif);
    font-style: italic;
  }

  .dp-advisor__name {
    margin: 0 0 3px;
    font-size: 14px;
    font-weight: 600;
  }

  .dp-advisor__role {
    margin: 0;
    color: rgba(34, 39, 33, 0.62);
    font-size: 12px;
    line-height: 1.4;
  }

  .dp-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: 44px;
  }

  .dp-step {
    position: relative;
    min-height: 250px;
    padding: 24px;
  }

  .dp-step__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    margin-bottom: 28px;
    border-radius: 999px;
    background: var(--dp-frost);
    color: var(--dp-forest);
    font-family: var(--dp-font-serif);
    font-size: 19px;
    font-style: italic;
  }

  .dp-step__title {
    margin: 0 0 10px;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.18;
  }

  .dp-step__copy {
    margin: 0;
    color: rgba(34, 39, 33, 0.68);
    font-size: 13px;
    line-height: 1.58;
  }

  .dp-commission {
    display: grid;
    grid-template-columns: 1fr;
    gap: 34px;
    margin-top: 34px;
    border-radius: 34px;
    padding: clamp(34px, 5vw, 64px);
    background:
      radial-gradient(circle at 90% 20%, rgba(211, 231, 192, 0.22), transparent 36%),
      linear-gradient(135deg, #737c5b 0%, #5f684d 100%);
    color: var(--dp-white);
    overflow: hidden;
    position: relative;
    box-shadow: 0 30px 80px rgba(34, 39, 33, 0.13);
  }

  .dp-commission::after {
    content: "";
    position: absolute;
    right: -120px;
    bottom: -140px;
    width: 340px;
    height: 340px;
    border-radius: 48% 52% 44% 56%;
    border: 1px solid rgba(255, 255, 255, 0.22);
    transform: rotate(18deg);
  }

  .dp-commission__copy {
  max-width: 620px;
  margin-bottom: 0;
  color: rgba(250, 250, 245, 0.82) !important;
  font-size: clamp(16px, 1.25vw, 19px);
  font-weight: 300;
  line-height: 1.65;
  }

  .dp-commission > div:first-child {
  position: relative;
  z-index: 1;
  max-width: 680px;
  }

  .dp-commission .dp-h3 {
    margin-bottom: 14px;
    color: var(--dp-cream);
    font-family: var(--dp-font-sans);
    font-size: clamp(30px, 3vw, 46px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .dp-rates {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14px;
  position: relative;
  z-index: 1;
  max-width: 100%;
  }

  .dp-rate {
  display: grid;
  grid-template-columns: minmax(180px, 0.34fr) minmax(0, 0.66fr);
  align-items: center;
  gap: 24px;
  border: 1px solid rgba(250, 250, 245, 0.22);
  border-radius: 20px;
  padding: 20px 26px;
  background: rgba(250, 250, 245, 0.10);
  box-shadow: inset 0 1px 0 rgba(250, 250, 245, 0.08);
  }

  .dp-rate span:first-child {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 34px;
    border-radius: 999px;
    padding: 8px 14px;
    background: rgba(250, 250, 245, 0.14);
    color: rgba(250, 250, 245, 0.92);
    font-family: var(--dp-font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .dp-rate span:last-child {
    color: var(--dp-pale);
    font-family: var(--dp-font-serif);
    font-size: clamp(32px, 3.2vw, 50px);
    font-style: italic;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
    text-align: left;
    white-space: nowrap;
  }

  .dp-quote-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
