
<style>
:root {
  --dp-ink: #222721;
  --dp-forest: #737c5b;
  --dp-sage: #a5bc8b;
  --dp-pale: #d3e7c0;
  --dp-frost: #e6f4d4;
  --dp-cream: #fafaf5;
  --dp-white: #ffffff;
  --dp-rose: #efd5ca;
  --dp-terracotta: #aa7a6b;
  --dp-line: rgba(34, 39, 33, 0.10);
  --dp-line-warm: rgba(170, 122, 107, 0.28);
  --dp-tint-sage: rgba(211, 231, 192, 0.20);
  --dp-tint-warm: rgba(249, 229, 219, 0.24);
  --dp-shadow: 0 18px 50px rgba(34, 39, 33, 0.06);
  --dp-shadow-sm: 0 10px 30px rgba(34, 39, 33, 0.045);
  --dp-radius: 20px;
  --dp-max: 1120px;
  --dp-font-sans: var(--font-body-family), Helvetica, Arial, sans-serif;
  --dp-font-heading: var(--font-heading-family), var(--dp-font-sans);
  --dp-font-serif: Georgia, 'Times New Roman', serif;
}

.dp-page, .dp-page * { box-sizing: border-box; }
.dp-page {
  margin: 0; overflow: hidden; color: var(--dp-ink);
  font-family: var(--dp-font-sans); letter-spacing: -0.01em;
  background:
    radial-gradient(circle at 88% 3%, rgba(191, 214, 165, 0.14), transparent 42%),
    radial-gradient(circle at 5% 26%, rgba(249, 229, 219, 0.16), transparent 38%),
    var(--dp-cream);
}
.dp-page :where(h1,h2,h3,h4,h5,h6,p,span,a,li,label,input,select,textarea,button) { font-family: var(--dp-font-sans); }
.dp-page :where(.dp-h1, .dp-h2, .dp-h3) { font-family: var(--dp-font-heading); }
.dp-page a { color: inherit; }

.dp-wrap { width: min(var(--dp-max), calc(100% - 44px)); margin-inline: auto; }
.dp-section { padding: clamp(54px, 5.6vw, 88px) 0; }

/* Section rhythm */
#solution { background: var(--dp-tint-sage); }
.dp-signup { background: var(--dp-tint-warm); }

.dp-kicker {
  display: inline-flex; align-items: center; gap: 10px; margin: 0 0 16px;
  font-size: 11px; font-weight: 600; line-height: 1; letter-spacing: 0.18em;
  color: var(--dp-forest); text-transform: uppercase;
}
.dp-kicker::before { content: ""; width: 28px; height: 1px; background: var(--dp-terracotta); opacity: 0.6; }

.dp-h1, .dp-h2, .dp-h3, .dp-page p { margin-block-start: 0; }
.dp-h1, .dp-h2, .dp-h3 { font-family: var(--dp-font-heading); letter-spacing: -0.045em; font-weight: 300; }
.dp-h1 { max-width: 740px; margin-bottom: 20px; font-size: clamp(44px, 6vw, 78px); line-height: 0.97; }
.dp-h2 { margin-bottom: 14px; font-size: clamp(30px, 3.4vw, 46px); line-height: 1.05; }
.dp-h3 { margin-bottom: 12px; font-size: clamp(21px, 2vw, 30px); line-height: 1.12; }
.dp-em { font-family: var(--dp-font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.04em; color: var(--dp-terracotta); }

.dp-copy { max-width: 620px; margin-bottom: 22px; color: rgba(34,39,33,0.70); font-size: clamp(15px, 1.15vw, 17px); font-weight: 300; line-height: 1.66; }

/* Buttons */
.dp-btn-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
.dp-btn {
  display: inline-flex; min-height: 48px; align-items: center; justify-content: center; gap: 8px;
  border: 1px solid var(--dp-ink); border-radius: 999px; padding: 14px 26px; background: transparent; color: var(--dp-ink);
  font-size: 12px; font-weight: 600; letter-spacing: 0.11em; line-height: 1; text-transform: uppercase; text-decoration: none;
  transition: transform 160ms ease, background 160ms ease, color 160ms ease, border-color 160ms ease;
}
.dp-btn:hover, .dp-btn:focus-visible { transform: translateY(-1px); background: var(--dp-ink); color: var(--dp-cream) !important; }
.dp-btn:hover *, .dp-btn:focus-visible * { color: var(--dp-cream) !important; }
.dp-btn--primary { border-color: var(--dp-sage); background: var(--dp-sage); color: var(--dp-ink); }
.dp-btn--primary:hover, .dp-btn--primary:focus-visible { border-color: var(--dp-ink); background: var(--dp-ink); color: var(--dp-cream) !important; }
.dp-btn--light { border-color: var(--dp-forest); background: var(--dp-forest); color: var(--dp-white); }
.dp-btn--light:hover { border-color: var(--dp-ink); background: var(--dp-ink); color: var(--dp-white); }

.dp-pill {
  display: inline-flex; align-items: center; min-height: 32px; border: 1px solid var(--dp-line);
  border-radius: 999px; padding: 7px 14px; background: rgba(255,255,255,0.5); color: rgba(34,39,33,0.7); font-size: 12px; line-height: 1;
}

/* HERO */
.dp-hero { position: relative; padding-top: clamp(48px, 6vw, 88px); padding-bottom: clamp(48px, 5vw, 72px); }
.dp-hero::before {
  content: ""; position: absolute; z-index: 0; width: 440px; height: 440px; top: 6%; right: -160px;
  border: 1px solid rgba(115,124,91,0.16); border-radius: 999px 999px 999px 28px; transform: rotate(18deg); pointer-events: none;
}
.dp-hero__grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0,1.05fr) minmax(340px,0.8fr); gap: clamp(34px,5vw,72px); align-items: center; }
.dp-hero__content { padding-top: 20px; }
.dp-hero__sub { max-width: 620px; margin-bottom: 26px; color: rgba(34,39,33,0.74); font-size: clamp(16px,1.4vw,20px); font-weight: 300; line-height: 1.55; }
.dp-hero__trust { display: flex; flex-wrap: wrap; gap: 10px; margin: 26px 0 0; }
.dp-hero__visual { position: relative; }
.dp-hero__media-card {
  position: relative; overflow: hidden; min-height: 520px; border-radius: 30px;
  background: radial-gradient(circle at 50% 28%, rgba(255,255,255,0.5), rgba(255,255,255,0) 70%), var(--dp-sage);
  box-shadow: 0 30px 70px rgba(34,39,33,0.13);
}
.dp-hero__image { display: block; width: 100%; height: 100%; min-height: 520px; object-fit: contain; object-position: center; padding: 22px; }
.dp-hero__placeholder { position: absolute; inset: 0; display: grid; place-items: center; }
.dp-logo-mark {
  display: inline-flex; align-items: center; justify-content: center; width: min(75%,300px); aspect-ratio: 1/1;
  border: 1px solid rgba(255,255,255,0.48); border-radius: 42% 58% 48% 52% / 56% 44% 56% 44%;
  background: rgba(250,250,245,0.18); color: var(--dp-white); font-size: clamp(34px,4vw,54px); font-weight: 300; letter-spacing: 0.36em; text-indent: 0.36em;
}

/* PROOF BAND (in hero) */
.dp-proof-band { margin-top: 34px; border-radius: 22px; padding: clamp(20px,3vw,30px); background: rgba(255,255,255,0.55); border: 1px solid var(--dp-line); box-shadow: var(--dp-shadow-sm); }
.dp-proof-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 14px; }
.dp-proof-item { border-left: 1px solid var(--dp-line-warm); padding-left: 18px; }
.dp-proof-item:first-child { border-left: 0; padding-left: 0; }
.dp-proof-item strong { display: block; margin-bottom: 6px; color: var(--dp-forest); font-size: clamp(20px,2.4vw,32px); font-weight: 400; letter-spacing: -0.045em; line-height: 1; }
.dp-proof-item span { display: block; color: rgba(34,39,33,0.62); font-size: 12px; font-weight: 500; letter-spacing: 0.05em; line-height: 1.4; text-transform: uppercase; }

/* PROBLEM → horizontal numbered rows */
.dp-why .dp-copy { max-width: 720px; }
.dp-card-grid { display: grid; grid-template-columns: 1fr; gap: 0; margin-top: 34px; }
.dp-info-card {
  display: grid; grid-template-columns: 56px minmax(0,1fr); column-gap: clamp(20px,3vw,40px);
  align-items: start; padding: clamp(22px,3vw,32px) 0; border-top: 1px solid var(--dp-line);
}
.dp-info-card:first-child { border-top: 0; }
.dp-info-card__icon {
  grid-row: 1 / span 2; align-self: start; display: grid; place-items: center; width: 44px; height: 44px;
  border-radius: 999px; background: var(--dp-frost); color: var(--dp-forest); font-family: var(--dp-font-serif); font-style: italic; font-size: 20px;
}
.dp-info-card__title { grid-column: 2; margin: 0 0 8px; font-size: clamp(20px,2vw,26px); font-weight: 300; letter-spacing: -0.03em; line-height: 1.15; }
.dp-info-card__copy { grid-column: 2; margin: 0; max-width: 620px; color: rgba(34,39,33,0.66); font-size: 15px; line-height: 1.6; }

/* SOLUTION → asymmetric split, focal panel */
.dp-solution-header { max-width: 820px; margin: 0 0 clamp(28px,4vw,44px); }
.dp-solution-header .dp-copy { max-width: 720px; }
.dp-solution-grid { display: grid; grid-template-columns: minmax(0,0.92fr) minmax(0,1.08fr); gap: clamp(28px,5vw,64px); align-items: stretch; }
.dp-solution-panel { display: flex; align-items: stretch; }
.dp-solution-panel .dp-mini-grid { width: 100%; margin-top: 0; }
.dp-mini-grid { display: grid; grid-template-columns: 1fr; gap: 0; }
.dp-mini { padding: clamp(18px,2.4vw,24px) 0; border-top: 1px solid rgba(34,39,33,0.12); }
.dp-mini:first-child { border-top: 0; padding-top: 0; }
.dp-mini__title { margin: 0 0 8px; color: var(--dp-ink); font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
.dp-mini__copy { margin: 0; color: rgba(34,39,33,0.68); font-size: 14px; line-height: 1.6; }

.dp-ingredient-card {
  position: relative; overflow: hidden; min-height: 100%; border-radius: var(--dp-radius); padding: clamp(30px,4vw,52px);
  background: radial-gradient(circle at 92% 0%, rgba(255,255,255,0.45), transparent 38%), var(--dp-pale);
}
.dp-ingredient-card::after { content: ""; position: absolute; width: 220px; height: 220px; right: -70px; bottom: -70px; border: 1px solid rgba(170,122,107,0.22); border-radius: 44% 56% 42% 58%; transform: rotate(20deg); }
.dp-check-list { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
.dp-check-list li { display: flex; gap: 12px; align-items: flex-start; color: rgba(34,39,33,0.76); font-size: 14px; line-height: 1.55; }
.dp-check-list li::before { content: ""; flex: 0 0 8px; width: 8px; height: 8px; margin-top: 7px; border-radius: 999px; background: var(--dp-forest); }

/* PROOF → centered intro + staggered pull-quotes */
.dp-testimonials { text-align: center; }
.dp-testimonials .dp-kicker { justify-content: center; }
.dp-testimonials .dp-kicker::before { display: none; }
.dp-testimonials .dp-h2 { margin-inline: auto; max-width: 720px; }
.dp-quote-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: clamp(28px,5vw,56px); margin-top: 42px; text-align: left; }
.dp-quote { position: relative; padding: 26px 0 0; }
.dp-quote::before { content: "\201C"; display: block; margin-bottom: -18px; color: var(--dp-rose); font-family: var(--dp-font-serif); font-style: italic; font-size: 72px; line-height: 1; }
.dp-quote-grid .dp-quote:nth-child(even) { margin-top: clamp(0px,4vw,56px); }
.dp-quote__text { margin: 0 0 18px; color: rgba(34,39,33,0.82); font-family: var(--dp-font-serif); font-size: clamp(18px,1.6vw,22px); font-style: italic; line-height: 1.5; letter-spacing: -0.02em; }
.dp-quote__name { margin: 0 0 4px; color: var(--dp-forest); font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }
.dp-quote__role { margin: 0; color: rgba(34,39,33,0.56); font-size: 12px; line-height: 1.4; }

/* OFFER → single shell: benefits + steps */
.dp-how-pricing__shell {
  position: relative; overflow: hidden; border-radius: 30px; padding: clamp(32px,5vw,62px);
  background: radial-gradient(circle at 90% 8%, rgba(211,231,192,0.28), transparent 30%), rgba(255,255,255,0.62);
  border: 1px solid var(--dp-line); box-shadow: var(--dp-shadow);
}
.dp-offer-intro { max-width: 760px; margin-bottom: clamp(24px,3.5vw,38px); }
.dp-offer-intro .dp-copy { max-width: 700px; margin-bottom: 0; }
.dp-benefit-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: clamp(18px,2.5vw,30px); align-items: start; }
.dp-benefit { border-top: 1px solid var(--dp-line); padding: 20px 0 0; }
.dp-benefit strong { display: block; margin-bottom: 10px; color: var(--dp-ink); font-size: 13px; font-weight: 700; letter-spacing: 0.08em; line-height: 1.25; text-transform: uppercase; }
.dp-benefit span { display: block; color: rgba(34,39,33,0.64); font-size: 14px; line-height: 1.56; }
.dp-offer-fine { margin: 18px 0 0; color: rgba(34,39,33,0.46); font-size: 11px; line-height: 1.5; }
.dp-divider { width: 100%; height: 1px; margin: clamp(32px,5vw,52px) 0; background: var(--dp-line); }
.dp-steps-head { max-width: 600px; margin-bottom: clamp(20px,3vw,30px); }
.dp-steps-head .dp-h3 { margin-bottom: 0; font-size: clamp(24px,2.6vw,38px); font-weight: 300; letter-spacing: -0.045em; }
.dp-steps { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: clamp(18px,2.5vw,32px); }
.dp-step { border-top: 1px solid var(--dp-line); padding: 20px 0 0; }
.dp-step__num { display: grid; place-items: center; width: 38px; height: 38px; margin-bottom: 18px; border-radius: 999px; background: var(--dp-frost); color: var(--dp-forest); font-family: var(--dp-font-serif); font-size: 17px; font-style: italic; line-height: 1; }
.dp-step__title { margin: 0 0 8px; color: var(--dp-ink); font-size: 17px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; }
.dp-step__copy { margin: 0; color: rgba(34,39,33,0.64); font-size: 13px; line-height: 1.56; }

/* CTA / FORM */
.dp-form-shell { display: grid; grid-template-columns: minmax(0,0.82fr) minmax(0,1.18fr); gap: clamp(30px,5vw,64px); align-items: start; }
.dp-form { background: rgba(255,255,255,0.85); border: 1px solid var(--dp-line); border-radius: 28px; box-shadow: var(--dp-shadow); padding: clamp(24px,4vw,42px); }
.dp-form :where(input, select, textarea, button, label, p, span, a, div) { font-family: var(--dp-font-sans) !important; }
.dp-note { margin-top: 18px; border-left: 2px solid var(--dp-terracotta); padding-left: 16px; color: rgba(34,39,33,0.6); font-size: 12px; line-height: 1.58; }

/* FAQ */
.dp-faq .dp-wrap { padding: clamp(28px,4vw,48px); border-radius: 28px; background: rgba(255,255,255,0.5); border: 1px solid var(--dp-line); }
.dp-faq-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 16px clamp(24px,4vw,44px); margin-top: 32px; }
.dp-faq-item { border-top: 1px solid var(--dp-line); padding-top: 20px; }
.dp-faq-item h3 { margin: 0 0 8px; font-size: 17px; font-weight: 500; letter-spacing: -0.02em; }
.dp-faq-item p { margin: 0; color: rgba(34,39,33,0.64); font-size: 14px; line-height: 1.6; }

/* FINAL CTA */
.dp-final { position: relative; padding: clamp(58px,6.5vw,92px) 0; background: var(--dp-cream); text-align: center; }
.dp-final .dp-wrap { max-width: 840px; padding: clamp(36px,5vw,58px); border: 1px solid var(--dp-line-warm); border-radius: 28px; background: rgba(255,255,255,0.55); box-shadow: var(--dp-shadow); }
.dp-final .dp-copy { margin-inline: auto; color: rgba(34,39,33,0.66); }

/* MOTION */
@media (prefers-reduced-motion: no-preference) {
  .dp-hero__content .dp-kicker,
  .dp-hero__content .dp-h1,
  .dp-hero__content .dp-hero__sub,
  .dp-hero__content .dp-btn-row,
  .dp-hero__content .dp-hero__trust,
  .dp-hero__visual { animation: dp-fade 0.7s cubic-bezier(0.2,0.7,0.2,1) both; }
  .dp-hero__content .dp-h1 { animation-delay: 0.06s; }
  .dp-hero__content .dp-hero__sub { animation-delay: 0.12s; }
  .dp-hero__content .dp-btn-row { animation-delay: 0.18s; }
  .dp-hero__content .dp-hero__trust { animation-delay: 0.24s; }
  .dp-hero__visual { animation-delay: 0.1s; }
  @keyframes dp-fade { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
}
@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    .dp-info-card, .dp-mini, .dp-quote, .dp-benefit, .dp-step, .dp-faq-item {
      animation: dp-rise linear both; animation-timeline: view(); animation-range: entry 0% entry 40%;
    }
    @keyframes dp-rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  }
}

/* RESPONSIVE */
@media (max-width: 990px) {
  .dp-hero__grid, .dp-form-shell { grid-template-columns: 1fr; }
  .dp-hero__media-card, .dp-hero__image { min-height: 420px; height: 420px; }
  .dp-solution-grid { grid-template-columns: 1fr; }
}
@media (max-width: 1100px) {
  .dp-benefit-grid, .dp-steps { grid-template-columns: repeat(2, minmax(0,1fr)); }
}
@media (max-width: 990px) {
  .dp-proof-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .dp-proof-item:nth-child(3) { border-left: 0; padding-left: 0; }
}
@media (max-width: 680px) {
  .dp-wrap { width: min(100% - 28px, var(--dp-max)); }
  .dp-h1 { font-size: clamp(40px,13vw,58px); }
  .dp-btn-row, .dp-btn { width: 100%; }
  .dp-hero { padding-top: 40px; padding-bottom: 44px; }
  .dp-hero__media-card, .dp-hero__image { min-height: 340px; height: 340px; border-radius: 24px; }
  .dp-section { padding: 50px 0; }
  .dp-form, .dp-faq .dp-wrap, .dp-final .dp-wrap, .dp-how-pricing__shell, .dp-ingredient-card { border-radius: 22px; }
  .dp-how-pricing__shell { padding: 30px 18px; }
  .dp-quote-grid, .dp-faq-grid, .dp-benefit-grid, .dp-steps, .dp-proof-grid { grid-template-columns: 1fr; }
  .dp-quote-grid .dp-quote:nth-child(even) { margin-top: 0; }
  .dp-info-card { grid-template-columns: 44px minmax(0,1fr); column-gap: 16px; padding: 20px 0; }
  .dp-proof-item, .dp-proof-item:nth-child(3) { border-left: 0; border-top: 1px solid var(--dp-line-warm); padding-top: 14px; padding-left: 0; }
  .dp-proof-item:first-child { border-top: 0; padding-top: 0; }
  .dp-final { padding: 50px 0; }
  .dp-final .dp-wrap { width: min(100% - 28px, var(--dp-max)); padding: 32px 22px; }
}
</style>

<main class="dp-page" id="dental-pros-page">

  <!-- 1 · HERO -->
  <section class="dp-hero" aria-label="Boka Dental Pros">
    <div class="dp-wrap">
      <div class="dp-hero__grid">
        <div class="dp-hero__content">
          {% if section.settings.hero_kicker != blank %}<span class="dp-kicker">{{ section.settings.hero_kicker }}</span>{% endif %}
          {% if section.settings.hero_heading != blank %}<h1 class="dp-h1">{{ section.settings.hero_heading }}</h1>{% endif %}
          {% if section.settings.hero_text != blank %}<p class="dp-hero__sub">{{ section.settings.hero_text }}</p>{% endif %}
          <div class="dp-btn-row">
            {% if section.settings.hero_primary_label != blank %}<a class="dp-btn dp-btn--primary" href="{{ section.settings.hero_primary_link }}">{{ section.settings.hero_primary_label }}</a>{% endif %}
            {% if section.settings.hero_secondary_label != blank %}<a class="dp-btn" href="{{ section.settings.hero_secondary_link }}">{{ section.settings.hero_secondary_label }}</a>{% endif %}
          </div>
          <div class="dp-hero__trust" aria-label="Program highlights">
            {% for block in section.blocks %}{% if block.type == 'hero_pill' %}<span class="dp-pill" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{% endif %}{% endfor %}
          </div>
        </div>
        <div class="dp-hero__visual">
          <div class="dp-hero__media-card">
            {% if section.settings.hero_image != blank %}
              {{ section.settings.hero_image | image_url: width: 1400 | image_tag: class: 'dp-hero__image', loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_image_alt }}
            {% elsif section.settings.hero_image_url != blank %}
              <img class="dp-hero__image" src="{{ section.settings.hero_image_url }}" alt="{{ section.settings.hero_image_alt | escape }}" loading="eager" fetchpriority="high" width="900" height="1100">
            {% else %}
              <div class="dp-hero__placeholder" aria-hidden="true"><div class="dp-logo-mark">BOKA</div></div>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="dp-proof-band" aria-label="Proof points">
        <div class="dp-proof-grid">
          {% for block in section.blocks %}{% if block.type == 'proof_stat' %}
            <div class="dp-proof-item" {{ block.shopify_attributes }}>
              {% if block.settings.stat != blank %}<strong>{{ block.settings.stat }}</strong>{% endif %}
              {% if block.settings.label != blank %}<span>{{ block.settings.label }}</span>{% endif %}
            </div>
          {% endif %}{% endfor %}
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · PROBLEM -->
  <section class="dp-section dp-why" id="problem" aria-label="Why patients need your recommendation">
    <div class="dp-wrap">
      {% if section.settings.problem_kicker != blank %}<span class="dp-kicker">{{ section.settings.problem_kicker }}</span>{% endif %}
      {% if section.settings.problem_heading != blank %}<h2 class="dp-h2">{{ section.settings.problem_heading }}</h2>{% endif %}
      {% if section.settings.problem_text != blank %}<p class="dp-copy">{{ section.settings.problem_text }}</p>{% endif %}
      <div class="dp-card-grid">
        {% for block in section.blocks %}{% if block.type == 'problem_point' %}
          <article class="dp-info-card" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}<div class="dp-info-card__icon">{{ block.settings.icon }}</div>{% endif %}
            {% if block.settings.title != blank %}<h3 class="dp-info-card__title">{{ block.settings.title }}</h3>{% endif %}
            {% if block.settings.text != blank %}<p class="dp-info-card__copy">{{ block.settings.text }}</p>{% endif %}
          </article>
        {% endif %}{% endfor %}
      </div>
    </div>
  </section>

  <!-- 3 · SOLUTION -->
  <section class="dp-section" id="solution" aria-label="What Boka is">
    <div class="dp-wrap">
      <div class="dp-solution-header">
        {% if section.settings.solution_kicker != blank %}<span class="dp-kicker">{{ section.settings.solution_kicker }}</span>{% endif %}
        {% if section.settings.solution_heading != blank %}<h2 class="dp-h2">{{ section.settings.solution_heading }}</h2>{% endif %}
        {% if section.settings.solution_text != blank %}<p class="dp-copy">{{ section.settings.solution_text }}</p>{% endif %}
      </div>
      <div class="dp-solution-grid">
        <div class="dp-solution-panel">
          <div class="dp-mini-grid">
            {% for block in section.blocks %}{% if block.type == 'solution_point' %}
              <div class="dp-mini" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}<p class="dp-mini__title">{{ block.settings.title }}</p>{% endif %}
                {% if block.settings.text != blank %}<p class="dp-mini__copy">{{ block.settings.text }}</p>{% endif %}
              </div>
            {% endif %}{% endfor %}
          </div>
        </div>
        <div class="dp-ingredient-card">
          {% if section.settings.ingredient_kicker != blank %}<span class="dp-kicker">{{ section.settings.ingredient_kicker }}</span>{% endif %}
          {% if section.settings.ingredient_heading != blank %}<h3 class="dp-h3">{{ section.settings.ingredient_heading }}</h3>{% endif %}
          <ul class="dp-check-list">
            {% for block in section.blocks %}{% if block.type == 'ingredient_bullet' %}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{% endif %}{% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · PROOF -->
  <section class="dp-section dp-testimonials" aria-label="Professional proof">
    <div class="dp-wrap">
      {% if section.settings.proof_kicker != blank %}<span class="dp-kicker">{{ section.settings.proof_kicker }}</span>{% endif %}
      {% if section.settings.proof_heading != blank %}<h2 class="dp-h2">{{ section.settings.proof_heading }}</h2>{% endif %}
      <div class="dp-quote-grid">
        {% for block in section.blocks %}{% if block.type == 'quote' %}
          <article class="dp-quote" {{ block.shopify_attributes }}>
            {% if block.settings.quote != blank %}<p class="dp-quote__text">{{ block.settings.quote }}</p>{% endif %}
            {% if block.settings.name != blank %}<p class="dp-quote__name">{{ block.settings.name }}</p>{% endif %}
            {% if block.settings.role != blank %}<p class="dp-quote__role">{{ block.settings.role }}</p>{% endif %}
          </article>
        {% endif %}{% endfor %}
      </div>
    </div>
  </section>

  <!-- 5 · OFFER -->
  <section class="dp-section dp-how-pricing" id="program" aria-label="The Dental Pros Program">
    <div class="dp-wrap">
      <div class="dp-how-pricing__shell">
        <div class="dp-offer-intro">
          {% if section.settings.offer_kicker != blank %}<span class="dp-kicker">{{ section.settings.offer_kicker }}</span>{% endif %}
          {% if section.settings.offer_heading != blank %}<h2 class="dp-h2">{{ section.settings.offer_heading }}</h2>{% endif %}
          {% if section.settings.offer_text != blank %}<p class="dp-copy">{{ section.settings.offer_text }}</p>{% endif %}
        </div>

        <div class="dp-benefit-grid" aria-label="Program benefits">
          {% for block in section.blocks %}{% if block.type == 'benefit' %}
            <article class="dp-benefit" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}<strong>{{ block.settings.title }}</strong>{% endif %}
              {% if block.settings.text != blank %}<span>{{ block.settings.text }}</span>{% endif %}
            </article>
          {% endif %}{% endfor %}
        </div>

        {% if section.settings.offer_fine != blank %}<p class="dp-offer-fine">{{ section.settings.offer_fine }}</p>{% endif %}

        <div class="dp-divider" aria-hidden="true"></div>

        <div class="dp-steps-head">
          {% if section.settings.steps_kicker != blank %}<span class="dp-kicker">{{ section.settings.steps_kicker }}</span>{% endif %}
          {% if section.settings.steps_heading != blank %}<h3 class="dp-h3">{{ section.settings.steps_heading }}</h3>{% endif %}
        </div>

        <div class="dp-steps" aria-label="How it works">
          {% for block in section.blocks %}{% if block.type == 'how_step' %}
            <article class="dp-step" {{ block.shopify_attributes }}>
              {% if block.settings.number != blank %}<span class="dp-step__num">{{ block.settings.number }}</span>{% endif %}
              {% if block.settings.title != blank %}<h4 class="dp-step__title">{{ block.settings.title }}</h4>{% endif %}
              {% if block.settings.text != blank %}<p class="dp-step__copy">{{ block.settings.text }}</p>{% endif %}
            </article>
          {% endif %}{% endfor %}
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · CTA / APPLY -->
  <section class="dp-section dp-signup" id="apply" aria-label="Apply to the Dental Pros Program">
    <div class="dp-wrap">
      <div class="dp-form-shell">
        <div>
          {% if section.settings.form_kicker != blank %}<span class="dp-kicker">{{ section.settings.form_kicker }}</span>{% endif %}
          {% if section.settings.form_heading != blank %}<h2 class="dp-h2">{{ section.settings.form_heading }}</h2>{% endif %}
          {% if section.settings.form_text != blank %}<p class="dp-copy">{{ section.settings.form_text }}</p>{% endif %}
          <ul class="dp-check-list">
            {% for block in section.blocks %}{% if block.type == 'form_bullet' %}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{% endif %}{% endfor %}
          </ul>
          {% if section.settings.form_note != blank %}<p class="dp-note">{{ section.settings.form_note }}</p>{% endif %}
        </div>
        <div class="dp-form">
          <div class="klaviyo-form-VvZypp"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ (objection handling) -->
  <section class="dp-section dp-faq" aria-label="FAQ">
    <div class="dp-wrap">
      {% if section.settings.faq_kicker != blank %}<span class="dp-kicker">{{ section.settings.faq_kicker }}</span>{% endif %}
      {% if section.settings.faq_heading != blank %}<h2 class="dp-h2">{{ section.settings.faq_heading }}</h2>{% endif %}
      <div class="dp-faq-grid">
        {% for block in section.blocks %}{% if block.type == 'faq' %}
          <div class="dp-faq-item" {{ block.shopify_attributes }}>
            {% if block.settings.question != blank %}<h3>{{ block.settings.question }}</h3>{% endif %}
            {% if block.settings.answer != blank %}<p>{{ block.settings.answer }}</p>{% endif %}
          </div>
        {% endif %}{% endfor %}
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="dp-final" aria-label="Final call to action">
    <div class="dp-wrap">
      {% if section.settings.final_heading != blank %}<h2 class="dp-h2">{{ section.settings.final_heading }}</h2>{% endif %}
      {% if section.settings.final_text != blank %}<p class="dp-copy">{{ section.settings.final_text }}</p>{% endif %}
      <div class="dp-btn-row" style="justify-content:center;">
        {% if section.settings.final_button_label != blank %}<a class="dp-btn dp-btn--light" href="{{ section.settings.final_button_link }}">{{ section.settings.final_button_label }}</a>{% endif %}
      </div>
    </div>
  </section>

</main>

