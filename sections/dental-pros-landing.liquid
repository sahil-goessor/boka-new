
<style>
:root {
  --dp-ink: #222721;
  --dp-forest: #737c5b;
  --dp-sage: #a5bc8b;
  --dp-mint: #bfd6a5;
  --dp-pale: #d3e7c0;
  --dp-frost: #e6f4d4;
  --dp-cream: #fafaf5;
  --dp-porcelain: #f7f7f0;
  --dp-white: #ffffff;
  --dp-petal: #f9e5db;
  --dp-rose: #efd5ca;
  --dp-terracotta: #aa7a6b;
  --dp-stone: #c1beb0;
  --dp-warm-gray: #8c8773;
  --dp-line: rgba(34, 39, 33, 0.10);
  --dp-line-warm: rgba(170, 122, 107, 0.28);
  --dp-tint-sage: rgba(211, 231, 192, 0.20);
  --dp-tint-warm: rgba(249, 229, 219, 0.24);
  --dp-shadow: 0 18px 50px rgba(34, 39, 33, 0.06);
  --dp-shadow-sm: 0 10px 30px rgba(34, 39, 33, 0.045);
  --dp-radius: 20px;
  --dp-radius-sm: 14px;
  --dp-max: 1120px;
  --dp-font-sans: var(--font-body-family), 'Neue Haas Unica W1G', Helvetica, Arial, sans-serif;
  --dp-font-heading: var(--font-heading-family), var(--dp-font-sans);
  --dp-font-serif: Georgia, 'Times New Roman', serif;
}

.dp-page, .dp-page * { box-sizing: border-box; }

.dp-page {
  margin: 0;
  overflow: hidden;
  color: var(--dp-ink);
  font-family: var(--dp-font-sans);
  letter-spacing: -0.01em;
  background:
    radial-gradient(circle at 88% 3%, rgba(191, 214, 165, 0.14), transparent 42%),
    radial-gradient(circle at 5% 26%, rgba(249, 229, 219, 0.16), transparent 38%),
    var(--dp-cream);
}

.dp-page :where(h1, h2, h3, h4, h5, h6, p, span, a, li, label, input, select, textarea, button) {
  font-family: var(--dp-font-sans);
}
.dp-page :where(.dp-h1, .dp-h2, .dp-h3) { font-family: var(--dp-font-heading); }
.dp-page a { color: inherit; }

.dp-wrap { width: min(var(--dp-max), calc(100% - 44px)); margin-inline: auto; }
.dp-section { padding: clamp(56px, 5.8vw, 92px) 0; }

/* Section rhythm */
#what-is-boka { background: var(--dp-tint-sage); }
.dp-signup    { background: var(--dp-tint-warm); }

.dp-kicker {
  display: inline-flex; align-items: center; gap: 10px;
  margin: 0 0 16px;
  font-size: 11px; font-weight: 600; line-height: 1;
  letter-spacing: 0.18em; color: var(--dp-forest); text-transform: uppercase;
}
.dp-kicker::before { content: ""; width: 28px; height: 1px; background: var(--dp-terracotta); opacity: 0.6; }

/* NEW — numbered argument labels */
.dp-step-label {
  display: inline-block; margin: 0 0 14px;
  font-family: var(--dp-font-sans); font-size: 11px; font-weight: 700;
  letter-spacing: 0.18em; text-transform: uppercase; color: var(--dp-terracotta);
}

.dp-h1, .dp-h2, .dp-h3, .dp-page p { margin-block-start: 0; }
.dp-h1, .dp-h2, .dp-h3 { font-family: var(--dp-font-heading); letter-spacing: -0.045em; font-weight: 300; }

.dp-h1 { max-width: 760px; margin-bottom: 22px; font-size: clamp(44px, 6vw, 80px); line-height: 0.96; }
.dp-h2 { margin-bottom: 16px; font-size: clamp(30px, 3.4vw, 46px); line-height: 1.05; }
.dp-h3 { margin-bottom: 12px; font-size: clamp(21px, 2vw, 30px); line-height: 1.12; }

.dp-em { font-family: var(--dp-font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.04em; color: var(--dp-terracotta); }

.dp-copy { max-width: 640px; margin-bottom: 22px; color: rgba(34, 39, 33, 0.70); font-size: clamp(15px, 1.15vw, 17px); font-weight: 300; line-height: 1.68; }
.dp-copy--sm { font-size: 14px; line-height: 1.62; }

/* Buttons */
.dp-btn-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
.dp-btn {
  display: inline-flex; min-height: 48px; align-items: center; justify-content: center; gap: 8px;
  border: 1px solid var(--dp-ink); border-radius: 999px; padding: 14px 26px;
  background: transparent; color: var(--dp-ink);
  font-size: 12px; font-weight: 600; letter-spacing: 0.11em; line-height: 1; text-transform: uppercase; text-decoration: none;
  transition: transform 160ms ease, background 160ms ease, color 160ms ease, border-color 160ms ease;
}
.dp-btn:hover, .dp-btn:focus-visible { transform: translateY(-1px); background: var(--dp-ink); color: var(--dp-cream) !important; }
.dp-btn:hover *, .dp-btn:focus-visible * { color: var(--dp-cream) !important; }
.dp-btn--primary { border-color: var(--dp-sage); background: var(--dp-sage); color: var(--dp-ink); }
.dp-btn--primary:hover, .dp-btn--primary:focus-visible { border-color: var(--dp-ink); background: var(--dp-ink); color: var(--dp-cream) !important; }
.dp-btn--primary:hover *, .dp-btn--primary:focus-visible * { color: var(--dp-cream) !important; }
.dp-btn--light { border-color: rgba(255, 255, 255, 0.7); color: var(--dp-white); }
.dp-btn--light:hover { border-color: var(--dp-white); background: var(--dp-white); color: var(--dp-ink); }

.dp-pill {
  display: inline-flex; align-items: center; min-height: 32px;
  border: 1px solid var(--dp-line); border-radius: 999px; padding: 7px 14px;
  background: rgba(255, 255, 255, 0.5); color: rgba(34, 39, 33, 0.7); font-size: 12px; line-height: 1;
}

/* HERO */
.dp-hero { position: relative; padding-top: clamp(48px, 6vw, 88px); background: transparent; }
.dp-hero::before {
  content: ""; position: absolute; z-index: 0;
  width: 460px; height: 460px; top: 6%; right: -160px;
  border: 1px solid rgba(115, 124, 91, 0.16);
  border-radius: 999px 999px 999px 28px; transform: rotate(18deg); pointer-events: none;
}
.dp-hero__grid {
  position: relative; z-index: 1; display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.8fr);
  gap: clamp(34px, 5vw, 72px); align-items: center;
}
.dp-hero__content { padding-top: 28px; }
.dp-hero__sub { max-width: 660px; margin-bottom: 26px; color: rgba(34, 39, 33, 0.74); font-size: clamp(16px, 1.4vw, 20px); font-weight: 300; line-height: 1.6; }
.dp-hero__trust { display: flex; flex-wrap: wrap; gap: 10px; margin: 28px 0 0; }
.dp-hero__visual { position: relative; }
.dp-hero__media-card {
  position: relative; overflow: hidden; min-height: 540px; border-radius: 30px;
  background: radial-gradient(circle at 50% 28%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 70%), var(--dp-sage);
  box-shadow: 0 30px 70px rgba(34, 39, 33, 0.13);
}
.dp-hero__image { display: block; width: 100%; height: 100%; min-height: 540px; object-fit: contain; object-position: center; padding: 22px; }
.dp-hero__placeholder { position: absolute; inset: 0; display: grid; place-items: center; padding: 38px; text-align: center; }
.dp-logo-mark {
  display: inline-flex; align-items: center; justify-content: center;
  width: min(75%, 300px); aspect-ratio: 1 / 1;
  border: 1px solid rgba(255, 255, 255, 0.48); border-radius: 42% 58% 48% 52% / 56% 44% 56% 44%;
  background: rgba(250, 250, 245, 0.18); color: var(--dp-white);
  font-size: clamp(34px, 4vw, 54px); font-weight: 300; letter-spacing: 0.36em; text-indent: 0.36em;
}

/* PROOF BAND (in hero) */
.dp-proof-band {
  margin-top: 36px; border-radius: 24px; padding: clamp(22px, 3vw, 32px);
  background: rgba(255, 255, 255, 0.55); border: 1px solid var(--dp-line); box-shadow: var(--dp-shadow-sm);
}
.dp-proof-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
.dp-proof-item { border-left: 1px solid var(--dp-line-warm); padding-left: 18px; }
.dp-proof-item:first-child { border-left: 0; padding-left: 0; }
.dp-proof-item strong { display: block; margin-bottom: 6px; color: var(--dp-forest); font-size: clamp(21px, 2.4vw, 34px); font-weight: 400; letter-spacing: -0.045em; line-height: 1; }
.dp-proof-item span { display: block; color: rgba(34, 39, 33, 0.62); font-size: 12px; font-weight: 500; letter-spacing: 0.06em; line-height: 1.4; text-transform: uppercase; }

/* WHAT IS BOKA → succinct two-column solution flow */
#what-is-boka {
  background:
    radial-gradient(circle at 84% 18%, rgba(211, 231, 192, 0.22), transparent 34%),
    radial-gradient(circle at 8% 88%, rgba(249, 229, 219, 0.14), transparent 32%),
    transparent;
}
.dp-solution-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.98fr) minmax(340px, 0.92fr);
  gap: clamp(38px, 6vw, 88px);
  align-items: center;
}
.dp-solution-copy { min-width: 0; }
.dp-solution-header { max-width: 700px; margin: 0 0 clamp(28px, 4vw, 44px); }
.dp-solution-header .dp-h2 { max-width: 680px; margin-bottom: 18px; font-size: clamp(36px, 4.7vw, 64px); line-height: 0.98; }
.dp-solution-header .dp-copy { max-width: 640px; margin-bottom: 0; }

.dp-mini-grid { display: grid; grid-template-columns: 1fr; gap: 0; max-width: 640px; }
.dp-mini {
  position: relative; display: grid;
  grid-template-columns: 74px minmax(0, 1fr);
  grid-template-areas: "icon title" "icon copy";
  column-gap: clamp(18px, 2.5vw, 30px); align-items: center;
  padding: clamp(20px, 2.7vw, 30px) 0; border-top: 1px solid rgba(34, 39, 33, 0.11);
  background: none; border-radius: 0; box-shadow: none;
}
.dp-mini:first-child { border-top: 0; padding-top: 0; }
.dp-mini::before {
  content: "✓"; grid-area: icon; display: grid; place-items: center;
  width: 58px; height: 58px; border-radius: 999px;
  background: rgba(255, 255, 255, 0.58); border: 1px solid rgba(115, 124, 91, 0.13);
  color: var(--dp-forest); font-size: 22px; font-weight: 500; line-height: 1;
}
.dp-mini:nth-child(2)::before { content: "↔"; }
.dp-mini:nth-child(3)::before { content: "✦"; }
.dp-mini:nth-child(4)::before { content: "•"; }
.dp-mini__title { grid-area: title; margin: 0 0 8px; color: var(--dp-ink); font-size: clamp(17px, 1.55vw, 21px); font-weight: 600; letter-spacing: -0.03em; line-height: 1.18; text-transform: none; }
.dp-mini__copy { grid-area: copy; margin: 0; max-width: 520px; color: rgba(34, 39, 33, 0.66); font-size: 15px; font-weight: 300; line-height: 1.55; }

.dp-card, .dp-ingredient-card { background: var(--dp-pale); border: 0; border-radius: var(--dp-radius); box-shadow: none; }
.dp-ingredient-card {
  position: relative; overflow: hidden; min-height: clamp(520px, 48vw, 620px);
  display: flex; flex-direction: column; justify-content: center; padding: clamp(36px, 5.2vw, 70px);
  background:
    radial-gradient(circle at 18% 12%, rgba(255, 255, 255, 0.52), transparent 34%),
    radial-gradient(circle at 92% 8%, rgba(255, 255, 255, 0.28), transparent 30%),
    var(--dp-pale);
  border-radius: clamp(22px, 2.5vw, 34px);
}
.dp-ingredient-card::after {
  content: ""; position: absolute; width: 300px; height: 300px; right: -118px; bottom: -118px;
  border: 1px solid rgba(255, 255, 255, 0.55); border-radius: 999px;
  box-shadow: -34px -34px 0 -1px transparent, -34px -34px 0 0 rgba(255,255,255,.28), -68px -68px 0 -1px transparent, -68px -68px 0 0 rgba(255,255,255,.22);
  pointer-events: none;
}
.dp-ingredient-card > * { position: relative; z-index: 1; }
.dp-ingredient-card .dp-kicker { margin-bottom: clamp(22px, 3vw, 34px); }
.dp-ingredient-card .dp-h3 { max-width: 460px; margin-bottom: clamp(26px, 4vw, 42px); font-size: clamp(30px, 3.35vw, 48px); line-height: 1.04; }

.dp-check-list { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
.dp-check-list li { display: flex; gap: 12px; align-items: flex-start; color: rgba(34, 39, 33, 0.76); font-size: 14px; line-height: 1.55; }
.dp-check-list li::before { content: ""; flex: 0 0 8px; width: 8px; height: 8px; margin-top: 7px; border-radius: 999px; background: var(--dp-forest); }
.dp-ingredient-card .dp-check-list { gap: 0; max-width: 520px; }
.dp-ingredient-card .dp-check-list li { gap: 18px; align-items: center; min-height: 62px; padding: 14px 0; border-top: 1px solid rgba(34, 39, 33, 0.10); color: rgba(34, 39, 33, 0.74); font-size: clamp(14px, 1.18vw, 16px); font-weight: 300; line-height: 1.38; }
.dp-ingredient-card .dp-check-list li:first-child { border-top: 0; }
.dp-ingredient-card .dp-check-list li::before { content: "✓"; display: grid; place-items: center; flex: 0 0 34px; width: 34px; height: 34px; margin-top: 0; border-radius: 999px; background: var(--dp-forest); color: var(--dp-white); font-size: 17px; font-weight: 700; line-height: 1; }

/* PROBLEM → horizontal numbered rows */
.dp-why { background: transparent; }
.dp-why .dp-copy { max-width: 760px; }
.dp-card-grid { display: grid; grid-template-columns: 1fr; gap: 0; margin-top: 36px; }
.dp-info-card {
  background: none; border: 0; box-shadow: none; border-radius: 0;
  display: grid; grid-template-columns: 56px minmax(0, 1fr); column-gap: clamp(20px, 3vw, 40px);
  align-items: start; padding: clamp(24px, 3vw, 34px) 0; border-top: 1px solid var(--dp-line);
}
.dp-info-card:first-child { border-top: 0; }
.dp-info-card__icon {
  grid-row: 1 / span 2; align-self: start; display: grid; place-items: center; width: 44px; height: 44px; margin: 0;
  border-radius: 999px; background: var(--dp-frost); color: var(--dp-forest); font-family: var(--dp-font-serif); font-style: italic; font-size: 20px;
}
.dp-info-card__title { grid-column: 2; margin: 0 0 8px; font-size: clamp(20px, 2vw, 26px); font-weight: 300; letter-spacing: -0.03em; line-height: 1.15; }
.dp-info-card__copy { grid-column: 2; margin: 0; max-width: 640px; color: rgba(34, 39, 33, 0.66); font-size: 15px; line-height: 1.62; }

/* SOLUTION → retail dominance, ink anchor band (on-brand) */
.dp-retail { background: var(--dp-ink); color: var(--dp-cream); position: relative; overflow: hidden; }
.dp-retail::before { content: ""; position: absolute; width: 520px; height: 520px; left: -180px; bottom: -220px; border: 1px solid rgba(255,255,255,.10); border-radius: 50%; }
.dp-retail .dp-step-label { color: var(--dp-sage); }
.dp-retail .dp-h2 { color: var(--dp-cream); max-width: 18ch; }
.dp-retail .dp-copy { color: rgba(250,250,245,.74); max-width: 56ch; }
.dp-retail .dp-copy strong { color: var(--dp-white); font-weight: 600; }
.dp-retail-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: clamp(18px,2.5vw,34px); margin-top: 48px; position: relative; z-index: 1; }
.dp-retail-cell { padding-left: 20px; border-left: 1px solid rgba(255,255,255,.14); }
.dp-retail-cell:first-child { border-left: 0; padding-left: 0; }
.dp-retail-cell strong { display: block; font-family: var(--dp-font-heading); font-weight: 300; font-size: clamp(28px,3.6vw,46px); color: var(--dp-sage); line-height: 1; margin-bottom: 10px; letter-spacing: -0.04em; }
.dp-retail-cell span { display: block; font-size: 13px; line-height: 1.45; color: rgba(250,250,245,.66); }

/* PROOF → centered intro + staggered pull-quotes */
.dp-testimonials { background: transparent; text-align: center; }
.dp-testimonials .dp-step-label { display: block; }
.dp-testimonials .dp-kicker { justify-content: center; }
.dp-testimonials .dp-kicker::before { display: none; }
.dp-testimonials .dp-h2 { margin-inline: auto; max-width: 760px; }
.dp-testimonials > .dp-wrap > .dp-copy { margin-inline: auto; text-align: center; max-width: 60ch; }
.dp-quote-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(28px, 5vw, 56px); margin-top: 44px; text-align: left; }
.dp-quote { position: relative; background: none; border: 0; box-shadow: none; border-radius: 0; padding: 26px 0 0; }
.dp-quote::before { content: "\201C"; display: block; margin-bottom: -18px; color: var(--dp-rose); font-family: var(--dp-font-serif); font-style: italic; font-size: 72px; line-height: 1; }
.dp-quote-grid .dp-quote:nth-child(even) { margin-top: clamp(0px, 4vw, 56px); }
.dp-quote__text { margin: 0 0 20px; color: rgba(34, 39, 33, 0.82); font-family: var(--dp-font-serif); font-size: clamp(19px, 1.7vw, 23px); font-style: italic; line-height: 1.5; letter-spacing: -0.02em; }
.dp-quote__name { margin: 0 0 4px; color: var(--dp-forest); font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }
.dp-quote__role { margin: 0; color: rgba(34, 39, 33, 0.56); font-size: 12px; line-height: 1.4; }
.dp-adv-foot { margin-top: 34px; text-align: center; font-size: 13px; color: rgba(34,39,33,.6); }
.dp-adv-foot a { color: var(--dp-forest); font-weight: 600; border-bottom: 1px solid var(--dp-line-warm); }

/* PRACTICE / B2B (contained panel) */
.dp-b2b { position: relative; background: transparent; }
.dp-b2b-box {
  display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
  gap: clamp(28px, 5vw, 64px); align-items: start;
  border-radius: 28px; padding: clamp(28px, 5vw, 54px);
  background: rgba(255, 255, 255, 0.72); border: 1px solid var(--dp-line); box-shadow: var(--dp-shadow);
}
.dp-note { margin-top: 18px; border-left: 2px solid var(--dp-terracotta); padding-left: 16px; color: rgba(34, 39, 33, 0.6); font-size: 12px; line-height: 1.58; }
.dp-process { display: grid; gap: 0; counter-reset: prostep; }
.dp-process__item { position: relative; background: none; border: 0; box-shadow: none; border-radius: 0; min-height: 0; padding: 18px 8px 18px 64px; counter-increment: prostep; border-top: 1px solid var(--dp-line); }
.dp-process__item:first-child { border-top: 0; padding-top: 4px; }
.dp-process__item::before { content: counter(prostep, decimal-leading-zero); position: absolute; top: 16px; left: 8px; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 999px; background: var(--dp-frost); color: var(--dp-forest); font-family: var(--dp-font-serif); font-style: italic; font-size: 15px; }
.dp-process__item:first-child::before { top: 2px; }
.dp-process__title { margin: 0 0 5px; font-size: 15px; font-weight: 600; }
.dp-process__copy { margin: 0; color: rgba(34, 39, 33, 0.64); font-size: 13px; line-height: 1.5; }

/* OFFER → pricing + how, anchored by big number */
.dp-how-pricing { position: relative; }
.dp-how-pricing__shell {
  position: relative; overflow: hidden; border-radius: 30px; padding: clamp(32px, 5vw, 64px);
  background: radial-gradient(circle at 90% 8%, rgba(211, 231, 192, 0.28), transparent 30%), rgba(255, 255, 255, 0.62);
  border: 1px solid var(--dp-line); box-shadow: var(--dp-shadow);
}
.dp-pricing-intro { display: grid; grid-template-columns: minmax(0,1fr) minmax(220px,0.5fr); gap: clamp(24px,4vw,56px); align-items: center; margin-bottom: clamp(26px, 4vw, 42px); }
.dp-pricing-intro__copy .dp-copy { max-width: 560px; margin-bottom: 0; }
.dp-pricing-hero { font-family: var(--dp-font-heading); font-weight: 300; font-size: clamp(46px, 6.5vw, 78px); line-height: 0.9; color: var(--dp-forest); letter-spacing: -0.045em; }
.dp-pricing-hero small { display: block; margin-top: 12px; font-family: var(--dp-font-sans); font-size: 14px; font-weight: 400; letter-spacing: 0.01em; color: rgba(34,39,33,.62); }

.dp-pricing-benefit-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(18px, 2.5vw, 30px); align-items: start; }
.dp-pricing-benefit-card { position: relative; overflow: visible; min-height: 0; border: 0; border-top: 1px solid var(--dp-line); border-radius: 0; padding: 20px 0 0; background: none; box-shadow: none; }
.dp-pricing-benefit-card strong { display: block; margin-bottom: 10px; color: var(--dp-ink); font-size: 13px; font-style: normal; font-weight: 700; letter-spacing: 0.08em; line-height: 1.25; text-transform: uppercase; }
.dp-pricing-benefit-card span { display: block; color: rgba(34, 39, 33, 0.64); font-size: 14px; line-height: 1.56; }
.dp-pricing-fine { margin: 18px 0 0; color: rgba(34, 39, 33, 0.46); font-size: 11px; line-height: 1.5; }
.dp-pricing-divider { width: 100%; height: 1px; margin: clamp(32px, 5vw, 54px) 0; background: var(--dp-line); }

.dp-how-compact__header { display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(260px, 0.58fr); gap: clamp(22px, 4vw, 54px); align-items: end; margin-bottom: clamp(22px, 3vw, 34px); }
.dp-how-compact__header .dp-copy { max-width: 520px; margin-bottom: 0; }
.dp-how-compact__title { max-width: 600px; }
.dp-how-compact__title .dp-h3 { margin-bottom: 0; font-size: clamp(24px, 2.6vw, 38px); font-weight: 300; letter-spacing: -0.045em; }

.dp-how-steps-compact { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(18px, 2.5vw, 32px); }
.dp-how-step-compact { position: relative; border: 0; border-top: 1px solid var(--dp-line); border-radius: 0; padding: 20px 0 0; background: none; box-shadow: none; }
.dp-how-step-compact__num { display: grid; place-items: center; width: 38px; height: 38px; margin-bottom: 18px; border-radius: 999px; background: var(--dp-frost); color: var(--dp-forest); font-family: var(--dp-font-serif); font-size: 17px; font-style: italic; line-height: 1; }
.dp-how-step-compact__title { margin: 0 0 8px; color: var(--dp-ink); font-size: 17px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; }
.dp-how-step-compact__copy { margin: 0; color: rgba(34, 39, 33, 0.64); font-size: 13px; line-height: 1.56; }

/* APPLY (warm band) */
.dp-form-shell { display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr); gap: clamp(30px, 5vw, 64px); align-items: start; }
.dp-form { background: rgba(255, 255, 255, 0.8); border: 1px solid var(--dp-line); border-radius: 28px; box-shadow: var(--dp-shadow); padding: clamp(24px, 4vw, 42px); }
.dp-form :where(input, select, textarea, button, label, p, span, a, div) { font-family: var(--dp-font-sans) !important; }

/* FAQ */
.dp-faq .dp-wrap { padding: clamp(28px, 4vw, 50px); border-radius: 28px; background: rgba(255, 255, 255, 0.5); border: 1px solid var(--dp-line); }
.dp-faq-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px clamp(24px, 4vw, 44px); margin-top: 34px; }
.dp-faq-item { border-top: 1px solid var(--dp-line); padding-top: 20px; }
.dp-faq-item h3 { margin: 0 0 8px; font-size: 17px; font-weight: 500; letter-spacing: -0.02em; }
.dp-faq-item p { margin: 0; color: rgba(34, 39, 33, 0.64); font-size: 14px; line-height: 1.6; }

/* FINAL CTA */
.dp-final { position: relative; padding: clamp(60px, 6.5vw, 96px) 0; background: var(--dp-cream); color: var(--dp-ink); text-align: center; }
.dp-final .dp-wrap { max-width: 860px; padding: clamp(36px, 5vw, 60px); border: 1px solid var(--dp-line-warm); border-radius: 28px; background: rgba(255, 255, 255, 0.55); box-shadow: var(--dp-shadow); }
.dp-final .dp-copy { margin-inline: auto; color: rgba(34, 39, 33, 0.66); }
.dp-final .dp-btn--light { border-color: var(--dp-forest); background: var(--dp-forest); color: var(--dp-white); }
.dp-final .dp-btn--light:hover { border-color: var(--dp-ink); background: var(--dp-ink); color: var(--dp-white); }

/* MOTION */
@media (prefers-reduced-motion: no-preference) {
  .dp-hero__content .dp-kicker,
  .dp-hero__content .dp-h1,
  .dp-hero__content .dp-hero__sub,
  .dp-hero__content .dp-btn-row,
  .dp-hero__content .dp-hero__trust,
  .dp-hero__visual { animation: dp-fade 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .dp-hero__content .dp-h1 { animation-delay: 0.06s; }
  .dp-hero__content .dp-hero__sub { animation-delay: 0.12s; }
  .dp-hero__content .dp-btn-row { animation-delay: 0.18s; }
  .dp-hero__content .dp-hero__trust { animation-delay: 0.24s; }
  .dp-hero__visual { animation-delay: 0.1s; }
  @keyframes dp-fade { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
}
@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    .dp-info-card, .dp-mini, .dp-quote, .dp-retail-cell, .dp-process__item, .dp-pricing-benefit-card, .dp-how-step-compact, .dp-faq-item {
      animation: dp-rise linear both; animation-timeline: view(); animation-range: entry 0% entry 40%;
    }
    @keyframes dp-rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  }
}

/* RESPONSIVE */
@media (max-width: 990px) {
  .dp-hero__grid, .dp-b2b-box, .dp-form-shell, .dp-solution-grid, .dp-pricing-intro { grid-template-columns: 1fr; }
  .dp-hero__media-card, .dp-hero__image { min-height: 420px; height: 420px; }
  .dp-retail-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
}
@media (max-width: 1100px) {
  .dp-pricing-benefit-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .dp-how-steps-compact { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 990px) {
  .dp-how-compact__header { grid-template-columns: 1fr; align-items: start; }
  .dp-proof-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .dp-proof-item:nth-child(3) { border-left: 0; padding-left: 0; }
}
@media (max-width: 680px) {
  .dp-wrap { width: min(100% - 28px, var(--dp-max)); }
  .dp-h1 { font-size: clamp(40px, 13vw, 60px); }
  .dp-h2 { line-height: 1.06; }
  .dp-btn-row, .dp-btn { width: 100%; }
  .dp-hero { padding-top: 40px; padding-bottom: 60px; }
  .dp-hero__media-card, .dp-hero__image { min-height: 340px; height: 340px; border-radius: 24px; }
  .dp-hero__image { padding: 14px; }
  .dp-logo-mark { font-size: 34px; }
  .dp-section { padding: 52px 0; }
  .dp-solution-header { margin-bottom: 26px; }
  .dp-b2b-box, .dp-form, .dp-faq .dp-wrap, .dp-final .dp-wrap, .dp-how-pricing__shell, .dp-ingredient-card { border-radius: 22px; }
  .dp-how-pricing__shell { padding: 30px 18px; }
  .dp-quote-grid, .dp-faq-grid, .dp-pricing-benefit-grid, .dp-how-steps-compact, .dp-proof-grid, .dp-retail-grid { grid-template-columns: 1fr; }
  .dp-quote-grid .dp-quote:nth-child(even) { margin-top: 0; }
  .dp-info-card { grid-template-columns: 44px minmax(0, 1fr); column-gap: 16px; padding: 22px 0; }
  .dp-proof-item, .dp-proof-item:nth-child(3) { border-left: 0; border-top: 1px solid var(--dp-line-warm); padding-top: 14px; padding-left: 0; }
  .dp-proof-item:first-child { border-top: 0; padding-top: 0; }
  .dp-retail-cell { border-left: 0; padding-left: 0; border-top: 1px solid rgba(255,255,255,.14); padding-top: 16px; }
  .dp-retail-cell:first-child { border-top: 0; padding-top: 0; }
  .dp-final { padding: 52px 0; }
  .dp-final .dp-wrap { width: min(100% - 28px, var(--dp-max)); padding: 32px 22px; }
}
</style>

<main class="dp-page" id="dental-pros-page">

  <!-- HERO -->
  <section class="dp-hero" aria-label="Boka Dental Pros Program">
    <div class="dp-wrap">
      <div class="dp-hero__grid">
        <div class="dp-hero__content">
          {% if section.settings.hero_kicker != blank %}<span class="dp-kicker">{{ section.settings.hero_kicker }}</span>{% endif %}
          {% if section.settings.hero_heading != blank %}<h1 class="dp-h1">{{ section.settings.hero_heading }}</h1>{% endif %}
          {% if section.settings.hero_text != blank %}<p class="dp-hero__sub">{{ section.settings.hero_text }}</p>{% endif %}
          <div class="dp-btn-row">
            {% if section.settings.hero_primary_label != blank %}<a class="dp-btn dp-btn--primary" href="{{ section.settings.hero_primary_link }}">{{ section.settings.hero_primary_label }}</a>{% endif %}
            {% if section.settings.hero_secondary_label != blank %}<a class="dp-btn" href="{{ section.settings.hero_secondary_link }}">{{ section.settings.hero_secondary_label }}</a>{% endif %}
          </div>
          <div class="dp-hero__trust" aria-label="Program highlights">
            {% for block in section.blocks %}{% if block.type == 'hero_pill' %}<span class="dp-pill" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{% endif %}{% endfor %}
          </div>
        </div>
        <div class="dp-hero__visual">
          <div class="dp-hero__media-card">
            {% if section.settings.hero_image != blank %}
              {{ section.settings.hero_image | image_url: width: 1400 | image_tag: class: 'dp-hero__image', loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_image_alt }}
            {% elsif section.settings.hero_image_url != blank %}
              <img class="dp-hero__image" src="{{ section.settings.hero_image_url }}" alt="{{ section.settings.hero_image_alt | escape }}" loading="eager" fetchpriority="high" width="900" height="1100">
            {% else %}
              <div class="dp-hero__placeholder" aria-hidden="true"><div class="dp-logo-mark">BOKA</div></div>
            {% endif %}
          </div>
        </div>
      </div>
      <div class="dp-proof-band" aria-label="Boka Dental Pros core proof points">
        <div class="dp-proof-grid">
          <div class="dp-proof-item"><strong>#1 Toothpaste</strong><span>On Amazon · growing at Walmart, Target, CVS</span></div>
          <div class="dp-proof-item"><strong>Up to 55% Off</strong><span>The more you buy, the more you save</span></div>
          <div class="dp-proof-item"><strong>n-Ha Powered</strong><span>The premier fluoride-free alternative</span></div>
          <div class="dp-proof-item"><strong>Free Samples</strong><span>Processed fast for approved teams</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT IS BOKA (intro / explainer) -->
  <section class="dp-section" id="what-is-boka" aria-label="What Boka is">
    <div class="dp-wrap">
      <div class="dp-solution-grid">
        <div class="dp-solution-copy">
          <div class="dp-solution-header">
            {% if section.settings.what_kicker != blank %}<span class="dp-kicker">{{ section.settings.what_kicker }}</span>{% endif %}
            {% if section.settings.what_heading != blank %}<h2 class="dp-h2">{{ section.settings.what_heading }}</h2>{% endif %}
            {% if section.settings.what_text_1 != blank %}<p class="dp-copy">{{ section.settings.what_text_1 }}</p>{% endif %}
            {% if section.settings.what_text_2 != blank and section.settings.what_text_2 != "-" %}<p class="dp-copy">{{ section.settings.what_text_2 }}</p>{% endif %}
          </div>
          <div class="dp-mini-grid" aria-label="Boka solution benefits">
            {% for block in section.blocks %}{% if block.type == 'what_mini_card' %}
              <div class="dp-mini" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}<p class="dp-mini__title">{{ block.settings.title }}</p>{% endif %}
                {% if block.settings.text != blank %}<p class="dp-mini__copy">{{ block.settings.text }}</p>{% endif %}
              </div>
            {% endif %}{% endfor %}
          </div>
        </div>
        <div class="dp-card dp-ingredient-card">
          {% if section.settings.ingredient_kicker != blank %}<span class="dp-kicker">{{ section.settings.ingredient_kicker }}</span>{% endif %}
          {% if section.settings.ingredient_heading != blank %}<h3 class="dp-h3">{{ section.settings.ingredient_heading }}</h3>{% endif %}
          <ul class="dp-check-list">
            {% for block in section.blocks %}{% if block.type == 'ingredient_bullet' %}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{% endif %}{% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 · PROBLEM -->
  <section class="dp-section dp-why" id="problem" aria-label="Why patients are asking about Boka">
    <div class="dp-wrap">
      <span class="dp-step-label">01 — The problem</span>
      {% if section.settings.why_kicker != blank %}<span class="dp-kicker">{{ section.settings.why_kicker }}</span>{% endif %}
      {% if section.settings.why_heading != blank %}<h2 class="dp-h2">{{ section.settings.why_heading }}</h2>{% endif %}
      {% if section.settings.why_text != blank %}<p class="dp-copy">{{ section.settings.why_text }}</p>{% endif %}
      <div class="dp-card-grid">
        {% for block in section.blocks %}{% if block.type == 'why_card' %}
          <article class="dp-info-card" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}<div class="dp-info-card__icon">{{ block.settings.icon }}</div>{% endif %}
            {% if block.settings.title != blank %}<h3 class="dp-info-card__title">{{ block.settings.title }}</h3>{% endif %}
            {% if block.settings.text != blank %}<p class="dp-info-card__copy">{{ block.settings.text }}</p>{% endif %}
          </article>
        {% endif %}{% endfor %}
      </div>
    </div>
  </section>

  <!-- 02 · SOLUTION — retail dominance -->
  <section class="dp-section dp-retail" id="solution" aria-label="Boka is the leading n-Ha toothpaste">
    <div class="dp-wrap">
      <span class="dp-step-label">02 — The solution</span>
      {% if section.settings.retail_heading != blank %}<h2 class="dp-h2">{{ section.settings.retail_heading }}</h2>{% endif %}
      {% if section.settings.retail_text != blank %}<p class="dp-copy">{{ section.settings.retail_text }}</p>{% endif %}
      <div class="dp-retail-grid" aria-label="Retail presence">
        <div class="dp-retail-cell"><strong>#1</strong><span>n-Ha toothpaste brand on Amazon</span></div>
        <div class="dp-retail-cell"><strong>Walmart</strong><span>Growing fast nationwide</span></div>
        <div class="dp-retail-cell"><strong>Target</strong><span>Expanding shelf presence</span></div>
        <div class="dp-retail-cell"><strong>CVS</strong><span>In-store and online</span></div>
      </div>
    </div>
  </section>

  <!-- 03 · PROOF — advisory committee -->
  <section class="dp-section dp-testimonials" aria-label="Reviewed by the Oral Health Advisory Committee">
    <div class="dp-wrap">
      <span class="dp-step-label">03 — The proof</span>
      {% if section.settings.testimonials_kicker != blank %}<span class="dp-kicker">{{ section.settings.testimonials_kicker }}</span>{% endif %}
      {% if section.settings.testimonials_heading != blank %}<h2 class="dp-h2">{{ section.settings.testimonials_heading }}</h2>{% endif %}
      {% if section.settings.testimonials_text != blank %}<p class="dp-copy">{{ section.settings.testimonials_text }}</p>{% endif %}
      <div class="dp-quote-grid">
        {% for block in section.blocks %}{% if block.type == 'quote' %}
          <article class="dp-quote" {{ block.shopify_attributes }}>
            {% if block.settings.quote != blank %}<p class="dp-quote__text">{{ block.settings.quote }}</p>{% endif %}
            {% if block.settings.name != blank %}<p class="dp-quote__name">{{ block.settings.name }}</p>{% endif %}
            {% if block.settings.role != blank %}<p class="dp-quote__role">{{ block.settings.role }}</p>{% endif %}
          </article>
        {% endif %}{% endfor %}
      </div>
      {% if section.settings.testimonials_footer != blank %}
        <p class="dp-adv-foot">{{ section.settings.testimonials_footer }}
          {% if section.settings.testimonials_footer_link_label != blank %}<a href="{{ section.settings.testimonials_footer_link }}">{{ section.settings.testimonials_footer_link_label }} →</a>{% endif %}
        </p>
      {% endif %}
    </div>
  </section>

  <!-- 04 · PRACTICE CASE -->
  <section class="dp-section dp-b2b" id="practice-economics" aria-label="Boka Pro practice economics">
    <div class="dp-wrap">
      <div class="dp-b2b-box">
        <div>
          <span class="dp-step-label">04 — Your practice</span>
          {% if section.settings.b2b_kicker != blank %}<span class="dp-kicker">{{ section.settings.b2b_kicker }}</span>{% endif %}
          {% if section.settings.b2b_heading != blank %}<h2 class="dp-h2">{{ section.settings.b2b_heading }}</h2>{% endif %}
          {% if section.settings.b2b_text != blank %}<p class="dp-copy">{{ section.settings.b2b_text }}</p>{% endif %}
          <div class="dp-btn-row">
            {% if section.settings.b2b_primary_label != blank %}<a class="dp-btn dp-btn--primary" href="{{ section.settings.b2b_primary_link }}">{{ section.settings.b2b_primary_label }}</a>{% endif %}
            {% if section.settings.b2b_secondary_label != blank %}<a class="dp-btn" href="{{ section.settings.b2b_secondary_link }}">{{ section.settings.b2b_secondary_label }}</a>{% endif %}
          </div>
          {% if section.settings.b2b_note != blank %}<p class="dp-note">{{ section.settings.b2b_note }}</p>{% endif %}
        </div>
        <div>
          <div class="dp-process">
            {% for block in section.blocks %}{% if block.type == 'process_item' %}
              <div class="dp-process__item" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}<p class="dp-process__title">{{ block.settings.title }}</p>{% endif %}
                {% if block.settings.text != blank %}<p class="dp-process__copy">{{ block.settings.text }}</p>{% endif %}
              </div>
            {% endif %}{% endfor %}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 · OFFER — pricing + how it works -->
  <section class="dp-section dp-how-pricing" id="how-it-works" aria-label="How the Dental Pros Program works">
    <div class="dp-wrap">
      <div class="dp-how-pricing__shell">
        <div class="dp-pricing-intro">
          <div class="dp-pricing-intro__copy">
            <span class="dp-step-label">05 — The offer</span>
            {% if section.settings.commission_kicker != blank %}<span class="dp-kicker">{{ section.settings.commission_kicker }}</span>{% endif %}
            {% if section.settings.commission_heading != blank %}<h2 class="dp-h2">{{ section.settings.commission_heading }}</h2>{% endif %}
            {% if section.settings.commission_text != blank %}<p class="dp-copy">{{ section.settings.commission_text }}</p>{% endif %}
          </div>
          <div class="dp-pricing-hero" aria-hidden="false">{{ section.settings.commission_number }}<small>{{ section.settings.commission_subtext }}</small></div>
        </div>

        <div class="dp-pricing-benefit-grid" aria-label="Professional pricing benefits">
          <article class="dp-pricing-benefit-card"><strong>Save up to 55%</strong><span>Exclusive savings through Dental Pros that benefit your practice and your patients.</span></article>
          <article class="dp-pricing-benefit-card"><strong>Better practice economics</strong><span>Preferred B2B pricing on qualifying products vs. standard retail.</span></article>
          <article class="dp-pricing-benefit-card"><strong>The more you buy, the more you save</strong><span>Greater savings as qualifying order volume grows.</span></article>
          <article class="dp-pricing-benefit-card"><strong>Stock, sample, recommend</strong><span>Keep Boka easy to have on hand for your team and patient conversations.</span></article>
        </div>

        <p class="dp-pricing-fine">Final pricing and eligibility may vary by account type, order volume, qualifying products, and program requirements.</p>

        <div class="dp-pricing-divider" aria-hidden="true"></div>

        <div class="dp-how-compact__header">
          <div class="dp-how-compact__title">
            {% if section.settings.how_kicker != blank %}<span class="dp-kicker">{{ section.settings.how_kicker }}</span>{% endif %}
            {% if section.settings.how_heading != blank %}<h3 class="dp-h3">{{ section.settings.how_heading }}</h3>{% endif %}
          </div>
          {% if section.settings.how_text != blank %}<p class="dp-copy">{{ section.settings.how_text }}</p>{% endif %}
        </div>

        <div class="dp-how-steps-compact" aria-label="How it works steps">
          {% for block in section.blocks %}{% if block.type == 'how_step' %}
            <article class="dp-how-step-compact" {{ block.shopify_attributes }}>
              {% if block.settings.number != blank %}<span class="dp-how-step-compact__num">{{ block.settings.number }}</span>{% endif %}
              {% if block.settings.title != blank %}<h4 class="dp-how-step-compact__title">{{ block.settings.title }}</h4>{% endif %}
              {% if block.settings.text != blank %}<p class="dp-how-step-compact__copy">{{ block.settings.text }}</p>{% endif %}
            </article>
          {% endif %}{% endfor %}
        </div>
      </div>
    </div>
  </section>

  <!-- 06 · APPLY -->
  <section class="dp-section dp-signup" id="signup" aria-label="Apply to the Dental Pros Program">
    <div class="dp-wrap">
      <div class="dp-form-shell">
        <div>
          <span class="dp-step-label">06 — Apply</span>
          {% if section.settings.form_kicker != blank %}<span class="dp-kicker">{{ section.settings.form_kicker }}</span>{% endif %}
          {% if section.settings.form_heading != blank %}<h2 class="dp-h2">{{ section.settings.form_heading }}</h2>{% endif %}
          {% if section.settings.form_text != blank %}<p class="dp-copy">{{ section.settings.form_text }}</p>{% endif %}
          <ul class="dp-check-list">
            {% for block in section.blocks %}{% if block.type == 'form_bullet' %}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{% endif %}{% endfor %}
          </ul>
        </div>
        <div class="dp-form">
          <div class="klaviyo-form-VvZypp"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="dp-section dp-faq" aria-label="Dental Pros Program FAQ">
    <div class="dp-wrap">
      {% if section.settings.faq_kicker != blank %}<span class="dp-kicker">{{ section.settings.faq_kicker }}</span>{% endif %}
      {% if section.settings.faq_heading != blank %}<h2 class="dp-h2">{{ section.settings.faq_heading }}</h2>{% endif %}
      <div class="dp-faq-grid">
        {% for block in section.blocks %}{% if block.type == 'faq' %}
          <div class="dp-faq-item" {{ block.shopify_attributes }}>
            {% if block.settings.question != blank %}<h3>{{ block.settings.question }}</h3>{% endif %}
            {% if block.settings.answer != blank %}<p>{{ block.settings.answer }}</p>{% endif %}
          </div>
        {% endif %}{% endfor %}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="dp-final" aria-label="Final call to action">
    <div class="dp-wrap">
      {% if section.settings.final_heading != blank %}<h2 class="dp-h2">{{ section.settings.final_heading }}</h2>{% endif %}
      {% if section.settings.final_text != blank %}<p class="dp-copy">{{ section.settings.final_text }}</p>{% endif %}
      <div class="dp-btn-row" style="justify-content: center;">
        {% if section.settings.final_button_label != blank %}<a class="dp-btn dp-btn--light" href="{{ section.settings.final_button_link }}">{{ section.settings.final_button_label }}</a>{% endif %}
      </div>
    </div>
  </section>

</main>

{% schema %}
{
  "name": "Dental Pros Landing",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_kicker", "label": "Hero eyebrow", "default": "Boka Dental Pros" },
    { "type": "html", "id": "hero_heading", "label": "Hero heading", "default": "Give patients the fluoride-free n-Ha toothpaste they\u2019re already <span class=\"dp-em\">asking</span> about." },
    { "type": "textarea", "id": "hero_text", "label": "Hero body text", "default": "Boka is the #1 nano-hydroxyapatite toothpaste brand. Join the Dental Pros Program for wholesale pricing, free samples, and a simple answer when patients want a fluoride-free option." },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_image_url", "label": "Fallback hero image URL", "default": "https://www.boka.com/cdn/shop/files/81BTsIMEbTL._AC_SL1500.jpg?v=1777991528&width=1400" },
    { "type": "text", "id": "hero_image_alt", "label": "Hero image alt text", "default": "Boka oral care product lifestyle image" },
    { "type": "text", "id": "hero_primary_label", "label": "Primary button label", "default": "Apply now" },
    { "type": "text", "id": "hero_primary_link", "label": "Primary button link", "default": "#signup" },
    { "type": "text", "id": "hero_secondary_label", "label": "Secondary button label", "default": "Why Boka" },
