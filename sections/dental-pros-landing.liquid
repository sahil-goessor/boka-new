  <section class="dp-section dp-testimonials" aria-label="Dentist and hygienist recommended">
    <div class="dp-wrap">
      {% if section.settings.testimonials_kicker != blank %}
        <span class="dp-kicker">{{ section.settings.testimonials_kicker }}</span>
      {% endif %}
      {% if section.settings.testimonials_heading != blank %}
        <h2 class="dp-h2">{{ section.settings.testimonials_heading }}</h2>
      {% endif %}
      <p class="dp-testimonials__intro">
        Boka is reviewed and recommended by leading dental academics and clinicians - the experts your peers already trust.
      </p>

      <div class="dp-quote-grid">
        {% for block in section.blocks %}
          {% if block.type == 'quote' %}
            <article class="dp-quote" {{ block.shopify_attributes }}>
              {% if block.settings.quote != blank %}
                <p class="dp-quote__text">{{ block.settings.quote }}</p>
              {% endif %}

              <div class="dp-quote__person">
                {% if block.settings.name != blank %}
                  {% assign quote_name_parts = block.settings.name | split: ' ' %}
                  {% assign quote_first_initial = quote_name_parts[0] | slice: 0, 1 %}
                  {% assign quote_last_initial = quote_name_parts[1] | slice: 0, 1 %}
                  <span class="dp-quote__avatar" aria-hidden="true">{{ quote_first_initial }}{{ quote_last_initial }}</span>
                  <div>
                    <p class="dp-quote__name">{{ block.settings.name }}</p>
                    {% if block.settings.role != blank %}
                      <p class="dp-quote__role">{{ block.settings.role }}</p>
                    {% endif %}
