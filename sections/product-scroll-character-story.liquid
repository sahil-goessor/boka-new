        top: auto;
        transform: none;
        display: flex;
        justify-content: center;
        margin: 0 0 24px;
      }

      #boka-collection-world-{{ section.id }} .boka-collection-world__scroll-scenes {
        margin-top: 0;
      }

      #boka-collection-world-{{ section.id }} .boka-collection-world__scene-trigger {
        min-height: 0;
      }

