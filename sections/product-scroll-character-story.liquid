
{% liquid
  assign active_collection = collection
  assign products_to_show = section.settings.product_limit

  assign hero_eyebrow = active_collection.metafields.custom.scroll_hero_eyebrow.value | default: section.settings.hero_eyebrow
  assign hero_heading = active_collection.metafields.custom.scroll_hero_heading.value | default: section.settings.hero_heading
  assign hero_text = active_collection.metafields.custom.scroll_hero_text.value | default: section.settings.hero_subheading
%}

{% if active_collection != blank and active_collection.products_count > 0 %}
  <section
    id="boka-collection-scroll-{{ section.id }}"
    class="boka-collection-scroll"
  >
    <div
      class="boka-collection-scroll__hero"
      {% if section.settings.hero_background_image != blank %}
        style="--hero-bg-image: url('{{ section.settings.hero_background_image | image_url: width: 2400 }}'); --hero-overlay-opacity: {{ section.settings.hero_image_overlay_opacity | divided_by: 100.0 }};"
      {% else %}
        style="--hero-bg-image: none; --hero-overlay-opacity: 0;"
      {% endif %}
    >
      <div class="boka-collection-scroll__hero-photo"></div>
      <div class="boka-collection-scroll__hero-photo-overlay"></div>

      <div class="boka-collection-scroll__hero-bg">
        <span class="boka-collection-scroll__blob is-one"></span>
        <span class="boka-collection-scroll__blob is-two"></span>
        <span class="boka-collection-scroll__blob is-three"></span>
        <span class="boka-collection-scroll__blob is-four"></span>
      </div>

      <div class="boka-collection-scroll__hero-inner">
        <div class="boka-collection-scroll__hero-copy">
          {% if hero_eyebrow != blank %}
            <p class="boka-collection-scroll__eyebrow">
              {{ hero_eyebrow }}
            </p>
          {% endif %}

          {% if hero_heading != blank %}
            <h1>{{ hero_heading }}</h1>
          {% else %}
            <h1>{{ active_collection.title }}</h1>
          {% endif %}

          {% if hero_text != blank %}
            <p class="boka-collection-scroll__hero-text">
              {{ hero_text }}
            </p>
          {% endif %}

          {% if section.settings.hero_button_label != blank %}
            <a
              href="#boka-collection-list-{{ section.id }}"
              class="boka-collection-scroll__button"
            >
              {{ section.settings.hero_button_label }}
            </a>
          {% endif %}
        </div>

        <div class="boka-collection-scroll__hero-products">
          {% for flavor_product in active_collection.products limit: products_to_show %}
            {% liquid
              assign loop_mod = forloop.index0 | modulo: 2

              if loop_mod == 0
                assign fallback_accent = section.settings.alt_accent_color_1
                assign fallback_bg = section.settings.alt_background_color_1
              else
                assign fallback_accent = section.settings.alt_accent_color_2
                assign fallback_bg = section.settings.alt_background_color_2
              endif

              assign character_name = flavor_product.metafields.custom.character_name.value | default: flavor_product.title
              assign character_image = flavor_product.metafields.custom.character_image.value
              assign character_hover_image = flavor_product.metafields.custom.character_hover_image.value
              assign metafield_accent = flavor_product.metafields.custom.flavor_accent_color.value
              assign metafield_bg = flavor_product.metafields.custom.flavor_background_color.value

              if section.settings.enable_metafield_color_overrides and metafield_accent != blank
                assign accent_color = metafield_accent
              else
                assign accent_color = fallback_accent
              endif

              if section.settings.enable_metafield_color_overrides and metafield_bg != blank
                assign background_color = metafield_bg
              else
                assign background_color = fallback_bg
              endif

              if character_image != blank
                assign character_image_url = character_image | image_url: width: 900
              elsif flavor_product.featured_image != blank
                assign character_image_url = flavor_product.featured_image | image_url: width: 900
              else
                assign character_image_url = blank
              endif

              if character_hover_image != blank
                assign character_hover_image_url = character_hover_image | image_url: width: 900
              else
                assign character_hover_image_url = character_image_url
              endif
            %}

            <a
              href="#boka-product-scene-{{ section.id }}-{{ forloop.index }}"
              class="boka-collection-scroll__hero-card is-card-{{ forloop.index }} js-boka-hover-swap"
              style="
                --card-accent: {{ accent_color }};
                --card-bg: {{ background_color }};
              "
              data-default-src="{{ character_image_url }}"
              data-hover-src="{{ character_hover_image_url }}"
            >
              {% if character_image_url != blank %}
                <img
                  src="{{ character_image_url }}"
                  alt="{{ character_name | escape }}"
                  loading="lazy"
                >
              {% endif %}

              <span>{{ character_name }}</span>
            </a>
          {% endfor %}
        </div>
      </div>

      <div class="boka-collection-scroll__curve is-hero-curve" aria-hidden="true">
        <svg viewBox="0 0 1440 150" preserveAspectRatio="none">
          <path d="M0,78 C180,132 340,136 520,82 C710,24 890,24 1080,82 C1235,130 1345,118 1440,76 L1440,150 L0,150 Z"></path>
        </svg>
      </div>
    </div>

    <div
      id="boka-collection-list-{{ section.id }}"
      class="boka-collection-scroll__list-section boka-collection-scroll__quiz-section"
    >
      <div class="boka-collection-scroll__list-inner">
        <div class="boka-collection-scroll__list-header">
          {% if section.settings.list_eyebrow != blank %}
            <p class="boka-collection-scroll__eyebrow">
              {{ section.settings.list_eyebrow }}
            </p>
          {% endif %}

          {% if section.settings.list_heading != blank %}
            <h2>{{ section.settings.list_heading }}</h2>
          {% endif %}

          {% if section.settings.list_text != blank %}
            <p>{{ section.settings.list_text }}</p>
          {% endif %}
        </div>

        <div class="boka-collection-scroll__quiz is-taking-quiz" data-product-count="{{ products_to_show }}">
          <div class="boka-collection-scroll__quiz-intro" aria-hidden="false">
            <span class="boka-collection-scroll__quiz-intro-icon">✦</span>
            <h3>{{ section.settings.quiz_side_heading }}</h3>
            <p>{{ section.settings.quiz_side_text }}</p>
          </div>

          <div class="boka-collection-scroll__quiz-main">
            <div class="boka-collection-scroll__quiz-topline">
              <p class="boka-collection-scroll__quiz-step js-boka-quiz-step">Question 1 of 4</p>
              <div class="boka-collection-scroll__quiz-progress" aria-hidden="true">
                <span class="js-boka-quiz-progress"></span>
              </div>
            </div>

            <div class="boka-collection-scroll__quiz-questions">
              <div class="boka-collection-scroll__quiz-question is-active" data-question-index="1">
                <h3>{{ section.settings.quiz_question_1 }}</h3>
                <p>{{ section.settings.quiz_question_1_text }}</p>

                <div class="boka-collection-scroll__quiz-options">
                  <button type="button" class="boka-collection-scroll__quiz-option" data-match-index="1">
                    <span class="boka-collection-scroll__quiz-icon is-orange">☼</span>
                    <span><strong>{{ section.settings.quiz_answer_1_1 }}</strong><small>{{ section.settings.quiz_answer_1_1_text }}</small></span>
                  </button>
                  <button type="button" class="boka-collection-scroll__quiz-option" data-match-index="2">
                    <span class="boka-collection-scroll__quiz-icon is-green">⌁</span>
                    <span><strong>{{ section.settings.quiz_answer_1_2 }}</strong><small>{{ section.settings.quiz_answer_1_2_text }}</small></span>
                  </button>
                  <button type="button" class="boka-collection-scroll__quiz-option" data-match-index="3">
                    <span class="boka-collection-scroll__quiz-icon is-pink">♡</span>
                    <span><strong>{{ section.settings.quiz_answer_1_3 }}</strong><small>{{ section.settings.quiz_answer_1_3_text }}</small></span>
                  </button>
                  <button type="button" class="boka-collection-scroll__quiz-option" data-match-index="4">
                    <span class="boka-collection-scroll__quiz-icon is-blue">✦</span>
                    <span><strong>{{ section.settings.quiz_answer_1_4 }}</strong><small>{{ section.settings.quiz_answer_1_4_text }}</small></span>
                  </button>
                </div>
              </div>

              <div class="boka-collection-scroll__quiz-question" data-question-index="2">
                <h3>{{ section.settings.quiz_question_2 }}</h3>
                <p>{{ section.settings.quiz_question_2_text }}</p>

                <div class="boka-collection-scroll__quiz-options is-compact">
                  <button type="button" class="boka-collection-scroll__quiz-option" data-match-index="1"><span class="boka-collection-scroll__quiz-icon is-orange">🍊</span><span><strong>{{ section.settings.quiz_answer_2_1 }}</strong></span></button>
                  <button type="button" class="boka-collection-scroll__quiz-option" data-match-index="2"><span class="boka-collection-scroll__quiz-icon is-green">🌿</span><span><strong>{{ section.settings.quiz_answer_2_2 }}</strong></span></button>
                  <button type="button" class="boka-collection-scroll__quiz-option" data-match-index="3"><span class="boka-collection-scroll__quiz-icon is-pink">🍓</span><span><strong>{{ section.settings.quiz_answer_2_3 }}</strong></span></button>
                  <button type="button" class="boka-collection-scroll__quiz-option" data-match-index="5"><span class="boka-collection-scroll__quiz-icon is-blue">🫐</span><span><strong>{{ section.settings.quiz_answer_2_4 }}</strong></span></button>
                </div>
              </div>

              <div class="boka-collection-scroll__quiz-question" data-question-index="3">
                <h3>{{ section.settings.quiz_question_3 }}</h3>
                <p>{{ section.settings.quiz_question_3_text }}</p>

                <div class="boka-collection-scroll__quiz-options is-compact">
                  <button type="button" class="boka-collection-scroll__quiz-option" data-match-index="1"><span class="boka-collection-scroll__quiz-icon is-orange">1</span><span><strong>{{ section.settings.quiz_answer_3_1 }}</strong></span></button>
                  <button type="button" class="boka-collection-scroll__quiz-option" data-match-index="2"><span class="boka-collection-scroll__quiz-icon is-green">2</span><span><strong>{{ section.settings.quiz_answer_3_2 }}</strong></span></button>
                  <button type="button" class="boka-collection-scroll__quiz-option" data-match-index="3"><span class="boka-collection-scroll__quiz-icon is-pink">3</span><span><strong>{{ section.settings.quiz_answer_3_3 }}</strong></span></button>
                  <button type="button" class="boka-collection-scroll__quiz-option" data-match-index="4"><span class="boka-collection-scroll__quiz-icon is-blue">4</span><span><strong>{{ section.settings.quiz_answer_3_4 }}</strong></span></button>
                </div>
              </div>

              <div class="boka-collection-scroll__quiz-question" data-question-index="4">
                <h3>{{ section.settings.quiz_question_4 }}</h3>
                <p>{{ section.settings.quiz_question_4_text }}</p>

                <div class="boka-collection-scroll__quiz-options is-compact">
                  <button type="button" class="boka-collection-scroll__quiz-option" data-match-index="1"><span class="boka-collection-scroll__quiz-icon is-orange">☀</span><span><strong>{{ section.settings.quiz_answer_4_1 }}</strong></span></button>
                  <button type="button" class="boka-collection-scroll__quiz-option" data-match-index="2"><span class="boka-collection-scroll__quiz-icon is-green">☁</span><span><strong>{{ section.settings.quiz_answer_4_2 }}</strong></span></button>
                  <button type="button" class="boka-collection-scroll__quiz-option" data-match-index="3"><span class="boka-collection-scroll__quiz-icon is-pink">✿</span><span><strong>{{ section.settings.quiz_answer_4_3 }}</strong></span></button>
                  <button type="button" class="boka-collection-scroll__quiz-option" data-match-index="5"><span class="boka-collection-scroll__quiz-icon is-blue">✦</span><span><strong>{{ section.settings.quiz_answer_4_4 }}</strong></span></button>
                </div>
              </div>
            </div>

            <div class="boka-collection-scroll__quiz-nav">
              <button type="button" class="boka-collection-scroll__quiz-back js-boka-quiz-back" disabled>
                ← Back
              </button>
              <span class="js-boka-quiz-nav-label">Step 1 of 4</span>
              <button type="button" class="boka-collection-scroll__quiz-next js-boka-quiz-next" disabled>
                Next →
              </button>
            </div>
          </div>


        </div>
      </div>
    </div>

    <div class="boka-collection-scroll__scenes">
      {% for flavor_product in active_collection.products limit: products_to_show %}
        {% liquid
          assign loop_mod = forloop.index0 | modulo: 2

          if loop_mod == 0
            assign scene_class = 'is-even'
            assign fallback_accent = section.settings.alt_accent_color_1
            assign fallback_bg = section.settings.alt_background_color_1
          else
            assign scene_class = 'is-odd'
            assign fallback_accent = section.settings.alt_accent_color_2
            assign fallback_bg = section.settings.alt_background_color_2
          endif

          assign headline = flavor_product.metafields.custom.flavor_scroll_headline.value | default: flavor_product.title
          assign description = flavor_product.metafields.custom.flavor_scroll_description.value | default: flavor_product.description | strip_html | truncate: 420
          assign bullets = flavor_product.metafields.custom.flavor_scroll_bullets.value
          assign character_name = flavor_product.metafields.custom.character_name.value | default: flavor_product.title
          assign character_quote = flavor_product.metafields.custom.character_quote.value

          assign metafield_accent = flavor_product.metafields.custom.flavor_accent_color.value
          assign metafield_bg = flavor_product.metafields.custom.flavor_background_color.value

          if section.settings.enable_metafield_color_overrides and metafield_accent != blank
            assign accent_color = metafield_accent
          else
            assign accent_color = fallback_accent
          endif

          if section.settings.enable_metafield_color_overrides and metafield_bg != blank
            assign background_color = metafield_bg
          else
            assign background_color = fallback_bg
          endif

          assign next_product = active_collection.products[forloop.index]

          if next_product != blank
            assign next_loop_mod = forloop.index | modulo: 2

            if next_loop_mod == 0
              assign next_fallback_bg = section.settings.alt_background_color_1
            else
              assign next_fallback_bg = section.settings.alt_background_color_2
            endif

            assign next_metafield_bg = next_product.metafields.custom.flavor_background_color.value

            if section.settings.enable_metafield_color_overrides and next_metafield_bg != blank
              assign next_bg = next_metafield_bg
            else
              assign next_bg = next_fallback_bg
            endif
          else
            assign next_bg = section.settings.default_background
          endif

          assign character_image = flavor_product.metafields.custom.character_image.value
          assign character_hover_image = flavor_product.metafields.custom.character_hover_image.value

          if character_image != blank
            assign character_image_url = character_image | image_url: width: 1400
          elsif flavor_product.featured_image != blank
            assign character_image_url = flavor_product.featured_image | image_url: width: 1400
          else
            assign character_image_url = blank
          endif

          if character_hover_image != blank
            assign character_hover_image_url = character_hover_image | image_url: width: 1400
          else
            assign character_hover_image_url = character_image_url
          endif
        %}

        <article
          id="boka-product-scene-{{ section.id }}-{{ forloop.index }}"
          class="boka-collection-scroll__scene {{ scene_class }}"
          style="
            --scene-bg: {{ background_color }};
            --next-bg: {{ next_bg }};
            --scene-accent: {{ accent_color }};
          "
          data-default-src="{{ character_image_url }}"
          data-hover-src="{{ character_hover_image_url }}"
        >
          <div class="boka-collection-scroll__scene-bg">
            <span class="boka-collection-scroll__scene-blob is-a"></span>
            <span class="boka-collection-scroll__scene-blob is-b"></span>
            <span class="boka-collection-scroll__scene-blob is-c"></span>
          </div>

          <div class="boka-collection-scroll__scene-inner">
            <div class="boka-collection-scroll__scene-copy">
              <p class="boka-collection-scroll__eyebrow">
                {{ section.settings.scene_card_label }}
              </p>

              <h2>{{ headline }}</h2>

              {% if description != blank %}
                <p class="boka-collection-scroll__description">
                  {{ description }}
                </p>
              {% endif %}

              {% if character_quote != blank %}
                <p class="boka-collection-scroll__quote">
                  {{ character_quote }}
                </p>
              {% endif %}

              {% if bullets != blank %}
                <div class="boka-collection-scroll__bullets">
                  {% for bullet in bullets %}
                    <div class="boka-collection-scroll__bullet">
                      <span></span>
                      <p>{{ bullet }}</p>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}

              <div class="boka-collection-scroll__product-row">
                {% if flavor_product.featured_image != blank %}
                  <div class="boka-collection-scroll__product-row-image">
                    <img
                      src="{{ flavor_product.featured_image | image_url: width: 500 }}"
                      alt="{{ flavor_product.featured_image.alt | default: flavor_product.title | escape }}"
                      loading="lazy"
                    >
                  </div>
                {% endif %}

                <div>
                  <p>{{ flavor_product.title }}</p>

                  {% if flavor_product.price %}
                    <span>{{ flavor_product.price | money }}</span>
                  {% endif %}
                </div>

                <a href="{{ flavor_product.url }}" class="boka-collection-scroll__button is-small">
                  {{ section.settings.product_button_label }}
                </a>
              </div>
            </div>

            <div class="boka-collection-scroll__scene-visual js-boka-scene-visual">
              <div class="boka-collection-scroll__orbit">
                <span></span>
                <span></span>
                <span></span>
              </div>

              {% if character_image_url != blank %}
                <img
                  class="boka-collection-scroll__character-image"
                  src="{{ character_image_url }}"
                  alt="{{ character_name | escape }}"
                  loading="lazy"
                >
              {% endif %}
            </div>
          </div>

          <div class="boka-collection-scroll__curve is-scene-curve" aria-hidden="true">
            <svg viewBox="0 0 1440 150" preserveAspectRatio="none">
              <path d="M0,78 C180,132 340,136 520,82 C710,24 890,24 1080,82 C1235,130 1345,118 1440,76 L1440,150 L0,150 Z"></path>
            </svg>
          </div>
        </article>
      {% endfor %}
    </div>
  </section>

  <style>
    #boka-collection-scroll-{{ section.id }} {
      position: relative;
      width: 100%;
      overflow: hidden;
      background: {{ section.settings.default_background }};
      color: {{ section.settings.text_color }};
      scroll-behavior: smooth;
      font-family: var(--text-font-family, inherit);
    }

    #boka-collection-scroll-{{ section.id }} * {
      box-sizing: border-box;
      font-family: inherit;
    }

    #boka-collection-scroll-{{ section.id }} h1,
    #boka-collection-scroll-{{ section.id }} h2,
    #boka-collection-scroll-{{ section.id }} h3,
    #boka-collection-scroll-{{ section.id }} h4,
    #boka-collection-scroll-{{ section.id }} h5,
    #boka-collection-scroll-{{ section.id }} h6 {
      font-family: var(--heading-font-family, var(--text-font-family, inherit));
      font-style: var(--heading-font-style, normal);
      font-weight: var(--heading-font-weight, 700);
    }

    #boka-collection-scroll-{{ section.id }} p,
    #boka-collection-scroll-{{ section.id }} span,
    #boka-collection-scroll-{{ section.id }} small,
    #boka-collection-scroll-{{ section.id }} a,
    #boka-collection-scroll-{{ section.id }} button,
    #boka-collection-scroll-{{ section.id }} div {
      font-family: var(--text-font-family, inherit);
    }

    #boka-collection-scroll-{{ section.id }} .boka-collection-scroll__button {
      font-family: var(--button-font-family, var(--text-font-family, inherit));
      font-style: var(--button-font-style, normal);
      font-weight: var(--button-font-weight, 700);
    }

    #boka-collection-scroll-{{ section.id }} .boka-collection-scroll__hero,
    #boka-collection-scroll-{{ section.id }} .boka-collection-scroll__list-section,
    #boka-collection-scroll-{{ section.id }} .boka-collection-scroll__scene {
      width: 100vw;
      margin-left: calc(50% - 50vw);
    }

    #boka-collection-scroll-{{ section.id }} .boka-collection-scroll__hero {
      position: relative;
      min-height: clamp(760px, 98vh, 1080px);
      display: flex;
      align-items: center;
      overflow: hidden;
      isolation: isolate;
      background:
        linear-gradient(
          135deg,
          {{ section.settings.hero_background_1 }},
          {{ section.settings.hero_background_2 }}
        );
    }

    #boka-collection-scroll-{{ section.id }} .boka-collection-scroll__hero-photo {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-image: var(--hero-bg-image);
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      opacity: 1;
      transform: scale(1.02);
    }

    #boka-collection-scroll-{{ section.id }} .boka-collection-scroll__hero-photo-overlay {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background:
        linear-gradient(
          90deg,
          rgba(255, 246, 244, 0.9) 0%,
          rgba(255, 246, 244, 0.68) 34%,
          rgba(255, 246, 244, var(--hero-overlay-opacity)) 62%,
          rgba(255, 246, 244, 0.12) 100%
        ),
        radial-gradient(
          circle at 18% 22%,
          rgba(255, 255, 255, 0.72),
          transparent 28%
        ),
        radial-gradient(
          circle at 80% 68%,
          rgba(255, 158, 176, 0.24),
          transparent 34%
        );
    }

    #boka-collection-scroll-{{ section.id }} .boka-collection-scroll__hero-bg,
    #boka-collection-scroll-{{ section.id }} .boka-collection-scroll__scene-bg {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }

    #boka-collection-scroll-{{ section.id }} .boka-collection-scroll__hero-bg {
      z-index: 2;
    }

    #boka-collection-scroll-{{ section.id }} .boka-collection-scroll__blob,
    #boka-collection-scroll-{{ section.id }} .boka-collection-scroll__scene-blob {
      position: absolute;
      display: block;
      border-radius: 999px;
      filter: blur(2px);
      opacity: 0.56;
      animation: boka-scroll-blob-{{ section.id }} 8s ease-in-out infinite;
    }

    #boka-collection-scroll-{{ section.id }} .boka-collection-scroll__blob.is-one {
      width: 420px;
      height: 420px;
      left: -120px;
      top: 10%;
      background: {{ section.settings.hero_blob_1 }};
    }

    #boka-collection-scroll-{{ section.id }} .boka-collection-scroll__blob.is-two {
      width: 520px;
      height: 520px;
      right: -160px;
      bottom: -140px;
      background: {{ section.settings.hero_blob_2 }};
      animation-delay: -2s;
    }

    #boka-collection-scroll-{{ section.id }} .boka-collection-scroll__blob.is-three {
      width: 260px;
      height: 260px;
      right: 42%;
      top: 8%;
      background: {{ section.settings.hero_blob_3 }};
      animation-delay: -4s;
    }

    #boka-collection-scroll-{{ section.id }} .boka-collection-scroll__blob.is-four {
      width: 220px;
      height: 220px;
      left: 44%;
      bottom: 12%;
      background: {{ section.settings.hero_blob_4 }};
      animation-delay: -6s;
    }

    @keyframes boka-scroll-blob-{{ section.id }} {
      0% {
        transform: translateY(0) rotate(0deg) scale(1);
      }

      50% {
        transform: translateY(-22px) rotate(5deg) scale(1.04);
      }

      100% {
        transform: translateY(0) rotate(0deg) scale(1);
      }
    }

    #boka-collection-scroll-{{ section.id }} .boka-collection-scroll__hero-inner {
      position: relative;
      z-index: 3;
      width: min(1500px, calc(100% - 40px));
      margin: 0 auto;
      display: grid;
