{% comment %}
  Section: Product Scroll Character Story
  Updated:
  - Full-width hero section
  - Floating product/character cards in hero
  - Alternating timeline-style cards
  - Characters/products move down the page in a visual line
  - Hover image/GIF support
  - Product metafield driven content

  Recommended product metafields:
  - custom.flavor_scroll_headline
  - custom.flavor_scroll_description
  - custom.flavor_scroll_bullets
  - custom.character_name
  - custom.character_quote
  - custom.character_image
  - custom.character_hover_image
  - custom.flavor_accent_color
  - custom.flavor_background_color
{% endcomment %}

<section
  id="boka-character-story-{{ section.id }}"
  class="boka-character-story"
>
  <div class="boka-character-story__hero">
    <div class="boka-character-story__hero-bg">
      <span class="boka-character-story__hero-blob is-one"></span>
      <span class="boka-character-story__hero-blob is-two"></span>
      <span class="boka-character-story__hero-blob is-three"></span>
    </div>

    <div class="boka-character-story__hero-inner">
      <div class="boka-character-story__hero-copy">
        {% if section.settings.hero_eyebrow != blank %}
          <p class="boka-character-story__eyebrow">
            {{ section.settings.hero_eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.hero_heading != blank %}
          <h2>{{ section.settings.hero_heading }}</h2>
        {% endif %}

        {% if section.settings.hero_subheading != blank %}
          <p class="boka-character-story__hero-text">
            {{ section.settings.hero_subheading }}
          </p>
        {% endif %}

        {% if section.settings.hero_button_label != blank %}
          <a
            href="#boka-character-story-timeline-{{ section.id }}"
            class="boka-character-story__hero-button"
          >
            {{ section.settings.hero_button_label }}
          </a>
        {% endif %}
      </div>

      <div class="boka-character-story__hero-float-area">
        {% for block in section.blocks %}
          {% assign flavor_product = block.settings.product %}

          {% if flavor_product != blank %}
            {% assign loop_mod = forloop.index0 | modulo: 2 %}

            {% if loop_mod == 0 %}
              {% assign fallback_accent = section.settings.alt_accent_color_1 %}
              {% assign fallback_bg = section.settings.alt_background_color_1 %}
            {% else %}
              {% assign fallback_accent = section.settings.alt_accent_color_2 %}
              {% assign fallback_bg = section.settings.alt_background_color_2 %}
            {% endif %}

            {% assign character_name = flavor_product.metafields.custom.character_name.value | default: flavor_product.title %}
            {% assign character_image = flavor_product.metafields.custom.character_image.value %}
            {% assign metafield_accent = flavor_product.metafields.custom.flavor_accent_color.value %}
            {% assign metafield_bg = flavor_product.metafields.custom.flavor_background_color.value %}

            {% if section.settings.enable_metafield_color_overrides and metafield_accent != blank %}
              {% assign accent_color = metafield_accent %}
            {% else %}
              {% assign accent_color = block.settings.fallback_accent_color | default: fallback_accent %}
            {% endif %}

            {% if section.settings.enable_metafield_color_overrides and metafield_bg != blank %}
              {% assign background_color = metafield_bg %}
            {% else %}
              {% assign background_color = block.settings.fallback_background_color | default: fallback_bg %}
            {% endif %}

            {% if character_image != blank %}
              {% assign character_image_url = character_image | image_url: width: 700 %}
            {% elsif block.settings.fallback_character_image != blank %}
              {% assign character_image_url = block.settings.fallback_character_image | image_url: width: 700 %}
            {% elsif flavor_product.featured_image != blank %}
              {% assign character_image_url = flavor_product.featured_image | image_url: width: 700 %}
            {% else %}
              {% assign character_image_url = blank %}
            {% endif %}

            <a
              href="{{ flavor_product.url }}"
              class="boka-character-story__floating-card is-float-{{ forloop.index }}"
              style="
                --float-accent: {{ accent_color }};
                --float-bg: {{ background_color }};
              "
              {{ block.shopify_attributes }}
            >
              {% if character_image_url != blank %}
                <img
                  src="{{ character_image_url }}"
                  alt="{{ character_name | escape }}"
                  loading="lazy"
                >
              {% endif %}

              <span>{{ character_name }}</span>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div
    id="boka-character-story-timeline-{{ section.id }}"
    class="boka-character-story__timeline-wrap"
  >
    <div class="boka-character-story__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="boka-character-story__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="boka-character-story__timeline">
      <div class="boka-character-story__timeline-line"></div>

      {% for block in section.blocks %}
        {% assign flavor_product = block.settings.product %}

        {% if flavor_product != blank %}
          {% assign remainder = forloop.index0 | modulo: 2 %}

          {% if remainder == 0 %}
            {% assign card_position_class = 'is-left' %}
            {% assign fallback_accent = section.settings.alt_accent_color_1 %}
            {% assign fallback_bg = section.settings.alt_background_color_1 %}
          {% else %}
            {% assign card_position_class = 'is-right' %}
            {% assign fallback_accent = section.settings.alt_accent_color_2 %}
            {% assign fallback_bg = section.settings.alt_background_color_2 %}
          {% endif %}

          {% assign headline = flavor_product.metafields.custom.flavor_scroll_headline.value | default: flavor_product.title %}
          {% assign description = flavor_product.metafields.custom.flavor_scroll_description.value | default: flavor_product.description | strip_html %}
          {% assign bullets = flavor_product.metafields.custom.flavor_scroll_bullets.value %}
          {% assign character_name = flavor_product.metafields.custom.character_name.value | default: flavor_product.title %}
          {% assign character_quote = flavor_product.metafields.custom.character_quote.value | default: block.settings.fallback_quote %}

          {% assign metafield_accent = flavor_product.metafields.custom.flavor_accent_color.value %}
          {% assign metafield_bg = flavor_product.metafields.custom.flavor_background_color.value %}

          {% if section.settings.enable_metafield_color_overrides and metafield_accent != blank %}
            {% assign accent_color = metafield_accent %}
          {% else %}
            {% assign accent_color = block.settings.fallback_accent_color | default: fallback_accent %}
          {% endif %}

          {% if section.settings.enable_metafield_color_overrides and metafield_bg != blank %}
            {% assign background_color = metafield_bg %}
          {% else %}
            {% assign background_color = block.settings.fallback_background_color | default: fallback_bg %}
          {% endif %}

          {% assign character_image = flavor_product.metafields.custom.character_image.value %}
          {% assign character_hover_image = flavor_product.metafields.custom.character_hover_image.value %}

          {% if character_image != blank %}
            {% assign character_image_url = character_image | image_url: width: 900 %}
          {% elsif block.settings.fallback_character_image != blank %}
            {% assign character_image_url = block.settings.fallback_character_image | image_url: width: 900 %}
          {% elsif flavor_product.featured_image != blank %}
            {% assign character_image_url = flavor_product.featured_image | image_url: width: 900 %}
          {% else %}
            {% assign character_image_url = blank %}
          {% endif %}

          {% if character_hover_image != blank %}
            {% assign character_hover_image_url = character_hover_image | image_url: width: 900 %}
          {% elsif block.settings.fallback_hover_image != blank %}
            {% assign character_hover_image_url = block.settings.fallback_hover_image | image_url: width: 900 %}
          {% else %}
            {% assign character_hover_image_url = character_image_url %}
          {% endif %}

          <article
            class="boka-character-story__timeline-item {{ card_position_class }}"
            style="
              --flavor-accent: {{ accent_color }};
              --flavor-bg: {{ background_color }};
            "
            data-default-src="{{ character_image_url }}"
            data-hover-src="{{ character_hover_image_url }}"
          >
            <div class="boka-character-story__timeline-dot">
              <span></span>
            </div>

            <div class="boka-character-story__card">
              <div class="boka-character-story__visual">
                <div class="boka-character-story__visual-bg"></div>

                {% if character_image_url != blank %}
                  <img
                    class="boka-character-story__character-img"
                    src="{{ character_image_url }}"
                    alt="{{ character_name | escape }}"
                    loading="lazy"
                  >
                {% endif %}
              </div>

              <div class="boka-character-story__content">
                <p class="boka-character-story__scene-label">
                  {{ block.settings.scene_label | default: 'Flavor profile' }}
                </p>

                <h3>{{ headline }}</h3>

                {% if description != blank %}
                  <p class="boka-character-story__description">
                    {{ description }}
                  </p>
                {% endif %}

                {% if character_quote != blank %}
                  <p class="boka-character-story__quote">
                    {{ character_quote }}
                  </p>
                {% endif %}

                {% if bullets != blank %}
                  <div class="boka-character-story__bullets">
                    {% for bullet in bullets %}
                      <div class="boka-character-story__bullet">
                        <span></span>
                        <p>{{ bullet }}</p>
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}

                <div class="boka-character-story__product-mini">
                  {% if flavor_product.featured_image != blank %}
                    <div class="boka-character-story__product-mini-image">
                      <img
                        src="{{ flavor_product.featured_image | image_url: width: 400 }}"
                        alt="{{ flavor_product.featured_image.alt | default: flavor_product.title | escape }}"
                        loading="lazy"
                      >
                    </div>
                  {% endif %}

                  <div>
                    <p>{{ flavor_product.title }}</p>

                    {% if flavor_product.price %}
                      <span>{{ flavor_product.price | money }}</span>
                    {% endif %}
                  </div>

                  <a href="{{ flavor_product.url }}" class="boka-character-story__button">
                    {{ section.settings.card_button_label }}
                  </a>
                </div>
              </div>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #boka-character-story-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ section.settings.default_background }};
    color: {{ section.settings.text_color }};
  }

  #boka-character-story-{{ section.id }} * {
    box-sizing: border-box;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    min-height: clamp(680px, 92vh, 980px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
      linear-gradient(
        135deg,
        {{ section.settings.hero_background_1 }},
        {{ section.settings.hero_background_2 }}
      );
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-blob {
    position: absolute;
    display: block;
    border-radius: 999px;
    opacity: 0.55;
    filter: blur(2px);
    animation: boka-hero-float-{{ section.id }} 7s ease-in-out infinite;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-blob.is-one {
    width: 360px;
    height: 360px;
    left: -100px;
    top: 8%;
    background: {{ section.settings.hero_blob_1 }};
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-blob.is-two {
    width: 460px;
    height: 460px;
    right: -140px;
    bottom: -120px;
    background: {{ section.settings.hero_blob_2 }};
    animation-delay: -2s;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-blob.is-three {
    width: 220px;
    height: 220px;
    right: 42%;
    top: 10%;
    background: {{ section.settings.hero_blob_3 }};
    animation-delay: -4s;
  }

  @keyframes boka-hero-float-{{ section.id }} {
    0% {
      transform: translateY(0) rotate(0deg);
    }

    50% {
      transform: translateY(-18px) rotate(4deg);
    }

    100% {
      transform: translateY(0) rotate(0deg);
    }
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-inner {
    position: relative;
    z-index: 2;
    width: min(1440px, calc(100% - 40px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(420px, 1.12fr);
    gap: clamp(36px, 6vw, 96px);
    align-items: center;
    padding: clamp(56px, 8vw, 120px) 0;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-copy {
    position: relative;
    z-index: 3;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__eyebrow,
  #boka-character-story-{{ section.id }} .boka-character-story__scene-label {
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: 0.76rem;
    line-height: 1.2;
    font-weight: 700;
    color: {{ section.settings.muted_text_color }};
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-copy h2 {
    margin: 0;
    max-width: 760px;
    font-size: clamp(3.4rem, 8vw, 9.6rem);
    line-height: 0.86;
    letter-spacing: -0.075em;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-text {
    margin: 24px 0 0;
    max-width: 560px;
    color: {{ section.settings.muted_text_color }};
    font-size: clamp(1.05rem, 1.5vw, 1.32rem);
    line-height: 1.55;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-button,
  #boka-character-story-{{ section.id }} .boka-character-story__button {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    font-weight: 700;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-button {
    min-height: 50px;
    padding: 0 26px;
    margin-top: 32px;
    font-size: 0.95rem;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__button {
    min-height: 40px;
    padding: 0 18px;
    font-size: 0.88rem;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-button:hover,
  #boka-character-story-{{ section.id }} .boka-character-story__button:hover {
    transform: translateY(-2px);
    opacity: 0.88;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-float-area {
    position: relative;
    min-height: 620px;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__floating-card {
    position: absolute;
    width: clamp(130px, 13vw, 220px);
    min-height: clamp(160px, 16vw, 270px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 18px;
    border-radius: 30px;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--float-bg) 86%, white),
        color-mix(in srgb, var(--float-accent) 28%, white)
      );
    box-shadow: 0 22px 70px rgba(17, 17, 17, 0.1);
    text-decoration: none;
    color: {{ section.settings.text_color }};
    animation: boka-floating-card-{{ section.id }} 5.5s ease-in-out infinite;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__floating-card img {
    width: 82%;
    max-height: 170px;
    object-fit: contain;
    display: block;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__floating-card span {
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__floating-card:hover {
    transform: translateY(-6px) rotate(0deg);
  }

  #boka-character-story-{{ section.id }} .boka-character-story__floating-card.is-float-1 {
    left: 4%;
    top: 5%;
    rotate: -5deg;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__floating-card.is-float-2 {
    right: 10%;
    top: 2%;
    rotate: 4deg;
    animation-delay: -1s;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__floating-card.is-float-3 {
    left: 34%;
    top: 34%;
    rotate: 2deg;
    animation-delay: -2s;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__floating-card.is-float-4 {
    left: 0;
    bottom: 6%;
    rotate: 5deg;
    animation-delay: -3s;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__floating-card.is-float-5 {
    right: 2%;
    bottom: 10%;
    rotate: -4deg;
    animation-delay: -4s;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__floating-card.is-float-6 {
    right: 35%;
    bottom: 0;
    rotate: 3deg;
    animation-delay: -5s;
  }

  @keyframes boka-floating-card-{{ section.id }} {
    0% {
      translate: 0 0;
    }

    50% {
      translate: 0 -16px;
    }

    100% {
      translate: 0 0;
    }
  }

  #boka-character-story-{{ section.id }} .boka-character-story__timeline-wrap {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding: clamp(64px, 9vw, 130px) 0;
    background: {{ section.settings.default_background }};
  }

  #boka-character-story-{{ section.id }} .boka-character-story__intro {
    width: min(900px, calc(100% - 40px));
    margin: 0 auto clamp(52px, 8vw, 110px);
    text-align: center;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__intro h2 {
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__intro > p:not(.boka-character-story__eyebrow) {
    margin: 18px auto 0;
    max-width: 660px;
    color: {{ section.settings.muted_text_color }};
    font-size: clamp(1rem, 1.35vw, 1.22rem);
    line-height: 1.55;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__timeline {
    position: relative;
    width: min(1280px, calc(100% - 40px));
    margin: 0 auto;
    display: grid;
    gap: clamp(48px, 9vw, 120px);
  }

  #boka-character-story-{{ section.id }} .boka-character-story__timeline-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 3px;
    transform: translateX(-50%);
    background:
      linear-gradient(
        to bottom,
        transparent,
        {{ section.settings.timeline_line_color }} 8%,
        {{ section.settings.timeline_line_color }} 92%,
        transparent
      );
    opacity: 0.45;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 72px minmax(0, 1fr);
    align-items: center;
    opacity: 0.42;
    transform: translateY(42px);
    transition:
      opacity 320ms ease,
      transform 320ms ease;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__timeline-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  #boka-character-story-{{ section.id }} .boka-character-story__timeline-item.is-left .boka-character-story__card {
    grid-column: 1 / 2;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__timeline-item.is-right .boka-character-story__card {
    grid-column: 3 / 4;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__timeline-dot {
    position: relative;
    z-index: 3;
    grid-column: 2 / 3;
    grid-row: 1;
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__timeline-dot span {
    width: 22px;
    height: 22px;
    display: block;
    border-radius: 999px;
    background: var(--flavor-accent);
    box-shadow:
      0 0 0 10px color-mix(in srgb, var(--flavor-accent) 26%, white),
      0 12px 34px rgba(17, 17, 17, 0.12);
  }

  #boka-character-story-{{ section.id }} .boka-character-story__card {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(150px, 0.38fr) minmax(0, 0.62fr);
    gap: clamp(18px, 3vw, 36px);
    align-items: center;
    min-height: 480px;
    padding: clamp(24px, 4vw, 52px);
    border-radius: 44px;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--flavor-bg) 84%, white),
        color-mix(in srgb, var(--flavor-accent) 26%, white)
      );
    border: 1px solid color-mix(in srgb, var(--flavor-accent) 42%, white);
    box-shadow: 0 24px 90px rgba(17, 17, 17, 0.08);
  }

  #boka-character-story-{{ section.id }} .boka-character-story__timeline-item.is-right .boka-character-story__card {
    grid-template-columns: minmax(0, 0.62fr) minmax(150px, 0.38fr);
  }

  #boka-character-story-{{ section.id }} .boka-character-story__timeline-item.is-right .boka-character-story__visual {
    order: 2;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__timeline-item.is-right .boka-character-story__content {
    order: 1;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__visual {
    position: relative;
    min-height: 360px;
    display: grid;
    place-items: center;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__visual-bg {
    position: absolute;
    inset: 10%;
    border-radius: 999px;
    background: var(--flavor-accent);
    opacity: 0.32;
    filter: blur(2px);
  }

  #boka-character-story-{{ section.id }} .boka-character-story__character-img {
    position: relative;
    z-index: 2;
    width: min(94%, 280px);
    max-height: 340px;
    object-fit: contain;
    transition:
      opacity 180ms ease,
      transform 220ms ease;
    animation: boka-character-float-{{ section.id }} 4.8s ease-in-out infinite;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__card:hover .boka-character-story__character-img {
    transform: translateY(-6px) scale(1.03);
  }

  @keyframes boka-character-float-{{ section.id }} {
    0% {
