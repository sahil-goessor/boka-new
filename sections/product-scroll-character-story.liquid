    #boka-character-story-{{ section.id }} *::before,
    #boka-character-story-{{ section.id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

<script>
  (() => {
    const section = document.querySelector('#boka-character-story-{{ section.id }}');
    if (!section) return;

    const items = Array.from(section.querySelectorAll('.boka-character-story__timeline-item'));

    if (!items.length) return;

    const visibilityObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle('is-visible', entry.isIntersecting);
      });
    }, {
      root: null,
      threshold: 0.24
    });

    items.forEach((item) => visibilityObserver.observe(item));

    const cards = Array.from(section.querySelectorAll('.boka-character-story__card'));

    cards.forEach((card) => {
      const item = card.closest('.boka-character-story__timeline-item');
      const image = card.querySelector('.boka-character-story__character-img');

      if (!item || !image) return;

      const defaultSrc = item.dataset.defaultSrc;
      const hoverSrc = item.dataset.hoverSrc || defaultSrc;

      card.addEventListener('mouseenter', () => {
        if (window.innerWidth < 900) return;
        if (!hoverSrc || image.getAttribute('src') === hoverSrc) return;
        image.style.opacity = '0';

        window.setTimeout(() => {
          image.setAttribute('src', hoverSrc);
          image.style.opacity = '1';
        }, 120);
      });

      card.addEventListener('mouseleave', () => {
        if (!defaultSrc || image.getAttribute('src') === defaultSrc) return;
        image.style.opacity = '0';

        window.setTimeout(() => {
          image.setAttribute('src', defaultSrc);
          image.style.opacity = '1';
        }, 120);
      });
    });
  })();
</script>

