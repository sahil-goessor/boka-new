{% comment %}
  Section: Collection Scroll Flavor World
  Best used on Shopify collection templates.

  What it does:
  - Uses the current collection's products
  - Full-width immersive hero
  - Floating product / character cards
  - Sticky scroll scene switcher
  - Product content changes as user scrolls
  - Hover image / GIF support
  - Product metafield driven content

  Recommended product metafields:
  - custom.flavor_scroll_headline        Single line text
  - custom.flavor_scroll_description     Multi-line text
  - custom.flavor_scroll_bullets         List of single line text
  - custom.character_name                Single line text
  - custom.character_quote               Single line text
  - custom.character_image               File
  - custom.character_hover_image         File
  - custom.flavor_accent_color           Color
  - custom.flavor_background_color       Color

  Optional collection metafields:
  - custom.scroll_hero_eyebrow           Single line text
  - custom.scroll_hero_heading           Single line text
  - custom.scroll_hero_text              Multi-line text
{% endcomment %}

{% liquid
  assign active_collection = collection
  assign products_to_show = section.settings.product_limit

  assign hero_eyebrow = active_collection.metafields.custom.scroll_hero_eyebrow.value | default: section.settings.hero_eyebrow
  assign hero_heading = active_collection.metafields.custom.scroll_hero_heading.value | default: section.settings.hero_heading
  assign hero_text = active_collection.metafields.custom.scroll_hero_text.value | default: section.settings.hero_subheading
%}

{% if active_collection != blank and active_collection.products_count > 0 %}
  <section
    id="boka-collection-world-{{ section.id }}"
    class="boka-collection-world"
  >
    <div class="boka-collection-world__hero">
      <div class="boka-collection-world__hero-sky">
        <span class="boka-collection-world__blob is-one"></span>
        <span class="boka-collection-world__blob is-two"></span>
        <span class="boka-collection-world__blob is-three"></span>
        <span class="boka-collection-world__blob is-four"></span>
      </div>

      <div class="boka-collection-world__hero-inner">
        <div class="boka-collection-world__hero-copy">
          {% if hero_eyebrow != blank %}
            <p class="boka-collection-world__eyebrow">
              {{ hero_eyebrow }}
            </p>
          {% endif %}

          {% if hero_heading != blank %}
            <h1>{{ hero_heading }}</h1>
          {% else %}
            <h1>{{ active_collection.title }}</h1>
          {% endif %}

          {% if hero_text != blank %}
            <p class="boka-collection-world__hero-text">
              {{ hero_text }}
            </p>
          {% endif %}

          {% if section.settings.hero_button_label != blank %}
            <a
              href="#boka-collection-world-scenes-{{ section.id }}"
              class="boka-collection-world__button"
            >
              {{ section.settings.hero_button_label }}
            </a>
          {% endif %}
        </div>

        <div class="boka-collection-world__float-stage">
          {% for flavor_product in active_collection.products limit: products_to_show %}
            {% liquid
              assign loop_mod = forloop.index0 | modulo: 2

              if loop_mod == 0
                assign fallback_accent = section.settings.alt_accent_color_1
                assign fallback_bg = section.settings.alt_background_color_1
              else
                assign fallback_accent = section.settings.alt_accent_color_2
                assign fallback_bg = section.settings.alt_background_color_2
              endif

              assign character_name = flavor_product.metafields.custom.character_name.value | default: flavor_product.title
              assign character_image = flavor_product.metafields.custom.character_image.value
              assign metafield_accent = flavor_product.metafields.custom.flavor_accent_color.value
              assign metafield_bg = flavor_product.metafields.custom.flavor_background_color.value

              if section.settings.enable_metafield_color_overrides and metafield_accent != blank
                assign accent_color = metafield_accent
              else
                assign accent_color = fallback_accent
              endif

              if section.settings.enable_metafield_color_overrides and metafield_bg != blank
                assign background_color = metafield_bg
              else
                assign background_color = fallback_bg
              endif

              if character_image != blank
                assign character_image_url = character_image | image_url: width: 700
              elsif flavor_product.featured_image != blank
                assign character_image_url = flavor_product.featured_image | image_url: width: 700
              else
                assign character_image_url = blank
              endif
            %}

            <a
              href="{{ flavor_product.url }}"
              class="boka-collection-world__float-card is-float-{{ forloop.index }}"
              style="
                --float-accent: {{ accent_color }};
                --float-bg: {{ background_color }};
              "
            >
              {% if character_image_url != blank %}
                <img
                  src="{{ character_image_url }}"
                  alt="{{ character_name | escape }}"
                  loading="lazy"
                >
              {% endif %}

              <span>{{ character_name }}</span>
            </a>
          {% endfor %}
        </div>
      </div>

      <div class="boka-collection-world__curve" aria-hidden="true">
        <svg viewBox="0 0 1440 140" preserveAspectRatio="none">
          <path d="M0,80 C180,130 360,130 540,80 C720,30 900,30 1080,80 C1260,130 1350,110 1440,80 L1440,140 L0,140 Z"></path>
        </svg>
      </div>
    </div>

    <div
      id="boka-collection-world-scenes-{{ section.id }}"
      class="boka-collection-world__scene-section"
    >
      <div class="boka-collection-world__intro">
        {% if section.settings.scene_eyebrow != blank %}
          <p class="boka-collection-world__eyebrow">
            {{ section.settings.scene_eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.scene_heading != blank %}
          <h2>{{ section.settings.scene_heading }}</h2>
        {% endif %}

        {% if section.settings.scene_text != blank %}
          <p>{{ section.settings.scene_text }}</p>
        {% endif %}
      </div>

      <div class="boka-collection-world__sticky-wrap">
        <div class="boka-collection-world__sticky-stage">
          <div class="boka-collection-world__stage-bg"></div>

          <div class="boka-collection-world__stage-inner">
            <div class="boka-collection-world__stage-copy">
              <p class="boka-collection-world__active-kicker"></p>
              <h3 class="boka-collection-world__active-title"></h3>
              <p class="boka-collection-world__active-description"></p>
              <p class="boka-collection-world__active-quote"></p>

              <div class="boka-collection-world__active-bullets"></div>

              <div class="boka-collection-world__active-product">
                <div class="boka-collection-world__active-product-image-wrap">
                  <img
                    class="boka-collection-world__active-product-image"
                    src=""
                    alt=""
                    loading="lazy"
                  >
                </div>

                <div>
                  <p class="boka-collection-world__active-product-title"></p>
                  <span class="boka-collection-world__active-product-price"></span>
                </div>

                <a class="boka-collection-world__active-link" href="#">
                  {{ section.settings.product_button_label }}
                </a>
              </div>
            </div>

            <div class="boka-collection-world__stage-visual">
              <div class="boka-collection-world__visual-orbit">
                <span></span>
                <span></span>
                <span></span>
              </div>

              <img
                class="boka-collection-world__active-character"
                src=""
                alt=""
                loading="lazy"
              >
            </div>
          </div>

          <div class="boka-collection-world__flavor-nav">
            {% for flavor_product in active_collection.products limit: products_to_show %}
              {% liquid
                assign character_name = flavor_product.metafields.custom.character_name.value | default: flavor_product.title
                assign metafield_accent = flavor_product.metafields.custom.flavor_accent_color.value

                assign loop_mod = forloop.index0 | modulo: 2
                if loop_mod == 0
                  assign fallback_accent = section.settings.alt_accent_color_1
                else
                  assign fallback_accent = section.settings.alt_accent_color_2
                endif

                if section.settings.enable_metafield_color_overrides and metafield_accent != blank
                  assign nav_accent = metafield_accent
                else
                  assign nav_accent = fallback_accent
                endif
              %}

              <button
                type="button"
                class="boka-collection-world__flavor-dot"
                data-scene-index="{{ forloop.index0 }}"
                style="--dot-color: {{ nav_accent }};"
                aria-label="{{ character_name | escape }}"
              >
                <span></span>
              </button>
            {% endfor %}
          </div>
        </div>

        <div class="boka-collection-world__scroll-scenes">
          {% for flavor_product in active_collection.products limit: products_to_show %}
            {% liquid
              assign loop_mod = forloop.index0 | modulo: 2

              if loop_mod == 0
                assign fallback_accent = section.settings.alt_accent_color_1
                assign fallback_bg = section.settings.alt_background_color_1
              else
                assign fallback_accent = section.settings.alt_accent_color_2
                assign fallback_bg = section.settings.alt_background_color_2
              endif

              assign headline = flavor_product.metafields.custom.flavor_scroll_headline.value | default: flavor_product.title
              assign description = flavor_product.metafields.custom.flavor_scroll_description.value | default: flavor_product.description | strip_html | truncate: 340
              assign bullets = flavor_product.metafields.custom.flavor_scroll_bullets.value
              assign character_name = flavor_product.metafields.custom.character_name.value | default: flavor_product.title
              assign character_quote = flavor_product.metafields.custom.character_quote.value

              assign metafield_accent = flavor_product.metafields.custom.flavor_accent_color.value
              assign metafield_bg = flavor_product.metafields.custom.flavor_background_color.value

              if section.settings.enable_metafield_color_overrides and metafield_accent != blank
                assign accent_color = metafield_accent
              else
                assign accent_color = fallback_accent
              endif

              if section.settings.enable_metafield_color_overrides and metafield_bg != blank
                assign background_color = metafield_bg
              else
                assign background_color = fallback_bg
              endif

              assign character_image = flavor_product.metafields.custom.character_image.value
              assign character_hover_image = flavor_product.metafields.custom.character_hover_image.value

              if character_image != blank
                assign character_image_url = character_image | image_url: width: 1100
              elsif flavor_product.featured_image != blank
                assign character_image_url = flavor_product.featured_image | image_url: width: 1100
              else
                assign character_image_url = blank
              endif

              if character_hover_image != blank
                assign character_hover_image_url = character_hover_image | image_url: width: 1100
              else
                assign character_hover_image_url = character_image_url
              endif

              if flavor_product.featured_image != blank
                assign product_image_url = flavor_product.featured_image | image_url: width: 500
              else
                assign product_image_url = character_image_url
              endif

              assign bullet_string = ''
              if bullets != blank
                for bullet in bullets
                  assign clean_bullet = bullet | strip_html | escape
                  if forloop.first
                    assign bullet_string = clean_bullet
                  else
                    assign bullet_string = bullet_string | append: '||' | append: clean_bullet
                  endif
                endfor
              endif
            %}

            <article
              class="boka-collection-world__scene-trigger"
              data-index="{{ forloop.index0 }}"
              data-kicker="{{ section.settings.scene_card_label | escape }}"
              data-title="{{ headline | strip_html | escape }}"
              data-description="{{ description | strip_html | escape }}"
              data-quote="{{ character_quote | strip_html | escape }}"
              data-bullets="{{ bullet_string }}"
              data-character-src="{{ character_image_url }}"
              data-character-hover-src="{{ character_hover_image_url }}"
              data-character-alt="{{ character_name | escape }}"
              data-product-src="{{ product_image_url }}"
              data-product-alt="{{ flavor_product.title | escape }}"
              data-product-title="{{ flavor_product.title | escape }}"
              data-product-price="{{ flavor_product.price | money | escape }}"
              data-product-url="{{ flavor_product.url }}"
              data-accent="{{ accent_color }}"
              data-bg="{{ background_color }}"
            >
              <div class="boka-collection-world__scene-marker">
                <span>{{ forloop.index }}</span>
                <p>{{ character_name }}</p>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <style>
    #boka-collection-world-{{ section.id }} {
      position: relative;
      overflow: hidden;
      background: {{ section.settings.default_background }};
      color: {{ section.settings.text_color }};
    }

    #boka-collection-world-{{ section.id }} * {
      box-sizing: border-box;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__hero {
      position: relative;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      min-height: clamp(720px, 96vh, 1040px);
      display: flex;
      align-items: center;
      overflow: hidden;
      background:
        linear-gradient(
          135deg,
          {{ section.settings.hero_background_1 }},
          {{ section.settings.hero_background_2 }}
        );
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__hero-sky {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__blob {
      position: absolute;
      display: block;
      border-radius: 999px;
      opacity: 0.56;
      filter: blur(2px);
      animation: boka-world-blob-{{ section.id }} 8s ease-in-out infinite;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__blob.is-one {
      width: 420px;
      height: 420px;
      left: -120px;
      top: 10%;
      background: {{ section.settings.hero_blob_1 }};
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__blob.is-two {
      width: 520px;
      height: 520px;
      right: -160px;
      bottom: -140px;
      background: {{ section.settings.hero_blob_2 }};
      animation-delay: -2s;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__blob.is-three {
      width: 260px;
      height: 260px;
      right: 42%;
      top: 8%;
      background: {{ section.settings.hero_blob_3 }};
      animation-delay: -4s;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__blob.is-four {
      width: 220px;
      height: 220px;
      left: 44%;
      bottom: 12%;
      background: {{ section.settings.hero_blob_4 }};
      animation-delay: -6s;
    }

    @keyframes boka-world-blob-{{ section.id }} {
      0% {
        transform: translateY(0) rotate(0deg) scale(1);
      }

      50% {
        transform: translateY(-22px) rotate(5deg) scale(1.04);
      }

      100% {
        transform: translateY(0) rotate(0deg) scale(1);
      }
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__hero-inner {
      position: relative;
      z-index: 2;
      width: min(1500px, calc(100% - 40px));
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 0.84fr) minmax(440px, 1.16fr);
      gap: clamp(36px, 6vw, 100px);
      align-items: center;
      padding: clamp(72px, 9vw, 140px) 0;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__eyebrow {
      margin: 0 0 14px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-size: 0.76rem;
      line-height: 1.2;
      font-weight: 800;
      color: {{ section.settings.muted_text_color }};
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__hero-copy h1 {
      margin: 0;
      max-width: 780px;
      font-size: clamp(3.6rem, 8.4vw, 10.6rem);
      line-height: 0.84;
      letter-spacing: -0.08em;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__hero-text {
      margin: 26px 0 0;
      max-width: 590px;
      color: {{ section.settings.muted_text_color }};
      font-size: clamp(1.08rem, 1.5vw, 1.35rem);
      line-height: 1.55;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__button,
    #boka-collection-world-{{ section.id }} .boka-collection-world__active-link {
      width: fit-content;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: {{ section.settings.button_background }};
      color: {{ section.settings.button_text_color }};
      text-decoration: none;
      font-weight: 800;
      transition: transform 180ms ease, opacity 180ms ease;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__button {
      min-height: 52px;
      padding: 0 28px;
      margin-top: 34px;
      font-size: 0.96rem;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__active-link {
      min-height: 42px;
      padding: 0 20px;
      font-size: 0.88rem;
      white-space: nowrap;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__button:hover,
    #boka-collection-world-{{ section.id }} .boka-collection-world__active-link:hover {
      transform: translateY(-2px);
      opacity: 0.88;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__float-stage {
      position: relative;
      min-height: 640px;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__float-card {
      position: absolute;
      width: clamp(140px, 13vw, 228px);
      min-height: clamp(170px, 16vw, 280px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      padding: 18px;
      border-radius: 34px;
      background:
        linear-gradient(
          135deg,
          color-mix(in srgb, var(--float-bg) 88%, white),
          color-mix(in srgb, var(--float-accent) 30%, white)
        );
      box-shadow: 0 24px 80px rgba(17, 17, 17, 0.1);
      text-decoration: none;
      color: {{ section.settings.text_color }};
      animation: boka-world-float-card-{{ section.id }} 5.8s ease-in-out infinite;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__float-card img {
      width: 84%;
      max-height: 175px;
      object-fit: contain;
      display: block;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__float-card span {
      font-size: 0.92rem;
      font-weight: 800;
      line-height: 1.15;
      text-align: center;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__float-card:hover {
      z-index: 6;
      transform: translateY(-8px) rotate(0deg);
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__float-card.is-float-1 {
      left: 4%;
      top: 4%;
      rotate: -5deg;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__float-card.is-float-2 {
      right: 8%;
      top: 2%;
      rotate: 4deg;
      animation-delay: -1s;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__float-card.is-float-3 {
      left: 34%;
      top: 34%;
      rotate: 2deg;
      animation-delay: -2s;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__float-card.is-float-4 {
      left: 0;
      bottom: 6%;
      rotate: 5deg;
      animation-delay: -3s;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__float-card.is-float-5 {
      right: 2%;
      bottom: 10%;
      rotate: -4deg;
      animation-delay: -4s;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__float-card.is-float-6 {
      right: 36%;
      bottom: 0;
      rotate: 3deg;
      animation-delay: -5s;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__float-card.is-float-7 {
      right: 42%;
      top: 0;
      rotate: -2deg;
      animation-delay: -2.5s;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__float-card.is-float-8 {
      left: 22%;
      bottom: 0;
      rotate: 4deg;
      animation-delay: -3.5s;
    }

    @keyframes boka-world-float-card-{{ section.id }} {
      0% {
        translate: 0 0;
      }

      50% {
        translate: 0 -18px;
      }

      100% {
        translate: 0 0;
      }
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__curve {
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 140px;
      z-index: 3;
      color: {{ section.settings.default_background }};
      pointer-events: none;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__curve svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__curve path {
      fill: currentColor;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__scene-section {
      width: 100vw;
      margin-left: calc(50% - 50vw);
      background: {{ section.settings.default_background }};
      padding: clamp(60px, 8vw, 118px) 0 clamp(72px, 10vw, 150px);
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__intro {
      width: min(900px, calc(100% - 40px));
      margin: 0 auto clamp(48px, 7vw, 96px);
      text-align: center;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__intro h2 {
      margin: 0;
      font-size: clamp(2.7rem, 6.4vw, 7.4rem);
      line-height: 0.9;
      letter-spacing: -0.065em;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__intro > p:not(.boka-collection-world__eyebrow) {
      margin: 18px auto 0;
      max-width: 690px;
      color: {{ section.settings.muted_text_color }};
      font-size: clamp(1rem, 1.35vw, 1.22rem);
      line-height: 1.58;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__sticky-wrap {
      position: relative;
      width: min(1340px, calc(100% - 40px));
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__sticky-stage {
      position: sticky;
      top: 92px;
      z-index: 4;
      min-height: calc(100vh - 120px);
      border-radius: clamp(32px, 5vw, 64px);
      overflow: hidden;
      background: var(--active-bg, {{ section.settings.alt_background_color_1 }});
      box-shadow: 0 28px 100px rgba(17, 17, 17, 0.08);
      transition: background 260ms ease;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__stage-bg {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 78% 24%, color-mix(in srgb, var(--active-accent, {{ section.settings.alt_accent_color_1 }}) 34%, transparent), transparent 28%),
        radial-gradient(circle at 18% 78%, rgba(255,255,255,0.62), transparent 32%);
      pointer-events: none;
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__stage-inner {
      position: relative;
      z-index: 2;
      min-height: calc(100vh - 120px);
      display: grid;
      grid-template-columns: minmax(0, 0.92fr) minmax(360px, 1.08fr);
      gap: clamp(28px, 5vw, 80px);
      align-items: center;
      padding: clamp(28px, 5vw, 72px);
    }

    #boka-collection-world-{{ section.id }} .boka-collection-world__active-kicker {
      margin: 0 0 12px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-size: 0.75rem;
      line-height: 1.2;
      font-weight: 800;
