        transition: none !important;
        scroll-behavior: auto !important;
      }
    }
  </style>

  <script>
    (() => {
      const section = document.querySelector('#boka-collection-scroll-{{ section.id }}');
      if (!section) return;

      const quiz = section.querySelector('.boka-collection-scroll__quiz');

      if (quiz) {
        const questions = Array.from(quiz.querySelectorAll('.boka-collection-scroll__quiz-question'));
        const progress = quiz.querySelector('.js-boka-quiz-progress');
        const stepLabel = quiz.querySelector('.js-boka-quiz-step');
        const navLabel = quiz.querySelector('.js-boka-quiz-nav-label');
        const backButton = quiz.querySelector('.js-boka-quiz-back');
        const nextButton = quiz.querySelector('.js-boka-quiz-next');
        const totalQuestions = questions.length;
        const productCount = parseInt(quiz.dataset.productCount, 10) || 1;
        const scores = {};
        const answers = {};
        let currentQuestion = 1;
        let activeProductIndex = 1;

        const getSafeProductIndex = (rawIndex) => {
          const requestedIndex = parseInt(rawIndex, 10) || 1;

          if (requestedIndex >= 1 && requestedIndex <= productCount) {
            return requestedIndex;
          }

          return ((requestedIndex - 1) % productCount) + 1;
        };

        const updateMatch = () => {
          let winningIndex = activeProductIndex;
          let winningScore = -1;

          Object.keys(scores).forEach((index) => {
            const score = scores[index];
            const numericIndex = parseInt(index, 10);

            if (score > winningScore) {
              winningScore = score;
              winningIndex = numericIndex;
            }
          });

          activeProductIndex = getSafeProductIndex(winningIndex);
        };

        const scrollToMatchedProduct = () => {
          updateMatch();

          const target = section.querySelector(`#boka-product-scene-{{ section.id }}-${activeProductIndex}`);

          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        };

        const updateQuizState = () => {
          questions.forEach((question) => {
            const questionIndex = parseInt(question.dataset.questionIndex, 10);
            question.classList.toggle('is-active', questionIndex === currentQuestion);
          });

          if (progress) {
            progress.style.width = `${(currentQuestion / totalQuestions) * 100}%`;
          }

          if (stepLabel) {
            stepLabel.textContent = `Question ${currentQuestion} of ${totalQuestions}`;
          }

          if (navLabel) {
            navLabel.textContent = `Step ${currentQuestion} of ${totalQuestions}`;
          }

          if (backButton) {
            backButton.disabled = currentQuestion <= 1;
          }

          if (nextButton) {
            nextButton.disabled = !answers[currentQuestion];
            nextButton.textContent = currentQuestion === totalQuestions ? 'See match →' : 'Next →';
          }
        };

        const recordAnswer = (button) => {
          const question = button.closest('.boka-collection-scroll__quiz-question');
          if (!question) return;

          const questionIndex = parseInt(question.dataset.questionIndex, 10);
          const previousAnswer = answers[questionIndex];
          const selectedIndex = getSafeProductIndex(button.dataset.matchIndex);

          if (previousAnswer) {
            scores[previousAnswer] = Math.max((scores[previousAnswer] || 1) - 1, 0);
          }

          answers[questionIndex] = selectedIndex;
          scores[selectedIndex] = (scores[selectedIndex] || 0) + 1;

          question.querySelectorAll('.boka-collection-scroll__quiz-option').forEach((option) => {
            option.classList.toggle('is-selected', option === button);
          });

          updateMatch();
          updateQuizState();

          if (questionIndex < totalQuestions) {
            window.setTimeout(() => {
              if (currentQuestion === questionIndex) {
                currentQuestion += 1;
                updateQuizState();
              }
            }, 240);
          }
        };

        quiz.querySelectorAll('.boka-collection-scroll__quiz-option').forEach((button) => {
          button.addEventListener('click', () => recordAnswer(button));
        });

        if (backButton) {
          backButton.addEventListener('click', () => {
            currentQuestion = Math.max(1, currentQuestion - 1);
            updateQuizState();
          });
        }

        if (nextButton) {
          nextButton.addEventListener('click', () => {
            if (currentQuestion < totalQuestions) {
              currentQuestion += 1;
              updateQuizState();
              return;
            }

            scrollToMatchedProduct();
          });
        }

        updateMatch();
        updateQuizState();
      }

      const swapImage = (image, src) => {
        if (!image || !src || image.getAttribute('src') === src) return;

        image.style.opacity = '0';

        window.setTimeout(() => {
          image.setAttribute('src', src);
          image.style.opacity = '1';
        }, 120);
      };

      const hoverSwapItems = Array.from(section.querySelectorAll('.js-boka-hover-swap'));

      hoverSwapItems.forEach((item) => {
        const image = item.querySelector('img');
        const defaultSrc = item.dataset.defaultSrc;
        const hoverSrc = item.dataset.hoverSrc || defaultSrc;

        if (!image || !defaultSrc) return;

        item.addEventListener('mouseenter', () => {
          if (window.innerWidth < 800) return;
          swapImage(image, hoverSrc);
        });

        item.addEventListener('mouseleave', () => {
          swapImage(image, defaultSrc);
        });
      });

      const scenes = Array.from(section.querySelectorAll('.boka-collection-scroll__scene'));

      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle('is-in-view', entry.isIntersecting);
        });
      }, {
        root: null,
        threshold: 0.25
      });

      scenes.forEach((scene) => {
        revealObserver.observe(scene);
      });

      const gifObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const scene = entry.target;
          const image = scene.querySelector('.boka-collection-scroll__character-image');
          const defaultSrc = scene.dataset.defaultSrc;
          const hoverSrc = scene.dataset.hoverSrc || defaultSrc;

          if (!image || !defaultSrc) return;

          if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
            scene.classList.add('is-gif-active');
            swapImage(image, hoverSrc);
          } else {
            scene.classList.remove('is-gif-active');

            if (!scene.matches(':hover')) {
              swapImage(image, defaultSrc);
            }
          }
        });
      }, {
        root: null,
        threshold: [0, 0.25, 0.5, 0.7, 1]
      });

      scenes.forEach((scene) => {
        gifObserver.observe(scene);
      });

      scenes.forEach((scene) => {
        const visual = scene.querySelector('.boka-collection-scroll__scene-visual');
        const image = scene.querySelector('.boka-collection-scroll__character-image');

        if (!visual || !image) return;

        const defaultSrc = scene.dataset.defaultSrc;
        const hoverSrc = scene.dataset.hoverSrc || defaultSrc;

        visual.addEventListener('mouseenter', () => {
          if (window.innerWidth < 800) return;
          swapImage(image, hoverSrc);
        });

        visual.addEventListener('mouseleave', () => {
          if (scene.classList.contains('is-gif-active')) return;
          swapImage(image, defaultSrc);
        });
      });
    })();
  </script>
{% endif %}

