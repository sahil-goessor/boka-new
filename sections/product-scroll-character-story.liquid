{% comment %}
  Section: Product Scroll Character Story
  For Shopify product page templates.

  Features:
  - Hero landing intro before product cards
  - Sticky character that updates while scrolling
  - Alternating card colors
  - Alternating card layouts
  - Default + hover character image/GIF support
  - Product metafield driven content

  Recommended product metafields:
  - custom.flavor_scroll_headline        Single line text
  - custom.flavor_scroll_description     Multi-line text
  - custom.flavor_scroll_bullets         List of single line text
  - custom.character_name                Single line text
  - custom.character_quote               Single line text
  - custom.character_image               File
  - custom.character_hover_image         File
  - custom.flavor_accent_color           Color
  - custom.flavor_background_color       Color
{% endcomment %}

<section
  id="boka-character-story-{{ section.id }}"
  class="boka-character-story"
  data-section-id="{{ section.id }}"
>
  <div class="boka-character-story__background"></div>

  <div class="boka-character-story__hero">
    <div class="boka-character-story__hero-bg">
      <span class="boka-character-story__hero-blob is-one"></span>
      <span class="boka-character-story__hero-blob is-two"></span>
      <span class="boka-character-story__hero-blob is-three"></span>
    </div>

    <div class="boka-character-story__hero-content">
      {% if section.settings.hero_eyebrow != blank %}
        <p class="boka-character-story__eyebrow">
          {{ section.settings.hero_eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.hero_heading != blank %}
        <h2>{{ section.settings.hero_heading }}</h2>
      {% endif %}

      {% if section.settings.hero_subheading != blank %}
        <p class="boka-character-story__hero-text">
          {{ section.settings.hero_subheading }}
        </p>
      {% endif %}

      <div class="boka-character-story__hero-actions">
        {% if section.settings.hero_button_label != blank %}
          <a
            href="#boka-character-story-scroll-{{ section.id }}"
            class="boka-character-story__hero-button"
          >
            {{ section.settings.hero_button_label }}
          </a>
        {% endif %}

        {% if section.settings.hero_secondary_label != blank and section.settings.hero_secondary_link != blank %}
          <a
            href="{{ section.settings.hero_secondary_link }}"
            class="boka-character-story__hero-link"
          >
            {{ section.settings.hero_secondary_label }}
          </a>
        {% endif %}
      </div>
    </div>

    {% if section.settings.hero_image != blank %}
      <div class="boka-character-story__hero-image-wrap">
        <img
          src="{{ section.settings.hero_image | image_url: width: 1200 }}"
          alt="{{ section.settings.hero_image.alt | default: section.settings.hero_heading | escape }}"
          loading="lazy"
          class="boka-character-story__hero-image"
        >
      </div>
    {% endif %}
  </div>

  <div class="boka-character-story__intro">
    {% if section.settings.eyebrow != blank %}
      <p class="boka-character-story__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p>{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div
    id="boka-character-story-scroll-{{ section.id }}"
    class="boka-character-story__layout"
  >
    <aside class="boka-character-story__sticky">
      <div class="boka-character-story__character-shell">
        <div class="boka-character-story__blob"></div>

        <img
          class="boka-character-story__character-image"
          src=""
          alt=""
          loading="lazy"
        >

        <div class="boka-character-story__character-copy">
          <p class="boka-character-story__character-kicker">
            {{ section.settings.character_kicker }}
          </p>
          <h3 class="boka-character-story__character-name"></h3>
          <p class="boka-character-story__character-quote"></p>
        </div>
      </div>
    </aside>

    <div class="boka-character-story__scenes">
      {% for block in section.blocks %}
        {% assign flavor_product = block.settings.product %}

        {% if flavor_product != blank %}
          {% assign remainder = forloop.index0 | modulo: 2 %}

          {% if remainder == 0 %}
            {% assign card_position_class = 'is-even' %}
            {% assign fallback_accent = section.settings.alt_accent_color_1 %}
            {% assign fallback_bg = section.settings.alt_background_color_1 %}
          {% else %}
            {% assign card_position_class = 'is-odd' %}
            {% assign fallback_accent = section.settings.alt_accent_color_2 %}
            {% assign fallback_bg = section.settings.alt_background_color_2 %}
          {% endif %}

          {% assign headline = flavor_product.metafields.custom.flavor_scroll_headline.value | default: flavor_product.title %}
          {% assign description = flavor_product.metafields.custom.flavor_scroll_description.value | default: flavor_product.description | strip_html %}
          {% assign bullets = flavor_product.metafields.custom.flavor_scroll_bullets.value %}
          {% assign character_name = flavor_product.metafields.custom.character_name.value | default: flavor_product.title %}
          {% assign character_quote = flavor_product.metafields.custom.character_quote.value | default: block.settings.fallback_quote %}

          {% assign metafield_accent = flavor_product.metafields.custom.flavor_accent_color.value %}
          {% assign metafield_bg = flavor_product.metafields.custom.flavor_background_color.value %}

          {% if section.settings.enable_metafield_color_overrides and metafield_accent != blank %}
            {% assign accent_color = metafield_accent %}
          {% else %}
            {% assign accent_color = block.settings.fallback_accent_color | default: fallback_accent %}
          {% endif %}

          {% if section.settings.enable_metafield_color_overrides and metafield_bg != blank %}
            {% assign background_color = metafield_bg %}
          {% else %}
            {% assign background_color = block.settings.fallback_background_color | default: fallback_bg %}
          {% endif %}

          {% assign character_image = flavor_product.metafields.custom.character_image.value %}
          {% assign character_hover_image = flavor_product.metafields.custom.character_hover_image.value %}

          {% if character_image != blank %}
            {% assign character_image_url = character_image | image_url: width: 1000 %}
          {% elsif block.settings.fallback_character_image != blank %}
            {% assign character_image_url = block.settings.fallback_character_image | image_url: width: 1000 %}
          {% elsif flavor_product.featured_image != blank %}
            {% assign character_image_url = flavor_product.featured_image | image_url: width: 1000 %}
          {% else %}
            {% assign character_image_url = blank %}
          {% endif %}

          {% if character_hover_image != blank %}
            {% assign character_hover_image_url = character_hover_image | image_url: width: 1000 %}
          {% elsif block.settings.fallback_hover_image != blank %}
            {% assign character_hover_image_url = block.settings.fallback_hover_image | image_url: width: 1000 %}
          {% else %}
            {% assign character_hover_image_url = character_image_url %}
          {% endif %}

          <article
            class="boka-character-story__scene {{ card_position_class }}"
            style="
              --flavor-accent: {{ accent_color }};
              --flavor-bg: {{ background_color }};
            "
            data-character-src="{{ character_image_url }}"
            data-character-hover-src="{{ character_hover_image_url }}"
            data-character-alt="{{ character_name | escape }}"
            data-character-name="{{ character_name | escape }}"
            data-character-quote="{{ character_quote | strip_html | escape }}"
            data-scene-bg="{{ background_color }}"
            {{ block.shopify_attributes }}
          >
            <div class="boka-character-story__scene-card">
              <div class="boka-character-story__scene-main">
                <p class="boka-character-story__scene-label">
                  {{ block.settings.scene_label | default: 'Flavor profile' }}
                </p>

                <h3>{{ headline }}</h3>

                {% if description != blank %}
                  <p class="boka-character-story__description">
                    {{ description }}
                  </p>
                {% endif %}

                {% if bullets != blank %}
                  <div class="boka-character-story__bullets">
                    {% for bullet in bullets %}
                      <div class="boka-character-story__bullet">
                        <span></span>
                        <p>{{ bullet }}</p>
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>

              <div class="boka-character-story__product-card">
                {% if flavor_product.featured_image != blank %}
                  <div class="boka-character-story__product-image">
                    <img
                      src="{{ flavor_product.featured_image | image_url: width: 700 }}"
                      alt="{{ flavor_product.featured_image.alt | default: flavor_product.title | escape }}"
                      loading="lazy"
                    >
                  </div>
                {% endif %}

                <div class="boka-character-story__product-info">
                  <p>{{ flavor_product.title }}</p>

                  {% if flavor_product.price %}
                    <span>{{ flavor_product.price | money }}</span>
                  {% endif %}

                  <a href="{{ flavor_product.url }}" class="boka-character-story__button">
                    {{ section.settings.card_button_label }}
                  </a>
                </div>
              </div>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #boka-character-story-{{ section.id }} {
    position: relative;
    overflow: clip;
    background: {{ section.settings.default_background }};
    color: {{ section.settings.text_color }};
    padding: clamp(44px, 7vw, 96px) 0 clamp(56px, 8vw, 120px);
    scroll-behavior: smooth;
  }

  #boka-character-story-{{ section.id }} * {
    box-sizing: border-box;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__background {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 12% 18%, rgba(203, 231, 218, 0.46), transparent 28%),
      radial-gradient(circle at 86% 36%, rgba(242, 224, 198, 0.58), transparent 30%),
      radial-gradient(circle at 50% 100%, rgba(226, 237, 244, 0.58), transparent 36%);
    pointer-events: none;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero,
  #boka-character-story-{{ section.id }} .boka-character-story__intro,
  #boka-character-story-{{ section.id }} .boka-character-story__layout {
    position: relative;
    z-index: 1;
    width: min(1240px, calc(100% - 32px));
    margin-inline: auto;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero {
    min-height: clamp(620px, 82vh, 860px);
    margin-bottom: clamp(64px, 10vw, 140px);
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 1.05fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
    overflow: hidden;
    border-radius: clamp(30px, 4vw, 56px);
    padding: clamp(28px, 5vw, 72px);
    background:
      linear-gradient(
        135deg,
        {{ section.settings.hero_background_1 }},
        {{ section.settings.hero_background_2 }}
      );
    box-shadow: 0 24px 90px rgba(17, 17, 17, 0.08);
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-blob {
    position: absolute;
    display: block;
    border-radius: 999px;
    opacity: 0.55;
    filter: blur(1px);
    animation: boka-hero-float-{{ section.id }} 6s ease-in-out infinite;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-blob.is-one {
    width: 260px;
    height: 260px;
    left: -70px;
    top: 8%;
    background: {{ section.settings.hero_blob_1 }};
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-blob.is-two {
    width: 340px;
    height: 340px;
    right: -120px;
    bottom: -80px;
    background: {{ section.settings.hero_blob_2 }};
    animation-delay: -2s;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-blob.is-three {
    width: 180px;
    height: 180px;
    right: 34%;
    top: 8%;
    background: {{ section.settings.hero_blob_3 }};
    animation-delay: -4s;
  }

  @keyframes boka-hero-float-{{ section.id }} {
    0% {
      transform: translateY(0) rotate(0deg);
    }

    50% {
      transform: translateY(-16px) rotate(4deg);
    }

    100% {
      transform: translateY(0) rotate(0deg);
    }
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-content,
  #boka-character-story-{{ section.id }} .boka-character-story__hero-image-wrap {
    position: relative;
    z-index: 2;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__eyebrow,
  #boka-character-story-{{ section.id }} .boka-character-story__scene-label,
  #boka-character-story-{{ section.id }} .boka-character-story__character-kicker {
    margin: 0 0 10px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: 0.76rem;
    line-height: 1.2;
    font-weight: 700;
    color: {{ section.settings.muted_text_color }};
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-content h2 {
    margin: 0;
    max-width: 700px;
    font-size: clamp(3rem, 7.4vw, 8.8rem);
    line-height: 0.86;
    letter-spacing: -0.075em;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-text {
    margin: 22px 0 0;
    max-width: 560px;
    color: {{ section.settings.muted_text_color }};
    font-size: clamp(1.05rem, 1.5vw, 1.32rem);
    line-height: 1.55;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 30px;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-button,
  #boka-character-story-{{ section.id }} .boka-character-story__button {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    font-weight: 700;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-button {
    min-height: 48px;
    padding: 0 24px;
    font-size: 0.95rem;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__button {
    min-height: 42px;
    margin-top: 14px;
    padding: 0 20px;
    font-size: 0.9rem;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-button:hover,
  #boka-character-story-{{ section.id }} .boka-character-story__button:hover {
    transform: translateY(-1px);
    opacity: 0.88;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-link {
    color: {{ section.settings.text_color }};
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 700;
    font-size: 0.95rem;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-image-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__hero-image {
    width: min(100%, 560px);
    height: auto;
    display: block;
    object-fit: contain;
    animation: boka-hero-image-float-{{ section.id }} 4.8s ease-in-out infinite;
  }

  @keyframes boka-hero-image-float-{{ section.id }} {
    0% {
      translate: 0 0;
      rotate: 0deg;
    }

    50% {
      translate: 0 -10px;
      rotate: 1.5deg;
    }

    100% {
      translate: 0 0;
      rotate: 0deg;
    }
  }

  #boka-character-story-{{ section.id }} .boka-character-story__intro {
    text-align: center;
    max-width: 820px;
    margin-bottom: clamp(36px, 6vw, 76px);
  }

  #boka-character-story-{{ section.id }} .boka-character-story__intro h2 {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 6.8rem);
    line-height: 0.92;
    letter-spacing: -0.06em;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__intro > p:not(.boka-character-story__eyebrow) {
    margin: 18px auto 0;
    max-width: 660px;
    color: {{ section.settings.muted_text_color }};
    font-size: clamp(1rem, 1.35vw, 1.22rem);
    line-height: 1.55;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__layout {
    display: grid;
    grid-template-columns: minmax(280px, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(28px, 5vw, 84px);
    align-items: start;
    scroll-margin-top: 100px;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__sticky {
    position: sticky;
    top: 104px;
    min-height: calc(100vh - 128px);
    display: flex;
    align-items: center;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__character-shell {
    position: relative;
    width: 100%;
    min-height: 560px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-radius: 42px;
    padding: clamp(20px, 3vw, 40px);
    background: rgba(255, 255, 255, 0.68);
    box-shadow: 0 24px 90px rgba(17, 17, 17, 0.08);
    backdrop-filter: blur(14px);
    overflow: hidden;
    cursor: pointer;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__blob {
    position: absolute;
    inset: 10%;
    border-radius: 999px;
    background: var(--active-scene-bg, #DDEFE6);
    filter: blur(4px);
    opacity: 0.62;
    transform: scale(0.9);
    transition: background 300ms ease, transform 300ms ease;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__character-shell:hover .boka-character-story__blob {
    transform: scale(1);
  }

  #boka-character-story-{{ section.id }} .boka-character-story__character-image {
    position: relative;
    z-index: 2;
    width: min(92%, 420px);
    max-height: 430px;
    object-fit: contain;
    margin: 0 auto;
    display: block;
    transform: translateY(0) rotate(0deg);
    transition:
      opacity 240ms ease,
      transform 220ms ease;
    animation: boka-character-float-{{ section.id }} 4.5s ease-in-out infinite;
  }

  @keyframes boka-character-float-{{ section.id }} {
    0% {
      translate: 0 0;
      rotate: 0deg;
    }

    25% {
      translate: 0 -5px;
      rotate: 1.5deg;
    }

    75% {
      translate: 0 5px;
      rotate: -1.5deg;
    }

    100% {
      translate: 0 0;
      rotate: 0deg;
    }
  }

  #boka-character-story-{{ section.id }} .boka-character-story__character-copy {
    position: relative;
    z-index: 2;
    margin-top: 28px;
    text-align: center;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__character-name {
    margin: 0;
    font-size: clamp(2.3rem, 5vw, 5rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__character-quote {
    margin: 16px auto 0;
    max-width: 360px;
    color: {{ section.settings.muted_text_color }};
    font-size: 1rem;
    line-height: 1.45;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__scenes {
    display: grid;
    gap: clamp(30px, 9vh, 96px);
  }

  #boka-character-story-{{ section.id }} .boka-character-story__scene {
    min-height: 82vh;
    display: flex;
    align-items: center;
    opacity: 0.38;
    transform: translateY(24px) scale(0.985);
    transition:
      opacity 260ms ease,
      transform 260ms ease;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__scene.is-even {
    transform: translateY(24px) rotate(-0.35deg) scale(0.985);
  }

  #boka-character-story-{{ section.id }} .boka-character-story__scene.is-odd {
    transform: translateY(24px) rotate(0.35deg) scale(0.985);
  }

  #boka-character-story-{{ section.id }} .boka-character-story__scene.is-active {
    opacity: 1;
    transform: translateY(0) rotate(0deg) scale(1);
  }

  #boka-character-story-{{ section.id }} .boka-character-story__scene-card {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.42fr);
    gap: 28px;
    align-items: center;
    border-radius: 38px;
    padding: clamp(24px, 4vw, 52px);
    border: 1px solid color-mix(in srgb, var(--flavor-accent) 42%, white);
    box-shadow: 0 20px 70px rgba(17, 17, 17, 0.07);
    transition:
      background 240ms ease,
      border-color 240ms ease,
      transform 240ms ease;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__scene.is-even .boka-character-story__scene-card {
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--flavor-bg) 82%, white),
        color-mix(in srgb, var(--flavor-accent) 22%, white)
      );
    transform-origin: left center;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__scene.is-odd .boka-character-story__scene-card {
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--flavor-accent) 26%, white),
        color-mix(in srgb, var(--flavor-bg) 84%, white)
      );
    transform-origin: right center;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__scene.is-odd .boka-character-story__scene-main {
    order: 2;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__scene.is-odd .boka-character-story__product-card {
    order: 1;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__scene.is-even .boka-character-story__scene-main {
    order: 1;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__scene.is-even .boka-character-story__product-card {
    order: 2;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__scene-main h3 {
    margin: 0;
    max-width: 740px;
    font-size: clamp(2.1rem, 4.8vw, 5.8rem);
    line-height: 0.93;
    letter-spacing: -0.06em;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__description {
    margin: 18px 0 0;
    max-width: 620px;
    color: {{ section.settings.muted_text_color }};
    font-size: clamp(1rem, 1.3vw, 1.18rem);
    line-height: 1.6;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__bullets {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  #boka-character-story-{{ section.id }} .boka-character-story__bullet {
    min-height: 68px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    border-radius: 18px;
    padding: 16px;
    background: rgba(255, 255, 255, 0.72);
  }

