        grid-template-columns: 68px 1fr;
      }

      #boka-collection-world-{{ section.id }} .boka-collection-world__active-link {
        grid-column: 1 / -1;
        width: 100%;
      }

      #boka-collection-world-{{ section.id }} .boka-collection-world__active-product-image-wrap {
