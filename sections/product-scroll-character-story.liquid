      #boka-collection-world-{{ section.id }} *::before,
      #boka-collection-world-{{ section.id }} *::after {
        animation: none !important;
        transition: none !important;
        scroll-behavior: auto !important;
      }
    }
  </style>

  <script>
    (() => {
      const section = document.querySelector('#boka-collection-world-{{ section.id }}');
      if (!section) return;

      const triggers = Array.from(section.querySelectorAll('.boka-collection-world__scene-trigger'));
      const dots = Array.from(section.querySelectorAll('.boka-collection-world__flavor-dot'));

      const stage = section.querySelector('.boka-collection-world__sticky-stage');
      const kicker = section.querySelector('.boka-collection-world__active-kicker');
      const title = section.querySelector('.boka-collection-world__active-title');
      const description = section.querySelector('.boka-collection-world__active-description');
      const quote = section.querySelector('.boka-collection-world__active-quote');
      const bulletsWrap = section.querySelector('.boka-collection-world__active-bullets');
      const character = section.querySelector('.boka-collection-world__active-character');
      const productImage = section.querySelector('.boka-collection-world__active-product-image');
      const productTitle = section.querySelector('.boka-collection-world__active-product-title');
      const productPrice = section.querySelector('.boka-collection-world__active-product-price');
      const productLink = section.querySelector('.boka-collection-world__active-link');
      const visual = section.querySelector('.boka-collection-world__stage-visual');

      if (!triggers.length || !stage || !character) return;

      let activeIndex = -1;
      let activeDefaultSrc = '';
      let activeHoverSrc = '';
      let isHovering = false;

      const setImage = (img, src, alt, immediate = false) => {
        if (!img || !src || img.getAttribute('src') === src) return;

        if (!immediate) img.style.opacity = '0';

        window.setTimeout(() => {
          img.setAttribute('src', src);
          img.setAttribute('alt', alt || '');
          img.style.opacity = '1';
        }, immediate ? 0 : 140);
      };

      const setActive = (index) => {
        const trigger = triggers[index];
        if (!trigger || index === activeIndex) return;

        activeIndex = index;

        const data = trigger.dataset;
        const accent = data.accent || '#DDEFE6';
        const bg = data.bg || '#F8FBF7';

        section.style.setProperty('--active-accent', accent);
        section.style.setProperty('--active-bg', bg);

        stage.style.background = bg;

        activeDefaultSrc = data.characterSrc || '';
        activeHoverSrc = data.characterHoverSrc || activeDefaultSrc;

        if (kicker) kicker.textContent = data.kicker || '';
        if (title) title.textContent = data.title || '';
        if (description) description.textContent = data.description || '';
        if (quote) quote.textContent = data.quote || '';

        setImage(character, isHovering ? activeHoverSrc : activeDefaultSrc, data.characterAlt || '');

        setImage(productImage, data.productSrc || activeDefaultSrc, data.productAlt || data.productTitle || '', true);

        if (productTitle) productTitle.textContent = data.productTitle || '';
        if (productPrice) productPrice.textContent = data.productPrice || '';

        if (productLink) {
          productLink.setAttribute('href', data.productUrl || '#');
        }

        if (bulletsWrap) {
          bulletsWrap.innerHTML = '';

          if (data.bullets) {
            data.bullets.split('||').forEach((bullet) => {
              if (!bullet.trim()) return;

              const item = document.createElement('div');
              item.className = 'boka-collection-world__bullet';

              const dot = document.createElement('span');
              const text = document.createElement('p');
              text.textContent = bullet;

              item.appendChild(dot);
              item.appendChild(text);
              bulletsWrap.appendChild(item);
            });
          }
        }

        dots.forEach((dot, dotIndex) => {
          dot.classList.toggle('is-active', dotIndex === index);
        });
      };

      setActive(0);

      const observer = new IntersectionObserver((entries) => {
        const activeEntry = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (activeEntry) {
          setActive(Number(activeEntry.target.dataset.index));
        }
      }, {
        root: null,
        threshold: [0.22, 0.35, 0.5, 0.65]
      });

      triggers.forEach((trigger) => observer.observe(trigger));

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const index = Number(dot.dataset.sceneIndex);
          const trigger = triggers[index];

          if (trigger) {
            trigger.scrollIntoView({
              behavior: 'smooth',
              block: 'center'
            });
          }

          setActive(index);
        });
      });

      if (visual) {
        visual.addEventListener('mouseenter', () => {
          if (window.innerWidth < 800) return;
          isHovering = true;
          setImage(character, activeHoverSrc, character.getAttribute('alt') || '', true);
        });

        visual.addEventListener('mouseleave', () => {
          isHovering = false;
          setImage(character, activeDefaultSrc, character.getAttribute('alt') || '', true);
        });
      }
    })();
  </script>
{% endif %}

