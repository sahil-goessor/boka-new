  <script>
    (() => {
      const section = document.querySelector('#boka-collection-scroll-{{ section.id }}');
      if (!section) return;

      const swapImage = (image, src) => {
        if (!image || !src || image.getAttribute('src') === src) return;

        image.style.opacity = '0';

        window.setTimeout(() => {
          image.setAttribute('src', src);
          image.style.opacity = '1';
        }, 120);
      };

      const hoverSwapItems = Array.from(section.querySelectorAll('.js-boka-hover-swap'));

      hoverSwapItems.forEach((item) => {
        const image = item.querySelector('img');
        const defaultSrc = item.dataset.defaultSrc;
        const hoverSrc = item.dataset.hoverSrc || defaultSrc;

        if (!image || !defaultSrc) return;

        item.addEventListener('mouseenter', () => {
          if (window.innerWidth < 800) return;
          swapImage(image, hoverSrc);
        });

        item.addEventListener('mouseleave', () => {
          swapImage(image, defaultSrc);
        });
      });

      const showcase = section.querySelector('.boka-collection-scroll__showcase');
      if (showcase) {
        const showcaseStage = showcase.querySelector('.boka-collection-scroll__showcase-stage');
        const showcaseImage = showcase.querySelector('.js-showcase-image');
        const showcaseHoverArea = showcase.querySelector('.js-showcase-hover-area');
        const showcaseTabs = Array.from(showcase.querySelectorAll('.boka-collection-scroll__showcase-tab'));
        const showcaseName = showcase.querySelector('.js-showcase-name');
        const showcaseNote = showcase.querySelector('.js-showcase-note');
        const showcaseProductTitle = showcase.querySelector('.js-showcase-product-title');
        const showcasePrice = showcase.querySelector('.js-showcase-price');
        const showcaseLink = showcase.querySelector('.js-showcase-link');

        let showcaseDefaultSrc = '';
        let showcaseHoverSrc = '';

        const setShowcase = (tab) => {
          if (!tab || !showcaseStage || !showcaseImage) return;

          showcaseTabs.forEach((item) => {
            const isActive = item === tab;
            item.classList.toggle('is-active', isActive);
            item.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });

          const data = tab.dataset;

          showcaseDefaultSrc = data.defaultSrc || '';
          showcaseHoverSrc = data.hoverSrc || showcaseDefaultSrc;

          showcaseStage.style.setProperty('--showcase-bg', data.bg || '#FFF4F6');
          showcaseStage.style.setProperty('--showcase-accent', data.accent || '#F8B8C9');

          if (showcaseName) showcaseName.textContent = data.name || '';
          if (showcaseNote) showcaseNote.textContent = data.note || '';
          if (showcaseProductTitle) showcaseProductTitle.textContent = data.productTitle || '';
          if (showcasePrice) showcasePrice.textContent = data.price || '';
          if (showcaseLink) showcaseLink.setAttribute('href', data.url || '#');

          swapImage(showcaseImage, showcaseDefaultSrc);
          showcaseImage.setAttribute('alt', data.name || data.productTitle || '');
        };

        if (showcaseTabs[0]) {
          setShowcase(showcaseTabs[0]);
        }

        showcaseTabs.forEach((tab) => {
          tab.addEventListener('click', () => setShowcase(tab));
          tab.addEventListener('mouseenter', () => {
            if (window.innerWidth < 800) return;
            setShowcase(tab);
          });
        });

        if (showcaseHoverArea && showcaseImage) {
          showcaseHoverArea.addEventListener('mouseenter', () => {
            if (window.innerWidth < 800) return;
            swapImage(showcaseImage, showcaseHoverSrc);
          });

          showcaseHoverArea.addEventListener('mouseleave', () => {
            swapImage(showcaseImage, showcaseDefaultSrc);
          });
        }
      }

      const scenes = Array.from(section.querySelectorAll('.boka-collection-scroll__scene'));

      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle('is-in-view', entry.isIntersecting);
        });
      }, {
        root: null,
        threshold: 0.25
      });

      scenes.forEach((scene) => {
        revealObserver.observe(scene);
      });

      const gifObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const scene = entry.target;
          const image = scene.querySelector('.boka-collection-scroll__character-image');
          const defaultSrc = scene.dataset.defaultSrc;
          const hoverSrc = scene.dataset.hoverSrc || defaultSrc;

          if (!image || !defaultSrc) return;

          if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
            scene.classList.add('is-gif-active');
            swapImage(image, hoverSrc);
          } else {
            scene.classList.remove('is-gif-active');

            if (!scene.matches(':hover')) {
              swapImage(image, defaultSrc);
            }
          }
        });
      }, {
        root: null,
        threshold: [0, 0.25, 0.5, 0.7, 1]
      });

      scenes.forEach((scene) => {
        gifObserver.observe(scene);
      });

      scenes.forEach((scene) => {
        const visual = scene.querySelector('.boka-collection-scroll__scene-visual');
        const image = scene.querySelector('.boka-collection-scroll__character-image');

        if (!visual || !image) return;

        const defaultSrc = scene.dataset.defaultSrc;
        const hoverSrc = scene.dataset.hoverSrc || defaultSrc;

        visual.addEventListener('mouseenter', () => {
          if (window.innerWidth < 800) return;
          swapImage(image, hoverSrc);
        });

        visual.addEventListener('mouseleave', () => {
          if (scene.classList.contains('is-gif-active')) return;
          swapImage(image, defaultSrc);
        });
      });
    })();
  </script>
{% endif %}

