{% comment %}
  Section: Collection Flavor Scroll Page
  For Shopify collection templates.

  Flow:
  1. Hero banner with optional lifestyle background
  2. Collection product list
  3. Featured product showcase
  4. Benefits section
  5. Review section
  6. One full scroll section per product

  Recommended product metafields:
  - custom.flavor_scroll_headline
  - custom.flavor_scroll_description
  - custom.flavor_scroll_bullets
  - custom.character_name
  - custom.character_quote
  - custom.character_image
  - custom.character_hover_image
  - custom.flavor_accent_color
  - custom.flavor_background_color

  Optional collection metafields:
  - custom.scroll_hero_eyebrow
  - custom.scroll_hero_heading
  - custom.scroll_hero_text
{% endcomment %}

{% liquid
  assign active_collection = collection
  assign products_to_show = section.settings.product_limit

  assign hero_eyebrow = active_collection.metafields.custom.scroll_hero_eyebrow.value | default: section.settings.hero_eyebrow
  assign hero_heading = active_collection.metafields.custom.scroll_hero_heading.value | default: section.settings.hero_heading
  assign hero_text = active_collection.metafields.custom.scroll_hero_text.value | default: section.settings.hero_subheading
%}

{% if active_collection != blank and active_collection.products_count > 0 %}
  <section id="boka-collection-scroll-{{ section.id }}" class="boka-collection-scroll">
    <div
      class="boka-collection-scroll__hero"
      {% if section.settings.hero_background_image != blank %}
        style="--hero-bg-image: url('{{ section.settings.hero_background_image | image_url: width: 2400 }}'); --hero-overlay-opacity: {{ section.settings.hero_image_overlay_opacity | divided_by: 100.0 }};"
      {% else %}
        style="--hero-bg-image: none; --hero-overlay-opacity: 0;"
      {% endif %}
    >
      <div class="boka-collection-scroll__hero-photo"></div>
      <div class="boka-collection-scroll__hero-photo-overlay"></div>

      <div class="boka-collection-scroll__hero-bg">
        <span class="boka-collection-scroll__blob is-one"></span>
        <span class="boka-collection-scroll__blob is-two"></span>
        <span class="boka-collection-scroll__blob is-three"></span>
        <span class="boka-collection-scroll__blob is-four"></span>
      </div>

      <div class="boka-collection-scroll__hero-inner">
        <div class="boka-collection-scroll__hero-copy">
          {% if hero_eyebrow != blank %}
            <p class="boka-collection-scroll__eyebrow">{{ hero_eyebrow }}</p>
          {% endif %}

          {% if hero_heading != blank %}
            <h1>{{ hero_heading }}</h1>
          {% else %}
            <h1>{{ active_collection.title }}</h1>
          {% endif %}

          {% if hero_text != blank %}
            <p class="boka-collection-scroll__hero-text">{{ hero_text }}</p>
          {% endif %}

          {% if section.settings.hero_button_label != blank %}
            <a href="#boka-collection-list-{{ section.id }}" class="boka-collection-scroll__button">
              {{ section.settings.hero_button_label }}
            </a>
          {% endif %}
        </div>

        <div class="boka-collection-scroll__hero-products">
          {% for flavor_product in active_collection.products limit: products_to_show %}
            {% liquid
              assign loop_mod = forloop.index0 | modulo: 2

              if loop_mod == 0
                assign fallback_accent = section.settings.alt_accent_color_1
                assign fallback_bg = section.settings.alt_background_color_1
              else
                assign fallback_accent = section.settings.alt_accent_color_2
                assign fallback_bg = section.settings.alt_background_color_2
              endif

              assign character_name = flavor_product.metafields.custom.character_name.value | default: flavor_product.title
              assign character_image = flavor_product.metafields.custom.character_image.value
              assign character_hover_image = flavor_product.metafields.custom.character_hover_image.value
              assign metafield_accent = flavor_product.metafields.custom.flavor_accent_color.value
              assign metafield_bg = flavor_product.metafields.custom.flavor_background_color.value

              if section.settings.enable_metafield_color_overrides and metafield_accent != blank
                assign accent_color = metafield_accent
              else
                assign accent_color = fallback_accent
              endif

              if section.settings.enable_metafield_color_overrides and metafield_bg != blank
                assign background_color = metafield_bg
              else
                assign background_color = fallback_bg
              endif

              if character_image != blank
                assign character_image_url = character_image | image_url: width: 900
              elsif flavor_product.featured_image != blank
                assign character_image_url = flavor_product.featured_image | image_url: width: 900
              else
                assign character_image_url = blank
              endif

              if character_hover_image != blank
                assign character_hover_image_url = character_hover_image | image_url: width: 900
              else
                assign character_hover_image_url = character_image_url
              endif
            %}

            <a
              href="#boka-product-scene-{{ section.id }}-{{ forloop.index }}"
              class="boka-collection-scroll__hero-card is-card-{{ forloop.index }} js-boka-hover-swap"
              style="--card-accent: {{ accent_color }}; --card-bg: {{ background_color }};"
              data-default-src="{{ character_image_url }}"
              data-hover-src="{{ character_hover_image_url }}"
            >
              {% if character_image_url != blank %}
                <img src="{{ character_image_url }}" alt="{{ character_name | escape }}" loading="lazy">
              {% endif %}
              <span>{{ character_name }}</span>
            </a>
          {% endfor %}
        </div>
      </div>

      <div class="boka-collection-scroll__curve is-hero-curve" aria-hidden="true">
        <svg viewBox="0 0 1440 150" preserveAspectRatio="none">
          <path d="M0,78 C180,132 340,136 520,82 C710,24 890,24 1080,82 C1235,130 1345,118 1440,76 L1440,150 L0,150 Z"></path>
        </svg>
      </div>
    </div>

    <div id="boka-collection-list-{{ section.id }}" class="boka-collection-scroll__list-section">
      <div class="boka-collection-scroll__list-inner">
        <div class="boka-collection-scroll__list-header">
          {% if section.settings.list_eyebrow != blank %}
            <p class="boka-collection-scroll__eyebrow">{{ section.settings.list_eyebrow }}</p>
          {% endif %}

          {% if section.settings.list_heading != blank %}
            <h2>{{ section.settings.list_heading }}</h2>
          {% endif %}

          {% if section.settings.list_text != blank %}
            <p>{{ section.settings.list_text }}</p>
          {% endif %}
        </div>

        <div class="boka-collection-scroll__product-list">
          {% for flavor_product in active_collection.products limit: products_to_show %}
            {% liquid
              assign loop_mod = forloop.index0 | modulo: 2

              if loop_mod == 0
                assign fallback_accent = section.settings.alt_accent_color_1
                assign fallback_bg = section.settings.alt_background_color_1
              else
                assign fallback_accent = section.settings.alt_accent_color_2
                assign fallback_bg = section.settings.alt_background_color_2
              endif

              assign metafield_accent = flavor_product.metafields.custom.flavor_accent_color.value
              assign metafield_bg = flavor_product.metafields.custom.flavor_background_color.value
              assign character_name = flavor_product.metafields.custom.character_name.value | default: flavor_product.title
              assign character_image = flavor_product.metafields.custom.character_image.value
              assign character_hover_image = flavor_product.metafields.custom.character_hover_image.value

              if section.settings.enable_metafield_color_overrides and metafield_accent != blank
                assign accent_color = metafield_accent
              else
                assign accent_color = fallback_accent
              endif

              if section.settings.enable_metafield_color_overrides and metafield_bg != blank
                assign background_color = metafield_bg
              else
                assign background_color = fallback_bg
              endif

              if character_image != blank
                assign list_image_url = character_image | image_url: width: 1000
              elsif flavor_product.featured_image != blank
                assign list_image_url = flavor_product.featured_image | image_url: width: 1000
              else
                assign list_image_url = blank
              endif

              if character_hover_image != blank
                assign list_hover_url = character_hover_image | image_url: width: 1000
              else
                assign list_hover_url = list_image_url
              endif
            %}

            <a
              href="#boka-product-scene-{{ section.id }}-{{ forloop.index }}"
              class="boka-collection-scroll__list-card js-boka-hover-swap"
              style="--list-accent: {{ accent_color }}; --list-bg: {{ background_color }};"
              data-default-src="{{ list_image_url }}"
              data-hover-src="{{ list_hover_url }}"
            >
              <div class="boka-collection-scroll__list-card-image">
                {% if list_image_url != blank %}
                  <img src="{{ list_image_url }}" alt="{{ character_name | escape }}" loading="lazy">
                {% endif %}
              </div>

              <div class="boka-collection-scroll__list-card-copy">
                <p>{{ character_name }}</p>
                <span>{{ flavor_product.title }}</span>

                {% if flavor_product.price %}
                  <small>{{ flavor_product.price | money }}</small>
                {% endif %}
              </div>
            </a>
          {% endfor %}
        </div>
      </div>
    </div>

    {% if section.settings.show_showcase %}
      <section id="boka-product-showcase-{{ section.id }}" class="boka-collection-scroll__showcase">
        <div class="boka-collection-scroll__showcase-inner">
          <div class="boka-collection-scroll__showcase-header">
            {% if section.settings.showcase_eyebrow != blank %}
              <p class="boka-collection-scroll__eyebrow">{{ section.settings.showcase_eyebrow }}</p>
            {% endif %}

            {% if section.settings.showcase_heading != blank %}
              <h2>{{ section.settings.showcase_heading }}</h2>
            {% endif %}

            {% if section.settings.showcase_text != blank %}
              <p>{{ section.settings.showcase_text }}</p>
            {% endif %}
          </div>

          <div class="boka-collection-scroll__showcase-grid">
            <div class="boka-collection-scroll__showcase-tabs" role="tablist" aria-label="Featured products">
              {% for flavor_product in active_collection.products limit: products_to_show %}
                {% liquid
                  assign loop_mod = forloop.index0 | modulo: 2

                  if loop_mod == 0
                    assign fallback_accent = section.settings.alt_accent_color_1
                    assign fallback_bg = section.settings.alt_background_color_1
                  else
                    assign fallback_accent = section.settings.alt_accent_color_2
                    assign fallback_bg = section.settings.alt_background_color_2
                  endif

                  assign headline = flavor_product.metafields.custom.flavor_scroll_headline.value | default: flavor_product.title
                  assign description = flavor_product.metafields.custom.flavor_scroll_description.value | default: flavor_product.description | strip_html | truncate: 240
                  assign character_name = flavor_product.metafields.custom.character_name.value | default: flavor_product.title
                  assign character_quote = flavor_product.metafields.custom.character_quote.value | default: section.settings.showcase_default_note
                  assign metafield_accent = flavor_product.metafields.custom.flavor_accent_color.value
                  assign metafield_bg = flavor_product.metafields.custom.flavor_background_color.value
                  assign character_image = flavor_product.metafields.custom.character_image.value
                  assign character_hover_image = flavor_product.metafields.custom.character_hover_image.value

                  if section.settings.enable_metafield_color_overrides and metafield_accent != blank
                    assign accent_color = metafield_accent
                  else
                    assign accent_color = fallback_accent
                  endif

                  if section.settings.enable_metafield_color_overrides and metafield_bg != blank
                    assign background_color = metafield_bg
                  else
                    assign background_color = fallback_bg
                  endif

                  if character_image != blank
                    assign showcase_image_url = character_image | image_url: width: 1400
                  elsif flavor_product.featured_image != blank
                    assign showcase_image_url = flavor_product.featured_image | image_url: width: 1400
                  else
                    assign showcase_image_url = blank
                  endif

                  if character_hover_image != blank
                    assign showcase_hover_url = character_hover_image | image_url: width: 1400
                  else
                    assign showcase_hover_url = showcase_image_url
                  endif
                %}

                <button
                  type="button"
                  class="boka-collection-scroll__showcase-tab{% if forloop.first %} is-active{% endif %}"
                  role="tab"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  data-showcase-index="{{ forloop.index0 }}"
                  data-title="{{ headline | strip_html | escape }}"
                  data-description="{{ description | strip_html | escape }}"
                  data-note="{{ character_quote | strip_html | escape }}"
                  data-name="{{ character_name | strip_html | escape }}"
                  data-product-title="{{ flavor_product.title | escape }}"
                  data-price="{{ flavor_product.price | money | escape }}"
                  data-url="{{ flavor_product.url }}"
                  data-default-src="{{ showcase_image_url }}"
                  data-hover-src="{{ showcase_hover_url }}"
                  data-accent="{{ accent_color }}"
                  data-bg="{{ background_color }}"
                >
                  <span class="boka-collection-scroll__showcase-tab-dot" style="--tab-color: {{ accent_color }};"></span>
                  <span class="boka-collection-scroll__showcase-tab-copy">
                    <strong>{{ character_name }}</strong>
                    <small>{{ flavor_product.title }}</small>
                  </span>
                </button>
              {% endfor %}
            </div>

            <div class="boka-collection-scroll__showcase-stage">
              <div class="boka-collection-scroll__showcase-bg"></div>

              <div class="boka-collection-scroll__showcase-card is-top">
                <p class="boka-collection-scroll__showcase-kicker">{{ section.settings.showcase_card_top_label }}</p>
                <strong class="js-showcase-name"></strong>
                <span class="js-showcase-note"></span>
              </div>

              <div class="boka-collection-scroll__showcase-image-wrap js-showcase-hover-area">
                <div class="boka-collection-scroll__showcase-orbit">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
                <img class="boka-collection-scroll__showcase-image js-showcase-image" src="" alt="" loading="lazy">
              </div>

              <div class="boka-collection-scroll__showcase-card is-bottom">
                <p class="boka-collection-scroll__showcase-kicker">{{ section.settings.showcase_card_bottom_label }}</p>
                <strong class="js-showcase-product-title"></strong>
                <span class="js-showcase-price"></span>
                <a class="boka-collection-scroll__button is-small js-showcase-link" href="#">
                  {{ section.settings.product_button_label }}
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="boka-collection-scroll__curve is-showcase-curve" aria-hidden="true">
          <svg viewBox="0 0 1440 150" preserveAspectRatio="none">
            <path d="M0,78 C180,132 340,136 520,82 C710,24 890,24 1080,82 C1235,130 1345,118 1440,76 L1440,150 L0,150 Z"></path>
          </svg>
        </div>
      </section>
    {% endif %}

    {% if section.settings.show_benefits %}
      <section class="boka-collection-scroll__benefits">
        <div class="boka-collection-scroll__benefits-inner">
          <div class="boka-collection-scroll__benefits-header">
            {% if section.settings.benefits_eyebrow != blank %}
              <p class="boka-collection-scroll__eyebrow">{{ section.settings.benefits_eyebrow }}</p>
            {% endif %}

            {% if section.settings.benefits_heading != blank %}
              <h2>{{ section.settings.benefits_heading }}</h2>
            {% endif %}
          </div>

          <div class="boka-collection-scroll__benefits-grid">
            <div class="boka-collection-scroll__benefit-card">
              <div class="boka-collection-scroll__benefit-icon">
                <svg viewBox="0 0 64 64" aria-hidden="true">
                  <path d="M32 7c10 0 18 8 18 18 0 14-18 32-18 32S14 39 14 25C14 15 22 7 32 7Z"></path>
                  <circle cx="32" cy="25" r="7"></circle>
                </svg>
              </div>
              <h3>{{ section.settings.benefit_1_title }}</h3>
              <p>{{ section.settings.benefit_1_text }}</p>
            </div>

            <div class="boka-collection-scroll__benefit-card">
              <div class="boka-collection-scroll__benefit-icon">
                <svg viewBox="0 0 64 64" aria-hidden="true">
                  <path d="M16 18c0-6 5-11 11-11h10c6 0 11 5 11 11v28c0 6-5 11-11 11H27c-6 0-11-5-11-11V18Z"></path>
                  <path d="M25 21h14M25 31h14M25 41h10"></path>
                </svg>
              </div>
              <h3>{{ section.settings.benefit_2_title }}</h3>
              <p>{{ section.settings.benefit_2_text }}</p>
            </div>

            <div class="boka-collection-scroll__benefit-card">
              <div class="boka-collection-scroll__benefit-icon">
                <svg viewBox="0 0 64 64" aria-hidden="true">
                  <path d="M32 8 52 20v24L32 56 12 44V20L32 8Z"></path>
                  <path d="M22 32h20M32 22v20"></path>
                </svg>
              </div>
              <h3>{{ section.settings.benefit_3_title }}</h3>
              <p>{{ section.settings.benefit_3_text }}</p>
            </div>
          </div>
        </div>
      </section>
    {% endif %}

    {% if section.settings.show_reviews %}
      <section class="boka-collection-scroll__reviews">
        <div class="boka-collection-scroll__reviews-inner">
          <div class="boka-collection-scroll__reviews-header">
            {% if section.settings.reviews_eyebrow != blank %}
              <p class="boka-collection-scroll__eyebrow">{{ section.settings.reviews_eyebrow }}</p>
            {% endif %}

            {% if section.settings.reviews_heading != blank %}
              <h2>{{ section.settings.reviews_heading }}</h2>
            {% endif %}
          </div>

          <div class="boka-collection-scroll__stat-grid">
            <div class="boka-collection-scroll__stat-card">
              <strong>{{ section.settings.stat_1_number }}</strong>
              <span>{{ section.settings.stat_1_label }}</span>
            </div>

            <div class="boka-collection-scroll__stat-card">
              <strong>{{ section.settings.stat_2_number }}</strong>
              <span>{{ section.settings.stat_2_label }}</span>
            </div>

            <div class="boka-collection-scroll__stat-card">
              <strong>{{ section.settings.stat_3_number }}</strong>
              <span>{{ section.settings.stat_3_label }}</span>
            </div>
          </div>

          <div class="boka-collection-scroll__review-grid">
            <div class="boka-collection-scroll__review-card">
              <div class="boka-collection-scroll__stars">★★★★★</div>
              <p>“{{ section.settings.review_1_text }}”</p>
              <span>{{ section.settings.review_1_name }}</span>
            </div>

            <div class="boka-collection-scroll__review-card">
              <div class="boka-collection-scroll__stars">★★★★★</div>
              <p>“{{ section.settings.review_2_text }}”</p>
              <span>{{ section.settings.review_2_name }}</span>
            </div>

            <div class="boka-collection-scroll__review-card">
              <div class="boka-collection-scroll__stars">★★★★★</div>
              <p>“{{ section.settings.review_3_text }}”</p>
              <span>{{ section.settings.review_3_name }}</span>
            </div>
          </div>
        </div>
      </section>
    {% endif %}

    <div class="boka-collection-scroll__scenes">
      {% for flavor_product in active_collection.products limit: products_to_show %}
        {% liquid
          assign loop_mod = forloop.index0 | modulo: 2

          if loop_mod == 0
            assign scene_class = 'is-even'
            assign fallback_accent = section.settings.alt_accent_color_1
            assign fallback_bg = section.settings.alt_background_color_1
          else
            assign scene_class = 'is-odd'
            assign fallback_accent = section.settings.alt_accent_color_2
            assign fallback_bg = section.settings.alt_background_color_2
          endif

          assign headline = flavor_product.metafields.custom.flavor_scroll_headline.value | default: flavor_product.title
          assign description = flavor_product.metafields.custom.flavor_scroll_description.value | default: flavor_product.description | strip_html | truncate: 420
          assign bullets = flavor_product.metafields.custom.flavor_scroll_bullets.value
          assign character_name = flavor_product.metafields.custom.character_name.value | default: flavor_product.title
          assign character_quote = flavor_product.metafields.custom.character_quote.value

          assign metafield_accent = flavor_product.metafields.custom.flavor_accent_color.value
          assign metafield_bg = flavor_product.metafields.custom.flavor_background_color.value

          if section.settings.enable_metafield_color_overrides and metafield_accent != blank
            assign accent_color = metafield_accent
          else
            assign accent_color = fallback_accent
          endif

          if section.settings.enable_metafield_color_overrides and metafield_bg != blank
            assign background_color = metafield_bg
          else
            assign background_color = fallback_bg
          endif

          assign next_product = active_collection.products[forloop.index]

          if next_product != blank
            assign next_loop_mod = forloop.index | modulo: 2

            if next_loop_mod == 0
              assign next_fallback_bg = section.settings.alt_background_color_1
            else
              assign next_fallback_bg = section.settings.alt_background_color_2
            endif

            assign next_metafield_bg = next_product.metafields.custom.flavor_background_color.value

            if section.settings.enable_metafield_color_overrides and next_metafield_bg != blank
              assign next_bg = next_metafield_bg
            else
              assign next_bg = next_fallback_bg
            endif
          else
            assign next_bg = section.settings.default_background
          endif

          assign character_image = flavor_product.metafields.custom.character_image.value
          assign character_hover_image = flavor_product.metafields.custom.character_hover_image.value

          if character_image != blank
            assign character_image_url = character_image | image_url: width: 1400
          elsif flavor_product.featured_image != blank
            assign character_image_url = flavor_product.featured_image | image_url: width: 1400
          else
            assign character_image_url = blank
          endif

          if character_hover_image != blank
            assign character_hover_image_url = character_hover_image | image_url: width: 1400
          else
            assign character_hover_image_url = character_image_url
          endif
        %}

        <article
          id="boka-product-scene-{{ section.id }}-{{ forloop.index }}"
          class="boka-collection-scroll__scene {{ scene_class }}"
          style="--scene-bg: {{ background_color }}; --next-bg: {{ next_bg }}; --scene-accent: {{ accent_color }};"
          data-default-src="{{ character_image_url }}"
          data-hover-src="{{ character_hover_image_url }}"
        >
          <div class="boka-collection-scroll__scene-bg">
            <span class="boka-collection-scroll__scene-blob is-a"></span>
            <span class="boka-collection-scroll__scene-blob is-b"></span>
            <span class="boka-collection-scroll__scene-blob is-c"></span>
          </div>

          <div class="boka-collection-scroll__scene-inner">
            <div class="boka-collection-scroll__scene-copy">
              <p class="boka-collection-scroll__eyebrow">{{ section.settings.scene_card_label }}</p>

              <h2>{{ headline }}</h2>

              {% if description != blank %}
                <p class="boka-collection-scroll__description">{{ description }}</p>
              {% endif %}

              {% if character_quote != blank %}
                <p class="boka-collection-scroll__quote">{{ character_quote }}</p>
              {% endif %}

              {% if bullets != blank %}
                <div class="boka-collection-scroll__bullets">
                  {% for bullet in bullets %}
                    <div class="boka-collection-scroll__bullet">
                      <span></span>
                      <p>{{ bullet }}</p>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}

              <div class="boka-collection-scroll__product-row">
                {% if flavor_product.featured_image != blank %}
                  <div class="boka-collection-scroll__product-row-image">
                    <img
                      src="{{ flavor_product.featured_image | image_url: width: 500 }}"
                      alt="{{ flavor_product.featured_image.alt | default: flavor_product.title | escape }}"
                      loading="lazy"
                    >
                  </div>
                {% endif %}

                <div>
                  <p>{{ flavor_product.title }}</p>

                  {% if flavor_product.price %}
                    <span>{{ flavor_product.price | money }}</span>
                  {% endif %}
                </div>

                <a href="{{ flavor_product.url }}" class="boka-collection-scroll__button is-small">
                  {{ section.settings.product_button_label }}
                </a>
              </div>
            </div>

            <div class="boka-collection-scroll__scene-visual js-boka-scene-visual">
              <div class="boka-collection-scroll__orbit">
                <span></span>
                <span></span>
                <span></span>
              </div>

              {% if character_image_url != blank %}
                <img
                  class="boka-collection-scroll__character-image"
                  src="{{ character_image_url }}"
                  alt="{{ character_name | escape }}"
                  loading="lazy"
                >
              {% endif %}
            </div>
          </div>

          <div class="boka-collection-scroll__curve is-scene-curve" aria-hidden="true">
            <svg viewBox="0 0 1440 150" preserveAspectRatio="none">
