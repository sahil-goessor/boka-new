<script>
  (() => {
    const section = document.querySelector('#boka-character-story-{{ section.id }}');
    if (!section) return;

    const scenes = Array.from(section.querySelectorAll('.boka-character-story__scene'));
    const characterShell = section.querySelector('.boka-character-story__character-shell');
    const characterImage = section.querySelector('.boka-character-story__character-image');
    const characterName = section.querySelector('.boka-character-story__character-name');
    const characterQuote = section.querySelector('.boka-character-story__character-quote');
    const characterBlob = section.querySelector('.boka-character-story__blob');

    if (!scenes.length || !characterImage || !characterName || !characterQuote) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let activeScene = null;
    let activeDefaultSrc = '';
    let activeHoverSrc = '';
    let isHoveringCharacter = false;

    const swapCharacterImage = (src, alt, immediate = false) => {
      if (!src || characterImage.getAttribute('src') === src) return;

      if (!prefersReducedMotion && !immediate) {
        characterImage.style.opacity = '0';
      }

      window.setTimeout(() => {
        characterImage.setAttribute('src', src);
        characterImage.setAttribute('alt', alt || '');
        characterImage.style.opacity = '1';
      }, prefersReducedMotion || immediate ? 0 : 140);
    };

    const setActiveScene = (scene) => {
      if (!scene || activeScene === scene) return;

      activeScene = scene;

      scenes.forEach((item) => {
        item.classList.toggle('is-active', item === scene);
      });

      const src = scene.dataset.characterSrc || '';
      const hoverSrc = scene.dataset.characterHoverSrc || src;
      const alt = scene.dataset.characterAlt || '';
      const name = scene.dataset.characterName || '';
      const quote = scene.dataset.characterQuote || '';
      const sceneBg = scene.dataset.sceneBg || '#DDEFE6';

      activeDefaultSrc = src;
      activeHoverSrc = hoverSrc;

      section.style.setProperty('--active-scene-bg', sceneBg);

      if (characterBlob) {
        characterBlob.style.background = sceneBg;
      }

      swapCharacterImage(isHoveringCharacter ? activeHoverSrc : activeDefaultSrc, alt);

      characterName.textContent = name;
      characterQuote.textContent = quote;
    };

    setActiveScene(scenes[0]);

    const observer = new IntersectionObserver((entries) => {
      const activeEntry = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

      if (activeEntry) {
        setActiveScene(activeEntry.target);
      }
    }, {
      root: null,
      threshold: [0.22, 0.35, 0.5, 0.65, 0.78]
    });

    scenes.forEach((scene) => observer.observe(scene));

    if (characterShell) {
      characterShell.addEventListener('mouseenter', () => {
        if (window.innerWidth < 900) return;

        isHoveringCharacter = true;

        if (activeScene) {
          swapCharacterImage(activeHoverSrc, activeScene.dataset.characterAlt || '', true);
        }
      });

      characterShell.addEventListener('mouseleave', () => {
        isHoveringCharacter = false;

        if (activeScene) {
          swapCharacterImage(activeDefaultSrc, activeScene.dataset.characterAlt || '', true);
        }
      });
    }

    let ticking = false;

    const updateCharacterScrollMotion = () => {
      const rect = section.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress = scrollable > 0
        ? Math.min(Math.max(-rect.top / scrollable, 0), 1)
        : 0;

      const yMove = window.innerWidth < 900 ? progress * 8 : progress * 64;
      const rotate = window.innerWidth < 900 ? 0 : (progress - 0.5) * 4;

      if (!prefersReducedMotion) {
        characterImage.style.transform = `translateY(${yMove}px) rotate(${rotate}deg)`;
      }

      ticking = false;
    };

    const requestUpdate = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateCharacterScrollMotion);
        ticking = true;
      }
    };

    updateCharacterScrollMotion();

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
  })();
</script>

