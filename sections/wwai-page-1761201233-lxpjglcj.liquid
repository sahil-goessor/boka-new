    .boka-purchase-options__card--onetime.is-active { background: var(--boka-active-bg); border-color: var(--boka-active-border); box-shadow: none; }
    .boka-purchase-options__card-button {
      width: 100%; padding: 14px; display: flex; gap: 0.75rem;
      border: 0; background: transparent; color: inherit; text-align: left; cursor: pointer; font: inherit;
    }
    .boka-purchase-options__card--onetime { padding: 14px; display: flex; gap: 0.75rem; cursor: pointer; font: inherit; }
    .boka-purchase-options__radio {
      width: 18px; height: 18px; border: 1px solid var(--boka-card-text);
      border-radius: 999px; margin-top: 2px; flex: 0 0 18px; background: transparent;
    }
    .boka-purchase-options__card.is-active .boka-purchase-options__radio {
      background: var(--boka-card-text); box-shadow: inset 0 0 0 5px var(--boka-card-bg);
    }
    .boka-purchase-options__card--onetime.is-active .boka-purchase-options__radio {
      box-shadow: inset 0 0 0 5px var(--boka-active-bg);
    }
    .boka-purchase-options__content { display: grid; gap: 0.35rem; flex: 1; min-width: 0; }
    .boka-purchase-options__top { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
    .boka-purchase-options__title { font-weight: 600; line-height: 1.2; }
    .boka-purchase-options__badge {
      font-size: 10px; line-height: 1; padding: 0.35rem 0.55rem;
      border-radius: 999px; background: var(--boka-badge-bg); color: var(--boka-badge-text); white-space: nowrap;
    }
    .boka-purchase-options__copy { font-size: 12px; color: var(--boka-muted-text); line-height: 1.35; }
    .boka-purchase-options__price { color: var(--boka-card-text); font-weight: 600; line-height: 1.2; }
    .boka-purchase-options__price s { margin-left: 0.4rem; color: var(--boka-muted-text); font-weight: 400; opacity: 0.55; }
    .boka-purchase-options__frequency-wrap { padding: 0 14px 14px 44px; display: grid; gap: 0.5rem; background: transparent; }
    .boka-purchase-options__frequency-label { font-size: 12px; color: var(--boka-muted-text); line-height: 1.2; padding-top: 0.75rem; }
    .boka-purchase-options__frequency-select-wrap { position: relative; width: 100%; }
    .boka-purchase-options__frequency-select {
      width: 100%; min-height: 44px; padding: 10px 42px 10px 14px;
      border: 1px solid var(--boka-card-border); border-radius: var(--rounded-button, 12px);
      background: var(--boka-card-bg); color: var(--boka-card-text);
      font: inherit; font-size: 1rem; line-height: 1.2; cursor: pointer; appearance: none; -webkit-appearance: none;
    }
    .boka-purchase-options__frequency-select:focus { outline: transparent; }
    .boka-purchase-options__frequency-chevron {
      position: absolute; top: 50%; right: 14px; transform: translateY(-50%);
      pointer-events: none; display: inline-flex; align-items: center; justify-content: center;
