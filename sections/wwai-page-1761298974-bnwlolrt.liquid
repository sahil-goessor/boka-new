:none;>Select Size</legend><input data-img-id data-title=Size data-wwai-product-label=refresh-mint-whitening-toothpaste data-wwai-product-variant-label="3 Pack" data-wwai-product-variant-label-key=Size data-wwai-product-variant-label-level=option1 data-wwai-product-variant-option-type=product_variant id=variant-size-3-5 name=variant-size type=radio value="3 Pack"><label class=pdp_variant_lable data-label="3 Pack" data-size-variant for=variant-size-3-5><span>3 Pack</span></label></fieldset></div><div data-variant='[{"id":40877436043307,"title":"1 Pack","option1":"1 Pack","option2":null,"option3":null,"sku":"BOK-FGS-W002-02-AA1US","requires_shipping":true,"taxable":true,"featured_image":{"id":"gid://shopify/ProductImage/35166904090667","alt":"Silver tube of Refresh Mint Whitening* n-Ha Toothpaste on a white background.","src":"https://cdn.shopify.com/s/files/1/2656/6094/files/RefreshMint_MainImage1pk_result.webp?v=1753092408","width":1100,"height":1100,"aspect_ratio":1},"available":true,"name":"Refresh Mint Whitening* n-Ha Toothpaste - 1 Pack","public_title":"1 Pack","options":["1 Pack"],"price":1200,"weight":0,"compare_at_price":1400,"inventory_management":"shopify","barcode":"","image":"https://cdn.shopify.com/s/files/1/2656/6094/files/RefreshMint_MainImage1pk_result.webp?v=1753092408","featured_media":{"alt":"Silver tube of Refresh Mint Whitening* n-Ha Toothpaste on a white background.","id":35166904090667,"position":1,"preview_image":{"aspect_ratio":1,"height":1100,"width":1100,"src":"https://cdn.shopify.com/s/files/1/2656/6094/files/RefreshMint_MainImage1pk_result.webp?v=1753092408"}},"requires_selling_plan":false,"selling_plan_allocations":[]},{"id":40877436076075,"title":"2 Pack","option1":"2 Pack","option2":null,"option3":null,"sku":"BOK-VIR-A002-01-BG1US","requires_shipping":true,"taxable":true,"featured_image":{"id":"gid://shopify/ProductImage/35166903992363","alt":"Two tubes of Refresh Mint Whitening* n-Ha Toothpaste, peroxide-free, stand side by side.","src":"https://cdn.shopify.com/s/files/1/2656/6094/files/RefreshMint_MainImage2pk_result.webp?v=1758819259","width":1100,"height":1100,"aspect_ratio":1},"available":true,"name":"Refresh Mint Whitening* n-Ha Toothpaste - 2 Pack","public_title":"2 Pack","options":["2 Pack"],"price":2200,"weight":0,"compare_at_price":2800,"inventory_management":"shopify","barcode":"","image":"https://cdn.shopify.com/s/files/1/2656/6094/files/RefreshMint_MainImage2pk_result.webp?v=1758819259","featured_media":{"alt":"Two tubes of Refresh Mint Whitening* n-Ha Toothpaste, peroxide-free, stand side by side.","id":35166903992363,"position":1,"preview_image":{"aspect_ratio":1,"height":1100,"width":1100,"src":"https://cdn.shopify.com/s/files/1/2656/6094/files/RefreshMint_MainImage2pk_result.webp?v=1758819259"}},"requires_selling_plan":false,"selling_plan_allocations":[]},{"id":41301320695851,"title":"3 Pack","option1":"3 Pack","option2":null,"option3":null,"sku":"BOK-VIR-W003-01-BW1US","requires_shipping":true,"taxable":true,"featured_image":{"id":"gid://shopify/ProductImage/35166904156203","alt":"Three tubes of Refresh Mint Whitening* n-Ha Toothpaste, peroxide-free, standing upright side by side.","src":"https://cdn.shopify.com/s/files/1/2656/6094/files/RefreshMint_MainImage3pk_result.webp?v=1758819259","width":1100,"height":1100,"aspect_ratio":1},"available":true,"name":"Refresh Mint Whitening* n-Ha Toothpaste - 3 Pack","public_title":"3 Pack","options":["3 Pack"],"price":3200,"weight":0,"compare_at_price":4200,"inventory_management":"shopify","barcode":"","image":"https://cdn.shopify.com/s/files/1/2656/6094/files/RefreshMint_MainImage3pk_result.webp?v=1758819259","featured_media":{"alt":"Three tubes of Refresh Mint Whitening* n-Ha Toothpaste, peroxide-free, standing upright side by side.","id":35166904156203,"position":1,"preview_image":{"aspect_ratio":1,"height":1100,"width":1100,"src":"https://cdn.shopify.com/s/files/1/2656/6094/files/RefreshMint_MainImage3pk_result.webp?v=1758819259"}},"requires_selling_plan":false,"selling_plan_allocations":[]}]' id=wwaiVariantData style="display: none;"></div></form></product-variant-selector>

{%- liquid
  assign boka_ela_product = all_products['refresh-mint-whitening-toothpaste']
  assign boka_selected_variant = boka_ela_product.selected_or_first_available_variant
  assign boka_first_selling_plan = nil
  assign boka_first_selling_plan_allocation = nil

  for selling_plan_group in boka_ela_product.selling_plan_groups
    for selling_plan in selling_plan_group.selling_plans
      if boka_first_selling_plan == nil
        assign boka_first_selling_plan = selling_plan
      endif
    endfor
  endfor

  if boka_selected_variant != blank and boka_selected_variant.selling_plan_allocations.size > 0
    if boka_first_selling_plan != blank
      for allocation in boka_selected_variant.selling_plan_allocations
        if allocation.selling_plan.id == boka_first_selling_plan.id
          assign boka_first_selling_plan_allocation = allocation
          break
        endif
      endfor
    endif
    if boka_first_selling_plan_allocation == nil
      assign boka_first_selling_plan_allocation = boka_selected_variant.selling_plan_allocations.first
    endif
  endif
-%}

{%- if boka_ela_product.selling_plan_groups.size > 0 and boka_selected_variant != blank -%}

  <form id="boka-listicle-pdp-form" style="display:none;">
    <input type="hidden" name="id" id="boka-listicle-variant-id" value="{{ boka_selected_variant.id }}">
  </form>

  <div class="boka-purchase-options" data-boka-purchase-options>

    <input
      type="hidden"
      name="selling_plan"
      value="{% if boka_first_selling_plan_allocation != blank %}{{ boka_first_selling_plan_allocation.selling_plan.id }}{% elsif boka_first_selling_plan != blank %}{{ boka_first_selling_plan.id }}{% endif %}"
      form="boka-listicle-pdp-form"
      data-boka-selling-plan-input
    >

    <div class="boka-purchase-options__card boka-purchase-options__card--subscribe is-active" data-boka-plan-card="subscribe">
      <button type="button" class="boka-purchase-options__card-button" data-boka-plan-option="subscribe" aria-pressed="true">
        <span class="boka-purchase-options__radio" aria-hidden="true"></span>
        <span class="boka-purchase-options__content">
          <span class="boka-purchase-options__top">
            <span class="boka-purchase-options__title">Subscribe &amp; Save</span>
            <span class="boka-purchase-options__badge">Save 15%</span>
          </span>
          <span class="boka-purchase-options__copy">Ships automatically. Pause, skip, or cancel anytime.</span>
          <span class="boka-purchase-options__price" data-boka-subscription-price>
            {%- if boka_first_selling_plan_allocation != blank -%}
              {{ boka_first_selling_plan_allocation.price | money }}
              {%- if boka_selected_variant.price > boka_first_selling_plan_allocation.price -%}
                <s>{{ boka_selected_variant.price | money }}</s>
              {%- elsif boka_first_selling_plan_allocation.compare_at_price > boka_first_selling_plan_allocation.price -%}
                <s>{{ boka_first_selling_plan_allocation.compare_at_price | money }}</s>
              {%- endif -%}
            {%- else -%}
              {{ boka_selected_variant.price | money }}
            {%- endif -%}
          </span>
        </span>
      </button>

      <div class="boka-purchase-options__frequency-wrap" data-boka-frequency-wrap>
        <label class="boka-purchase-options__frequency-label" for="boka-selling-plan-{{ boka_ela_product.id }}-listicle">
          Delivery frequency
        </label>
        <div class="boka-purchase-options__frequency-select-wrap">
          <select id="boka-selling-plan-{{ boka_ela_product.id }}-listicle" class="boka-purchase-options__frequency-select" data-boka-frequency-select aria-label="Delivery frequency">
            {%- assign boka_rendered_plan_count = 0 -%}
            {%- for selling_plan_group in boka_ela_product.selling_plan_groups -%}
              {%- for selling_plan in selling_plan_group.selling_plans -%}
                {%- assign boka_rendered_plan_count = boka_rendered_plan_count | plus: 1 -%}
                {%- assign boka_matching_alloc = nil -%}
                {%- if boka_selected_variant.selling_plan_allocations.size > 0 -%}
                  {%- for allocation in boka_selected_variant.selling_plan_allocations -%}
                    {%- if allocation.selling_plan.id == selling_plan.id -%}
                      {%- assign boka_matching_alloc = allocation -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                <option
                  value="{{ selling_plan.id }}"
                  data-selling-plan-price="{% if boka_matching_alloc != blank %}{{ boka_matching_alloc.price | money | escape }}{% else %}{{ boka_selected_variant.price | money | escape }}{% endif %}"
                  data-selling-plan-compare="{% if boka_matching_alloc != blank and boka_selected_variant.price > boka_matching_alloc.price %}{{ boka_selected_variant.price | money | escape }}{% elsif boka_matching_alloc != blank and boka_matching_alloc.compare_at_price > boka_matching_alloc.price %}{{ boka_matching_alloc.compare_at_price | money | escape }}{% endif %}"
                  {% if boka_first_selling_plan_allocation != blank and boka_matching_alloc != blank and boka_matching_alloc.selling_plan.id == boka_first_selling_plan_allocation.selling_plan.id %}selected{% elsif boka_first_selling_plan_allocation == blank and boka_rendered_plan_count == 1 %}selected{% endif %}
                >{{ selling_plan.name }}</option>
              {%- endfor -%}
            {%- endfor -%}
          </select>
          <span class="boka-purchase-options__frequency-chevron" aria-hidden="true">
            <svg width="12" height="7" viewBox="0 0 12 7" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </div>
    </div>

    <button type="button" class="boka-purchase-options__card boka-purchase-options__card--onetime" data-boka-plan-card="onetime" data-boka-plan-option="onetime" aria-pressed="false">
      <span class="boka-purchase-options__radio" aria-hidden="true"></span>
      <span class="boka-purchase-options__content">
        <span class="boka-purchase-options__top">
          <span class="boka-purchase-options__title">One-time purchase</span>
        </span>
        <span class="boka-purchase-options__copy">Buy once with no automatic refills.</span>
        <span class="boka-purchase-options__price" data-boka-onetime-price>{{ boka_selected_variant.price | money }}</span>
      </span>
    </button>

    <script type="application/json" data-boka-purchase-options-data>
      {
        "variants": [
          {%- for variant in boka_ela_product.variants -%}
            {
              "id": {{ variant.id | json }},
              "price": {{ variant.price | money | json }},
              "plans": [
                {%- assign boka_plan_index = 0 -%}
                {%- for selling_plan_group in boka_ela_product.selling_plan_groups -%}
                  {%- for selling_plan in selling_plan_group.selling_plans -%}
                    {%- assign boka_var_alloc = nil -%}
                    {%- if variant.selling_plan_allocations.size > 0 -%}
                      {%- for allocation in variant.selling_plan_allocations -%}
                        {%- if allocation.selling_plan.id == selling_plan.id -%}
                          {%- assign boka_var_alloc = allocation -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                    {%- if boka_plan_index > 0 -%},{%- endif -%}
                    {
                      "id": {{ selling_plan.id | json }},
                      "name": {{ selling_plan.name | json }},
                      "price": {% if boka_var_alloc != blank %}{{ boka_var_alloc.price | money | json }}{% else %}{{ variant.price | money | json }}{% endif %},
                      "compare": {% if boka_var_alloc != blank and variant.price > boka_var_alloc.price %}{{ variant.price | money | json }}{% elsif boka_var_alloc != blank and boka_var_alloc.compare_at_price > boka_var_alloc.price %}{{ boka_var_alloc.compare_at_price | money | json }}{% else %}""{% endif %}
                    }
                    {%- assign boka_plan_index = boka_plan_index | plus: 1 -%}
                  {%- endfor -%}
                {%- endfor -%}
              ]
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    </script>
  </div>

  <script>
    (() => {
      const root = document.currentScript.previousElementSibling;
      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const input             = root.querySelector('[data-boka-selling-plan-input]');
      const planCards         = [...root.querySelectorAll('[data-boka-plan-card]')];
      const planButtons       = [...root.querySelectorAll('[data-boka-plan-option]')];
      const frequencySelect   = root.querySelector('[data-boka-frequency-select]');
      const subscriptionPrice = root.querySelector('[data-boka-subscription-price]');
      const oneTimePrice      = root.querySelector('[data-boka-onetime-price]');
      const dataScript        = root.querySelector('[data-boka-purchase-options-data]');

      let variantData = { variants: [] };
      try {
        variantData = JSON.parse(dataScript?.textContent || '{"variants":[]}');
      } catch (e) {
        console.warn('Boka listicle: could not parse variant data', e);
      }

      const variantIdInput = document.getElementById('boka-listicle-variant-id');

      const getVariantById = (id) =>
        variantData.variants.find((v) => String(v.id) === String(id));

      const getSelectedFrequencyOption = () =>
        frequencySelect ? frequencySelect.options[frequencySelect.selectedIndex] : null;

      const renderPrice = (price, compare) =>
        compare ? `${price} <s>${compare}</s>` : price;

      const updateSubscriptionPrice = () => {
        const opt = getSelectedFrequencyOption();
        if (!subscriptionPrice || !opt) return;
        const price   = opt.dataset.sellingPlanPrice;
        const compare = opt.dataset.sellingPlanCompare;
        if (price) subscriptionPrice.innerHTML = renderPrice(price, compare);
      };

      const rebuildFrequencyOptions = (variant) => {
        if (!frequencySelect || !variant || !Array.isArray(variant.plans)) return;
        const prev = frequencySelect.value;
        frequencySelect.innerHTML = '';
        variant.plans.forEach((plan) => {
          const opt = document.createElement('option');
          opt.value = plan.id;
          opt.textContent = plan.name;
          opt.dataset.sellingPlanPrice   = plan.price   || variant.price || '';
          opt.dataset.sellingPlanCompare = plan.compare || '';
          frequencySelect.appendChild(opt);
        });
        if (prev && [...frequencySelect.options].some((o) => o.value === prev)) {
          frequencySelect.value = prev;
        } else if (frequencySelect.options.length > 0) {
          frequencySelect.selectedIndex = 0;
        }
      };

      const isSubscribeActive = () =>
        !!root.querySelector('[data-boka-plan-card="subscribe"]')?.classList.contains('is-active');

      const getSellingPlanId = () => {
        if (!input || input.disabled || !input.value) return null;
        return input.value;
      };

      const syncCtas = () => {
        const onetimeCta   = document.getElementById('boka-listicle-onetime-cta');
        const subscribeCta = document.getElementById('boka-listicle-subscribe-cta');
        const isSub  = isSubscribeActive();
        const varId  = variantIdInput ? variantIdInput.value : null;
        const planId = getSellingPlanId();
        if (onetimeCta)   onetimeCta.style.display  = isSub ? 'none' : 'block';
        if (subscribeCta) subscribeCta.style.display = isSub ? 'block' : 'none';
        if (subscribeCta && planId && varId) {
          subscribeCta.dataset.variantId = varId;
          subscribeCta.dataset.planId    = planId;
        }
      };

      const updateForVariant = (variantId) => {
        const variant = getVariantById(variantId);
        if (!variant) return;
        if (variantIdInput) variantIdInput.value = String(variantId);
        if (oneTimePrice && variant.price) oneTimePrice.textContent = variant.price;
        rebuildFrequencyOptions(variant);
        if (input && isSubscribeActive()) {
          input.disabled = false;
          input.value    = frequencySelect ? frequencySelect.value : '';
        }
        updateSubscriptionPrice();
        syncCtas();
      };

      const setActivePlan = (type) => {
        planCards.forEach((card) =>
          card.classList.toggle('is-active', card.dataset.bokaPlanCard === type)
        );
        planButtons.forEach((btn) => {
          btn.setAttribute('aria-pressed', btn.dataset.bokaPlanOption === type ? 'true' : 'false');
        });
        if (!input) return;
        if (type === 'subscribe') {
          input.disabled = false;
          input.value    = frequencySelect ? frequencySelect.value : '';
          updateSubscriptionPrice();
        } else {
          input.value    = '';
          input.disabled = true;
        }
        syncCtas();
      };

      planButtons.forEach((btn) => {
        btn.addEventListener('click', () => setActivePlan(btn.dataset.bokaPlanOption));
      });

      if (frequencySelect) {
        frequencySelect.addEventListener('click', (e) => e.stopPropagation());
        frequencySelect.addEventListener('change', () => {
          setActivePlan('subscribe');
          syncCtas();
        });
      }

      document.addEventListener('change', (e) => {
        const t = e.target;
        if (!t) return;
        if (t.name === 'variant-size' && t.type === 'radio') {
          const wwaiEl = document.getElementById('wwaiVariantData');
          let wwaiVariants = [];
          try { wwaiVariants = JSON.parse(wwaiEl?.getAttribute('data-variant') || '[]') || []; } catch (_) {}
          const matched = wwaiVariants.find((v) => v.option1 === t.value);
          if (matched) updateForVariant(matched.id);
          else setTimeout(syncCtas, 100);
        }
      });

      document.addEventListener('variant:change', (e) => {
        const id = e.detail?.variant?.id || e.detail?.id;
        if (id) updateForVariant(id);
      });

      document.addEventListener('click', function(e) {
        if (!e.target.closest('#boka-listicle-subscribe-cta')) return;
        e.preventDefault();
        e.stopPropagation();

        const varId  = variantIdInput ? variantIdInput.value : null;
        const planId = getSellingPlanId();

        if (!varId || !planId) {
          console.warn('Boka subscribe: missing varId or planId', { varId, planId });
          return;
        }

        const btn  = document.getElementById('boka-listicle-subscribe-cta');
        const orig = btn ? btn.innerHTML : '';
        if (btn) { btn.innerHTML = 'Adding…'; btn.style.pointerEvents = 'none'; }

        fetch('/cart/add.js', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ items: [{ id: Number(varId), quantity: 1, selling_plan: Number(planId) }] })
        })
        .then(function(response) {
          if (!response.ok) {
            return response.json().then(function(err) {
              console.error('Boka cart add failed:', err);
              window.location.href = '/cart/' + varId + ':1?selling_plan=' + planId;
            });
          }
          window.location.href = '/discount/NEWTOBOKA?redirect=/checkout';
        })
        .catch(function() {
          window.location.href = '/cart/' + varId + ':1?selling_plan=' + planId;
        })
        .finally(function() {
          if (btn) { btn.innerHTML = orig; btn.style.pointerEvents = ''; }
        });
      }, true);

      let currentVariantId = variantIdInput ? variantIdInput.value : null;
      setInterval(() => {
        const next = variantIdInput ? variantIdInput.value : null;
        if (next && String(next) !== String(currentVariantId)) {
          currentVariantId = next;
          updateForVariant(next);
        }
      }, 250);

      const subscribeCard = root.querySelector('[data-boka-plan-card="subscribe"]');
      if (subscribeCard && window.MutationObserver) {
        new MutationObserver(syncCtas).observe(subscribeCard, { attributes: true, attributeFilter: ['class'] });
      }

      updateForVariant(variantIdInput ? variantIdInput.value : null);
      setActivePlan('subscribe');
