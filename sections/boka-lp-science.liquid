<section class="boka-lp boka-lp-science">
  <div class="boka-lp__section boka-lp__section--science-collage" id="boka-science">
    <div class="boka-lp__wrap boka-lp__science-collage-wrap">

      <div class="boka-lp__science-collage-copy">
        <p class="boka-lp__eyebrow">Inspired by nature. Backed by science.</p>
        <h2 class="boka-lp__section-title">Thoughtfully formulated oral care for your daily routine.</h2>
      </div>

      <div class="boka-lp__science-collage-stage">
        {% if section.settings.science_image != blank %}
          {{
            section.settings.science_image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              class: 'boka-lp__science-collage-image',
              alt: section.settings.science_image_alt
          }}
        {% else %}
          <div class="boka-lp__science-collage-placeholder">BOKA</div>
        {% endif %}

        <div class="boka-lp__science-card boka-lp__science-card--one">
          <strong>n-Ha, made simple</strong>
          <p>n-Ha is a breakthrough material inspired by nature and backed by science, designed to fit into your everyday brushing routine.</p>
        </div>

        <div class="boka-lp__science-card boka-lp__science-card--two">
          <strong>Fluoride free</strong>
          <p>Boka toothpaste is fluoride free and thoughtfully formulated for daily use.</p>
        </div>

        <div class="boka-lp__science-card boka-lp__science-card--three">
          <strong>Daily formulas you’ll love</strong>
          <p>Made with great-tasting flavors and a design-forward approach to make your routine feel fresh, simple, and easy to enjoy.</p>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Boka LP science",
  "settings": [
    {
      "type": "image_picker",
      "id": "science_image",
      "label": "Science section image"
    },
    {
      "type": "text",
      "id": "science_image_alt",
      "label": "Science image alt text",
      "default": "Boka oral care products arranged on a clean background"
    }
  ],
  "presets": [
    {
      "name": "Boka LP science"
    }
  ]
}
{% endschema %}