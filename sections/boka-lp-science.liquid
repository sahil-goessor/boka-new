<section class="boka-lp boka-lp-science">
  <div class="boka-lp__section boka-lp__section--science-collage" id="boka-science">
    <div class="boka-lp__wrap boka-lp__science-collage-wrap">

      <div class="boka-lp__science-collage-copy">
        <p class="boka-lp__eyebrow">Powered by nature. Scientifically designed.</p>
        <h2 class="boka-lp__section-title">Science-backed care, without making oral care feel clinical.</h2>
      </div>

      <div class="boka-lp__science-collage-stage">
        {% if section.settings.science_image != blank %}
          {{
            section.settings.science_image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              class: 'boka-lp__science-collage-image',
              alt: section.settings.science_image_alt
          }}
        {% else %}
          <div class="boka-lp__science-collage-placeholder">BOKA</div>
        {% endif %}

        <div class="boka-lp__science-card boka-lp__science-card--one">
          <strong>n-Ha, made simple</strong>
          <p>n-Ha is a form of calcium that makes up the primary foundation of teeth and bones. It helps support your everyday oral care routine.</p>
        </div>

        <div class="boka-lp__science-card boka-lp__science-card--two">
          <strong>A fluoride-free option</strong>
          <p>Fluoride is a trusted ingredient, and some people prefer a different option. Boka gives you a feel-good fluoride-free routine.</p>
        </div>

        <div class="boka-lp__science-card boka-lp__science-card--three">
          <strong>Clean, daily formulas</strong>
          <p>Designed for people who care about ingredients, efficacy, and a bathroom shelf that looks as good as it feels.</p>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Boka LP science",
  "settings": [
    {
      "type": "image_picker",
      "id": "science_image",
      "label": "Science section image"
    },
    {
      "type": "text",
      "id": "science_image_alt",
      "label": "Science image alt text",
      "default": "Boka oral care products"
    }
  ],
  "presets": [
    {
      "name": "Boka LP science"
    }
  ]
}
{% endschema %}