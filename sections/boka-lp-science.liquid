<section class="boka-lp boka-lp-science" id="boka-science-section-{{ section.id }}">
  <div class="boka-lp__section boka-lp__section--science-collage" id="boka-science">
    <div class="boka-lp__wrap boka-lp__science-collage-wrap">

      <div class="boka-lp__science-collage-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="boka-lp__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="boka-lp__section-title">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
      </div>

      <div class="boka-lp__science-collage-stage">
        {% if section.settings.science_image != blank %}
          {{
            section.settings.science_image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              class: 'boka-lp__science-collage-image',
              alt: section.settings.science_image_alt
          }}
        {% else %}
          <div class="boka-lp__science-collage-placeholder">BOKA</div>
        {% endif %}

        <div class="boka-lp__science-card boka-lp__science-card--one">
          {% if section.settings.card_1_heading != blank %}
            <strong>{{ section.settings.card_1_heading }}</strong>
          {% endif %}

          {% if section.settings.card_1_copy != blank %}
            <div class="boka-lp__science-card-copy">
              {{ section.settings.card_1_copy }}
            </div>
          {% endif %}
        </div>

        <div class="boka-lp__science-card boka-lp__science-card--two">
          {% if section.settings.card_2_heading != blank %}
            <strong>{{ section.settings.card_2_heading }}</strong>
          {% endif %}

          {% if section.settings.card_2_copy != blank %}
            <div class="boka-lp__science-card-copy">
              {{ section.settings.card_2_copy }}
            </div>
          {% endif %}
        </div>

        <div class="boka-lp__science-card boka-lp__science-card--three">
          {% if section.settings.card_3_heading != blank %}
            <strong>{{ section.settings.card_3_heading }}</strong>
          {% endif %}

          {% if section.settings.card_3_copy != blank %}
            <div class="boka-lp__science-card-copy">
              {{ section.settings.card_3_copy }}
            </div>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Boka LP science",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Inspired by nature. Backed by science."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Thoughtfully formulated oral care for your daily routine."
    },
    {
      "type": "image_picker",
      "id": "science_image",
      "label": "Science section image"
    },
    {
      "type": "text",
      "id": "science_image_alt",
      "label": "Science image alt text",
      "default": "Boka oral care products arranged on a clean background"
    },
    {
      "type": "inline_richtext",
      "id": "card_1_heading",
      "label": "Card 1 heading",
      "default": "n-Ha, made simple"
    },
    {
      "type": "richtext",
      "id": "card_1_copy",
      "label": "Card 1 copy",
      "default": "<p>n-Ha is inspired by the mineral that makes up teeth and designed to fit into your everyday brushing routine.</p>"
    },
    {
      "type": "inline_richtext",
      "id": "card_2_heading",
      "label": "Card 2 heading",
      "default": "Fluoride free"
    },
    {
      "type": "richtext",
      "id": "card_2_copy",
      "label": "Card 2 copy",
      "default": "<p>Boka toothpaste is fluoride free and thoughtfully formulated for daily use.</p>"
    },
    {
      "type": "inline_richtext",
      "id": "card_3_heading",
      "label": "Card 3 heading",
      "default": "Daily formulas you’ll love"
    },
    {
      "type": "richtext",
      "id": "card_3_copy",
      "label": "Card 3 copy",
      "default": "<p>Made with great-tasting flavors and a design-forward approach to make your routine feel fresh, simple, and easy to enjoy.</p>"
    }
  ],
  "presets": [
    {
      "name": "Boka LP science"
    }
  ]
}
{% endschema %}