<section class="boka-lp boka-lp-included-bento-section" id="boka-included-section-{{ section.id }}">
<div class="boka-lp__section boka-lp__section--included-bento" id="boka-included-{{ section.id }}">
    <div class="boka-lp__wrap boka-lp__included-bento-wrap">

      <div class="boka-lp__included-bento-head">
        {% if section.settings.eyebrow != blank %}
          <p class="boka-lp__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="boka-lp__section-title">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.copy != blank %}
          <div class="boka-lp__section-copy">
            {{ section.settings.copy }}
          </div>
        {% endif %}
      </div>

      <div class="boka-lp__included-bento">
        <div class="boka-lp__included-bento-card boka-lp__included-bento-card--large">
          <div class="boka-lp__included-bento-copy">
            <span class="boka-lp__included-bento-number">01</span>
            <h3>Goal-Based n-Ha Toothpaste</h3>
            <p>Your daily n-Ha toothpaste, matched to your routine goal.</p>
          </div>

          <div class="boka-lp__included-bento-image">
            {% if section.settings.included_toothpaste_image != blank %}
              <img
                src="{{ section.settings.included_toothpaste_image | image_url: width: 720 }}"
                width="360"
                height="360"
                loading="lazy"
                alt="Boka goal-based n-Ha toothpaste"
              >
            {% else %}
              <span class="boka-lp__included-image-placeholder">BOKA</span>
            {% endif %}
          </div>
        </div>

        <div class="boka-lp__included-bento-card">
          <div class="boka-lp__included-bento-copy">
            <span class="boka-lp__included-bento-number">02</span>
            <h3>Classic Brush</h3>
            <p>Soft, simple, and made for everyday brushing.</p>
          </div>

          <div class="boka-lp__included-bento-image">
            {% if section.settings.included_brush_image != blank %}
              <img
                src="{{ section.settings.included_brush_image | image_url: width: 520 }}"
                width="260"
                height="260"
                loading="lazy"
                alt="Boka Classic Brush"
              >
            {% else %}
              <span class="boka-lp__included-image-placeholder">BOKA</span>
            {% endif %}
          </div>
        </div>

        <div class="boka-lp__included-bento-card">
          <div class="boka-lp__included-bento-copy">
            <span class="boka-lp__included-bento-number">03</span>
            <h3>Ela Mint Floss</h3>
            <p>A simple floss step for the full routine.</p>
          </div>

          <div class="boka-lp__included-bento-image">
            {% if section.settings.included_floss_image != blank %}
              <img
                src="{{ section.settings.included_floss_image | image_url: width: 520 }}"
                width="260"
                height="260"
                loading="lazy"
                alt="Boka Ela Mint Floss"
              >
            {% else %}
              <span class="boka-lp__included-image-placeholder">BOKA</span>
            {% endif %}
          </div>
        </div>

        <div class="boka-lp__included-bento-card">
          <div class="boka-lp__included-bento-copy">
            <span class="boka-lp__included-bento-number">04</span>
            <h3>Rasana Tongue Cleaner</h3>
            <p>A small finishing step for a fresh-feeling routine.</p>
          </div>

          <div class="boka-lp__included-bento-image">
            {% if section.settings.included_tongue_cleaner_image != blank %}
              <img
                src="{{ section.settings.included_tongue_cleaner_image | image_url: width: 520 }}"
                width="260"
                height="260"
                loading="lazy"
                alt="Boka Rasana Tongue Cleaner"
              >
            {% else %}
              <span class="boka-lp__included-image-placeholder">BOKA</span>
            {% endif %}
          </div>
        </div>

        <div class="boka-lp__included-bento-card boka-lp__included-bento-card--wide">
          <div class="boka-lp__included-bento-copy">
            <span class="boka-lp__included-bento-number">05</span>
            <h3>Boka Toiletry Bag</h3>
            <p>Keep the full routine together at home or on the go.</p>
          </div>

          <div class="boka-lp__included-bento-image">
            {% if section.settings.included_bag_image != blank %}
              <img
                src="{{ section.settings.included_bag_image | image_url: width: 720 }}"
                width="360"
                height="360"
                loading="lazy"
                alt="Boka Toiletry Bag"
              >
            {% else %}
              <span class="boka-lp__included-image-placeholder">BOKA</span>
            {% endif %}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Boka LP what's included",
  "settings": [
    {
      "type": "image_picker",
      "id": "included_toothpaste_image",
      "label": "Included thumbnail - Toothpaste"
    },
    {
      "type": "image_picker",
      "id": "included_brush_image",
      "label": "Included thumbnail - Brush"
    },
    {
      "type": "image_picker",
      "id": "included_floss_image",
      "label": "Included thumbnail - Floss"
    },
    {
      "type": "image_picker",
      "id": "included_tongue_cleaner_image",
      "label": "Included thumbnail - Tongue cleaner"
    },
    {
      "type": "image_picker",
      "id": "included_bag_image",
      "label": "Included thumbnail - Toiletry bag"
    }
  ],
  "presets": [
    {
      "name": "Boka LP what's included"
    }
  ]
}
{% endschema %}