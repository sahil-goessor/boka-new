<section class="boka-lp boka-lp-kit-system">
  <div class="boka-lp__section boka-lp__section--kit-system" id="boka-kit-system-{{ section.id }}">
    <div class="boka-lp__wrap boka-lp__kit-system-wrap">

      <div class="boka-lp__kit-system-head">
        <p class="boka-lp__eyebrow">What’s inside</p>

        <h2 class="boka-lp__section-title">
          Everything you need to make your daily routine feel easy.
        </h2>

        <p class="boka-lp__section-copy">
          Your first box brings the essentials together in one simple system.
        </p>
      </div>

      <div class="boka-lp__cards-4 boka-lp__included-cards boka-lp__kit-system-products">
        <div class="boka-lp__info-card boka-lp__included-card">
          <div class="boka-lp__included-image" aria-hidden="true">
            {% if section.settings.included_toothpaste_image != blank %}
              <img
                src="{{ section.settings.included_toothpaste_image | image_url: width: 320 }}"
                width="160"
                height="160"
                loading="lazy"
                alt="Goal Based n-Ha Toothpaste"
              >
            {% else %}
              <span class="boka-lp__included-image-placeholder">BOKA</span>
            {% endif %}
          </div>
          <strong>Goal Based n-Ha Toothpaste</strong>
        </div>

        <div class="boka-lp__info-card boka-lp__included-card">
          <div class="boka-lp__included-image" aria-hidden="true">
            {% if section.settings.included_brush_image != blank %}
              <img
                src="{{ section.settings.included_brush_image | image_url: width: 320 }}"
                width="160"
                height="160"
                loading="lazy"
                alt="Charcoal Classic Brush"
              >
            {% else %}
              <span class="boka-lp__included-image-placeholder">BOKA</span>
            {% endif %}
          </div>
          <strong>Charcoal Classic Brush</strong>
        </div>

        <div class="boka-lp__info-card boka-lp__included-card">
          <div class="boka-lp__included-image" aria-hidden="true">
            {% if section.settings.included_floss_image != blank %}
              <img
                src="{{ section.settings.included_floss_image | image_url: width: 320 }}"
                width="160"
                height="160"
                loading="lazy"
                alt="Teflon- and petroleum-free Floss"
              >
            {% else %}
              <span class="boka-lp__included-image-placeholder">BOKA</span>
            {% endif %}
          </div>
          <strong>Teflon/Petroleum-free Floss</strong>
        </div>

        <div class="boka-lp__info-card boka-lp__included-card">
          <div class="boka-lp__included-image" aria-hidden="true">
            {% if section.settings.included_tongue_cleaner_image != blank %}
              <img
                src="{{ section.settings.included_tongue_cleaner_image | image_url: width: 320 }}"
                width="160"
                height="160"
                loading="lazy"
                alt="Rasana Tongue Cleaner"
              >
            {% else %}
              <span class="boka-lp__included-image-placeholder">BOKA</span>
            {% endif %}
          </div>
          <strong>Rasana Tongue Cleaner</strong>
        </div>

        <div class="boka-lp__info-card boka-lp__included-card">
          <div class="boka-lp__included-image" aria-hidden="true">
            {% if section.settings.included_bag_image != blank %}
              <img
                src="{{ section.settings.included_bag_image | image_url: width: 320 }}"
                width="160"
                height="160"
                loading="lazy"
                alt="Boka Toiletry Bag"
              >
            {% else %}
              <span class="boka-lp__included-image-placeholder">BOKA</span>
            {% endif %}
          </div>
          <strong>Boka Toiletry Bag</strong>
        </div>
      </div>

      <div class="boka-lp__kit-system-divider">
        <span>$24.99 first order. Refills later.</span>
      </div>

      <div class="boka-lp__kit-system-refill-head">
        <h3>Start with the full routine. Refill only what you need.</h3>
      </div>

      <div class="boka-lp__routine-grid boka-lp__kit-system-routine">
        <div class="boka-lp__routine-panel is-green">
          <h3>First order · $24.99 + free shipping</h3>
          <p>
            Your first box is a complete Starter Kit: a $49.99 value for $24.99 today,
            with free shipping on your first order and refills.
          </p>
          <ul>
            <li>n-Ha Toothpaste</li>
            <li>Brush</li>
            <li>Floss</li>
            <li>Tongue cleaner</li>
            <li>Boka Toiletry Bag</li>
          </ul>
        </div>

        <div class="boka-lp__routine-panel">
          <h3>Every 3 months · Refill essentials</h3>
          <p>
            Your recurring refill keeps the routine going with the consumables you actually
            need to replace — no extra brush or tongue cleaner unless you want them.
          </p>
          <ul>
            <li>Toothpaste refill</li>
            <li>Floss or selected add-ons</li>
            <li>Save 15% on refills</li>
            <li>Pause, skip, or cancel anytime</li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Boka LP kit system",
  "settings": [
    {
      "type": "image_picker",
      "id": "included_toothpaste_image",
      "label": "Included thumbnail - Toothpaste"
    },
    {
      "type": "image_picker",
      "id": "included_brush_image",
      "label": "Included thumbnail - Brush"
    },
    {
      "type": "image_picker",
      "id": "included_floss_image",
      "label": "Included thumbnail - Floss"
    },
    {
      "type": "image_picker",
      "id": "included_tongue_cleaner_image",
      "label": "Included thumbnail - Tongue cleaner"
    },
    {
      "type": "image_picker",
      "id": "included_bag_image",
      "label": "Included thumbnail - Toiletry bag"
    }
  ],
  "presets": [
    {
      "name": "Boka LP kit system"
    }
  ]
}
{% endschema %}