<section class="boka-lp boka-lp-kit-flow-section">
  <div class="boka-lp__section boka-lp__section--kit-flow" id="boka-included-{{ section.id }}">
    <div class="boka-lp__wrap boka-lp__kit-flow-wrap">

      <div class="boka-lp__kit-flow-head">
        <p class="boka-lp__eyebrow">What’s inside</p>
        <h2 class="boka-lp__section-title">
          Everything you need to make your daily routine feel easy.
        </h2>
        <p class="boka-lp__section-copy">
          Your first box brings the essentials together in one simple system.
        </p>
      </div>

      <div class="boka-lp__kit-flow">
        <div class="boka-lp__kit-flow-item">
          <div class="boka-lp__kit-flow-copy">
            <span class="boka-lp__kit-flow-number">01</span>
            <h3>Goal Based n-Ha Toothpaste</h3>
          </div>

          <div class="boka-lp__kit-flow-image">
            {% if section.settings.included_toothpaste_image != blank %}
              <img
                src="{{ section.settings.included_toothpaste_image | image_url: width: 620 }}"
                width="310"
                height="310"
                loading="lazy"
                alt="Goal Based n-Ha Toothpaste"
              >
            {% else %}
              <span class="boka-lp__included-image-placeholder">BOKA</span>
            {% endif %}
          </div>
        </div>

        <div class="boka-lp__kit-flow-item is-reverse">
          <div class="boka-lp__kit-flow-copy">
            <span class="boka-lp__kit-flow-number">02</span>
            <h3>Charcoal Classic Brush</h3>
          </div>

          <div class="boka-lp__kit-flow-image">
            {% if section.settings.included_brush_image != blank %}
              <img
                src="{{ section.settings.included_brush_image | image_url: width: 620 }}"
                width="310"
                height="310"
                loading="lazy"
                alt="Charcoal Classic Brush"
              >
            {% else %}
              <span class="boka-lp__included-image-placeholder">BOKA</span>
            {% endif %}
          </div>
        </div>

        <div class="boka-lp__kit-flow-item">
          <div class="boka-lp__kit-flow-copy">
            <span class="boka-lp__kit-flow-number">03</span>
            <h3>Teflon/Petroleum-free Floss</h3>
          </div>

          <div class="boka-lp__kit-flow-image">
            {% if section.settings.included_floss_image != blank %}
              <img
                src="{{ section.settings.included_floss_image | image_url: width: 620 }}"
                width="310"
                height="310"
                loading="lazy"
                alt="Teflon- and petroleum-free Floss"
              >
            {% else %}
              <span class="boka-lp__included-image-placeholder">BOKA</span>
            {% endif %}
          </div>
        </div>

        <div class="boka-lp__kit-flow-item is-reverse">
          <div class="boka-lp__kit-flow-copy">
            <span class="boka-lp__kit-flow-number">04</span>
            <h3>Rasana Tongue Cleaner</h3>
          </div>

          <div class="boka-lp__kit-flow-image">
            {% if section.settings.included_tongue_cleaner_image != blank %}
              <img
                src="{{ section.settings.included_tongue_cleaner_image | image_url: width: 620 }}"
                width="310"
                height="310"
                loading="lazy"
                alt="Rasana Tongue Cleaner"
              >
            {% else %}
              <span class="boka-lp__included-image-placeholder">BOKA</span>
            {% endif %}
          </div>
        </div>

        <div class="boka-lp__kit-flow-item">
          <div class="boka-lp__kit-flow-copy">
            <span class="boka-lp__kit-flow-number">05</span>
            <h3>Boka Toiletry Bag</h3>
          </div>

          <div class="boka-lp__kit-flow-image">
            {% if section.settings.included_bag_image != blank %}
              <img
                src="{{ section.settings.included_bag_image | image_url: width: 620 }}"
                width="310"
                height="310"
                loading="lazy"
                alt="Boka Toiletry Bag"
              >
            {% else %}
              <span class="boka-lp__included-image-placeholder">BOKA</span>
            {% endif %}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Boka LP what's included",
  "settings": [
    {
      "type": "image_picker",
      "id": "included_toothpaste_image",
      "label": "Included thumbnail - Toothpaste"
    },
    {
      "type": "image_picker",
      "id": "included_brush_image",
      "label": "Included thumbnail - Brush"
    },
    {
      "type": "image_picker",
      "id": "included_floss_image",
      "label": "Included thumbnail - Floss"
    },
    {
      "type": "image_picker",
      "id": "included_tongue_cleaner_image",
      "label": "Included thumbnail - Tongue cleaner"
    },
    {
      "type": "image_picker",
      "id": "included_bag_image",
      "label": "Included thumbnail - Toiletry bag"
    }
  ],
  "presets": [
    {
      "name": "Boka LP what's included"
    }
  ]
}
{% endschema %}