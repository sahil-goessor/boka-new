<section class="boka-lp boka-lp-faq" id="boka-faq-section-{{ section.id }}">
  <style>
    #boka-faq-section-{{ section.id }} {
      font-family: var(--font-body-family) !important;
      font-style: var(--font-body-style);
      font-weight: var(--font-body-weight);
    }

    #boka-faq-section-{{ section.id }} *,
    #boka-faq-section-{{ section.id }} *::before,
    #boka-faq-section-{{ section.id }} *::after {
      font-family: inherit;
      box-sizing: border-box;
    }

    #boka-faq-section-{{ section.id }} .boka-lp__section-title {
      font-family: var(--font-heading-family) !important;
      font-style: var(--font-heading-style) !important;
      font-weight: var(--font-heading-weight) !important;
      font-size: clamp(30px, 4vw, 46px);
      line-height: 1.06;
      letter-spacing: -0.045em;
      color: var(--boka-charcoal);
      max-width: 780px;
      margin: 0 0 18px;
    }

    #boka-faq-section-{{ section.id }} .boka-lp__faq-question {
      font-family: var(--font-heading-family) !important;
      font-style: var(--font-heading-style) !important;
      font-weight: var(--font-heading-weight) !important;
    }

    #boka-faq-section-{{ section.id }} .boka-lp__eyebrow,
    #boka-faq-section-{{ section.id }} .boka-lp__faq-content,
    #boka-faq-section-{{ section.id }} .boka-lp__faq-btn {
      font-family: var(--font-body-family) !important;
      font-style: var(--font-body-style);
    }

    #boka-faq-section-{{ section.id }} button {
      font: inherit;
    }

    @media screen and (max-width: 749px) {
      #boka-faq-section-{{ section.id }},
      #boka-faq-section-{{ section.id }} *,
      #boka-faq-section-{{ section.id }} *::before,
      #boka-faq-section-{{ section.id }} *::after {
        font-family: var(--font-body-family) !important;
      }

      #boka-faq-section-{{ section.id }} .boka-lp__section-title,
      #boka-faq-section-{{ section.id }} .boka-lp__faq-question {
        font-family: var(--font-heading-family) !important;
      }

      #boka-faq-section-{{ section.id }} .boka-lp__section-title {
        font-size: clamp(30px, 9vw, 40px);
        line-height: 1.04;
        letter-spacing: -0.045em;
      }
    }
  </style>

  <div class="boka-lp__section boka-lp__section--faq" id="boka-faq-{{ section.id }}">
    <div class="boka-lp__wrap boka-lp__wrap--faq">
      <div class="boka-lp__faq-heading">
        {% if section.settings.eyebrow != blank %}
          <p class="boka-lp__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="boka-lp__section-title">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
      </div>

      <div class="boka-lp__faq" data-boka-faq>
        <div class="boka-lp__faq-item is-open">
          <button type="button" class="boka-lp__faq-btn">
            <span class="boka-lp__faq-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 18c4-1 7-4 8-9 2 4 5 6 9 7-4 1-7 3-9 7-1-4-4-6-8-5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M12 9c-1-3 0-5 2-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>

            <span class="boka-lp__faq-question">
              {{ section.settings.faq_1_question }}
            </span>

            <span class="boka-lp__faq-chevron" aria-hidden="true"></span>
          </button>

          <div class="boka-lp__faq-content">
            {{ section.settings.faq_1_answer }}
          </div>
        </div>

        <div class="boka-lp__faq-item">
          <button type="button" class="boka-lp__faq-btn">
            <span class="boka-lp__faq-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M5 6h14v12H5V6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="m5 7 7 6 7-6" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              </svg>
            </span>

            <span class="boka-lp__faq-question">
              {{ section.settings.faq_2_question }}
            </span>

            <span class="boka-lp__faq-chevron" aria-hidden="true"></span>
          </button>

          <div class="boka-lp__faq-content">
            {{ section.settings.faq_2_answer }}
          </div>
        </div>

        <div class="boka-lp__faq-item">
          <button type="button" class="boka-lp__faq-btn">
            <span class="boka-lp__faq-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 7h16v13H4V7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M7 7V4h10v3" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M8 12h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>

            <span class="boka-lp__faq-question">
              {{ section.settings.faq_3_question }}
            </span>

            <span class="boka-lp__faq-chevron" aria-hidden="true"></span>
          </button>

          <div class="boka-lp__faq-content">
            {{ section.settings.faq_3_answer }}
          </div>
        </div>

        <div class="boka-lp__faq-item">
          <button type="button" class="boka-lp__faq-btn">
            <span class="boka-lp__faq-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 18c4-1 7-4 8-9 2 4 5 6 9 7-4 1-7 3-9 7-1-4-4-6-8-5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M12 9c-1-3 0-5 2-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>

            <span class="boka-lp__faq-question">
              {{ section.settings.faq_4_question }}
            </span>

            <span class="boka-lp__faq-chevron" aria-hidden="true"></span>
          </button>

          <div class="boka-lp__faq-content">
            {{ section.settings.faq_4_answer }}
          </div>
        </div>

        <div class="boka-lp__faq-item">
          <button type="button" class="boka-lp__faq-btn">
            <span class="boka-lp__faq-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 18c4-1 7-4 8-9 2 4 5 6 9 7-4 1-7 3-9 7-1-4-4-6-8-5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M12 9c-1-3 0-5 2-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>

            <span class="boka-lp__faq-question">
              {{ section.settings.faq_5_question }}
            </span>

            <span class="boka-lp__faq-chevron" aria-hidden="true"></span>
          </button>

          <div class="boka-lp__faq-content">
            {{ section.settings.faq_5_answer }}
          </div>
        </div>

        <div class="boka-lp__faq-item">
          <button type="button" class="boka-lp__faq-btn">
            <span class="boka-lp__faq-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 18c4-1 7-4 8-9 2 4 5 6 9 7-4 1-7 3-9 7-1-4-4-6-8-5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M12 9c-1-3 0-5 2-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>

            <span class="boka-lp__faq-question">
              {{ section.settings.faq_6_question }}
            </span>

            <span class="boka-lp__faq-chevron" aria-hidden="true"></span>
          </button>

          <div class="boka-lp__faq-content">
            {{ section.settings.faq_6_answer }}
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.getElementById('boka-faq-{{ section.id }}');
      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      root.querySelectorAll('.boka-lp__faq-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const item = btn.closest('.boka-lp__faq-item');
          const faq = btn.closest('.boka-lp__faq');

          faq.querySelectorAll('.boka-lp__faq-item').forEach((other) => {
            if (other !== item) other.classList.remove('is-open');
          });

          item.classList.toggle('is-open');
        });
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Boka LP FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Need to know"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions before you start?"
    },
    {
      "type": "text",
      "id": "faq_1_question",
      "label": "FAQ 1 question",
      "default": "What is n-Ha?"
    },
    {
      "type": "textarea",
      "id": "faq_1_answer",
      "label": "FAQ 1 answer",
      "default": "n-Ha stands for nano-hydroxyapatite. It is featured in Boka toothpaste and is inspired by the mineral that makes up teeth."
    },
    {
      "type": "text",
      "id": "faq_2_question",
      "label": "FAQ 2 question",
      "default": "Is Boka toothpaste fluoride free?"
    },
    {
      "type": "textarea",
      "id": "faq_2_answer",
      "label": "FAQ 2 answer",
      "default": "Yes. Boka n-Ha toothpaste is fluoride free and thoughtfully formulated for daily brushing."
    },
    {
      "type": "text",
      "id": "faq_3_question",
      "label": "FAQ 3 question",
      "default": "What comes in the starter kit?"
    },
    {
      "type": "textarea",
      "id": "faq_3_answer",
      "label": "FAQ 3 answer",
      "default": "Your starter kit includes n-Ha toothpaste, a Classic Brush, floss, a tongue cleaner, and a Boka toiletry bag."
    },
    {
      "type": "text",
      "id": "faq_4_question",
      "label": "FAQ 4 question",
      "default": "How do I choose the right routine goal?"
    },
    {
      "type": "textarea",
      "id": "faq_4_answer",
      "label": "FAQ 4 answer",
      "default": "Choose the goal that best matches the flavor or routine focus you want to start with. Each option includes a Boka n-Ha toothpaste plus the same starter essentials."
    },
    {
      "type": "text",
      "id": "faq_5_question",
      "label": "FAQ 5 question",
      "default": "Can I switch flavors later?"
    },
    {
      "type": "textarea",
      "id": "faq_5_answer",
      "label": "FAQ 5 answer",
      "default": "Yes. You can update your product selection through your account portal where available."
    },
    {
      "type": "text",
      "id": "faq_6_question",
      "label": "FAQ 6 question",
      "default": "Is this made for daily use?"
    },
    {
      "type": "textarea",
      "id": "faq_6_answer",
      "label": "FAQ 6 answer",
      "default": "Yes. Boka toothpaste is made for daily brushing when used as directed."
    }
  ],
  "presets": [
    {
      "name": "Boka LP FAQ"
    }
  ]
}
{% endschema %}