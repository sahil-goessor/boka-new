<section class="boka-lp boka-lp-faq">
  <div class="boka-lp__section boka-lp__section--faq" id="boka-faq-{{ section.id }}">
    <div class="boka-lp__wrap boka-lp__wrap--faq">
      <div class="boka-lp__faq-heading">
        <p class="boka-lp__eyebrow">Need to know</p>
        <h2 class="boka-lp__section-title">Questions before you start?</h2>
      </div>

      <div class="boka-lp__faq" data-boka-faq>

        <div class="boka-lp__faq-item is-open">
          <button type="button" class="boka-lp__faq-btn">
            <span class="boka-lp__faq-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 18c4-1 7-4 8-9 2 4 5 6 9 7-4 1-7 3-9 7-1-4-4-6-8-5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M12 9c-1-3 0-5 2-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>
            <span class="boka-lp__faq-question">What is n-Ha?</span>
            <span class="boka-lp__faq-chevron" aria-hidden="true"></span>
          </button>
          <div class="boka-lp__faq-content">
            n-Ha stands for nano-hydroxyapatite. It is a breakthrough material inspired by nature and backed by science, and it is featured in Boka toothpaste.
          </div>
        </div>

        <div class="boka-lp__faq-item">
          <button type="button" class="boka-lp__faq-btn">
            <span class="boka-lp__faq-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M5 6h14v12H5V6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="m5 7 7 6 7-6" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="boka-lp__faq-question">Is Boka toothpaste fluoride free?</span>
            <span class="boka-lp__faq-chevron" aria-hidden="true"></span>
          </button>
          <div class="boka-lp__faq-content">
            Yes. Boka n-Ha toothpaste is fluoride free and thoughtfully formulated for daily brushing.
          </div>
        </div>

        <div class="boka-lp__faq-item">
          <button type="button" class="boka-lp__faq-btn">
            <span class="boka-lp__faq-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 7h16v13H4V7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M7 7V4h10v3" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M8 12h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>
            <span class="boka-lp__faq-question">What comes in the starter kit?</span>
            <span class="boka-lp__faq-chevron" aria-hidden="true"></span>
          </button>
          <div class="boka-lp__faq-content">
            Your starter kit includes n-Ha toothpaste, a Classic Brush, floss, a tongue cleaner, and a Boka toiletry bag.
          </div>
        </div>

        <div class="boka-lp__faq-item">
          <button type="button" class="boka-lp__faq-btn">
            <span class="boka-lp__faq-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 18c4-1 7-4 8-9 2 4 5 6 9 7-4 1-7 3-9 7-1-4-4-6-8-5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M12 9c-1-3 0-5 2-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>
            <span class="boka-lp__faq-question">How do I choose the right routine goal?</span>
            <span class="boka-lp__faq-chevron" aria-hidden="true"></span>
          </button>
          <div class="boka-lp__faq-content">
            Choose the goal that best matches the flavor or routine focus you want to start with. Each option includes a Boka n-Ha toothpaste plus the same starter essentials.
          </div>
        </div>

        <div class="boka-lp__faq-item">
          <button type="button" class="boka-lp__faq-btn">
            <span class="boka-lp__faq-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 18c4-1 7-4 8-9 2 4 5 6 9 7-4 1-7 3-9 7-1-4-4-6-8-5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M12 9c-1-3 0-5 2-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>
            <span class="boka-lp__faq-question">Can I switch flavors later?</span>
            <span class="boka-lp__faq-chevron" aria-hidden="true"></span>
          </button>
          <div class="boka-lp__faq-content">
            Yes. You can update your product selection through your account portal where available.
          </div>
        </div>

        <div class="boka-lp__faq-item">
          <button type="button" class="boka-lp__faq-btn">
            <span class="boka-lp__faq-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 18c4-1 7-4 8-9 2 4 5 6 9 7-4 1-7 3-9 7-1-4-4-6-8-5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M12 9c-1-3 0-5 2-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>
            <span class="boka-lp__faq-question">Is this safe for daily use?</span>
            <span class="boka-lp__faq-chevron" aria-hidden="true"></span>
          </button>
          <div class="boka-lp__faq-content">
            Yes. Boka toothpaste is safe for daily use when used as directed.
          </div>
        </div>

      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.getElementById('boka-faq-{{ section.id }}');
      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      root.querySelectorAll('.boka-lp__faq-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const item = btn.closest('.boka-lp__faq-item');
          const faq = btn.closest('.boka-lp__faq');

          faq.querySelectorAll('.boka-lp__faq-item').forEach((other) => {
            if (other !== item) other.classList.remove('is-open');
          });

          item.classList.toggle('is-open');
        });
      });
    })();
  </script>
</section>