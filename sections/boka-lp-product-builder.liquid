    {
      "type": "text",
      "id": "variant_note",
      "label": "Variant step note",
      "default": "Goal-based variants"
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Quantity step label",
      "default": "Choose quantity"
    },
    {
      "type": "text",
      "id": "quantity_note",
      "label": "Quantity step note",
      "default": "Stock your routine"
    },
    {
      "type": "text",
      "id": "plan_label",
      "label": "Plan step label",
