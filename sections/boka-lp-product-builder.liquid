    {
      "type": "text",
      "id": "subscription_title",
      "label": "Subscription title",
      "default": "Subscribe & Save"
    },
    {
      "type": "text",
      "id": "subscription_note",
      "label": "Subscription note",
      "default": "We'll handle the routine refills every 3 months"
