<section class="boka-lp boka-lp-compare" id="boka-compare-{{ section.id }}">
  <div class="boka-lp__section boka-lp__section--compare">
    <div class="boka-lp__wrap boka-lp__compare-layout">

      <div class="boka-lp__compare-copy">
        <p class="boka-lp__eyebrow">The easy switch</p>

        <h2 class="boka-lp__compare-heading">Same habit. Better formula.</h2>

        <p class="boka-lp__compare-text">
          Keep brushing like usual — just upgrade to a fluoride-free n-Ha routine made without sulfates, parabens, or artificial flavors.
        </p>

        <div class="boka-lp__compare-rating">
          <span class="boka-lp__compare-stars">★★★★★</span>
          <span>{{ section.settings.rating_text }}</span>
        </div>

        <a class="boka-lp__compare-button" href="#boka-buybox">
          Choose your starter kit
        </a>
      </div>

      <div class="boka-lp__compare-table-card">
        <div class="boka-lp__compare-grid boka-lp__compare-grid--head">
          <div class="boka-lp__compare-blank"></div>

          <div class="boka-lp__compare-brand">
            <span>Boka</span>
          </div>

          <div>Typical toothpaste</div>
          <div>Typical routine</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">Fits your current routine</div>
          <div class="boka-lp__compare-good">✓</div>
          <div class="boka-lp__compare-maybe">Partial</div>
          <div class="boka-lp__compare-maybe">Varies</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">Powered by n-Ha</div>
          <div class="boka-lp__compare-good">✓</div>
          <div class="boka-lp__compare-bad">×</div>
          <div class="boka-lp__compare-bad">×</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">Fluoride-free</div>
          <div class="boka-lp__compare-good">✓</div>
          <div class="boka-lp__compare-maybe">Varies</div>
          <div class="boka-lp__compare-maybe">Varies</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">No sulfates or parabens</div>
          <div class="boka-lp__compare-good">✓</div>
          <div class="boka-lp__compare-maybe">Varies</div>
          <div class="boka-lp__compare-maybe">Varies</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">No artificial flavors</div>
          <div class="boka-lp__compare-good">✓</div>
          <div class="boka-lp__compare-maybe">Varies</div>
          <div class="boka-lp__compare-maybe">Varies</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">Complete starter system</div>
          <div class="boka-lp__compare-good">✓</div>
          <div class="boka-lp__compare-bad">×</div>
          <div class="boka-lp__compare-maybe">Pieced together</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">Refills without rethinking it</div>
          <div class="boka-lp__compare-good">✓</div>
          <div class="boka-lp__compare-bad">×</div>
          <div class="boka-lp__compare-bad">×</div>
