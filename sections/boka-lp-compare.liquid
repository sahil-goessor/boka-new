<section class="boka-lp boka-lp-compare" id="boka-compare-{{ section.id }}">
  <div class="boka-lp__section boka-lp__section--compare">
    <div class="boka-lp__wrap boka-lp__compare-layout">

      <div class="boka-lp__compare-copy">
        <p class="boka-lp__eyebrow">The easy start</p>

        <h2 class="boka-lp__compare-heading">A fresh way to build your daily routine.</h2>

        <p class="boka-lp__compare-text">
          Start with a fluoride-free n-Ha toothpaste, plus the daily essentials that make your routine feel simple from day one.
        </p>

        <div class="boka-lp__compare-rating">
          <span class="boka-lp__compare-stars">★★★★★</span>
          <span>{{ section.settings.rating_text }}</span>
        </div>

        <a class="boka-lp__compare-button" href="#boka-buybox">
          Choose your starter kit
        </a>
      </div>

      <div class="boka-lp__compare-table-card boka-lp__compare-table-card--three-col boka-lp__compare-table-card--spotlight">
        <div class="boka-lp__compare-grid boka-lp__compare-grid--head">
          <div class="boka-lp__compare-blank"></div>

          <div class="boka-lp__compare-brand">
            <span>Your first Boka box</span>
          </div>

          <div>What it means</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">Fluoride-free toothpaste</div>
          <div class="boka-lp__compare-good">✓</div>
          <div class="boka-lp__compare-maybe">Features n-Ha</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">n-Ha included</div>
          <div class="boka-lp__compare-good">✓</div>
          <div class="boka-lp__compare-maybe">Inspired by nature and backed by science</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">Daily essentials included</div>
          <div class="boka-lp__compare-good">✓</div>
          <div class="boka-lp__compare-maybe">Toothpaste, brush, floss, tongue cleaner, and bag</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">No SLS or parabens</div>
          <div class="boka-lp__compare-good">✓</div>
          <div class="boka-lp__compare-maybe">Thoughtfully formulated</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">No artificial colors</div>
          <div class="boka-lp__compare-good">✓</div>
          <div class="boka-lp__compare-maybe">Dye free</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">First-order savings</div>
          <div class="boka-lp__compare-good">✓</div>
          <div class="boka-lp__compare-maybe">Starter offer available for new customers</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">Easy refill rhythm</div>
          <div class="boka-lp__compare-good">✓</div>
          <div class="boka-lp__compare-maybe">Refills every 3 months</div>
        </div>
      </div>

    </div>
  </div>
</section>