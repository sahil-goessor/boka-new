<section class="boka-lp boka-lp-compare boka-lp--compare-section" id="boka-compare-{{ section.id }}">
  <style>
    #boka-compare-{{ section.id }} {
      --boka-lp-body-font: var(--font-body-family);
      --boka-lp-body-style: var(--font-body-style);
      --boka-lp-body-weight: var(--font-body-weight);
      --boka-lp-heading-font: var(--font-heading-family);
      --boka-lp-heading-style: var(--font-heading-style);
      --boka-lp-heading-weight: var(--font-heading-weight);

      font-family: var(--boka-lp-body-font) !important;
      font-style: var(--boka-lp-body-style);
      font-weight: var(--boka-lp-body-weight);
    }

    #boka-compare-{{ section.id }} *,
    #boka-compare-{{ section.id }} *::before,
    #boka-compare-{{ section.id }} *::after {
      box-sizing: border-box;
      font-family: inherit;
    }

    #boka-compare-{{ section.id }} .boka-lp__eyebrow,
    #boka-compare-{{ section.id }} .boka-lp__compare-text,
    #boka-compare-{{ section.id }} .boka-lp__compare-rating,
    #boka-compare-{{ section.id }} .boka-lp__compare-stars,
    #boka-compare-{{ section.id }} .boka-lp__compare-button,
    #boka-compare-{{ section.id }} .boka-lp__compare-good,
    #boka-compare-{{ section.id }} .boka-lp__compare-maybe,
    #boka-compare-{{ section.id }} .boka-lp__compare-grid > div {
      font-family: var(--boka-lp-body-font) !important;
      font-style: var(--boka-lp-body-style);
    }

    #boka-compare-{{ section.id }} h1,
    #boka-compare-{{ section.id }} h2,
    #boka-compare-{{ section.id }} h3,
    #boka-compare-{{ section.id }} .boka-lp__compare-heading,
    #boka-compare-{{ section.id }} .boka-lp__compare-brand,
    #boka-compare-{{ section.id }} .boka-lp__compare-brand span,
    #boka-compare-{{ section.id }} .boka-lp__compare-label,
    #boka-compare-{{ section.id }} .boka-lp__compare-grid--head > div {
      font-family: var(--boka-lp-heading-font) !important;
      font-style: var(--boka-lp-heading-style);
      font-weight: var(--boka-lp-heading-weight);
    }

    #boka-compare-{{ section.id }} em {
      font-family: var(--boka-lp-heading-font) !important;
      font-style: italic;
      font-weight: var(--boka-lp-heading-weight);
    }

    #boka-compare-{{ section.id }} .boka-lp__compare-brand {
      text-align: center;
    }

    #boka-compare-{{ section.id }} .boka-lp__compare-brand-inner {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-width: 0;
    }

    #boka-compare-{{ section.id }} .boka-lp__compare-logo {
      display: block;
      width: auto;
      max-width: min(120px, 100%);
      max-height: 34px;
      object-fit: contain;
    }

    #boka-compare-{{ section.id }} .boka-lp__compare-brand-text {
      display: block;
    }

    @media screen and (max-width: 749px) {
      #boka-compare-{{ section.id }},
      #boka-compare-{{ section.id }} *,
      #boka-compare-{{ section.id }} *::before,
      #boka-compare-{{ section.id }} *::after {
        font-family: var(--boka-lp-body-font) !important;
      }

      #boka-compare-{{ section.id }} .boka-lp__compare-heading,
      #boka-compare-{{ section.id }} .boka-lp__compare-brand,
      #boka-compare-{{ section.id }} .boka-lp__compare-brand span,
      #boka-compare-{{ section.id }} .boka-lp__compare-label,
      #boka-compare-{{ section.id }} .boka-lp__compare-grid--head > div {
        font-family: var(--boka-lp-heading-font) !important;
      }

      #boka-compare-{{ section.id }} .boka-lp__compare-good,
      #boka-compare-{{ section.id }} .boka-lp__compare-maybe,
      #boka-compare-{{ section.id }} .boka-lp__compare-text,
      #boka-compare-{{ section.id }} .boka-lp__compare-rating,
      #boka-compare-{{ section.id }} .boka-lp__compare-stars,
      #boka-compare-{{ section.id }} .boka-lp__compare-button {
        font-family: var(--boka-lp-body-font) !important;
      }

      /*
        Mobile background-height fix only.
        This keeps text behavior from your original CSS while making each
        cell background stretch when another column wraps taller.
      */
      #boka-compare-{{ section.id }} .boka-lp__compare-table-card {
        width: 100%;
        overflow: hidden;
      }

      #boka-compare-{{ section.id }} .boka-lp__compare-grid {
        align-items: stretch;
        height: auto;
        min-height: auto;
      }

      #boka-compare-{{ section.id }} .boka-lp__compare-grid > div {
        height: auto;
        min-height: 100%;
      }

      #boka-compare-{{ section.id }} .boka-lp__compare-brand,
      #boka-compare-{{ section.id }} .boka-lp__compare-good {
        background: var(--boka-green-light);
      }

      #boka-compare-{{ section.id }} .boka-lp__compare-maybe {
        background: rgba(250, 250, 245, 0.74);
      }

      #boka-compare-{{ section.id }} .boka-lp__compare-logo {
        max-width: 82px;
        max-height: 28px;
      }
    }
  </style>

  <div class="boka-lp__section boka-lp__section--compare">
    <div class="boka-lp__wrap boka-lp__compare-layout">

      <div class="boka-lp__compare-copy">
        <p class="boka-lp__eyebrow">
          {{ section.settings.eyebrow }}
        </p>

        <h2 class="boka-lp__compare-heading">
          {{ section.settings.heading }}
        </h2>

        <p class="boka-lp__compare-text">
          {{ section.settings.copy }}
        </p>

        <div class="boka-lp__compare-rating">
          <span class="boka-lp__compare-stars">
            {{ section.settings.stars_text }}
          </span>

          {% if section.settings.rating_text != blank %}
            <span>{{ section.settings.rating_text }}</span>
          {% endif %}
        </div>

        <a class="boka-lp__compare-button" href="{{ section.settings.button_link | default: '#boka-buybox' }}">
          {{ section.settings.button_text }}
        </a>
      </div>

      <div class="boka-lp__compare-table-card boka-lp__compare-table-card--three-col boka-lp__compare-table-card--spotlight">
        <div class="boka-lp__compare-grid boka-lp__compare-grid--head">
          <div class="boka-lp__compare-blank"></div>

          <div class="boka-lp__compare-brand">
            <span class="boka-lp__compare-brand-inner">
              {% if section.settings.boka_column_logo != blank %}
                {{
                  section.settings.boka_column_logo
                  | image_url: width: 240
                  | image_tag:
                    loading: 'lazy',
                    class: 'boka-lp__compare-logo',
                    alt: section.settings.boka_column_logo_alt
                }}
              {% else %}
                <span class="boka-lp__compare-brand-text">
                  {{ section.settings.boka_column_title }}
                </span>
              {% endif %}
            </span>
          </div>

          <div>{{ section.settings.other_column_title }}</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">Features n-Ha</div>
          <div class="boka-lp__compare-good">Included</div>
          <div class="boka-lp__compare-maybe">Not the usual go-to</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">Fluoride free</div>
          <div class="boka-lp__compare-good">Yes</div>
          <div class="boka-lp__compare-maybe">Often made with fluoride</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">No SLS</div>
          <div class="boka-lp__compare-good">Yes</div>
          <div class="boka-lp__compare-maybe">Often includes foaming agents</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">No parabens</div>
          <div class="boka-lp__compare-good">Yes</div>
          <div class="boka-lp__compare-maybe">Check the label</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">No artificial colors</div>
          <div class="boka-lp__compare-good">Yes</div>
          <div class="boka-lp__compare-maybe">Color can be added</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">Great-tasting flavors</div>
          <div class="boka-lp__compare-good">Minty, fruity, and fresh</div>
          <div class="boka-lp__compare-maybe">Usually mint-first</div>
        </div>

        <div class="boka-lp__compare-grid">
          <div class="boka-lp__compare-label">Made for daily use</div>
          <div class="boka-lp__compare-good">Daily brushing</div>
          <div class="boka-lp__compare-maybe">Check product directions</div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Boka LP compare",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The easy switch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What makes Boka toothpaste different?"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "Keep brushing like usual with a fluoride-free toothpaste that features nano-hydroxyapatite, or n-Ha, an ingredient inspired by the mineral that makes up teeth."
    },
    {
      "type": "text",
      "id": "stars_text",
      "label": "Stars text",
      "default": "★★★★★ 4.6 stars from 950,000+ customers"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Additional rating text"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Choose your starter kit"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "boka_column_logo",
      "label": "Boka column logo"
    },
    {
      "type": "text",
      "id": "boka_column_logo_alt",
      "label": "Boka column logo alt text",
      "default": "Boka"
    },
    {
      "type": "text",
      "id": "boka_column_title",
      "label": "Boka column title fallback",
      "default": "Boka Toothpaste"
    },
    {
      "type": "text",
      "id": "other_column_title",
      "label": "Other column title",
      "default": "Other Toothpaste"
    }
  ],
  "presets": [
    {
      "name": "Boka LP compare"
    }
  ]
}
{% endschema %}