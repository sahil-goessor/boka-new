{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign subtitle = section.settings.subtitle
  assign free_shipping_label = section.settings.free_shipping_label
  assign cta_label = section.settings.cta_label | default: 'Add to cart'
  assign refill_note = section.settings.refill_note
  assign reviews_heading = section.settings.reviews_heading
  assign goal_option_index = 0

  for option in product.options_with_values
    if option.name == 'Goal'
      assign goal_option_index = forloop.index0
      break
    endif
  endfor
%}

{{ 'starter-kit.css' | asset_url | stylesheet_tag }}

<script type="application/json" id="GoalStarterVariantData-{{ section.id }}">
[
  {% for variant in product.variants %}
    {% assign matched_goal_block = blank %}
{% for block in section.blocks %}
  {% if block.type == 'goal_group' and block.settings.goal == variant.options[goal_option_index] %}
    {% assign matched_goal_block = block %}
    {% break %}
  {% endif %}
{% endfor %}
    {
      "id": {{ variant.id | json }},
      "title": {{ variant.title | json }},
      "available": {{ variant.available | json }},
      "price": {{ variant.price | json }},
      "compare_at_price": {{ variant.compare_at_price | default: 2499 | json }},
      "goal": {{ variant.options[goal_option_index] | json }},

      "featured_image": {% if variant.featured_media != blank %}{{ variant.featured_media | image_url: width: 1400 | json }}{% else %}null{% endif %},
      "featured_image_alt": {% if variant.featured_media != blank %}{{ variant.featured_media.alt | default: variant.title | json }}{% else %}{{ variant.title | json }}{% endif %},

      "subtitle": {{ variant.metafields.custom.goal_subtitle.value | default: subtitle | json }},
      "included_title": {% if matched_goal_block and matched_goal_block.settings.included_title != blank %}{{ matched_goal_block.settings.included_title | json }}{% else %}{{ variant.title | json }}{% endif %},
      "included_subtitle": {% if matched_goal_block and matched_goal_block.settings.included_subtitle != blank %}{{ matched_goal_block.settings.included_subtitle | json }}{% else %}{{ '4 oz' | json }}{% endif %},
      "included_image": {% if matched_goal_block and matched_goal_block.settings.included_image != blank %}{{ matched_goal_block.settings.included_image | image_url: width: 500 | json }}{% else %}null{% endif %},
      "refill_headline": {{ 'Refill every 3 months' | json }},
      "refill_item_1": {{ variant.title | json }},
      "refill_item_2": {{ '' | json }},
      "refill_item_3": {{ '' | json }},
      "refill_full_value": {{ 2997 | json }},
      "refill_price": {{ 2697 | json }},
      "refill_savings": {{ '10% subscriber savings' | json }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
</script>

<div
  class="goal-starter color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-selected-variant-id="{{ selected_variant.id }}"
  data-goal-option-name="Goal"
>
  <div class="page-width">
    <div class="goal-starter__breadcrumbs caption-with-letter-spacing">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      <span>/</span>
      <span>Bundles</span>
      <span>/</span>
      <span data-breadcrumb-title>{{ product.title }}</span>
    </div>

    <div class="goal-starter__main-grid">
  <div class="goal-starter__hero-block">
    <div class="goal-starter__hero-media">
      <div class="goal-starter__hero-image-wrap">
        {% if selected_variant.featured_media %}
          {{
            selected_variant.featured_media
            | image_url: width: 1400
            | image_tag:
              class: 'goal-starter__hero-image',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '400, 600, 800, 1000, 1200, 1400',
              sizes: '(min-width: 990px) 60vw, 100vw',
              alt: selected_variant.featured_media.alt | default: selected_variant.title
          }}
        {% elsif product.featured_media %}
          {{
            product.featured_media
            | image_url: width: 1400
            | image_tag:
              class: 'goal-starter__hero-image',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '400, 600, 800, 1000, 1200, 1400',
              sizes: '(min-width: 990px) 60vw, 100vw',
              alt: product.featured_media.alt | default: product.title
          }}
        {% endif %}
      </div>
    </div>
  </div>

  <div class="goal-starter__summary-column {% if section.settings.enable_sticky_summary %}goal-starter__summary-column--sticky{% endif %}">
    {% form 'product', product, class: 'goal-starter__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' %}
      <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-id-input>
      <input type="hidden" name="properties[Goal]" value="{{ selected_variant.options[goal_option_index] }}" data-goal-property>

      <div class="goal-starter__summary-card">
        <h1 class="goal-starter__title" data-product-title>{{ product.title }}</h1>

        {% if subtitle != blank %}
          <p class="goal-starter__subtitle" data-product-subtitle>{{ subtitle }}</p>
        {% endif %}

        <div class="goal-starter__price-helper-row">
          <div class="goal-starter__price-inline-row">
            <div class="goal-starter__price-row">
              <span class="goal-starter__price" data-main-display-price>{{ 1399 | money }}</span>
              {% if section.settings.show_compare_at_price %}
                <s class="goal-starter__compare-at" data-main-display-compare-at>{{ 2499 | money }}</s>
              {% endif %}
            </div>

            {% if section.settings.show_free_shipping_badge %}
              <div class="goal-starter__shipping-pill">
                <span class="goal-starter__shipping-pill-icon">✦</span>
                <span>{{ free_shipping_label }}</span>
              </div>
            {% endif %}
          </div>
        </div>

        <div class="goal-starter__summary-section">
          <h2 class="goal-starter__summary-heading">1. Choose your goal</h2>
          <div class="goal-starter__goal-buttons" data-goal-buttons>
            {% assign goal_option = product.options_with_values[goal_option_index] %}
            {% for value in goal_option.values %}
              {% assign matched_variant = nil %}
              {% for variant in product.variants %}
                {% if variant.options[goal_option_index] == value %}
                  {% assign matched_variant = variant %}
                  {% break %}
                {% endif %}
              {% endfor %}
              <button
                type="button"
                class="goal-starter__goal-button {% if selected_variant.options[goal_option_index] == value %}is-active{% endif %}"
                data-goal="{{ value | handleize }}"
                data-variant-id="{% if matched_variant %}{{ matched_variant.id }}{% endif %}"
                data-goal-label="{{ value | escape }}"
              >
                {{ value }}
              </button>
            {% endfor %}
          </div>
        </div>
        <div class="goal-starter__included-box">
      <h2 class="goal-starter__section-title">What’s included</h2>

      <div class="goal-starter__included-grid" data-goal-included-items>
        {% assign selected_goal_block = blank %}
        {% for block in section.blocks %}
          {% if block.type == 'goal_group' and block.settings.goal == selected_variant.options[goal_option_index] %}
            {% assign selected_goal_block = block %}
            {% break %}
          {% endif %}
        {% endfor %}

        <div class="goal-starter__included-card">
          {% if selected_goal_block and selected_goal_block.settings.included_image != blank %}
            {{ selected_goal_block.settings.included_image | image_url: width: 360 | image_tag: loading: 'lazy', alt: selected_goal_block.settings.included_title | default: selected_variant.title }}
          {% endif %}
          <div class="goal-starter__included-title" data-included-title>
            {% if selected_goal_block and selected_goal_block.settings.included_title != blank %}
              {{ selected_goal_block.settings.included_title }}
            {% else %}
              {{ selected_variant.title }}
            {% endif %}
          </div>
          <div class="goal-starter__included-subtitle" data-included-subtitle>
            {% if selected_goal_block and selected_goal_block.settings.included_subtitle != blank %}
              {{ selected_goal_block.settings.included_subtitle }}
            {% else %}
              4 oz
            {% endif %}
          </div>
        </div>

        <div class="goal-starter__included-card">
          <img
            src="https://cdn.shopify.com/s/files/1/2656/6094/files/Classic_Brush_Mint_8d759cd4-0976-45c7-a7a3-cd0cd2f14527.jpg?v=1738586774"
            alt="Classic Brush Mint"
            loading="lazy"
            width="360"
            height="360"
          >
          <div class="goal-starter__included-title">1 Classic Brush</div>
        </div>

        <div class="goal-starter__included-card">
          <img
            src="https://cdn.shopify.com/s/files/1/2656/6094/files/Main_1_1.webp?v=1763467756"
            alt="Tongue Cleaner"
            loading="lazy"
            width="360"
            height="360"
          >
          <div class="goal-starter__included-title">1 Tongue Cleaner</div>
        </div>
      </div>
    </div>
        <div class="goal-starter__summary-section">
          {% render 'goal-starter-upsell-picker',
            product: product,
            section: section,
            goal_option_index: goal_option_index,
            context: 'summary',
            heading: '2. Recommended for your goal',
            subheading: 'Add or remove optional routine builders.',
            show_group_heading: false
          %}
        </div>

        <div class="goal-starter__summary-section">
          <h2 class="goal-starter__summary-heading">3. What’s in your routine</h2>

          <div class="goal-starter__line-item">
            <span>Base starter</span>
            <span data-base-line-price>{{ 1399 | money }}</span>
          </div>

          <div data-upsell-summary-lines></div>

          <div class="goal-starter__total-row">
            <span>Total</span>
            <span data-total-price>{{ 1399 | money }}</span>
          </div>
        </div>

        <button type="submit" name="add" class="goal-starter__cta button">
          <span>{{ cta_label }} — </span><span data-total-price-button>{{ 1399 | money }}</span>
        </button>

        {% if section.settings.show_refill_plan %}
          <div class="goal-starter__summary-refill">
            <div class="goal-starter__summary-refill-top">
              <h3 class="goal-starter__summary-refill-heading" data-refill-headline>Refill every 3 months</h3>
              <p class="goal-starter__summary-refill-subtext">Never run out. Cancel or modify anytime.</p>
            </div>

            <div class="goal-starter__summary-refill-product" data-refill-items>
              <div>{{ selected_variant.title }}</div>
            </div>

            <div class="goal-starter__summary-refill-pricing">
              <div class="goal-starter__summary-refill-row">
                <span>Full value (recurring)</span>
                <span data-refill-full-value>{{ 2997 | money }}</span>
              </div>
              <div class="goal-starter__summary-refill-row goal-starter__summary-refill-row--price">
                <span>Your refill price</span>
                <span data-refill-price>{{ 2697 | money }}</span>
              </div>
              <div class="goal-starter__summary-refill-savings" data-refill-savings>10% subscriber savings</div>
            </div>
          </div>
        {% endif %}

        <div class="goal-starter__micro-trust">
          <span>Cancel or modify anytime</span>
          <span>30-day risk-free trial</span>
        </div>
      </div>
    {% endform %}
  </div>

  <div class="goal-starter__details-block">
    {% assign testimonial_blocks = section.blocks | where: 'type', 'testimonial' %}
    {% if testimonial_blocks.size > 0 %}
      <div class="goal-starter__reviews">
        <h2 class="goal-starter__reviews-heading">{{ reviews_heading }}</h2>
        <div class="goal-starter__reviews-grid">
          {% for block in testimonial_blocks %}
            <div class="goal-starter__review-card" {{ block.shopify_attributes }}>
              <div class="goal-starter__review-stars">{% for i in (1..block.settings.stars) %}★{% endfor %}</div>
              <blockquote class="goal-starter__review-quote">“{{ block.settings.quote }}”</blockquote>
              <div class="goal-starter__review-name">{{ block.settings.name }}</div>
              <div class="goal-starter__review-location">{{ block.settings.location }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

    {% assign trust_blocks = section.blocks | where: 'type', 'trust_item' %}
    {% if section.settings.show_trust_icons and trust_blocks.size > 0 %}
      <div class="goal-starter__trust-strip">
        {% for block in trust_blocks %}
          <div class="goal-starter__trust-item" {{ block.shopify_attributes }}>
            <div class="goal-starter__trust-icon">{{ block.settings.icon | escape }}</div>
            <div>
              <div class="goal-starter__trust-heading">{{ block.settings.heading }}</div>
              <div class="goal-starter__trust-text">{{ block.settings.text }}</div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Goal starter product",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A goal-based starter with the essentials and optional add-ons tailored to your routine."
    },
    {
      "type": "text",
      "id": "free_shipping_label",
      "label": "Free shipping label",
      "default": "Free shipping at $20+"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "refill_note",
      "label": "Refill note",
      "default": "Brush and tongue cleaner are included in your starter kit only and are not included in recurring refills."
    },
    {
      "type": "text",
      "id": "reviews_heading",
      "label": "Reviews heading",
      "default": "Loved by thousands of Boka fans"
    },
    {
      "type": "checkbox",
      "id": "show_compare_at_price",
      "label": "Show compare-at price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_free_shipping_badge",
      "label": "Show free shipping badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_goal_helper_text",
      "label": "Show goal helper text",
      "default": true
    },
    {
      "type": "text",
      "id": "goal_helper_text",
      "label": "Goal helper heading",
      "default": "Pick your goal. We’ll curate the perfect starter for you."
    },
    {
      "type": "text",
      "id": "goal_helper_subtext",
      "label": "Goal helper subtext",
      "default": "Includes base and add-ons—update anytime."
    },
    {
      "type": "checkbox",
      "id": "show_trust_icons",
      "label": "Show trust strip",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_summary",
      "label": "Enable sticky summary on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_refill_plan",
      "label": "Show refill plan",
      "default": true
    },
    {
      "type": "select",
      "id": "desktop_media_width",
      "label": "Desktop media width",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "mobile_stack_media_first",
      "label": "Show media first on mobile",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon label",
          "default": "truck"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "at $20+"
        }
      ]
    },
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stars",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "This is hands down my favorite oral care upgrade!"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Annie B."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Austin, TX"
        }
      ]
    },
    {
  "type": "goal_group",
  "name": "Goal upsell group",
  "settings": [
    {
      "type": "select",
      "id": "goal",
      "label": "Goal",
      "options": [
        { "value": "Daily Care", "label": "Daily Care" },
        { "value": "Whiten", "label": "Whiten" },
        { "value": "Sensitive", "label": "Sensitive" },
        { "value": "Kids", "label": "Kids" },
        { "value": "Try Flavors", "label": "Try Flavors" }
      ],
      "default": "Daily Care"
    },
    {
      "type": "text",
      "id": "group_heading",
      "label": "Group heading",
      "default": "Recommended for this goal"
    },
    {
      "type": "image_picker",
      "id": "included_image",
      "label": "Included image"
    },
    {
      "type": "text",
      "id": "included_title",
      "label": "Included title"
    },
    {
      "type": "text",
      "id": "included_subtitle",
      "label": "Included subtitle",
      "default": "4 oz"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    }
  ]
}
  ],
  "presets": [
    {
      "name": "Goal starter product"
    }
  ]
}
{% endschema %}