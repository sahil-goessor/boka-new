              <span class="boka-lp__review-meta">{{ section.settings.daily_review_2_meta }}</span>
              <span class="boka-lp__review-pill">Verified buyer</span>
            </div>
          </div>

          <div class="boka-lp__review-card">
            <div class="boka-lp__stars">★★★★★</div>
            <p class="boka-lp__review-copy">{{ section.settings.daily_review_3 }}</p>
            <div class="boka-lp__review-bottom">
              <span class="boka-lp__review-meta">{{ section.settings.daily_review_3_meta }}</span>
              <span class="boka-lp__review-pill">Verified buyer</span>
            </div>
          </div>
        </div>
      </div>

      <div class="boka-lp__review-panel" data-review-panel="whitening">
