<section class="boka-lp boka-lp-reviews" id="boka-reviews-section-{{ section.id }}">
<div class="boka-lp__section boka-lp__section--reviews" id="boka-reviews">
    <div class="boka-lp__wrap">
      <div class="boka-lp__reviews-head">
        <div>
          {% if section.settings.eyebrow != blank %}
            <p class="boka-lp__eyebrow">
              {{ section.settings.eyebrow }}
            </p>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="boka-lp__section-title">
              {{ section.settings.heading }}
            </h2>
          {% endif %}

          {% if section.settings.copy != blank %}
            <p class="boka-lp__section-copy">
              {{ section.settings.copy }}
            </p>
          {% endif %}
        </div>

        {% if section.settings.rating_text != blank %}
          <div class="boka-lp__rating-row">
            <span class="boka-lp__stars" aria-hidden="true">★★★★★</span>
            <span>{{ section.settings.rating_text }}</span>
          </div>
        {% endif %}
      </div>

      <div class="boka-lp__review-tabs" role="tablist" aria-label="Review categories">
        <button type="button" class="boka-lp__review-goal-tab is-active" data-review-goal="daily" role="tab" aria-selected="true">
          Daily Care
        </button>
        <button type="button" class="boka-lp__review-goal-tab" data-review-goal="whitening" role="tab" aria-selected="false">
          Whitening
        </button>
        <button type="button" class="boka-lp__review-goal-tab" data-review-goal="sensitivity" role="tab" aria-selected="false">
          Sensitivity
        </button>
        <button type="button" class="boka-lp__review-goal-tab" data-review-goal="kids" role="tab" aria-selected="false">
          Kids
        </button>
        <button type="button" class="boka-lp__review-goal-tab" data-review-goal="probiotic" role="tab" aria-selected="false">
          Probiotic
        </button>
      </div>

      <div class="boka-lp__review-panel is-active" data-review-panel="daily">
        <div class="boka-lp__review-grid">
          <div class="boka-lp__review-card">
            <div class="boka-lp__stars">★★★★★</div>
            <p class="boka-lp__review-copy">{{ section.settings.daily_review_1 }}</p>
            <div class="boka-lp__review-bottom">
              <span class="boka-lp__review-meta">{{ section.settings.daily_review_1_meta }}</span>
              <span class="boka-lp__review-pill">Verified buyer</span>
            </div>
          </div>

          <div class="boka-lp__review-card">
