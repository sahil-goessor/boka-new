<section class="boka-lp boka-lp-reviews" id="boka-reviews-section-{{ section.id }}">
  <style>
    #boka-reviews-section-{{ section.id }} {
      font-family: var(--font-body-family) !important;
      font-style: var(--font-body-style);
      font-weight: var(--font-body-weight);
    }

    #boka-reviews-section-{{ section.id }} *,
    #boka-reviews-section-{{ section.id }} *::before,
    #boka-reviews-section-{{ section.id }} *::after {
      box-sizing: border-box;
      font-family: inherit;
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__section-title,
    #boka-reviews-section-{{ section.id }} .boka-lp__review-title,
    #boka-reviews-section-{{ section.id }} .boka-lp__review-goal-tab {
      font-family: var(--font-heading-family) !important;
      font-style: var(--font-heading-style) !important;
      font-weight: var(--font-heading-weight) !important;
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__section-title {
      font-size: clamp(30px, 4vw, 46px);
      line-height: 1.06;
      letter-spacing: -0.045em;
      max-width: 780px;
      margin: 0 0 18px;
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__eyebrow,
    #boka-reviews-section-{{ section.id }} .boka-lp__section-copy,
    #boka-reviews-section-{{ section.id }} .boka-lp__rating-row,
    #boka-reviews-section-{{ section.id }} .boka-lp__stars,
    #boka-reviews-section-{{ section.id }} .boka-lp__review-copy,
    #boka-reviews-section-{{ section.id }} .boka-lp__review-meta,
    #boka-reviews-section-{{ section.id }} .boka-lp__review-pill {
      font-family: var(--font-body-family) !important;
      font-style: var(--font-body-style);
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__reviews-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 24px;
      align-items: end;
      margin-bottom: 28px;
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__rating-row {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      flex-wrap: wrap;
      color: var(--boka-charcoal);
      font-size: 13px;
      font-weight: 700;
      padding: 0;
      border-radius: 0;
      background: transparent;
      border: 0;
      white-space: nowrap;
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__stars {
      color: var(--boka-green-deep);
      letter-spacing: .06em;
      font-size: 12px;
      white-space: nowrap;
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__review-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0 0 22px;
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__review-goal-tab {
      appearance: none;
      border: 1px solid rgba(34, 39, 33, 0.18);
      background: var(--boka-white);
      color: var(--boka-charcoal);
      border-radius: 999px;
      padding: 11px 16px;
      cursor: pointer;

      font-family: var(--font-heading-family) !important;
      font-style: var(--font-heading-style) !important;
      font-weight: var(--font-heading-weight) !important;
      font-size: 15px;

      line-height: 1;
      letter-spacing: -0.01em;
      transition: background .18s ease, border-color .18s ease, transform .18s ease;
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__review-goal-tab.is-active {
      background: var(--boka-green-light);
      border-color: var(--boka-green-mid);
      color: var(--boka-charcoal);
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__review-goal-tab:hover {
      transform: translateY(-1px);
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__review-panel {
      display: none;
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__review-panel.is-active {
      display: block;
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__review-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__review-card {
      display: grid;
      align-content: start;
      gap: 13px;
      background: var(--boka-surface);
      border: var(--boka-border-soft);
      border-radius: 22px;
      padding: 24px;
      box-shadow: var(--boka-shadow-soft);
      min-height: 100%;
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__review-card .boka-lp__stars {
      display: block;
      color: var(--boka-green-deep);
      font-size: 13px;
      line-height: 1;
      letter-spacing: .06em;
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__review-copy {
      margin: 0;
      color: var(--boka-charcoal);
      font-size: 16px;
      line-height: 1.5;
      font-weight: 650;
      letter-spacing: -0.01em;
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__review-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 4px;
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__review-meta {
      color: var(--boka-gray);
      font-size: 12px;
      line-height: 1.25;
      font-weight: 750;
    }

    #boka-reviews-section-{{ section.id }} .boka-lp__review-pill {
      display: inline-flex;
      align-items: center;
      min-height: 26px;
      padding: 6px 9px;
      border-radius: 999px;
      background: var(--boka-cream);
      border: 1px solid var(--boka-stone);
      color: var(--boka-olive);
      font-size: 10px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: .04em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    @media screen and (max-width: 749px) {
      #boka-reviews-section-{{ section.id }},
      #boka-reviews-section-{{ section.id }} *,
      #boka-reviews-section-{{ section.id }} *::before,
      #boka-reviews-section-{{ section.id }} *::after {
        font-family: var(--font-body-family) !important;
      }

      #boka-reviews-section-{{ section.id }} .boka-lp__section-title,
      #boka-reviews-section-{{ section.id }} .boka-lp__review-title,
      #boka-reviews-section-{{ section.id }} .boka-lp__review-goal-tab {
        font-family: var(--font-heading-family) !important;
      }

      #boka-reviews-section-{{ section.id }} .boka-lp__section-title {
        font-size: clamp(30px, 9vw, 40px);
        line-height: 1.04;
      }

      #boka-reviews-section-{{ section.id }} .boka-lp__reviews-head {
        grid-template-columns: 1fr;
        gap: 14px;
        margin-bottom: 22px;
      }

      #boka-reviews-section-{{ section.id }} .boka-lp__rating-row {
        width: fit-content;
        white-space: normal;
      }

      #boka-reviews-section-{{ section.id }} .boka-lp__review-tabs {
        flex-wrap: nowrap;
        overflow-x: auto;
        padding-bottom: 4px;
        -webkit-overflow-scrolling: touch;
      }

      #boka-reviews-section-{{ section.id }} .boka-lp__review-goal-tab {
        flex: 0 0 auto;
      }

      #boka-reviews-section-{{ section.id }} .boka-lp__review-grid {
        grid-template-columns: 1fr;
      }

      #boka-reviews-section-{{ section.id }} .boka-lp__review-card {
        padding: 20px;
        border-radius: 20px;
      }

      #boka-reviews-section-{{ section.id }} .boka-lp__review-copy {
        font-size: 15px;
      }
    }
  </style>

  <div class="boka-lp__section boka-lp__section--reviews" id="boka-reviews">
