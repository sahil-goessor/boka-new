          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.getElementById('boka-reviews-section-{{ section.id }}');
      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const tabs = [...root.querySelectorAll('[data-review-goal]')];
      const panels = [...root.querySelectorAll('[data-review-panel]')];

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const goal = tab.dataset.reviewGoal;

          tabs.forEach((otherTab) => {
            const isActive = otherTab === tab;
            otherTab.classList.toggle('is-active', isActive);
            otherTab.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });

          panels.forEach((panel) => {
            panel.classList.toggle('is-active', panel.dataset.reviewPanel === goal);
          });
        });
      });
    })();
  </script>
</section>

