<div id="shopify-section-{{ section.id }}">

  <style>
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.background_color }};
      width: 100%;
      box-sizing: border-box;
    }
    #shopify-section-{{ section.id }} .boka-outer {
      display: flex;
      align-items: stretch;
      height: {{ section.settings.section_height }}px;
      overflow: hidden;
    }
    #shopify-section-{{ section.id }} .boka-left {
      flex: 0 0 {{ 100 | minus: section.settings.video_width_percent }}%;
      width: {{ 100 | minus: section.settings.video_width_percent }}%;
      padding: {{ section.settings.left_padding }}px {{ section.settings.left_padding }}px {{ section.settings.left_padding }}px {{ section.settings.left_padding }}px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      box-sizing: border-box;
      overflow-y: auto;
    }
    /* Constrain content width so it doesn't stretch across the full left column */
    #shopify-section-{{ section.id }} .boka-left-inner {
      max-width: 630px;
    }
    #shopify-section-{{ section.id }} .boka-right {
      flex: 0 0 {{ section.settings.video_width_percent }}%;
      width: {{ section.settings.video_width_percent }}%;
      position: relative;
      overflow: hidden;
    }
    #shopify-section-{{ section.id }} .boka-right video,
    #shopify-section-{{ section.id }} .boka-right img.boka-fallback {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    #shopify-section-{{ section.id }} .boka-stars {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 14px;
    }
    #shopify-section-{{ section.id }} .boka-stars svg {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
    }
    #shopify-section-{{ section.id }} .boka-review-text {
      color: {{ section.settings.review_text_color }};
      font-size: {{ section.settings.review_font_size }}px;
      margin: 0;
      font-weight: 400;
    }
    #shopify-section-{{ section.id }} .boka-heading {
      color: {{ section.settings.heading_color }};
      font-size: {{ section.settings.heading_font_size }}px;
      line-height: 1.2;
      font-weight: 700;
      margin: 0 0 20px 0;
    }
    #shopify-section-{{ section.id }} .boka-cta {
      display: inline-block;
      background-color: {{ section.settings.button_bg_color }};
      color: {{ section.settings.button_text_color }}!important;
      padding: 12px 99.5px;
      font-size: {{ section.settings.button_font_size }}px;
      font-weight: 700;
      text-decoration: none;
      letter-spacing: 0.05em;
      border-radius: {{ section.settings.button_border_radius }}px;
      margin-bottom: 16px;
      transition: opacity 0.2s;
      text-align: center;
      align-self: flex-start;
    }
    #shopify-section-{{ section.id }} .boka-cta:hover {
      opacity: 0.85;
    }
    #shopify-section-{{ section.id }} .boka-timer-label {
      color: {{ section.settings.timer_text_color }};
      font-size: {{ section.settings.body_font_size }}px;
      margin: 0 0 4px 0;
    }
    #shopify-section-{{ section.id }} .boka-timer-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 16px;
    }
    #shopify-section-{{ section.id }} .boka-timer-row strong {
      color: {{ section.settings.timer_text_color }};
      font-size: {{ section.settings.body_font_size }}px;
    }
    #shopify-section-{{ section.id }} .boka-countdown {
      color: {{ section.settings.timer_countdown_color }};
      font-size: {{ section.settings.body_font_size }}px;
      font-weight: 700;
    }
    #shopify-section-{{ section.id }} .boka-shipping {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background-color: {{ section.settings.shipping_banner_bg }};
      padding: 10px 14px;
      border-radius: 6px;
      margin-bottom: 12px;
      align-self: flex-start;
    }
    #shopify-section-{{ section.id }} .boka-shipping p {
      color: {{ section.settings.shipping_text_color }};
      font-size: {{ section.settings.body_font_size }}px;
      font-weight: 600;
      margin: 0;
    }
    #shopify-section-{{ section.id }} .boka-promo {
      background-color: {{ section.settings.promo_bg_color }};
      padding: 10px 14px;
      border-radius: 6px;
    }
    #shopify-section-{{ section.id }} .boka-promo p {
      color: {{ section.settings.promo_text_color }};
      font-size: {{ section.settings.body_font_size }}px;
      margin: 0;
    }
    #shopify-section-{{ section.id }} .boka-play-btn {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: rgba(0,0,0,0.4);
      border: none;
      border-radius: 50%;
      width: 56px;
      height: 56px;
      cursor: pointer;
      display: none;
      align-items: center;
      justify-content: center;
      color: #fff;
      z-index: 2;
    }
    #shopify-section-{{ section.id }} .boka-mute-btn {
      position: absolute;
      bottom: 12px;
      right: 12px;
      background: rgba(0,0,0,0.45);
      border: none;
      border-radius: 50%;
      width: 40px;
      height: 40px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      z-index: 2;
    }
    #shopify-section-{{ section.id }} .boka-stars {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 14px;
      text-decoration: none;
      cursor: pointer;
    }
    #shopify-section-{{ section.id }} .boka-cta-loader svg {
      animation: boka-spin-{{ section.id }} 1s linear infinite;
    }
    @keyframes boka-spin-{{ section.id }} {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    #shopify-section-{{ section.id }} .boka-cta:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    /* ── Mobile ── */
    @media (max-width: 768px) {
      #shopify-section-{{ section.id }} .boka-outer {
        flex-direction: column-reverse;
        height: auto;
        overflow: visible;
        position: relative;
        padding-bottom: 30px;
      }
      /* Video sits at top, full width */
      #shopify-section-{{ section.id }} .boka-right {
        flex: none;
        width: 100%;
        height: {{ section.settings.mobile_video_height }}px;
        position: relative;
      }
      #shopify-section-{{ section.id }} .boka-right::after {
        content: '';
        position: absolute;
        bottom: -10px;
        left: 0;
        width: 100%;
        height: 160px;
        background: linear-gradient(180deg, #fafaf500 0, #fafaf5 100%);
        pointer-events: none;
        z-index: 0;
      }
      /* White card slides up over the video */
      #shopify-section-{{ section.id }} .boka-left {
        flex: 1 1 auto;
        width: 90%;
        max-width: 480px;
        align-self: center;
        padding: {{ section.settings.mobile_padding }}px;
        overflow-y: visible;
        background: #ffffff;
        border-radius: 8px;
        margin-top: -94px;
        position: relative;
        z-index: 1;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.12);
        box-sizing: border-box;
        border: 1px solid #090909;
      }
      #shopify-section-{{ section.id }} .boka-left-inner {
        max-width: 100%;
      }
      #shopify-section-{{ section.id }} .boka-heading {
        font-size: {{ section.settings.mobile_heading_font_size }}px;
        line-height: 1.3;
      }
      #shopify-section-{{ section.id }} .boka-cta {
        align-self: stretch;
        width: 100%;
        box-sizing: border-box;
      }
      #shopify-section-{{ section.id }} .boka-mute-btn {
        bottom: 100px;
      }
      #shopify-section-{{ section.id }} .boka-timer-label {
        line-height: normal;
      }
      #shopify-section-{{ section.id }} .boka-shipping p {
        line-height: normal;
      }
    }

    #shopify-section-{{ section.id }} .boka-hero__amazon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background-color: #1a98ff;
      color: #ffffff;
      text-decoration: none;
      font-size: 16px;
      font-weight: 700;
      padding: 13px 40px;
      border-radius: 12px;
      width: 320px;
      max-width: 100%;
      transition: background-color 0.2s;
      letter-spacing: 0.3px;
      margin-bottom: 12px;
    }

    #shopify-section-{{ section.id }} .boka-hero__amazon-btn strong {
      color: #ffffff;
      font-weight: 700;
      font-size: 16px;
      line-height: 1;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .boka-hero__amazon-btn svg {
      display: block;
      margin-top: 8px;
    }

    #shopify-section-{{ section.id }} .boka-hero__amazon-btn:hover {
      background-color: #0e85e8;
    }

    @media (max-width: 767px) {
      #shopify-section-{{ section.id }} .boka-hero__amazon-btn {
        width: 100%;
      }
    }

    #shopify-section-{{ section.id }} .boka-subheading {
      color: {{ section.settings.subheading_color }};
      font-size: {{ section.settings.subheading_font_size }}px;
      line-height: 1.5;
      font-weight: 400;
      margin: -12px 0 20px 0;
    }

    #shopify-section-{{ section.id }} .boka-walmart {
      display: flex;
      align-items: center;
      gap: 10px;
      background-color: {{ section.settings.walmart_bg_color }};
      border: 1.5px solid {{ section.settings.walmart_border_color }};
      padding: 11px 18px;
      border-radius: 4px;
      margin-bottom: 12px;
      text-decoration: none;
      width: fit-content;
      box-shadow: 0 1px 4px rgba(0,0,0,0.07);
      transition: box-shadow 0.2s, background-color 0.2s;
    }
    #shopify-section-{{ section.id }} .boka-walmart:hover {
      background-color: #fff3c4;
      box-shadow: 0 2px 8px rgba(0,0,0,0.13);
    }
    #shopify-section-{{ section.id }} .boka-walmart-text-wrap {
      display: flex;
      flex-direction: column;
      gap: 1px;
    }
    #shopify-section-{{ section.id }} .boka-walmart-eyebrow {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #9a7d00;
      margin: 0;
      line-height: 1;
    }
    #shopify-section-{{ section.id }} .boka-walmart-label {
      color: {{ section.settings.walmart_text_color }};
      font-size: {{ section.settings.body_font_size }}px;
      font-weight: 700;
      margin: 0;
      line-height: 1.3;
    }
    #shopify-section-{{ section.id }} .boka-walmart-arrow {
      margin-left: auto;
      color: #9a7d00;
      flex-shrink: 0;
    }
    #shopify-section-{{ section.id }} .boka-pulse-box {
      display: inline-flex;
      align-items: center;
      background-color: {{ section.settings.pulse_bg_color }};
      border: 2px solid {{ section.settings.pulse_border_color }};
      padding: 16px 16px;
      border-radius: 6px;
      margin-bottom: 12px;
      animation: boka-pulse-{{ section.id }} 1.8s ease-in-out infinite;
      align-self: flex-start;
      width: fit-content;
    }
    #shopify-section-{{ section.id }} .boka-pulse-box p {
      color: {{ section.settings.pulse_text_color }};
      font-size: 18px;
      margin: 0;
      line-height: 1.4;
      position: relative;
      z-index: 2;
    }
    #shopify-section-{{ section.id }} .boka-pulse-box p strong {
      font-weight: 700;
    }
    #shopify-section-{{ section.id }} .boka-pulse-box p s {
      opacity: 0.6;
    }
    @keyframes boka-pulse-{{ section.id }} {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 {{ section.settings.pulse_border_color }}66;
  }
  50% {
    transform: scale(1.05);
    box-shadow: 0 0 0 10px {{ section.settings.pulse_border_color }}00;
  }
}
    @media (max-width: 768px) {
      #shopify-section-{{ section.id }} .boka-walmart {
        width: 100%;
        box-sizing: border-box;
      }
      #shopify-section-{{ section.id }} .boka-pulse-box {
        width: 100%;
        box-sizing: border-box;
    }
  </style>

  <div class="boka-outer boka-hero__container">

    {%- comment -%} ── LEFT ── {%- endcomment -%}
    <div class="boka-left">
      <div class="boka-left-inner">

        {%- if section.settings.show_reviews -%}
          <a class="boka-stars" href="#{{ section.settings.reviews_section_id }}">
            {%- assign star_count = section.settings.star_count -%}
            {%- for i in (1..5) -%}
              {%- if i <= star_count -%}
                <svg fill="{{ section.settings.star_color }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M11.6857 1.55835C11.8025 1.18368 12.3328 1.18368 12.4495 1.55835L14.7421 8.91577C14.7941 9.08292 14.9489 9.19678 15.124 9.19678H22.5772C22.9607 9.19678 23.1244 9.68407 22.8188 9.91561L16.7605 14.5054C16.6262 14.6072 16.57 14.7823 16.6202 14.9432L18.9274 22.3476C19.0431 22.7191 18.6141 23.0204 18.3039 22.7855L12.3092 18.2438C12.1663 18.1356 11.9689 18.1356 11.8261 18.2438L5.83131 22.7855C5.52117 23.0204 5.09211 22.7191 5.20787 22.3476L7.51506 14.9432C7.5652 14.7823 7.50907 14.6072 7.37472 14.5054L1.31645 9.91561C1.01084 9.68407 1.17458 9.19678 1.55801 9.19678H9.0113C9.18639 9.19678 9.34111 9.08292 9.3932 8.91577L11.6857 1.55835Z" stroke="{{ section.settings.star_color }}" stroke-width="1"/>
                </svg>
              {%- else -%}
                <svg fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M11.6857 1.55835C11.8025 1.18368 12.3328 1.18368 12.4495 1.55835L14.7421 8.91577C14.7941 9.08292 14.9489 9.19678 15.124 9.19678H22.5772C22.9607 9.19678 23.1244 9.68407 22.8188 9.91561L16.7605 14.5054C16.6262 14.6072 16.57 14.7823 16.6202 14.9432L18.9274 22.3476C19.0431 22.7191 18.6141 23.0204 18.3039 22.7855L12.3092 18.2438C12.1663 18.1356 11.9689 18.1356 11.8261 18.2438L5.83131 22.7855C5.52117 23.0204 5.09211 22.7191 5.20787 22.3476L7.51506 14.9432C7.5652 14.7823 7.50907 14.6072 7.37472 14.5054L1.31645 9.91561C1.01084 9.68407 1.17458 9.19678 1.55801 9.19678H9.0113C9.18639 9.19678 9.34111 9.08292 9.3932 8.91577L11.6857 1.55835Z" stroke="{{ section.settings.star_color }}" stroke-width="2"/>
                </svg>
              {%- endif -%}
            {%- endfor -%}
            <p class="boka-review-text">{{ section.settings.review_text }}</p>
          </a>
        {%- endif -%}

        <h1 class="boka-heading">{{ section.settings.heading_text }}</h1>

        {%- if section.settings.subheading_text != blank -%}
          <h2 class="boka-subheading">{{ section.settings.subheading_text }}</h2>
        {%- endif -%}

        {%- if section.settings.cta_text != blank -%}
          <button
            type="button"
            class="boka-cta"
            data-button-action="{{ section.settings.button_action }}"
            data-button-link="{{ section.settings.cta_url }}"
            data-variant-id="{{ section.settings.variant_id }}"
            data-product-quantity="{{ section.settings.product_quantity }}"
            {% if page.handle == 'amz-amb-brightboost' %}
              onclick="window.trbClick('B0CQPPDQM9')"
            {% endif %}
          >
            <span class="boka-cta-text">{{ section.settings.cta_text }}</span>
            <span class="boka-cta-loader" style="display:none;">
              <svg width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" opacity="0.25"/>
                <path d="M12 2 A10 10 0 0 1 22 12" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round"/>
              </svg>
            </span>
          </button>
        {%- endif -%}
        {%- if section.settings.show_walmart_banner -%}
  
          <a class="boka-walmart"
              {%- if section.settings.walmart_section_id != blank -%}
                href="#{{ section.settings.walmart_section_id }}"
              {%- elsif section.settings.walmart_url != blank -%}
                href="{{ section.settings.walmart_url }}" rel="noopener" target="_blank"
              {%- endif -%}
            >
            <!-- Walmart spark -->
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;">
              <path d="M12 2.4a1.1 1.1 0 0 1 1.1 1.1v3.3a1.1 1.1 0 0 1-2.2 0V3.5A1.1 1.1 0 0 1 12 2.4Z" fill="#FFC220"/>
              <path d="M12 16.1a1.1 1.1 0 0 1 1.1 1.1v3.3a1.1 1.1 0 0 1-2.2 0v-3.3a1.1 1.1 0 0 1 1.1-1.1Z" fill="#FFC220"/>
              <path d="M21.6 12a1.1 1.1 0 0 1-1.1 1.1h-3.3a1.1 1.1 0 0 1 0-2.2h3.3A1.1 1.1 0 0 1 21.6 12Z" fill="#FFC220"/>
              <path d="M7.9 12a1.1 1.1 0 0 1-1.1 1.1H3.5a1.1 1.1 0 0 1 0-2.2h3.3A1.1 1.1 0 0 1 7.9 12Z" fill="#FFC220"/>
              <path d="M18.98 5.02a1.1 1.1 0 0 1 0 1.556l-2.334 2.334a1.1 1.1 0 1 1-1.556-1.556L17.424 5.02a1.1 1.1 0 0 1 1.556 0Z" fill="#FFC220"/>
              <path d="M8.91 15.09a1.1 1.1 0 0 1 0 1.556L6.576 18.98a1.1 1.1 0 1 1-1.556-1.556L7.354 15.09a1.1 1.1 0 0 1 1.556 0Z" fill="#FFC220"/>
              <path d="M5.02 5.02a1.1 1.1 0 0 1 1.556 0L8.91 7.354a1.1 1.1 0 1 1-1.556 1.556L5.02 6.576a1.1 1.1 0 0 1 0-1.556Z" fill="#FFC220"/>
              <path d="M15.09 15.09a1.1 1.1 0 0 1 1.556 0l2.334 2.334a1.1 1.1 0 1 1-1.556 1.556L15.09 16.646a1.1 1.1 0 0 1 0-1.556Z" fill="#FFC220"/>
            </svg>
            <div class="boka-walmart-text-wrap">
              <p class="boka-walmart-eyebrow">Also available in-store</p>
              <p class="boka-walmart-label">{{ section.settings.walmart_text }}</p>
            </div>
            {%- if section.settings.walmart_section_id != blank or section.settings.walmart_url != blank -%}
              <svg class="boka-walmart-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- endif -%}
          </a>
        {%- endif -%}
        {% if section.settings.amazon_url != blank %}
          <a href="{{ section.settings.amazon_url }}" target="_blank" rel="noopener" class="boka-hero__amazon-btn">
            <strong>Buy on</strong>
            <svg fill="none" height="22" viewBox="0 0 603 182" width="73" xmlns="http://www.w3.org/2000/svg">
