              <img src="{{ section.settings.shipping_icon | img_url: '60x' }}" alt="" style="width:36px;height:auto;flex-shrink:0;">
            {%- else -%}
              <svg width="34" height="34" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;">
                <path d="M3 14h18v9H3z" stroke="{{ section.settings.shipping_text_color }}" stroke-width="1.5" fill="none"/>
                <path d="M21 16h5l3 4v3h-8V16z" stroke="{{ section.settings.shipping_text_color }}" stroke-width="1.5" fill="none"/>
                <circle cx="8" cy="24" r="2" fill="{{ section.settings.shipping_text_color }}"/>
                <circle cx="26" cy="24" r="2" fill="{{ section.settings.shipping_text_color }}"/>
              </svg>
            {%- endif -%}
            <p>{{ section.settings.shipping_text }}</p>
          </div>
        {%- endif -%}

        {%- if section.settings.show_promo_banner and section.settings.promo_text != blank -%}
          <div class="boka-promo">
            <p>
              {%- if section.settings.promo_heading != blank -%}
                <strong>{{ section.settings.promo_heading }}</strong>&nbsp;
              {%- endif -%}
              {{ section.settings.promo_text }}
            </p>
          </div>
        {%- endif -%}

      </div>{%- comment -%}/.boka-left-inner{%- endcomment -%}
    </div>

    {%- comment -%} ── RIGHT (Video) ── {%- endcomment -%}
    <div class="boka-right">
      {%- if section.settings.video_url != blank -%}
        <video
          class="boka-video"
          aria-label="{{ section.settings.video_aria_label }}"
          {% if section.settings.video_autoplay %}autoplay{% endif %}
          {% if section.settings.video_loop %}loop{% endif %}
          {% if section.settings.video_muted %}muted{% endif %}
          playsinline
          preload="metadata"
          {% if section.settings.video_poster != blank %}poster="{{ section.settings.video_poster | img_url: 'master' }}"{% endif %}
        >
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>

        <button class="boka-play-btn" aria-label="Play">
          <svg height="22" viewBox="0 0 18 18" width="22" xmlns="http://www.w3.org/2000/svg">
            <path d="M15.562 8.1L3.87.225c-.818-.562-1.87 0-1.87.9v15.75c0 .9 1.052 1.462 1.87.9L15.563 9.9c.584-.45.584-1.35 0-1.8z" fill="currentColor"/>
          </svg>
        </button>

        <button class="boka-mute-btn" aria-label="Toggle mute">
          <svg height="18" viewBox="0 0 497 497" width="18" xmlns="http://www.w3.org/2000/svg">
            <path d="M259.4 128.9c-3.4-1.8-7.5-1.7-10.8.4l-95.1 61.8h-35.2c-5.8 0-10.6 4.8-10.6 10.6v92.7c0 5.9 4.8 10.6 10.6 10.6h35.2l95.1 61.8c1.8 1.2 3.8 1.7 5.8 1.7 1.7 0 3.5-.4 5-1.3 3.4-1.8 5.6-5.4 5.6-9.3V138.2c0-3.9-2.2-7.4-5.6-9.3z" fill="currentColor"/>
            <path d="M303.6 302.9c-3.8 0-7.5-1.4-10.3-4.3-5.7-5.6-5.7-14.9 0-20.6 7.2-7.2 11.2-16.8 11.2-27s-4-19.9-11.2-27.1c-5.7-5.7-5.7-14.9 0-20.6 5.7-5.7 14.9-5.7 20.6 0 12.7 12.7 19.7 29.6 19.7 47.6 0 18.1-7 35-19.7 47.7-2.9 2.9-6.6 4.3-10.3 4.3z" fill="currentColor"/>
          </svg>
        </button>

      {%- elsif section.settings.fallback_image != blank -%}
        <img class="boka-fallback" src="{{ section.settings.fallback_image | img_url: 'master' }}" alt="{{ section.settings.video_aria_label }}">
      {%- endif -%}
    </div>

  </div>
</div>

<script>
(function () {
  var section = document.getElementById('shopify-section-{{ section.id }}');
  if (!section) return;

  // ── Countdown Timer ──
  var countdownEl = section.querySelector('.boka-countdown');
  if (countdownEl) {
    var endTime = new Date(countdownEl.dataset.end).getTime();
    function tick() {
      var diff = endTime - Date.now();
      if (diff <= 0) { countdownEl.textContent = '00:00:00'; return; }
      var h = Math.floor(diff / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      countdownEl.textContent =
        String(h).padStart(2,'0') + ':' +
        String(m).padStart(2,'0') + ':' +
        String(s).padStart(2,'0');
    }
    tick();
    setInterval(tick, 1000);
  }

  // ── Video Controls ──
  var video   = section.querySelector('.boka-video');
  var muteBtn = section.querySelector('.boka-mute-btn');
  var playBtn = section.querySelector('.boka-play-btn');

  if (video && muteBtn) {
    muteBtn.addEventListener('click', function () {
      video.muted = !video.muted;
    });
    video.addEventListener('click', function () {
      video.muted = !video.muted;
    });
  }
  if (video && playBtn) {
    video.addEventListener('pause', function () { playBtn.style.display = 'flex'; });
    video.addEventListener('play',  function () { playBtn.style.display = 'none'; });
    playBtn.addEventListener('click', function () { video.play(); });
  }

  // ── CTA Button / Add to Cart ──
  var ctaBtn = section.querySelector('.boka-cta');
  if (ctaBtn) {
    ctaBtn.addEventListener('click', async function (e) {
      e.preventDefault();

      var action    = this.dataset.buttonAction;
      var link      = this.dataset.buttonLink;
      var variantId = this.dataset.variantId;
      var quantity  = parseInt(this.dataset.productQuantity) || 1;
      var textEl    = this.querySelector('.boka-cta-text');
      var loaderEl  = this.querySelector('.boka-cta-loader');
      var originalText = textEl ? textEl.textContent : '';

      // Regular link — just navigate
      if (action === 'link' || !variantId) {
        if (link) window.location.href = link;
        return;
      }

      // Show loader
      if (textEl) textEl.style.display = 'none';
      if (loaderEl) loaderEl.style.display = 'inline-flex';
      this.disabled = true;

      try {
        var response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: [{ id: variantId, quantity: quantity }] })
        });

        if (!response.ok) throw new Error('Failed to add to cart');

        // Fire cart refresh events for theme compatibility
        document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));

        if (action === 'add_and_checkout') {
          window.location.href = '/checkout';

        } else if (action === 'add_and_cart') {
          // Try to open side cart drawer (works with Dawn and most themes)
          document.documentElement.dispatchEvent(new CustomEvent('cart:open', { bubbles: true }));
          document.dispatchEvent(new CustomEvent('cart:open', { bubbles: true }));
          var cartDrawer = document.querySelector('cart-drawer');
          if (cartDrawer && typeof cartDrawer.open === 'function') cartDrawer.open();
          ['[data-drawer="cart"]','[data-cart-drawer]','#cart-drawer','.cart-drawer','#CartDrawer','.CartDrawer'].forEach(function(sel) {
            var el = document.querySelector(sel);
            if (el) { el.classList.add('is-open','active','open'); el.setAttribute('aria-hidden','false'); }
          });
          if (textEl) { textEl.textContent = '✓ Added!'; textEl.style.display = 'inline'; }
          if (loaderEl) loaderEl.style.display = 'none';
          this.disabled = false;
          setTimeout(function() { if (textEl) textEl.textContent = originalText; }, 2000);

        } else if (action === 'add_and_stay') {
          if (textEl) { textEl.textContent = '✓ Added to Cart'; textEl.style.display = 'inline'; }
          if (loaderEl) loaderEl.style.display = 'none';
          this.disabled = false;
          setTimeout(function() { if (textEl) textEl.textContent = originalText; }, 2000);
        }

      } catch (err) {
        console.error('Add to cart error:', err);
        if (textEl) { textEl.textContent = 'Error – Try Again'; textEl.style.display = 'inline'; }
        if (loaderEl) loaderEl.style.display = 'none';
        this.disabled = false;
        setTimeout(function() { if (textEl) textEl.textContent = originalText; }, 2000);
      }
    });
  }
})();
</script>

