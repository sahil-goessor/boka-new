<div id="shopify-section-{{ section.id }}" style="width: 100%; margin: 0 auto; box-sizing: border-box;">

  <style>
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.background_color }};
    }
    #shopify-section-{{ section.id }} .boka-outer {
      display: flex;
      align-items: stretch;
      min-height: {{ section.settings.section_min_height }}px;
    }
    #shopify-section-{{ section.id }} .boka-left {
      flex: 1 1 50%;
      padding: {{ section.settings.left_padding }}px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      max-width: 600px;
      box-sizing: border-box;
    }
    #shopify-section-{{ section.id }} .boka-right {
      flex: 1 1 50%;
      position: relative;
      overflow: hidden;
      min-height: {{ section.settings.video_min_height }}px;
    }
    #shopify-section-{{ section.id }} .boka-right video,
    #shopify-section-{{ section.id }} .boka-right img.boka-fallback {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    #shopify-section-{{ section.id }} .boka-stars {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 14px;
    }
    #shopify-section-{{ section.id }} .boka-stars svg {
      width: 20px;
      height: 20px;
    }
    #shopify-section-{{ section.id }} .boka-review-text {
      color: {{ section.settings.review_text_color }};
      font-size: {{ section.settings.review_font_size }}px;
      margin: 0;
      font-weight: 500;
    }
    #shopify-section-{{ section.id }} .boka-heading {
      color: {{ section.settings.heading_color }};
      font-size: {{ section.settings.heading_font_size }}px;
      line-height: 1.2;
      font-weight: 700;
      margin: 0 0 24px 0;
    }
    #shopify-section-{{ section.id }} .boka-cta {
      display: inline-block;
      background-color: {{ section.settings.button_bg_color }};
      color: {{ section.settings.button_text_color }};
      padding: 14px 28px;
      font-size: {{ section.settings.button_font_size }}px;
      font-weight: 700;
      text-decoration: none;
      letter-spacing: 0.05em;
      border-radius: {{ section.settings.button_border_radius }}px;
      margin-bottom: 20px;
      transition: opacity 0.2s;
      text-align: center;
    }
    #shopify-section-{{ section.id }} .boka-cta:hover {
      opacity: 0.85;
    }
    #shopify-section-{{ section.id }} .boka-timer-label {
      color: {{ section.settings.timer_text_color }};
      font-size: {{ section.settings.body_font_size }}px;
      margin: 0 0 4px 0;
    }
    #shopify-section-{{ section.id }} .boka-timer-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 20px;
    }
    #shopify-section-{{ section.id }} .boka-timer-row strong {
      color: {{ section.settings.timer_text_color }};
      font-size: {{ section.settings.body_font_size }}px;
    }
    #shopify-section-{{ section.id }} .boka-countdown {
      color: {{ section.settings.timer_countdown_color }};
      font-size: {{ section.settings.body_font_size }}px;
      font-weight: 700;
    }
    #shopify-section-{{ section.id }} .boka-shipping {
      display: flex;
      align-items: center;
      gap: 12px;
      background-color: {{ section.settings.shipping_banner_bg }};
      padding: 12px 16px;
      border-radius: 6px;
      margin-bottom: 16px;
    }
    #shopify-section-{{ section.id }} .boka-shipping p {
      color: {{ section.settings.shipping_text_color }};
      font-size: {{ section.settings.body_font_size }}px;
      font-weight: 600;
      margin: 0;
    }
    #shopify-section-{{ section.id }} .boka-promo {
      background-color: {{ section.settings.promo_bg_color }};
      padding: 12px 16px;
      border-radius: 6px;
    }
    #shopify-section-{{ section.id }} .boka-promo p {
      color: {{ section.settings.promo_text_color }};
      font-size: {{ section.settings.body_font_size }}px;
      margin: 0;
    }
    #shopify-section-{{ section.id }} .boka-play-btn {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: rgba(0,0,0,0.4);
      border: none;
      border-radius: 50%;
      width: 56px;
      height: 56px;
      cursor: pointer;
      display: none;
      align-items: center;
      justify-content: center;
      color: #fff;
    }
    #shopify-section-{{ section.id }} .boka-mute-btn {
      position: absolute;
      bottom: 12px;
      right: 12px;
      background: rgba(0,0,0,0.45);
      border: none;
      border-radius: 50%;
      width: 40px;
      height: 40px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
    }

    /* ── Mobile ── */
    @media (max-width: 768px) {
      #shopify-section-{{ section.id }} .boka-outer {
        flex-direction: column-reverse;
        min-height: unset;
      }
      #shopify-section-{{ section.id }} .boka-left {
        flex: 1 1 100%;
        max-width: 100%;
        padding: {{ section.settings.mobile_padding }}px;
      }
      #shopify-section-{{ section.id }} .boka-right {
        flex: 1 1 100%;
        width: 100%;
        min-height: {{ section.settings.mobile_video_height }}px;
      }
      #shopify-section-{{ section.id }} .boka-heading {
        font-size: {{ section.settings.mobile_heading_font_size }}px;
      }
      #shopify-section-{{ section.id }} .boka-cta {
        width: 100%;
        box-sizing: border-box;
      }
    }
  </style>

  <div class="boka-outer">

    {%- comment -%} ── LEFT SIDE ── {%- endcomment -%}
    <div class="boka-left">

      {%- if section.settings.show_reviews -%}
      <div class="boka-stars">
        {%- assign star_count = section.settings.star_count -%}
        {%- for i in (1..5) -%}
          {%- if i <= star_count -%}
            <svg fill="{{ section.settings.star_color }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M11.6857 1.55835C11.8025 1.18368 12.3328 1.18368 12.4495 1.55835L14.7421 8.91577C14.7941 9.08292 14.9489 9.19678 15.124 9.19678H22.5772C22.9607 9.19678 23.1244 9.68407 22.8188 9.91561L16.7605 14.5054C16.6262 14.6072 16.57 14.7823 16.6202 14.9432L18.9274 22.3476C19.0431 22.7191 18.6141 23.0204 18.3039 22.7855L12.3092 18.2438C12.1663 18.1356 11.9689 18.1356 11.8261 18.2438L5.83131 22.7855C5.52117 23.0204 5.09211 22.7191 5.20787 22.3476L7.51506 14.9432C7.5652 14.7823 7.50907 14.6072 7.37472 14.5054L1.31645 9.91561C1.01084 9.68407 1.17458 9.19678 1.55801 9.19678H9.0113C9.18639 9.19678 9.34111 9.08292 9.3932 8.91577L11.6857 1.55835Z" stroke="{{ section.settings.star_color }}" stroke-width="1"/>
            </svg>
          {%- else -%}
            <svg fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M11.6857 1.55835C11.8025 1.18368 12.3328 1.18368 12.4495 1.55835L14.7421 8.91577C14.7941 9.08292 14.9489 9.19678 15.124 9.19678H22.5772C22.9607 9.19678 23.1244 9.68407 22.8188 9.91561L16.7605 14.5054C16.6262 14.6072 16.57 14.7823 16.6202 14.9432L18.9274 22.3476C19.0431 22.7191 18.6141 23.0204 18.3039 22.7855L12.3092 18.2438C12.1663 18.1356 11.9689 18.1356 11.8261 18.2438L5.83131 22.7855C5.52117 23.0204 5.09211 22.7191 5.20787 22.3476L7.51506 14.9432C7.5652 14.7823 7.50907 14.6072 7.37472 14.5054L1.31645 9.91561C1.01084 9.68407 1.17458 9.19678 1.55801 9.19678H9.0113C9.18639 9.19678 9.34111 9.08292 9.3932 8.91577L11.6857 1.55835Z" stroke="{{ section.settings.star_color }}" stroke-width="2"/>
            </svg>
          {%- endif -%}
        {%- endfor -%}
        <p class="boka-review-text">{{ section.settings.review_text }}</p>
      </div>
      {%- endif -%}

      <h1 class="boka-heading">{{ section.settings.heading_text }}</h1>

      {%- if section.settings.cta_text != blank -%}
        <a class="boka-cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_text }}</a>
      {%- endif -%}

      {%- if section.settings.show_timer -%}
        <p class="boka-timer-label">{{ section.settings.timer_label_text }}</p>
        <div class="boka-timer-row">
          <strong>Offer Ends in</strong>
          <span
            class="boka-countdown"
            data-end="{{ section.settings.timer_end_date }}"
          >--:--:--</span>
        </div>
      {%- endif -%}

      {%- if section.settings.show_shipping_banner -%}
        <div class="boka-shipping">
          {%- if section.settings.shipping_icon != blank -%}
            <img src="{{ section.settings.shipping_icon | img_url: '60x' }}" alt="" style="width:36px;height:auto;flex-shrink:0;">
          {%- else -%}
            <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 14h18v9H3z" stroke="{{ section.settings.shipping_text_color }}" stroke-width="1.5" fill="none"/>
              <path d="M21 16h5l3 4v3h-8V16z" stroke="{{ section.settings.shipping_text_color }}" stroke-width="1.5" fill="none"/>
              <circle cx="8" cy="24" r="2" fill="{{ section.settings.shipping_text_color }}"/>
              <circle cx="26" cy="24" r="2" fill="{{ section.settings.shipping_text_color }}"/>
            </svg>
          {%- endif -%}
          <p>{{ section.settings.shipping_text }}</p>
        </div>
      {%- endif -%}

      {%- if section.settings.show_promo_banner and section.settings.promo_text != blank -%}
        <div class="boka-promo">
          <p>
            {%- if section.settings.promo_heading != blank -%}
              <strong>{{ section.settings.promo_heading }}</strong>&nbsp;
            {%- endif -%}
            {{ section.settings.promo_text }}
          </p>
        </div>
      {%- endif -%}

    </div>

    {%- comment -%} ── RIGHT SIDE (Video) ── {%- endcomment -%}
    <div class="boka-right">
      {%- if section.settings.video_url != blank -%}
        <video
          class="boka-video"
          aria-label="{{ section.settings.video_aria_label }}"
          {% if section.settings.video_autoplay %}autoplay{% endif %}
          {% if section.settings.video_loop %}loop{% endif %}
          {% if section.settings.video_muted %}muted{% endif %}
          playsinline
          preload="metadata"
          {% if section.settings.video_poster != blank %}poster="{{ section.settings.video_poster | img_url: 'master' }}"{% endif %}
        >
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>

        <button class="boka-play-btn" aria-label="Play">
          <svg height="22" viewBox="0 0 18 18" width="22" xmlns="http://www.w3.org/2000/svg">
            <path d="M15.562 8.1L3.87.225c-.818-.562-1.87 0-1.87.9v15.75c0 .9 1.052 1.462 1.87.9L15.563 9.9c.584-.45.584-1.35 0-1.8z" fill="currentColor"/>
          </svg>
        </button>

        <button class="boka-mute-btn" aria-label="Toggle mute">
          <svg height="18" viewBox="0 0 497 497" width="18" xmlns="http://www.w3.org/2000/svg">
            <path d="M259.4 128.9c-3.4-1.8-7.5-1.7-10.8.4l-95.1 61.8h-35.2c-5.8 0-10.6 4.8-10.6 10.6v92.7c0 5.9 4.8 10.6 10.6 10.6h35.2l95.1 61.8c1.8 1.2 3.8 1.7 5.8 1.7 1.7 0 3.5-.4 5-1.3 3.4-1.8 5.6-5.4 5.6-9.3V138.2c0-3.9-2.2-7.4-5.6-9.3z" fill="currentColor"/>
            <path d="M303.6 302.9c-3.8 0-7.5-1.4-10.3-4.3-5.7-5.6-5.7-14.9 0-20.6 7.2-7.2 11.2-16.8 11.2-27s-4-19.9-11.2-27.1c-5.7-5.7-5.7-14.9 0-20.6 5.7-5.7 14.9-5.7 20.6 0 12.7 12.7 19.7 29.6 19.7 47.6 0 18.1-7 35-19.7 47.7-2.9 2.9-6.6 4.3-10.3 4.3z" fill="currentColor"/>
          </svg>
        </button>

      {%- elsif section.settings.fallback_image != blank -%}
        <img class="boka-fallback" src="{{ section.settings.fallback_image | img_url: 'master' }}" alt="{{ section.settings.video_aria_label }}">
      {%- endif -%}
    </div>

  </div>
</div>

<script>
(function () {
  var section = document.getElementById('shopify-section-{{ section.id }}');
  if (!section) return;

  // ── Countdown Timer ──
  var countdownEl = section.querySelector('.boka-countdown');
  if (countdownEl) {
    var endTime = new Date(countdownEl.dataset.end).getTime();
    function tick() {
      var diff = endTime - Date.now();
      if (diff <= 0) { countdownEl.textContent = '00:00:00'; return; }
      var h = Math.floor(diff / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      countdownEl.textContent =
        String(h).padStart(2,'0') + ':' +
        String(m).padStart(2,'0') + ':' +
        String(s).padStart(2,'0');
    }
    tick();
    setInterval(tick, 1000);
  }

  // ── Video Controls ──
  var video   = section.querySelector('.boka-video');
  var muteBtn = section.querySelector('.boka-mute-btn');
  var playBtn = section.querySelector('.boka-play-btn');

  if (video && muteBtn) {
    muteBtn.addEventListener('click', function () {
      video.muted = !video.muted;
    });
  }
  if (video && playBtn) {
    video.addEventListener('pause', function () { playBtn.style.display = 'flex'; });
    video.addEventListener('play',  function () { playBtn.style.display = 'none'; });
    playBtn.addEventListener('click', function () { video.play(); });
  }
})();
</script>

