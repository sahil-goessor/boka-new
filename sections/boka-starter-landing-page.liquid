      #boka-starter-lp-{{ section.id }} .boka-lp__gallery-wrap { display: contents; }

      #boka-starter-lp-{{ section.id }} .boka-lp__gallery-card {
        order: 3;
        grid-template-columns: 1fr;
        border-radius: var(--boka-box-radius);
        padding: 14px;
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__buybox {
        order: 5;
        display: grid;
        gap: 14px;
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__product-summary-card,
      #boka-starter-lp-{{ section.id }} .boka-lp__buybox-inner {
        padding: 22px;
        border-radius: var(--boka-box-radius);
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__product-title {
        font-size: clamp(28px, 8vw, 38px);
