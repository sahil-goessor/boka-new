{% liquid
  assign lp_product = section.settings.product
  assign first_variant = lp_product.selected_or_first_available_variant
  assign has_selling_plans = false

  if lp_product != blank and lp_product.selling_plan_groups.size > 0
    assign has_selling_plans = true
  endif
%}

<section id="boka-starter-lp-{{ section.id }}" class="boka-lp" data-section-id="{{ section.id }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;500;700&family=Cormorant+Garamond:ital,wght@1,400;1,500&display=swap" rel="stylesheet">

  <style>
    {% if section.settings.hide_theme_header %}
      body:has(#boka-starter-lp-{{ section.id }}) .shopify-section-group-header-group,
      body:has(#boka-starter-lp-{{ section.id }}) #shopify-section-header,
      body:has(#boka-starter-lp-{{ section.id }}) .header-wrapper:not(.landing-header-wrapper),
      body:has(#boka-starter-lp-{{ section.id }}) .announcement-bar,
      body:has(#boka-starter-lp-{{ section.id }}) .utility-bar {
        display: none !important;
      }

      body:has(#boka-starter-lp-{{ section.id }}) {
        padding-top: 0 !important;
      }
    {% endif %}

    
       ========================================================== */
    #boka-starter-lp-{{ section.id }} {
      --boka-green-light: {{ section.settings.green_light | default: '#e6f4d4' }};
      --boka-green: {{ section.settings.green | default: '#d3e7c0' }};
      --boka-green-mid: #bfd6a5;
      --boka-green-deep: #a5bc8b;
      --boka-olive: #737c5b;

      --boka-blush-light: {{ section.settings.blush_light | default: '#f9e5db' }};
      --boka-blush: #efd5ca;
      --boka-clay: #aa7a6b;
      --boka-taupe: #d1aa9d;

      --boka-cream: {{ section.settings.cream | default: '#fafaf5' }};
      --boka-stone: #e2e2d9;
      --boka-warm-gray: #c1beb0;
      --boka-gray: #8c8773;
      --boka-charcoal: #222721;
      --boka-white: #ffffff;
      --boka-hero-green: #dfeccf;

      --boka-border-soft: 1px solid var(--boka-stone);
      --boka-border-medium: 1px solid var(--boka-charcoal);
      --boka-surface: rgba(255, 255, 255, .92);
      --boka-surface-cream: rgba(250, 250, 245, .92);
      --boka-shadow-soft: 0 1px 0 rgba(34, 39, 33, .04);
      --boka-shadow-card: 0 12px 28px -18px rgba(34, 39, 33, .25);

      --boka-btn-radius: 4px;
      --boka-box-radius: 22px;
      --boka-box-radius-lg: 28px;

      color: var(--boka-charcoal);
      background: linear-gradient(180deg, var(--boka-cream) 0%, var(--boka-white) 48%, var(--boka-cream) 100%);
      font-family: "Neue Haas Unica W1G", "Archivo", Helvetica, Arial, sans-serif;
      font-weight: 400;
      line-height: 1.5;
      overflow: clip;
    }

    #boka-starter-lp-{{ section.id }} *,
    #boka-starter-lp-{{ section.id }} *::before,
    #boka-starter-lp-{{ section.id }} *::after {
      box-sizing: border-box;
    }

    #boka-starter-lp-{{ section.id }} button,
    #boka-starter-lp-{{ section.id }} input,
    #boka-starter-lp-{{ section.id }} select {
      font: inherit;
    }

    #boka-starter-lp-{{ section.id }} p,
    #boka-starter-lp-{{ section.id }} h1,
    #boka-starter-lp-{{ section.id }} h2,
    #boka-starter-lp-{{ section.id }} h3 {
      margin: 0;
    }

    #boka-starter-lp-{{ section.id }} a {
      color: inherit;
    }

    #boka-starter-lp-{{ section.id }} em,
    #boka-starter-lp-{{ section.id }} .boka-lp__serif {
      font-family: "Ivar Display Italic", "Cormorant Garamond", "Times New Roman", serif;
      font-style: italic;
      font-weight: 400;
      letter-spacing: -.01em;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__topbar {
      position: sticky;
      top: 0;
      z-index: 20;
      background: var(--boka-green-light);
      color: var(--boka-charcoal);
      border-bottom: 1px solid var(--boka-green-mid);
      text-align: center;
      padding: 10px 16px;
      font-size: 12px;
      line-height: 1.3;
      font-weight: 500;
      letter-spacing: .04em;
      text-transform: uppercase;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__topbar a {
      text-decoration: underline;
      text-underline-offset: 3px;
      font-weight: 700;
    }

    
    #boka-starter-lp-{{ section.id }} .boka-lp__nav-cta,
    #boka-starter-lp-{{ section.id }} .boka-lp__bottom-button,
    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 24px;
      border-radius: var(--boka-btn-radius);
      border: 1px solid var(--boka-charcoal);
      background: var(--boka-charcoal);
      color: var(--boka-cream);
      text-decoration: none;
      font-size: 12px;
      line-height: 1;
      font-weight: 700;
      letter-spacing: 0;
      text-transform: uppercase;
      white-space: nowrap;
      transition: background .18s ease, transform .18s ease;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__nav-cta:hover,
    #boka-starter-lp-{{ section.id }} .boka-lp__bottom-button:hover,
    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-button:hover {
      background: #111;
      transform: translateY(-1px);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-button {
      min-height: 52px;
      padding: 0 30px;
      margin-top: 28px;
      font-size: 13px;
      width: fit-content;
      color: var(--boka-cream) !important;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__hero {
      max-width: 1400px;
      margin: 0 auto;
      padding: {{ section.settings.padding_top | default: 34 }}px 4% {{ section.settings.padding_bottom | default: 64 }}px;
      display: grid;
      grid-template-columns: minmax(0, 1.06fr) minmax(420px, .94fr);
      gap: 28px;
      align-items: start;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner {
      grid-column: 1 / -1;
      width: 100vw;
      max-width: none;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
      padding: 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      background:
        radial-gradient(circle at 76% 42%, rgba(255,255,255,.34) 0%, rgba(255,255,255,0) 38%),
        linear-gradient(90deg, #dfeccf 0%, #dfeccf 52%, #dbe8ca 100%);
      overflow: hidden;
      text-align: left;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-main {
      display: grid;
      grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
      align-items: center;
      gap: clamp(24px, 5vw, 78px);
      min-height: clamp(560px, 48vw, 720px);
      padding: clamp(56px, 7vw, 96px) 6% 36px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-content {
      order: 1;
      max-width: 620px;
      position: relative;
      z-index: 2;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-image-wrap {
      order: 2;
      width: 100%;
      height: clamp(500px, 46vw, 720px);
      display: flex;
      align-items: center;
      justify-content: flex-end;
      position: relative;
      z-index: 1;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-image {
      width: auto;
      height: 100%;
      object-fit: contain;
      object-position: center right;
      display: block;
      opacity: .92;
      mix-blend-mode: multiply;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__promo-eyebrow {
      margin: 0 0 18px;
      color: var(--boka-olive);
      font-size: 11px;
      line-height: 1.2;
      font-weight: 700;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner h2 {
      margin: 0;
      color: var(--boka-charcoal);
      font-size: clamp(44px, 5.6vw, 80px);
      line-height: .92;
      letter-spacing: -.04em;
      font-weight: 700;
      max-width: 12ch;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-content > p:last-of-type {
      margin: 22px 0 0;
      max-width: 520px;
      color: var(--boka-charcoal);
      font-size: 16px;
      line-height: 1.5;
      font-weight: 400;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__proof-bar-section--banner {
      width: 100%;
      padding: 0 6% clamp(34px, 5vw, 58px);
      background: transparent;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__proof-bar-section--banner .boka-lp__proof-bar {
      width: 100%;
      max-width: 1180px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow: hidden;
      background: rgba(250, 250, 245, .72);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(34, 39, 33, .14);
      border-radius: var(--boka-box-radius-lg);
      box-shadow: none;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__proof-bar-section--banner .boka-lp__proof-stat {
      padding: 22px 18px;
      border-right: 1px solid rgba(34, 39, 33, .10);
      text-align: center;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__proof-bar-section--banner .boka-lp__proof-stat:last-child {
      border-right: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__proof-number {
      display: block;
      color: var(--boka-charcoal);
      font-size: clamp(22px, 2.4vw, 30px);
      line-height: 1;
      letter-spacing: -.02em;
      font-weight: 700;
      margin-bottom: 8px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__proof-label {
      color: var(--boka-gray);
      font-size: 12px;
      line-height: 1.35;
      font-weight: 500;
      letter-spacing: .03em;
      text-transform: uppercase;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__hero-full-bleed {
      grid-column: 1 / -1;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
      display: grid;
      gap: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__gallery-wrap {
      position: sticky;
      top: 24px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__gallery-card {
      background: var(--boka-surface);
      border: var(--boka-border-soft);
      border-radius: var(--boka-box-radius-lg);
      overflow: hidden;
      padding: 18px;
      display: grid;
      grid-template-columns: 104px minmax(0, 1fr);
      gap: 0;
      box-shadow: var(--boka-shadow-soft);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__main-media {
      position: relative;
      min-height: 590px;
      background: var(--boka-white);
      border-radius: var(--boka-box-radius);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      order: 2;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__main-media img {
      width: 100%;
      height: 100%;
      min-height: 560px;
      object-fit: cover;
      display: block;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__main-media--contain img {
      object-fit: contain;
      padding: 8%;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__placeholder {
      width: 100%;
      min-height: 560px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--boka-charcoal);
      letter-spacing: .22em;
      font-size: 44px;
      opacity: .25;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__media-badge {
      position: absolute;
      top: 14px;
      left: 14px;
      z-index: 2;
      background: var(--boka-cream);
      border: 1px solid var(--boka-green-mid);
      color: var(--boka-charcoal);
      border-radius: 999px;
      padding: 8px 14px;
      font-size: 10px;
      line-height: 1;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__thumbs {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 12px;
      background: transparent;
      border-right: 1px solid var(--boka-stone);
      max-height: 560px;
      overflow-y: auto;
      order: 1;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__thumb {
      width: 80px;
      min-height: 80px;
      border: 1px solid var(--boka-stone);
      border-radius: 14px;
      background: var(--boka-white);
      padding: 0;
      cursor: pointer;
      overflow: hidden;
      transition: border-color .2s, transform .2s, box-shadow .2s;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__thumb:hover,
    #boka-starter-lp-{{ section.id }} .boka-lp__thumb.is-active {
      border-color: var(--boka-green-deep);
      box-shadow: 0 0 0 2px var(--boka-green-light);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__thumb img,
    #boka-starter-lp-{{ section.id }} .boka-lp__thumb-placeholder {
      width: 100%;
      height: 80px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__thumb img {
      object-fit: cover;
      display: block;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__thumb-placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--boka-gray);
      font-size: 9px;
      font-weight: 500;
      letter-spacing: .06em;
      text-align: center;
      text-transform: uppercase;
      padding: 6px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__guarantees {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-top: 14px;
      background: var(--boka-surface-cream);
      border: var(--boka-border-soft);
      border-radius: var(--boka-box-radius);
      overflow: hidden;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__guarantees div {
      min-height: 56px;
      padding: 14px 10px;
      border-right: 1px solid var(--boka-stone);
      text-align: center;
      color: var(--boka-charcoal);
      font-size: 11px;
      line-height: 1.3;
      font-weight: 500;
      letter-spacing: .04em;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__guarantees div:last-child {
      border-right: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__buybox {
      display: grid;
      gap: 18px;
      background: transparent;
      border: 0;
      overflow: visible;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__intro-card {
      background: transparent;
      padding: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__rating-row {
      display: flex;
      align-items: center;
      gap: 9px;
      flex-wrap: wrap;
      color: var(--boka-charcoal);
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 14px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__stars {
      color: var(--boka-olive);
      letter-spacing: .06em;
      font-size: 12px;
      white-space: nowrap;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__eyebrow {
      margin: 0 0 12px;
      color: var(--boka-olive);
      font-size: 11px;
      line-height: 1.2;
      font-weight: 700;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__product-summary-card,
    #boka-starter-lp-{{ section.id }} .boka-lp__buybox-inner {
      background: var(--boka-surface);
      border: var(--boka-border-soft);
      border-radius: var(--boka-box-radius-lg);
      padding: 30px;
      box-shadow: var(--boka-shadow-soft);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__product-summary-card {
      margin-top: 14px;
    }

    /* Product title — Bold, NOT Black. Brand calls for Light/Regular/Bold only. */
    #boka-starter-lp-{{ section.id }} .boka-lp__product-title {
      color: var(--boka-charcoal);
      font-size: clamp(30px, 4vw, 44px);
      line-height: 1.02;
      letter-spacing: -.035em;
      font-weight: 700;
      max-width: 14ch;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__product-title p {
      margin: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__product-description,
    #boka-starter-lp-{{ section.id }} .boka-lp__subtitle {
      margin-top: 18px;
      max-width: 560px;
      color: var(--boka-charcoal);
      font-size: 16px;
      line-height: 1.55;
      font-weight: 400;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__checklist,
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-features,
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-features_otp,
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-features_opt {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__checklist {
      display: grid;
      gap: 12px;
      margin-top: 22px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__checklist--product {
      padding-top: 22px;
      border-top: 1px solid var(--boka-stone);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__checklist li {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      color: var(--boka-charcoal);
      font-size: 15px;
      line-height: 1.45;
      font-weight: 400;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__checklist li::before {
      content: "✓";
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--boka-green-light);
      color: var(--boka-olive);
      border: 1px solid var(--boka-green-mid);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 24px;
      font-size: 12px;
      font-weight: 700;
      margin-top: 0;
    }

    /* FORM STEPS */
    #boka-starter-lp-{{ section.id }} .boka-lp__step {
      padding: 26px 0;
      border-top: 1px solid var(--boka-stone);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__step:first-of-type {
      padding-top: 0;
      border-top: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__step-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 16px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__step-title {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--boka-charcoal);
      font-size: 18px;
      line-height: 1.2;
      font-weight: 700;
      letter-spacing: -.01em;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__step-number {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: var(--boka-charcoal);
      color: var(--boka-cream);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 26px;
      font-size: 12px;
      font-weight: 700;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-grid,
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-fallback {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-card,
    #boka-starter-lp-{{ section.id }} .boka-lp__qty-card,
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-card {
      border: 1px solid var(--boka-stone) !important;
      background: #ffffff !important;
      color: var(--boka-charcoal);
    }

    /* Selection cards keep softly rounded corners (they're "boxes", not buttons). */
    #boka-starter-lp-{{ section.id }} .boka-lp__goal-card {
      position: relative;
      min-height: 76px;
      border-radius: var(--boka-box-radius);
      padding: 22px 64px 22px 22px;
      text-align: left;
      cursor: pointer;
      transition: background .18s ease, border-color .18s ease;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-card:hover:not([disabled]),
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-card:hover:not([disabled]) {
      background: var(--boka-cream) !important;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-card.is-active,
    #boka-starter-lp-{{ section.id }} .boka-lp__qty-card.is-active,
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-card.is-active {
      background: var(--boka-green-light) !important;
      border: 1px solid var(--boka-green-mid) !important;
      color: var(--boka-charcoal) !important;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-card.is-active::after {
      content: "✓";
      position: absolute;
      top: 50%;
      right: 18px;
      transform: translateY(-50%);
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--boka-charcoal);
      color: var(--boka-cream);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      font-weight: 700;
      line-height: 1;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-card[disabled],
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-card[disabled] {
      opacity: .45;
      cursor: not-allowed;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-title {
      display: block;
      color: var(--boka-charcoal);
      font-size: 18px;
      line-height: 1.15;
      font-weight: 700;
      letter-spacing: -.015em;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-sub,
    #boka-starter-lp-{{ section.id }} .boka-lp__goal-sub::before,
    #boka-starter-lp-{{ section.id }} .boka-lp__goal-sub::after {
      display: none;
      content: none;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__quantity-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__qty-card {
      min-height: 56px;
      border-radius: 14px;
      padding: 10px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-card {
      position: relative;
      width: 100%;
      border-radius: var(--boka-box-radius);
      padding: 26px;
      text-align: left;
      cursor: pointer;
      overflow: hidden;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-card.has-badge {
      padding-top: 46px;
    }

    /* Plan badge — kept on a sharp corner per brand (no pill) */
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-badge {
      position: absolute;
      top: 0;
      right: 0;
      background: var(--boka-charcoal);
      color: var(--boka-cream);
      border-radius: 0 var(--boka-box-radius) 0 var(--boka-btn-radius);
      padding: 10px 14px;
      font-size: 10px;
      line-height: 1;
      letter-spacing: .08em;
      text-transform: uppercase;
      text-align: center;
      font-weight: 700;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 14px;
      align-items: start;
      margin-bottom: 16px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-head > span:last-child {
      display: flex;
      align-items: baseline;
      justify-content: flex-end;
      gap: 7px;
      flex-wrap: wrap;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-title {
      font-size: 22px;
      line-height: 1.1;
      font-weight: 700;
      letter-spacing: -.02em;
      max-width: 12ch;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__price {
      font-size: 28px;
      line-height: 1;
      font-weight: 700;
      white-space: nowrap;
      letter-spacing: -.02em;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__compare-price {
      margin-right: 7px;
      color: var(--boka-gray);
      font-size: 14px;
      line-height: 1;
      text-decoration: line-through;
      font-weight: 400;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-note {
      display: block;
      margin: 0 0 18px;
      color: var(--boka-charcoal);
      font-size: 14.5px;
      line-height: 1.5;
      font-weight: 400;
      max-width: 36ch;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-features,
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-features_otp,
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-features_opt {
      display: grid;
      gap: 9px;
      padding-top: 16px;
      border-top: 1px solid rgba(34, 39, 33, .12);
      color: var(--boka-gray);
      font-size: 13px;
      line-height: 1.45;
      font-weight: 400;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-features li::before,
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-features_otp li::before {
      margin-right: 7px;
      color: var(--boka-olive);
      font-weight: 700;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-features li::before {
      content: "✓";
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-features_otp li::before {
      content: "×";
    }

    /* ATC — flagship button. Brand: charcoal, sharp corners, uppercase, letter-spacing 0. */
    #boka-starter-lp-{{ section.id }} .boka-lp__atc {
      width: 100%;
      min-height: 60px;
      border: 1px solid var(--boka-charcoal);
      border-radius: var(--boka-btn-radius);
      background: var(--boka-charcoal);
      color: var(--boka-cream);
      padding: 18px 24px;
      cursor: pointer;
      font-size: 14px;
      line-height: 1;
      font-weight: 700;
      letter-spacing: 0;
      text-transform: uppercase;
      transition: background .2s, transform .15s;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__atc:hover:not([disabled]) {
      background: #111;
      transform: translateY(-1px);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__atc[disabled] {
      opacity: .55;
      cursor: not-allowed;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__atc-subtext,
    #boka-starter-lp-{{ section.id }} .boka-lp__message {
      margin-top: 12px;
      min-height: 20px;
      text-align: center;
      color: var(--boka-gray);
      font-size: 12px;
      line-height: 1.4;
      font-weight: 400;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__message {
      color: var(--boka-olive);
      font-size: 13px;
      font-weight: 500;
    }

    /* SECTION SYSTEM */
    #boka-starter-lp-{{ section.id }} .boka-lp__section {
      padding: 88px 5%;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__section--white   { background: var(--boka-white); }
    #boka-starter-lp-{{ section.id }} .boka-lp__section--green   { background: var(--boka-green-light); }
    #boka-starter-lp-{{ section.id }} .boka-lp__section--blush   { background: var(--boka-blush-light); }
    #boka-starter-lp-{{ section.id }} .boka-lp__section--charcoal{ background: var(--boka-charcoal); color: var(--boka-cream); }

    #boka-starter-lp-{{ section.id }} .boka-lp__wrap {
      max-width: 1180px;
      margin: 0 auto;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__wrap--narrow {
      max-width: 900px;
    }

    /* Section titles — Bold (700), generous tracking, max 14ch for editorial feel. */
    #boka-starter-lp-{{ section.id }} .boka-lp__section-title {
      margin: 0 0 22px;
      color: var(--boka-charcoal);
      font-size: clamp(30px, 3.6vw, 44px);
      line-height: 1.08;
      letter-spacing: -.025em;
      font-weight: 700;
      max-width: 780px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__section-copy {
      margin: 0 0 30px;
      max-width: 720px;
      color: var(--boka-gray);
      font-size: 16px;
      line-height: 1.65;
      font-weight: 400;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__section--charcoal .boka-lp__section-title,
    #boka-starter-lp-{{ section.id }} .boka-lp__section--charcoal .boka-lp__eyebrow {
      color: var(--boka-cream);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__section--charcoal .boka-lp__section-copy {
      color: rgba(250, 250, 245, .76);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__cards-4,
    #boka-starter-lp-{{ section.id }} .boka-lp__cards-3 {
      display: grid;
      gap: 16px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__cards-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    #boka-starter-lp-{{ section.id }} .boka-lp__cards-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }

    #boka-starter-lp-{{ section.id }} .boka-lp__info-card,
    #boka-starter-lp-{{ section.id }} .boka-lp__routine-panel {
      background: var(--boka-surface);
      border: var(--boka-border-soft);
      border-radius: var(--boka-box-radius);
      padding: 28px;
      box-shadow: var(--boka-shadow-soft);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__section--charcoal .boka-lp__info-card {
      background: rgba(250, 250, 245, .07);
      border-color: rgba(250, 250, 245, .16);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__info-card strong,
    #boka-starter-lp-{{ section.id }} .boka-lp__routine-panel h3 {
      display: block;
      margin: 0 0 10px;
      color: var(--boka-charcoal);
      font-size: 19px;
      line-height: 1.2;
      font-weight: 700;
      letter-spacing: -.015em;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__section--charcoal .boka-lp__info-card strong {
      color: var(--boka-cream);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__info-card p,
    #boka-starter-lp-{{ section.id }} .boka-lp__routine-panel p,
    #boka-starter-lp-{{ section.id }} .boka-lp__routine-panel li {
      color: var(--boka-gray);
      font-size: 14.5px;
      line-height: 1.6;
      font-weight: 400;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__section--charcoal .boka-lp__info-card p {
      color: rgba(250, 250, 245, .68);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__routine-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__routine-panel.is-green {
      background: var(--boka-green-light);
      border-color: var(--boka-green-mid);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__routine-panel ul {
      margin: 14px 0 0;
      padding-left: 18px;
    }

    /* COMPARE TABLE — softened to brand standard */
    #boka-starter-lp-{{ section.id }} .boka-lp__compare {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      overflow: hidden;
      border: 1px solid var(--boka-stone);
      border-radius: var(--boka-box-radius);
      background: var(--boka-white);
      font-size: 14.5px;
      box-shadow: var(--boka-shadow-soft);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__compare th,
    #boka-starter-lp-{{ section.id }} .boka-lp__compare td {
      padding: 18px 20px;
      border-bottom: 1px solid var(--boka-stone);
      color: var(--boka-gray);
      font-weight: 400;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__compare tr:last-child td {
      border-bottom: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__compare th {
      color: var(--boka-charcoal);
      text-align: center;
      font-weight: 700;
      background: var(--boka-cream);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__compare th:first-child,
    #boka-starter-lp-{{ section.id }} .boka-lp__compare td:first-child {
      text-align: left;
      color: var(--boka-charcoal);
      font-weight: 500;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__compare .is-boka {
      background: var(--boka-green-light);
      color: var(--boka-charcoal);
      text-align: center;
      font-weight: 700;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__compare td:not(:first-child) {
      text-align: center;
    }

    /* FAQ */
    #boka-starter-lp-{{ section.id }} .boka-lp__faq {
      border: 1px solid var(--boka-stone);
      border-radius: var(--boka-box-radius);
      overflow: hidden;
      background: var(--boka-white);
      box-shadow: var(--boka-shadow-soft);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__faq-item + .boka-lp__faq-item {
      border-top: 1px solid var(--boka-stone);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__faq-btn {
      width: 100%;
      border: 0;
      background: transparent;
      padding: 22px 26px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 18px;
      cursor: pointer;
      text-align: left;
      color: var(--boka-charcoal);
      font-size: 15px;
      font-weight: 700;
      letter-spacing: -.005em;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__faq-btn span {
      color: var(--boka-olive);
      font-size: 20px;
      line-height: 1;
      font-weight: 400;
      transition: transform .2s;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__faq-content {
      display: none;
      padding: 0 26px 24px;
      color: var(--boka-gray);
      font-size: 14.5px;
      line-height: 1.7;
      font-weight: 400;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__faq-item.is-open .boka-lp__faq-content {
      display: block;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__faq-item.is-open .boka-lp__faq-btn span {
      transform: rotate(45deg);
    }

    /* WHAT'S INSIDE */
    #boka-starter-lp-{{ section.id }} .boka-lp__included-mobile { display: none; }

    #boka-starter-lp-{{ section.id }} .boka-lp__included-desktop {
      display: block;
      background: var(--boka-white);
      padding: 64px 4%;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__included-desktop .boka-lp__wrap {
      max-width: 1180px;
      background: linear-gradient(180deg, var(--boka-green-light) 0%, rgba(230, 244, 212, .62) 100%);
      border: 1px solid var(--boka-green-mid);
      border-radius: var(--boka-box-radius-lg);
      padding: 48px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__included-desktop .boka-lp__info-card {
      background: rgba(255, 255, 255, .84);
      border: 1px solid rgba(34, 39, 33, .08);
      box-shadow: none;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__included-cards {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 16px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__included-card {
      display: grid;
      grid-template-rows: auto 1fr;
      align-items: start;
      justify-items: center;
      gap: 16px;
      min-height: 232px;
      padding: 20px;
      text-align: center;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__included-card .boka-lp__info-icon,
    #boka-starter-lp-{{ section.id }} .boka-lp__included-card p {
      display: none !important;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__included-image {
      background: transparent !important;
      border: 0 !important;
      box-shadow: none !important;
      border-radius: 0 !important;
      padding: 0 !important;
      overflow: visible !important;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__included-image img {
      display: block;
      width: 150px;
      height: 150px;
      max-width: 100%;
      object-fit: contain;
      margin: 0 auto;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__included-image-placeholder {
      width: 132px;
      height: 132px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--boka-charcoal);
      font-size: 18px;
      line-height: 1;
      font-weight: 700;
      letter-spacing: .18em;
      opacity: .25;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__included-card strong,
    #boka-starter-lp-{{ section.id }} .boka-lp__included-desktop .boka-lp__info-card strong {
      margin: 0;
      font-family: "Neue Haas Unica W1G", "Archivo", Helvetica, Arial, sans-serif !important;
      color: var(--boka-charcoal);
      font-size: 16px;
      line-height: 1.2;
      font-weight: 700;
      letter-spacing: -.01em;
      text-align: center;
    }

    /* BOTTOM CTA */
    #boka-starter-lp-{{ section.id }} .boka-lp__bottom-cta { text-align: center; }

    #boka-starter-lp-{{ section.id }} .boka-lp__bottom-cta .boka-lp__section-title,
    #boka-starter-lp-{{ section.id }} .boka-lp__bottom-cta .boka-lp__section-copy {
      margin-left: auto;
      margin-right: auto;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__bottom-cta .boka-lp__section-title {
      color: var(--boka-cream);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__bottom-button {
      min-width: 230px;
      min-height: 52px;
      background: var(--boka-cream);
      color: var(--boka-charcoal);
      border-color: var(--boka-cream);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__bottom-button:hover {
      background: #fff;
    }

    /* MOBILE */
    @media (max-width: 980px) {
      #boka-starter-lp-{{ section.id }} .boka-lp__hero {
        grid-template-columns: 1fr;
        gap: 18px;
        padding-left: 16px;
        padding-right: 16px;
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner {
        background: var(--boka-hero-green);
        text-align: center;
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-main {
        grid-template-columns: 1fr;
        min-height: 0;
        gap: 28px;
        padding: 38px 18px 28px;
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-content {
        order: 2;
        max-width: 100%;
        text-align: center;
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-image-wrap {
        order: 1;
        height: auto;
        justify-content: center;
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-image {
        width: min(100%, 460px);
        height: auto;
        object-position: center;
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner h2 {
        max-width: 12ch;
        margin: 0 auto;
        font-size: clamp(36px, 11vw, 52px);
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-content > p:last-of-type {
        margin: 16px auto 0;
        max-width: 420px;
        font-size: 14.5px;
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-button {
        min-height: 48px;
        margin-top: 22px;
        padding: 0 24px;
        font-size: 12px;
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__proof-bar-section--banner {
        padding: 0 16px 34px;
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__proof-bar-section--banner .boka-lp__proof-bar {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-radius: var(--boka-box-radius);
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__proof-bar-section--banner .boka-lp__proof-stat:nth-child(1),
      #boka-starter-lp-{{ section.id }} .boka-lp__proof-bar-section--banner .boka-lp__proof-stat:nth-child(2) {
        border-bottom: 1px solid rgba(34, 39, 33, .10);
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__proof-bar-section--banner .boka-lp__proof-stat:nth-child(2),
      #boka-starter-lp-{{ section.id }} .boka-lp__proof-bar-section--banner .boka-lp__proof-stat:nth-child(4) {
        border-right: 0;
