{% liquid
  assign lp_product = section.settings.product
  assign first_variant = lp_product.selected_or_first_available_variant
  assign has_selling_plans = false

  if lp_product != blank and lp_product.selling_plan_groups.size > 0
    assign has_selling_plans = true
  endif

  assign variation = section.settings.variation
%}

<section
  id="boka-ab-lp-{{ section.id }}"
  class="boka-ab-lp boka-ab-lp--{{ variation }}"
  data-section-id="{{ section.id }}"
>
  <style>
    {% if section.settings.hide_theme_header %}
      body:has(#boka-ab-lp-{{ section.id }}) .shopify-section-group-header-group,
      body:has(#boka-ab-lp-{{ section.id }}) #shopify-section-header,
      body:has(#boka-ab-lp-{{ section.id }}) .header-wrapper,
      body:has(#boka-ab-lp-{{ section.id }}) .announcement-bar,
      body:has(#boka-ab-lp-{{ section.id }}) .utility-bar {
        display: none !important;
      }

      body {
        padding-top: 0 !important;
      }
    {% endif %}

    #boka-ab-lp-{{ section.id }} {
      --boka-green: #d3e7c0;
      --boka-green-mid: #bfd6a5;
      --boka-green-deep: #a5bc8b;
      --boka-olive: #737c5b;

      --boka-blush-light: #f9e5db;
      --boka-blush: #efd5ca;
      --boka-blush-deep: #d1aa9d;
      --boka-clay: #aa7a6b;

      --boka-cream: #fafaf5;
      --boka-stone: #e2e2d9;
      --boka-taupe: #c1beb0;
      --boka-gray: #8c8773;
      --boka-charcoal: #222721;
      --boka-white: #ffffff;

      background: var(--boka-cream);
      color: var(--boka-charcoal);
      font-family: Helvetica, Arial, sans-serif;
      line-height: 1.45;
      overflow: clip;
    }

    #boka-ab-lp-{{ section.id }} *,
    #boka-ab-lp-{{ section.id }} *::before,
    #boka-ab-lp-{{ section.id }} *::after {
      box-sizing: border-box;
    }

    #boka-ab-lp-{{ section.id }} button,
    #boka-ab-lp-{{ section.id }} input,
    #boka-ab-lp-{{ section.id }} select {
      font: inherit;
    }

    #boka-ab-lp-{{ section.id }} img {
      max-width: 100%;
      display: block;
    }

    #boka-ab-lp-{{ section.id }} a {
      color: inherit;
    }

    #boka-ab-lp-{{ section.id }} p,
    #boka-ab-lp-{{ section.id }} h1,
    #boka-ab-lp-{{ section.id }} h2,
    #boka-ab-lp-{{ section.id }} h3 {
      margin: 0;
    }

    #boka-ab-lp-{{ section.id }} em {
      font-family: "Times New Roman", Times, serif;
      font-style: italic;
      font-weight: 400;
      letter-spacing: -.02em;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__topbar {
      background: var(--boka-green);
      color: var(--boka-charcoal);
      text-align: center;
      padding: 10px 16px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: .01em;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__nav {
      position: sticky;
      top: 0;
      z-index: 20;
      background: rgba(250, 250, 245, .94);
      border-bottom: 1px solid var(--boka-stone);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__nav-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 14px 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 18px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__logo {
      text-decoration: none;
      font-size: 22px;
      line-height: 1;
      letter-spacing: .22em;
      text-transform: uppercase;
      font-weight: 400;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__nav-links {
      display: flex;
      gap: 24px;
      color: var(--boka-gray);
      font-size: 13px;
      font-weight: 700;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__nav-links a {
      text-decoration: none;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__button,
    #boka-ab-lp-{{ section.id }} .boka-ab__atc,
    #boka-ab-lp-{{ section.id }} .shopify-payment-button__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 56px;
      width: 100%;
      padding: 0 26px;
      border: 0;
      border-radius: 0;
      background: var(--boka-charcoal);
      color: var(--boka-cream);
      text-decoration: none;
      cursor: pointer;
      font-size: 15px;
      line-height: 1;
      font-weight: 700;
      letter-spacing: .01em;
      text-transform: uppercase;
      transition: background .2s ease;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__button:hover,
    #boka-ab-lp-{{ section.id }} .boka-ab__atc:hover {
      background: #000;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__button--small {
      min-height: 42px;
      width: auto;
      padding: 0 18px;
      font-size: 13px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__eyebrow {
      color: var(--boka-olive);
      font-size: 12px;
      line-height: 1.2;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__title {
      color: var(--boka-charcoal);
      font-size: clamp(42px, 6vw, 82px);
      line-height: .92;
      letter-spacing: -.055em;
      font-weight: 700;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__subtitle {
      color: var(--boka-charcoal);
      font-size: clamp(17px, 1.55vw, 21px);
      line-height: 1.5;
      font-weight: 400;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__muted {
      color: var(--boka-gray);
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__glass {
      background: rgba(255, 255, 255, .7);
      border: 1px solid rgba(34, 39, 33, .08);
      border-radius: 24px;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__soft-card {
      background: rgba(255, 255, 255, .7);
      border: 1px solid var(--boka-stone);
      border-radius: 22px;
      padding: 24px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__list {
      list-style: none;
      margin: 22px 0 0;
      padding: 0;
      display: grid;
      gap: 12px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__list li {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 12px;
      align-items: start;
      color: var(--boka-charcoal);
      font-size: 15px;
      line-height: 1.4;
      font-weight: 400;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__list li::before {
      content: "";
      width: 18px;
      height: 18px;
      margin-top: 2px;
      border: 1.5px solid var(--boka-charcoal);
      border-radius: 999px;
      background:
        linear-gradient(45deg, transparent 43%, var(--boka-charcoal) 43% 57%, transparent 57%);
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__pill-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__pill {
      display: inline-flex;
      align-items: center;
      min-height: 30px;
      border-radius: 999px;
      padding: 0 12px;
      background: var(--boka-green);
      color: var(--boka-charcoal);
      font-size: 12px;
      line-height: 1;
      font-weight: 700;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__pill--dark {
      background: var(--boka-charcoal);
      color: var(--boka-cream);
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__product-form {
      display: grid;
      gap: 14px;
      margin-top: 22px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__select,
    #boka-ab-lp-{{ section.id }} .boka-ab__quantity {
      width: 100%;
      min-height: 48px;
      border: 1px solid var(--boka-stone);
      border-radius: 999px;
      background: var(--boka-white);
      color: var(--boka-charcoal);
      padding: 0 16px;
      font-size: 14px;
      font-weight: 400;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__form-row {
      display: grid;
      grid-template-columns: 1fr 110px;
      gap: 10px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__price-line {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 14px;
      padding: 16px 0;
      border-top: 1px solid var(--boka-stone);
      border-bottom: 1px solid var(--boka-stone);
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__price {
      font-size: 24px;
      line-height: 1;
      font-weight: 700;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__compare {
      margin-left: 8px;
      color: var(--boka-gray);
      font-size: 15px;
      text-decoration: line-through;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__microcopy {
      color: var(--boka-gray);
      font-size: 13px;
      line-height: 1.4;
      text-align: center;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__media {
      position: relative;
      overflow: hidden;
      border-radius: 28px;
      background: var(--boka-green);
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__media--contain img {
      object-fit: contain;
      padding: clamp(28px, 5vw, 72px);
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__placeholder {
      min-height: 520px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(34, 39, 33, .35);
      font-size: 42px;
      letter-spacing: .22em;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__section {
      padding: 74px 5%;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__wrap {
      max-width: 1180px;
      margin: 0 auto;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__section-title {
      max-width: 760px;
      margin: 0 0 18px;
      color: var(--boka-charcoal);
      font-size: clamp(32px, 4vw, 52px);
      line-height: 1;
      letter-spacing: -.045em;
      font-weight: 700;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__section-copy {
      max-width: 720px;
      color: var(--boka-gray);
      font-size: 17px;
      line-height: 1.6;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__proof-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      margin-top: 30px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__proof-card strong {
      display: block;
      margin-bottom: 8px;
      color: var(--boka-charcoal);
      font-size: 17px;
      line-height: 1.2;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__proof-card p {
      color: var(--boka-gray);
      font-size: 14px;
      line-height: 1.55;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__footer-cta {
      background: var(--boka-green);
      padding: 64px 5%;
      text-align: center;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__footer-cta-inner {
      max-width: 760px;
      margin: 0 auto;
      display: grid;
      gap: 20px;
      justify-items: center;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__footer-cta .boka-ab__button {
      max-width: 320px;
    }

    /* Variation 1: Science Split */
    #boka-ab-lp-{{ section.id }} .boka-ab__hero-v1 {
      max-width: 1400px;
      margin: 0 auto;
      padding: 56px 5% 74px;
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(420px, .95fr);
      gap: 42px;
      align-items: center;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__hero-v1 .boka-ab__media {
      min-height: 650px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__hero-v1-card {
      padding: clamp(30px, 4vw, 54px);
      display: grid;
      gap: 20px;
    }

    /* Variation 2: Editorial Elevated */
    #boka-ab-lp-{{ section.id }} .boka-ab__hero-v2 {
      position: relative;
      min-height: 760px;
      padding: 76px 5%;
      background:
        radial-gradient(circle at 76% 30%, rgba(211, 231, 192, .9), transparent 34%),
        linear-gradient(90deg, var(--boka-cream), var(--boka-blush-light));
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__hero-v2-inner {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: .9fr 1.1fr;
      gap: 42px;
      align-items: center;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__hero-v2-copy {
      max-width: 600px;
      display: grid;
      gap: 22px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__hero-v2-product {
      min-height: 620px;
      padding: clamp(32px, 5vw, 70px);
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, .55);
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__floating-note {
      position: absolute;
      right: 8%;
      bottom: 72px;
      width: min(380px, 82vw);
      padding: 22px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__floating-note strong {
      display: block;
      margin-bottom: 6px;
      font-size: 18px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__floating-note span {
      color: var(--boka-gray);
      font-size: 14px;
      line-height: 1.5;
    }

    /* Variation 3: Guided Routine */
    #boka-ab-lp-{{ section.id }} .boka-ab__hero-v3 {
      max-width: 1400px;
      margin: 0 auto;
      padding: 52px 5% 72px;
      display: grid;
      grid-template-columns: minmax(0, .92fr) minmax(420px, 1.08fr);
      gap: 42px;
      align-items: start;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__quiz {
      display: grid;
      gap: 14px;
      padding: clamp(28px, 4vw, 46px);
      background: var(--boka-green);
      border-radius: 28px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__quiz-option {
      width: 100%;
      border: 1px solid rgba(34, 39, 33, .16);
      border-radius: 22px;
      background: rgba(255, 255, 255, .68);
      padding: 20px;
      text-align: left;
      cursor: pointer;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__quiz-option strong {
      display: block;
      margin-bottom: 6px;
      font-size: 18px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__quiz-option span {
      color: var(--boka-gray);
      font-size: 14px;
      line-height: 1.45;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__quiz-option.is-active {
      background: var(--boka-white);
      outline: 2px solid var(--boka-charcoal);
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__routine-card {
      padding: clamp(28px, 4vw, 48px);
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__routine-image {
      min-height: 380px;
      margin-top: 24px;
    }

    /* Variation 4: Subscription Value */
    #boka-ab-lp-{{ section.id }} .boka-ab__hero-v4 {
      padding: 56px 5% 78px;
      background: var(--boka-blush-light);
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__hero-v4-inner {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(400px, .8fr);
      gap: 34px;
      align-items: stretch;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__offer-panel {
      padding: clamp(34px, 5vw, 70px);
      background: var(--boka-cream);
      border-radius: 28px;
      display: grid;
      gap: 22px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__value-stack {
      display: grid;
      gap: 14px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__value-row {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--boka-stone);
      color: var(--boka-gray);
      font-size: 15px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__value-row strong {
      color: var(--boka-charcoal);
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__checkout-card {
      padding: 28px;
      align-self: center;
    }

    /* Variation 5: Ingredient Proof */
    #boka-ab-lp-{{ section.id }} .boka-ab__hero-v5 {
      background: var(--boka-green);
      padding: 56px 5% 78px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__hero-v5-inner {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: .95fr 1.05fr;
      gap: 42px;
      align-items: center;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__ingredient-panel {
      padding: clamp(32px, 5vw, 64px);
      background: rgba(250, 250, 245, .78);
      border-radius: 28px;
      display: grid;
      gap: 22px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__ingredient-cards {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin-top: 8px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__ingredient-card {
      background: rgba(255, 255, 255, .72);
      border-radius: 22px;
      padding: 20px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__ingredient-card strong {
      display: block;
      margin-bottom: 8px;
      font-size: 17px;
    }

    #boka-ab-lp-{{ section.id }} .boka-ab__ingredient-card span {
      color: var(--boka-gray);
      font-size: 14px;
      line-height: 1.5;
    }

    @media (max-width: 980px) {
      #boka-ab-lp-{{ section.id }} .boka-ab__nav-links {
        display: none;
      }

      #boka-ab-lp-{{ section.id }} .boka-ab__hero-v1,
      #boka-ab-lp-{{ section.id }} .boka-ab__hero-v2-inner,
      #boka-ab-lp-{{ section.id }} .boka-ab__hero-v3,
      #boka-ab-lp-{{ section.id }} .boka-ab__hero-v4-inner,
      #boka-ab-lp-{{ section.id }} .boka-ab__hero-v5-inner,
      #boka-ab-lp-{{ section.id }} .boka-ab__proof-grid {
        grid-template-columns: 1fr;
      }

      #boka-ab-lp-{{ section.id }} .boka-ab__hero-v1 .boka-ab__media,
      #boka-ab-lp-{{ section.id }} .boka-ab__hero-v2-product,
      #boka-ab-lp-{{ section.id }} .boka-ab__routine-image {
        min-height: 420px;
      }

      #boka-ab-lp-{{ section.id }} .boka-ab__floating-note {
        position: static;
        margin: 20px auto 0;
      }

      #boka-ab-lp-{{ section.id }} .boka-ab__ingredient-cards {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      #boka-ab-lp-{{ section.id }} .boka-ab__topbar {
        font-size: 12px;
      }

      #boka-ab-lp-{{ section.id }} .boka-ab__logo {
        font-size: 18px;
      }

      #boka-ab-lp-{{ section.id }} .boka-ab__button--small {
        min-height: 38px;
        padding: 0 14px;
        font-size: 12px;
      }

      #boka-ab-lp-{{ section.id }} .boka-ab__hero-v1,
      #boka-ab-lp-{{ section.id }} .boka-ab__hero-v2,
      #boka-ab-lp-{{ section.id }} .boka-ab__hero-v3,
      #boka-ab-lp-{{ section.id }} .boka-ab__hero-v4,
      #boka-ab-lp-{{ section.id }} .boka-ab__hero-v5 {
        padding: 34px 4% 56px;
      }

      #boka-ab-lp-{{ section.id }} .boka-ab__form-row {
        grid-template-columns: 1fr;
      }

      #boka-ab-lp-{{ section.id }} .boka-ab__section {
        padding: 56px 4%;
      }
    }
  </style>

  {% if section.settings.show_topbar %}
    <div class="boka-ab__topbar">
      {{ section.settings.topbar_text }}
    </div>
  {% endif %}

  {% if section.settings.show_nav %}
    <nav class="boka-ab__nav" aria-label="Landing page navigation">
      <div class="boka-ab__nav-inner">
        <a class="boka-ab__logo" href="{{ routes.root_url }}" aria-label="Boka home">BOKA</a>

        <div class="boka-ab__nav-links">
          <a href="#boka-ab-science-{{ section.id }}">Science</a>
          <a href="#boka-ab-routine-{{ section.id }}">Routine</a>
          <a href="#boka-ab-buy-{{ section.id }}">Offer</a>
        </div>

        <a class="boka-ab__button boka-ab__button--small" href="#boka-ab-buy-{{ section.id }}">
          Shop now
        </a>
      </div>
    </nav>
  {% endif %}

  {% capture product_media %}
    <div class="boka-ab__media {% if section.settings.product_image_fit == 'contain' %}boka-ab__media--contain{% endif %}">
      {% if section.settings.hero_image != blank %}
        <img
          src="{{ section.settings.hero_image | image_url: width: 1400 }}"
          alt="{{ section.settings.hero_image.alt | default: lp_product.title | escape }}"
          loading="eager"
        >
      {% elsif lp_product.featured_image %}
        <img
          src="{{ lp_product.featured_image | image_url: width: 1400 }}"
          alt="{{ lp_product.title | escape }}"
          loading="eager"
        >
      {% else %}
        <div class="boka-ab__placeholder">BOKA</div>
      {% endif %}
    </div>
  {% endcapture %}

  {% capture product_form %}
    <div id="boka-ab-buy-{{ section.id }}" class="boka-ab__product-form">
      {% if lp_product != blank %}
        {% form 'product', lp_product, class: 'boka-ab__form', data-type: 'add-to-cart-form' %}
          <input type="hidden" name="id" value="{{ first_variant.id }}">

          <div class="boka-ab__price-line">
            <span>
              <strong class="boka-ab__price">
                {{ first_variant.price | money }}
              </strong>

              {% if first_variant.compare_at_price > first_variant.price %}
                <span class="boka-ab__compare">
                  {{ first_variant.compare_at_price | money }}
                </span>
              {% endif %}
            </span>

            <span class="boka-ab__muted">
              {{ section.settings.price_note }}
            </span>
          </div>

          {% if lp_product.variants.size > 1 %}
            <div class="boka-ab__form-row">
              <select class="boka-ab__select" name="id" aria-label="Choose product option">
                {% for variant in lp_product.variants %}
                  <option
                    value="{{ variant.id }}"
                    {% if variant == first_variant %}selected{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {{ variant.title }} — {{ variant.price | money }}
                  </option>
                {% endfor %}
              </select>

              <input class="boka-ab__quantity" type="number" name="quantity" value="1" min="1" aria-label="Quantity">
            </div>
          {% else %}
            <input class="boka-ab__quantity" type="hidden" name="quantity" value="1">
          {% endif %}

          {% if has_selling_plans and section.settings.show_selling_plan_select %}
            <select class="boka-ab__select" name="selling_plan" aria-label="Delivery frequency">
              <option value="">One-time purchase</option>
              {% for group in lp_product.selling_plan_groups %}
                {% for plan in group.selling_plans %}
                  <option value="{{ plan.id }}">{{ plan.name }}</option>
                {% endfor %}
              {% endfor %}
            </select>
          {% endif %}

          <button
            type="submit"
            class="boka-ab__atc"
            {% unless first_variant.available %}disabled{% endunless %}
          >
            {% if first_variant.available %}
              {{ section.settings.cta_text }}
            {% else %}
              Sold out
            {% endif %}
          </button>

          <p class="boka-ab__microcopy">
            {{ section.settings.microcopy }}
          </p>
        {% endform %}
      {% else %}
        <div class="boka-ab__soft-card">
          <p>Select a product in the section settings to activate checkout.</p>
        </div>
      {% endif %}
    </div>
  {% endcapture %}

  {% case variation %}

    {% when 'science_split' %}
      <div class="boka-ab__hero-v1">
        {{ product_media }}

        <div class="boka-ab__hero-v1-card boka-ab__glass">
          <p class="boka-ab__eyebrow">Daily oral care, naturally elevated</p>

          <h1 class="boka-ab__title">
            Science-backed care for a healthier-feeling <em>smile</em>.
          </h1>

          <p class="boka-ab__subtitle">
            Start a feel-good routine with Boka n-Ha Toothpaste and the everyday essentials designed to keep your mouth fresh, balanced, and feeling its best.
          </p>

          <div class="boka-ab__pill-row">
            <span class="boka-ab__pill">Fluoride-free</span>
            <span class="boka-ab__pill">Made with n-Ha</span>
            <span class="boka-ab__pill boka-ab__pill--dark">Starter offer</span>
          </div>

          <ul class="boka-ab__list">
            <li>n-Ha helps support enamel health as part of your daily routine.</li>
            <li>Clean, fresh formulas made without SLS or artificial flavors.</li>
            <li>Thoughtfully designed oral care you’ll want to use every day.</li>
          </ul>

          {{ product_form }}
        </div>
      </div>

    {% when 'editorial_elevated' %}
      <div class="boka-ab__hero-v2">
        <div class="boka-ab__hero-v2-inner">
          <div class="boka-ab__hero-v2-copy">
            <p class="boka-ab__eyebrow">The 2-minute upgrade</p>

            <h1 class="boka-ab__title">
              Oral care you’ll actually want to leave on the <em>counter</em>.
            </h1>

            <p class="boka-ab__subtitle">
              Boka blends science and nature into a cleaner, calmer daily routine — because fresh breath and healthy smiles should feel good, too.
            </p>

            <div class="boka-ab__pill-row">
              <span class="boka-ab__pill">Bright, airy, shelf-ready</span>
              <span class="boka-ab__pill">Feel-good formula</span>
            </div>

            <a class="boka-ab__button" href="#boka-ab-buy-{{ section.id }}" style="max-width: 320px;">
              Build my starter kit
            </a>
          </div>

          <div class="boka-ab__hero-v2-product boka-ab__glass">
            {{ product_media }}
          </div>
        </div>

        <div class="boka-ab__floating-note boka-ab__glass">
          <strong>Made for your daily ritual.</strong>
          <span>n-Ha toothpaste, brush, floss, and tongue cleaner come together for a simple routine that feels elevated from start to finish.</span>
        </div>
      </div>

      <div style="max-width: 560px; margin: -44px auto 60px; padding: 0 5%;">
        {{ product_form }}
      </div>

    {% when 'guided_routine' %}
      <div class="boka-ab__hero-v3">
        <div class="boka-ab__quiz">
          <p class="boka-ab__eyebrow">Choose your focus</p>

          <h1 class="boka-ab__title">
            Let’s make oral care feel less like a chore.
          </h1>

          <p class="boka-ab__subtitle">
            Pick your daily goal, then start with the Boka essentials that support your smile and your whole-body routine.
          </p>

          <button class="boka-ab__quiz-option is-active" type="button" data-boka-quiz="fresh">
            <strong>Fresh, balanced, everyday care</strong>
            <span>For a simple morning-and-night routine with n-Ha toothpaste and daily essentials.</span>
          </button>

          <button class="boka-ab__quiz-option" type="button" data-boka-quiz="bright">
            <strong>A brighter smile, the gentle way</strong>
            <span>For shoppers who want a cleaner, polished feeling without harsh messaging.</span>
          </button>

          <button class="boka-ab__quiz-option" type="button" data-boka-quiz="family">
            <strong>Easy care for the whole household</strong>
            <span>For routines that need to feel safe, reliable, and simple to repeat.</span>
          </button>
        </div>

        <div class="boka-ab__routine-card boka-ab__glass">
          <p class="boka-ab__eyebrow">Your starter routine</p>

          <h2 class="boka-ab__section-title" style="margin-bottom: 14px;">
            n-Ha care, clean tools, and a fresh start.
          </h2>

          <p class="boka-ab__section-copy">
            We designed this kit to make daily oral care feel more mindful, more elevated, and easier to keep up with.
          </p>

          <ul class="boka-ab__list">
            <li>Brush with n-Ha toothpaste morning and night.</li>
            <li>Use floss and the tongue cleaner to round out your routine.</li>
            <li>Subscribe for easy refills, or keep it one-time.</li>
          </ul>

          <div class="boka-ab__routine-image">
            {{ product_media }}
          </div>

          {{ product_form }}
        </div>
      </div>

    {% when 'subscription_value' %}
      <div class="boka-ab__hero-v4">
        <div class="boka-ab__hero-v4-inner">
          <div class="boka-ab__offer-panel">
            <p class="boka-ab__eyebrow">Starter offer</p>

            <h1 class="boka-ab__title">
              Your everyday smile routine, ready when you are.
            </h1>

            <p class="boka-ab__subtitle">
              Get the Boka Starter Kit first, then keep your routine going with simple refills. No overthinking. No bathroom clutter. Just care that feels good.
            </p>

            <div class="boka-ab__value-stack">
              <div class="boka-ab__value-row">
                <span>Starter kit value</span>
                <strong>{{ section.settings.value_price }}</strong>
              </div>

              <div class="boka-ab__value-row">
                <span>Today’s first order</span>
                <strong>{{ section.settings.offer_price }}</strong>
              </div>

              <div class="boka-ab__value-row">
                <span>Shipping</span>
                <strong>{{ section.settings.shipping_text }}</strong>
              </div>

              <div class="boka-ab__value-row">
                <span>Refills</span>
                <strong>Easy to manage</strong>
              </div>
            </div>

            <ul class="boka-ab__list">
              <li>Science-backed ingredients for daily oral wellness.</li>
              <li>Premium tools designed to live beautifully on your shelf.</li>
              <li>Simple refill timing to support consistency.</li>
            </ul>
          </div>

          <div class="boka-ab__checkout-card boka-ab__glass">
            {{ product_media }}
            {{ product_form }}
          </div>
        </div>
      </div>

    {% when 'ingredient_proof' %}
      <div class="boka-ab__hero-v5">
        <div class="boka-ab__hero-v5-inner">
          <div>
            {{ product_media }}
          </div>

          <div class="boka-ab__ingredient-panel">
            <p class="boka-ab__eyebrow">Powered by n-Ha</p>

            <h1 class="boka-ab__title">
              A smarter clean starts with your <em>enamel</em>.
            </h1>

            <p class="boka-ab__subtitle">
              Boka’s fluoride-free n-Ha toothpaste is designed for everyday enamel care, with feel-good formulas that make your routine fresh, balanced, and easy to love.
            </p>

            <div class="boka-ab__ingredient-cards">
              <div class="boka-ab__ingredient-card">
                <strong>n-Ha</strong>
                <span>A form of calcium that supports the primary foundation of teeth and enamel.</span>
              </div>

              <div class="boka-ab__ingredient-card">
                <strong>Clean feel</strong>
                <span>Fresh, low-foam formulas made without SLS or artificial flavors.</span>
              </div>

              <div class="boka-ab__ingredient-card">
                <strong>Daily wellness</strong>
                <span>Oral care that supports your smile and fits into your larger routine.</span>
              </div>

              <div class="boka-ab__ingredient-card">
                <strong>Elevated design</strong>
                <span>Minimal, premium essentials made for the bathroom counter.</span>
              </div>
            </div>

            {{ product_form }}
          </div>
        </div>
      </div>

  {% endcase %}

  <section id="boka-ab-science-{{ section.id }}" class="boka-ab__section">
    <div class="boka-ab__wrap">
      <p class="boka-ab__eyebrow">Science meets nature</p>

      <h2 class="boka-ab__section-title">
        We make oral care feel good without making the science feel complicated.
      </h2>

      <p class="boka-ab__section-copy">
        Boka lives at the intersection of effective ingredients, daily wellness, and a more elevated routine. We keep the language clear, the formulas thoughtful, and the experience easy to repeat.
      </p>

      <div class="boka-ab__proof-grid">
        <div class="boka-ab__proof-card boka-ab__soft-card">
          <strong>n-Ha toothpaste</strong>
          <p>Made with nano-hydroxyapatite, a science-backed ingredient used to support everyday enamel care.</p>
        </div>

        <div class="boka-ab__proof-card boka-ab__soft-card">
          <strong>Fluoride-free alternative</strong>
          <p>For people who prefer a different daily oral care option, without demonizing conventional care.</p>
        </div>

        <div class="boka-ab__proof-card boka-ab__soft-card">
          <strong>Designed for consistency</strong>
          <p>Premium essentials that make your twice-daily routine feel cleaner, calmer, and easier to keep.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="boka-ab-routine-{{ section.id }}" class="boka-ab__section" style="background: var(--boka-blush-light);">
    <div class="boka-ab__wrap">
      <p class="boka-ab__eyebrow">How it fits your day</p>

      <h2 class="boka-ab__section-title">
        A simple routine, naturally elevated.
      </h2>

      <p class="boka-ab__section-copy">
        Brush, floss, clean your tongue, and keep going. We designed the kit to make those small daily moments feel a little more thoughtful.
      </p>

      <div class="boka-ab__proof-grid">
        <div class="boka-ab__proof-card boka-ab__soft-card">
          <strong>Morning</strong>
          <p>Start fresh with n-Ha toothpaste and tools that feel clean without feeling clinical.</p>
        </div>

        <div class="boka-ab__proof-card boka-ab__soft-card">
          <strong>Evening</strong>
          <p>End the day with the same simple steps, because consistency is where the routine works hardest.</p>
        </div>

        <div class="boka-ab__proof-card boka-ab__soft-card">
          <strong>Refill</strong>
          <p>Keep your essentials coming on a schedule that fits your household.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="boka-ab__footer-cta">
    <div class="boka-ab__footer-cta-inner">
      <p class="boka-ab__eyebrow">Ready to start?</p>

      <h2 class="boka-ab__section-title" style="margin: 0;">
        Your healthier-feeling smile starts with two minutes.
      </h2>

      <a class="boka-ab__button" href="#boka-ab-buy-{{ section.id }}">
        {{ section.settings.cta_text }}
      </a>
    </div>
  </section>

  <script>
    (() => {
      const section = document.getElementById('boka-ab-lp-{{ section.id }}');
      if (!section) return;

      const quizButtons = section.querySelectorAll('[data-boka-quiz]');
      quizButtons.forEach((button) => {
        button.addEventListener('click', () => {
          quizButtons.forEach((item) => item.classList.remove('is-active'));
          button.classList.add('is-active');
        });
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Boka A/B Landing Mockups",
  "settings": [
    {
      "type": "select",
      "id": "variation",
      "label": "A/B variation",
      "default": "science_split",
      "options": [
        {
          "value": "science_split",
          "label": "Variation 1 — Science split"
        },
        {
          "value": "editorial_elevated",
          "label": "Variation 2 — Editorial elevated"
        },
        {
          "value": "guided_routine",
          "label": "Variation 3 — Guided routine"
        },
        {
          "value": "subscription_value",
          "label": "Variation 4 — Subscription value"
        },
        {
          "value": "ingredient_proof",
          "label": "Variation 5 — Ingredient proof"
        }
      ]
    },
    {
      "type": "product",
      "id": "product",
      "label": "Landing page product"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image override"
    },
    {
      "type": "select",
      "id": "product_image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "hide_theme_header",
      "label": "Hide theme header",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_topbar",
      "label": "Show topbar",
      "default": true
    },
    {
      "type": "text",
      "id": "topbar_text",
      "label": "Topbar text",
      "default": "Starter offer: build a better daily oral care routine"
    },
    {
      "type": "checkbox",
      "id": "show_nav",
      "label": "Show landing nav",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Start my routine"
