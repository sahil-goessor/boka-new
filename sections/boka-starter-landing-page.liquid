    { "type": "text", "id": "subscription_feature_2", "label": "Subscription feature 2", "default": "Pause, skip, or cancel anytime" },
    { "type": "text", "id": "subscription_feature_3", "label": "Subscription feature 3", "default": "Never run out of the essentials" },
