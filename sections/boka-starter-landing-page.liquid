{% liquid
  assign lp_product = section.settings.product
  assign first_variant = lp_product.selected_or_first_available_variant
  assign has_selling_plans = false

  if lp_product != blank and lp_product.selling_plan_groups.size > 0
    assign has_selling_plans = true
  endif
%}

<section id="boka-starter-lp-{{ section.id }}" class="boka-lp" data-section-id="{{ section.id }}">
  <style>
    {% if section.settings.hide_theme_header %}
  body:has(#boka-starter-lp-{{ section.id }}) .shopify-section-group-header-group,
  body:has(#boka-starter-lp-{{ section.id }}) #shopify-section-header,
  body:has(#boka-starter-lp-{{ section.id }}) .header-wrapper:not(.landing-header-wrapper),
  body:has(#boka-starter-lp-{{ section.id }}) .announcement-bar,
  body:has(#boka-starter-lp-{{ section.id }}) .utility-bar {
    display: none !important;
  }

  body {
    padding-top: 0 !important;
  }
{% endif %}
    #boka-starter-lp-{{ section.id }} {
      --boka-green-light: {{ section.settings.green_light | default: '#e6f4d4' }};
      --boka-green: {{ section.settings.green | default: '#d3e7c0' }};
      --boka-green-mid: #bfd6a5;
      --boka-green-deep: #a5be8b;
      --boka-olive: #737c5b;
      --boka-blush-light: {{ section.settings.blush_light | default: '#f9e5db' }};
      --boka-blush: #efd5ca;
      --boka-clay: #aa7a6b;
      --boka-cream: {{ section.settings.cream | default: '#fafaf5' }};
      --boka-stone: #e2e2d9;
      --boka-taupe: #d1bebc;
      --boka-gray: #8c8773;
      --boka-charcoal: #222721;
      --boka-white: #ffffff;
      --boka-radius: 16px;
      --boka-radius-lg: 22px;
      --boka-shadow: none;
      --boka-border-strong: 2px solid var(--boka-charcoal);
      background: linear-gradient(180deg, var(--boka-cream) 0%, #fff 46%, var(--boka-cream) 100%);
      color: var(--boka-charcoal);
      font-family: "Neue Haas Unica W1G", Helvetica, Arial, sans-serif;
      line-height: 1.5;
      overflow: clip;
    }

    #boka-starter-lp-{{ section.id }} *,
    #boka-starter-lp-{{ section.id }} *::before,
    #boka-starter-lp-{{ section.id }} *::after { box-sizing: border-box; }

    #boka-starter-lp-{{ section.id }} button,
    #boka-starter-lp-{{ section.id }} input,
    #boka-starter-lp-{{ section.id }} select { font: inherit; }

    #boka-starter-lp-{{ section.id }} a { color: inherit; }
    #boka-starter-lp-{{ section.id }} em { font-family: "Ivar Display Italic", "Times New Roman", serif; font-style: italic; font-weight: 400; letter-spacing: -.02em; }
    #boka-starter-lp-{{ section.id }} p { margin: 0; }

    #boka-starter-lp-{{ section.id }} .boka-lp__topbar {
      position: sticky;
      top: 0;
      z-index: 20;
      background: var(--boka-green-light);
      color: var(--boka-charcoal);
      border-bottom: 1px solid var(--boka-green-mid);
      text-align: center;
      padding: 10px 16px;
      font-size: 13px;
      font-weight: 900;
      letter-spacing: .02em;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__topbar a {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__nav {
      background: rgba(250,250,245,.96);
      border-bottom: 2px solid var(--boka-charcoal);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      position: sticky;
      top: {% if section.settings.show_announcement %}39px{% else %}0{% endif %};
      z-index: 19;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__nav-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 12px 4%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__logo {
      text-decoration: none;
      font-size: 22px;
      letter-spacing: .22em;
      font-weight: 400;
      line-height: 1;
      text-transform: uppercase;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__nav-links {
      display: flex;
      align-items: center;
      gap: 24px;
      color: var(--boka-gray);
      font-size: 13px;
      font-weight: 700;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__nav-links a { text-decoration: none; }

    #boka-starter-lp-{{ section.id }} .boka-lp__nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__nav-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 0;
      background: var(--boka-charcoal);
      color: var(--boka-cream);
      min-height: 40px;
      padding: 0 18px;
      text-decoration: none;
      font-family: "Ivar Display", "Times New Roman", serif;
      font-size: 14px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0;
      white-space: nowrap;
      border: 2px solid var(--boka-charcoal);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__cart-button {
      min-width: 40px;
      min-height: 40px;
      border: 2px solid var(--boka-charcoal);
      border-radius: 0;
      background: var(--boka-cream);
      color: var(--boka-charcoal);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 0 12px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 900;
      line-height: 1;
      white-space: nowrap;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__cart-icon {
      width: 17px;
      height: 17px;
      display: inline-block;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__cart-count {
      min-width: 18px;
      height: 18px;
      border-radius: 999px;
      background: var(--boka-green-light);
      color: var(--boka-charcoal);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 5px;
      font-size: 11px;
      font-weight: 900;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__hero {
      max-width: 1400px;
      margin: 0 auto;
      padding: {{ section.settings.padding_top | default: 34 }}px 4% {{ section.settings.padding_bottom | default: 64 }}px;
      display: grid;
      grid-template-columns: minmax(0, 1.06fr) minmax(420px, .94fr);
      gap: 28px;
      align-items: start;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__gallery-wrap {
      position: sticky;
      top: {% if section.settings.show_nav %}110px{% else %}24px{% endif %};
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__gallery-card {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--boka-stone);
      border-radius: var(--boka-radius-lg);
      overflow: hidden;
      box-shadow: var(--boka-shadow);
      display: grid;
      grid-template-columns: 104px minmax(0, 1fr);
      gap: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__main-media {
      position: relative;
      min-height: 590px;
      background: var(--boka-green-light);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__main-media img {
      width: 100%;
      height: 100%;
      min-height: 560px;
      object-fit: cover;
      display: block;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__main-media--contain img {
      object-fit: contain;
      padding: 8%;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__placeholder {
      width: 100%;
      min-height: 560px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--boka-charcoal);
      letter-spacing: .22em;
      font-size: 44px;
      opacity: .25;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__media-badge {
      position: absolute;
      top: 18px;
      left: 18px;
      z-index: 2;
      background: var(--boka-cream);
      border: 1px solid var(--boka-green-mid);
      color: var(--boka-charcoal);
      border-radius: 10px;
      padding: 9px 14px;
      font-size: 11px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
      backdrop-filter: none;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__thumbs {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 12px;
      background: transparent;
      border-right: 1px solid var(--boka-stone);
      border-top: 0;
      max-height: 560px;
      overflow-y: auto;
      order: 1;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__main-media {
      order: 2;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__thumb {
      border: 1.5px solid var(--boka-stone);
      border-radius: 16px;
      background: var(--boka-cream);
      width: 80px;
      min-height: 80px;
      padding: 0;
      cursor: pointer;
      overflow: hidden;
      transition: border-color .2s, transform .2s, box-shadow .2s;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__thumb:hover,
    #boka-starter-lp-{{ section.id }} .boka-lp__thumb.is-active {
      border-color: var(--boka-green-deep);
      transform: translateX(1px);
      box-shadow: 0 0 0 2px var(--boka-green-light);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__thumb img {
      width: 100%;
      height: 80px;
      object-fit: cover;
      display: block;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__thumb-placeholder {
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--boka-gray);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .06em;
      text-align: center;
      text-transform: uppercase;
      padding: 6px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__hero-proof {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
      margin-top: 12px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__proof-card {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 2px solid var(--boka-charcoal);
      border-radius: 14px;
      padding: 14px;
      color: var(--boka-gray);
      font-size: 12px;
      line-height: 1.35;
      font-weight: 700;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__proof-card strong {
      display: block;
      color: var(--boka-charcoal);
      font-size: 13px;
      margin-bottom: 4px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__buybox {
      background: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      overflow: visible;
      display: grid;
      gap: 18px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__intro-card,
    #boka-starter-lp-{{ section.id }} .boka-lp__buybox-inner {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: var(--boka-border-strong);
      border-radius: var(--boka-radius-lg);
      box-shadow: 8px 8px 0 var(--boka-green-mid);
      padding: 28px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__intro-card .boka-lp__benefit-pills {
      margin-bottom: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__intro-card .boka-lp__subtitle {
      margin-bottom: 20px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__rating-row {
      display: flex;
      align-items: center;
      gap: 9px;
      flex-wrap: wrap;
      color: var(--boka-gray);
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 13px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__stars {
      color: var(--boka-olive);
      letter-spacing: .06em;
      font-size: 12px;
      white-space: nowrap;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__eyebrow {
      margin: 0 0 10px;
      color: var(--boka-olive);
      font-size: 12px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__title {
      margin: 0 0 12px;
      color: var(--boka-charcoal);
      font-size: clamp(38px, 4.8vw, 66px);
      line-height: .9;
      letter-spacing: -.065em;
      font-weight: 900;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__title p { margin: 0; }

    #boka-starter-lp-{{ section.id }} .boka-lp__subtitle {
      margin: 0 0 22px;
      color: var(--boka-charcoal);
      font-size: 18px;
      line-height: 1.55;
      font-weight: 650;
      letter-spacing: -.01em;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__benefit-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 22px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      min-height: 34px;
      border: 2px solid var(--boka-charcoal);
      background: var(--boka-green-light);
      color: var(--boka-charcoal);
      border-radius: 10px;
      padding: 7px 11px;
      font-size: 12px;
      line-height: 1;
      font-weight: 900;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__pill::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--boka-olive);
      display: inline-block;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__step {
      padding: 22px 0;
      border-top: 1px solid var(--boka-stone);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__step:first-of-type { border-top: 0; padding-top: 0; }

    #boka-starter-lp-{{ section.id }} .boka-lp__step-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__step-title {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0;
      color: var(--boka-charcoal);
      font-size: 15px;
      line-height: 1.2;
      font-weight: 900;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__step-number {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: var(--boka-charcoal);
      color: var(--boka-cream);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 800;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__step-note {
      color: var(--boka-gray);
      font-size: 12px;
      font-weight: 700;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-card,
    #boka-starter-lp-{{ section.id }} .boka-lp__qty-card,
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-card {
      border: 2px solid var(--boka-charcoal);
      background: var(--boka-cream);
      color: var(--boka-charcoal);
      cursor: pointer;
      transition: background .2s, border-color .2s, transform .2s, box-shadow .2s;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-card {
      position: relative;
      min-height: 74px;
      border-radius: 18px;
      padding: 14px 15px;
      text-align: left;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-card:hover:not([disabled]),
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-card:hover:not([disabled]) {
      transform: translateY(-1px);
      border-color: var(--boka-green-deep);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-card.is-active,
    #boka-starter-lp-{{ section.id }} .boka-lp__qty-card.is-active,
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-card.is-active {
      background: var(--boka-green-light);
      border-color: var(--boka-charcoal);
      box-shadow: 4px 4px 0 var(--boka-green-mid);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-card[disabled],
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-card[disabled] {
      opacity: .45;
      cursor: not-allowed;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-title {
      display: block;
      margin-bottom: 5px;
      color: var(--boka-charcoal);
      font-size: 14px;
      line-height: 1.2;
      font-weight: 900;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-sub {
      display: block;
      color: var(--boka-gray);
      font-size: 12px;
      line-height: 1.35;
      font-weight: 650;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__quantity-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__qty-card {
      border-radius: 16px;
      min-height: 56px;
      padding: 10px;
      font-size: 13px;
      font-weight: 900;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-fallback {
      display: grid;
      gap: 10px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-card {
  position: relative;
  width: 100%;
  border-radius: 18px;
  padding: 17px;
  text-align: left;
}

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-badge {
      position: absolute;
      top: 0;
      right: 0;
      background: var(--boka-charcoal);
      color: var(--boka-cream);
      border-radius: 0 14px 0 12px;
      padding: 7px 12px;
      font-size: 10px;
      line-height: 1;
      letter-spacing: .08em;
      text-transform: uppercase;
      font-weight: 900;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-head {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
      padding-right: 0;
      margin-bottom: 12px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-head > span:last-child {
      display: flex;
      align-items: baseline;
      gap: 8px;
      flex-wrap: wrap;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-card.has-badge {
      padding-top: 56px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-card:not(.has-badge) .boka-lp__plan-head { padding-right: 0; }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-title {
      font-size: 15px;
      line-height: 1.25;
      font-weight: 900;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__price {
      font-size: 18px;
      line-height: 1.1;
      font-weight: 900;
      white-space: nowrap;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__compare-price {
      margin-left: 6px;
      color: var(--boka-gray);
      font-size: 13px;
      text-decoration: line-through;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-note {
      display: block;
      color: var(--boka-gray);
      font-size: 13px;
      line-height: 1.4;
      font-weight: 650;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-features {
      list-style: none;
      padding: 10px 0 0;
      margin: 0;
      display: grid;
      gap: 4px;
      color: var(--boka-gray);
      font-size: 12px;
      font-weight: 650;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__plan-features li::before {
      content: '✓';
      color: var(--boka-olive);
      font-weight: 900;
      margin-right: 6px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__frequency-wrap { margin-top: 10px; }

    #boka-starter-lp-{{ section.id }} .boka-lp__select {
      width: 100%;
      min-height: 48px;
      border: 1.5px solid var(--boka-stone);
      background: var(--boka-white);
      color: var(--boka-charcoal);
      border-radius: 999px;
      padding: 12px 16px;
      font-size: 14px;
      font-weight: 700;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__atc {
      width: 100%;
      min-height: 58px;
      border: 2px solid var(--boka-charcoal);
      border-radius: 0;
      background: var(--boka-charcoal);
      color: var(--boka-cream);
      padding: 17px 24px;
      cursor: pointer;
      font-family: "Ivar Display", "Times New Roman", serif;
      font-size: 16px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: 0;
      text-transform: uppercase;
      transition: background .2s, transform .15s, box-shadow .2s;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__atc:hover:not([disabled]) {
      background: #000;
      transform: translateY(-1px);
      box-shadow: 4px 4px 0 var(--boka-green-mid);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__atc[disabled] { opacity: .55; cursor: not-allowed; }

    #boka-starter-lp-{{ section.id }} .boka-lp__message {
      min-height: 20px;
      margin-top: 10px;
      text-align: center;
