{% liquid
  assign lp_product = section.settings.product
  assign first_variant = lp_product.selected_or_first_available_variant
  assign has_selling_plans = false

  if lp_product != blank and lp_product.selling_plan_groups.size > 0
    assign has_selling_plans = true
  endif
%}

<section id="boka-starter-lp-{{ section.id }}" class="boka-lp" data-section-id="{{ section.id }}">
  <style>
    {% if section.settings.hide_theme_header %}
      body:has(#boka-starter-lp-{{ section.id }}) .shopify-section-group-header-group,
      body:has(#boka-starter-lp-{{ section.id }}) #shopify-section-header,
      body:has(#boka-starter-lp-{{ section.id }}) .header-wrapper:not(.landing-header-wrapper),
      body:has(#boka-starter-lp-{{ section.id }}) .announcement-bar,
      body:has(#boka-starter-lp-{{ section.id }}) .utility-bar {
        display: none !important;
      }

      body:has(#boka-starter-lp-{{ section.id }}) {
        padding-top: 0 !important;
      }
    {% endif %}


    #boka-starter-lp-{{ section.id }} {
      --boka-green-light: {{ section.settings.green_light | default: '#e6f4d4' }};
      --boka-green: {{ section.settings.green | default: '#d3e7c0' }};
      --boka-green-mid: #bfd6a5;
      --boka-green-deep: #a5be8b;
      --boka-olive: #737c5b;
      --boka-blush-light: {{ section.settings.blush_light | default: '#f9e5db' }};
      --boka-blush: #efd5ca;
      --boka-clay: #aa7a6b;
      --boka-cream: {{ section.settings.cream | default: '#fafaf5' }};
      --boka-stone: #e2e2d9;
      --boka-taupe: #d1bebc;
      --boka-gray: #8c8773;
      --boka-charcoal: #222721;
      --boka-white: #ffffff;
      --boka-hero-green: #dfeccf;

      --boka-border-soft: 1px solid var(--boka-stone);
      --boka-border-medium: 1.5px solid var(--boka-charcoal);
      --boka-surface: rgba(255, 255, 255, .92);
      --boka-surface-cream: rgba(250, 250, 245, .92);
      --boka-shadow-soft: 0 1px 0 rgba(34, 39, 33, .04);
      --boka-shadow-card: 5px 5px 0 var(--boka-green-mid);

      color: var(--boka-charcoal);
      background: linear-gradient(180deg, var(--boka-cream) 0%, var(--boka-white) 48%, var(--boka-cream) 100%);
      font-family: "Neue Haas Unica W1G", Helvetica, Arial, sans-serif;
      line-height: 1.5;
      overflow: clip;
    }

    #boka-starter-lp-{{ section.id }} *,
    #boka-starter-lp-{{ section.id }} *::before,
    #boka-starter-lp-{{ section.id }} *::after {
      box-sizing: border-box;
    }

    #boka-starter-lp-{{ section.id }} button,
    #boka-starter-lp-{{ section.id }} input,
    #boka-starter-lp-{{ section.id }} select {
      font: inherit;
    }

    #boka-starter-lp-{{ section.id }} p,
    #boka-starter-lp-{{ section.id }} h1,
    #boka-starter-lp-{{ section.id }} h2,
    #boka-starter-lp-{{ section.id }} h3 {
      margin: 0;
    }

    #boka-starter-lp-{{ section.id }} a {
      color: inherit;
    }

    #boka-starter-lp-{{ section.id }} em {
      font-family: "Ivar Display Italic", "Times New Roman", serif;
      font-style: italic;
      font-weight: 400;
      letter-spacing: -.02em;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__topbar {
      position: sticky;
      top: 0;
      z-index: 20;
      background: var(--boka-green-light);
      color: var(--boka-charcoal);
      border-bottom: 1px solid var(--boka-green-mid);
      text-align: center;
      padding: 10px 16px;
      font-size: 12px;
      line-height: 1.3;
      font-weight: 850;
      letter-spacing: .04em;
      text-transform: uppercase;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__topbar a {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__nav {
      position: sticky;
      top: {% if section.settings.show_announcement %}39px{% else %}0{% endif %};
      z-index: 19;
      background: rgba(250, 250, 245, .95);
      border-bottom: 1px solid var(--boka-stone);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__nav-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 12px 4%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__logo {
      text-decoration: none;
      font-size: 22px;
      line-height: 1;
      letter-spacing: .22em;
      font-weight: 400;
      text-transform: uppercase;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__nav-links,
    #boka-starter-lp-{{ section.id }} .boka-lp__nav-actions {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__nav-links {
      color: var(--boka-gray);
      font-size: 13px;
      font-weight: 700;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__nav-links a {
      text-decoration: none;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__nav-cta,
    #boka-starter-lp-{{ section.id }} .boka-lp__bottom-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: 0 20px;
      border-radius: 999px;
      border: var(--boka-border-medium);
      background: var(--boka-charcoal);
      color: var(--boka-cream);
      text-decoration: none;
      font-size: 12px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: .04em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__cart-button {
      min-width: 40px;
      min-height: 40px;
      border: 1px solid var(--boka-stone);
      border-radius: 999px;
      background: var(--boka-white);
      color: var(--boka-charcoal);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 0 12px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 900;
      line-height: 1;
      white-space: nowrap;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__cart-icon {
      width: 17px;
      height: 17px;
      display: inline-block;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__cart-count {
      min-width: 18px;
      height: 18px;
      border-radius: 999px;
      background: var(--boka-green-light);
      color: var(--boka-charcoal);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 5px;
      font-size: 11px;
      font-weight: 900;
    }

    /* Main hero grid */
    #boka-starter-lp-{{ section.id }} .boka-lp__hero {
      max-width: 1400px;
      margin: 0 auto;
      padding: {{ section.settings.padding_top | default: 34 }}px 4% {{ section.settings.padding_bottom | default: 64 }}px;
      display: grid;
      grid-template-columns: minmax(0, 1.06fr) minmax(420px, .94fr);
      gap: 28px;
      align-items: start;
    }

    /* Two-column promo banner */
    #boka-starter-lp-{{ section.id }} .boka-lp__promo-heading,
    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner {
      grid-column: 1 / -1;
      width: 100vw;
      max-width: none;
      margin: 0 calc(50% - 50vw);
      padding: clamp(54px, 7vw, 96px) 6%;
      min-height: clamp(600px, 52vw, 760px);
      display: grid;
      grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
      align-items: center;
      gap: clamp(28px, 5vw, 86px);
      background:
        radial-gradient(circle at 78% 46%, rgba(255, 255, 255, .32) 0%, rgba(255, 255, 255, 0) 38%),
        linear-gradient(90deg, #dfeccf 0%, #dfeccf 48%, #dbe8ca 100%);
      overflow: hidden;
      text-align: left;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-content {
      order: 1;
      width: 100%;
      max-width: 620px;
      margin: 0;
      padding: 0;
      text-align: left;
      background: transparent;
      position: relative;
      z-index: 2;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-image-wrap {
      order: 2;
      width: 100%;
      height: clamp(520px, 48vw, 760px);
      background: transparent;
      overflow: visible;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      position: relative;
      z-index: 1;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-image {
      width: auto;
      height: 100%;
      max-width: none;
      object-fit: contain;
      object-position: center right;
      display: block;
      opacity: .86;
      mix-blend-mode: multiply;
      filter: saturate(.94) contrast(.98);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__promo-eyebrow {
      margin: 0 0 14px;
      color: var(--boka-olive);
      font-size: 12px;
      line-height: 1.2;
      font-weight: 900;
      letter-spacing: .13em;
      text-transform: uppercase;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner h2,
    #boka-starter-lp-{{ section.id }} .boka-lp__promo-heading h2 {
      color: var(--boka-charcoal);
      font-size: clamp(48px, 6vw, 88px);
      line-height: .88;
      letter-spacing: -.07em;
      font-weight: 900;
      max-width: 10ch;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-content > p:last-of-type {
      margin: 20px 0 0;
      max-width: 520px;
      color: var(--boka-charcoal);
      font-size: 15px;
      line-height: 1.45;
      font-weight: 800;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 54px;
      margin-top: 28px;
      padding: 0 30px;
      border-radius: 999px;
      background: var(--boka-charcoal);
      color: var(--boka-cream);
      border: var(--boka-border-medium);
      text-decoration: none;
      font-size: 13px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: .04em;
      text-transform: uppercase;
      transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__promo-banner-button:hover {
      background: #111;
      transform: translateY(-1px);
      box-shadow: var(--boka-shadow-card);
    }

    /* Full bleed proof/included area */
    #boka-starter-lp-{{ section.id }} .boka-lp__hero-full-bleed {
      grid-column: 1 / -1;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
      display: grid;
      gap: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__hero-full-bleed .boka-lp__proof-bar-section {
      width: 100%;
      padding: 34px 4% 28px;
      background: var(--boka-white);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__hero-full-bleed .boka-lp__proof-bar,
    #boka-starter-lp-{{ section.id }} .boka-lp__hero-full-bleed .boka-lp__included-desktop,
    #boka-starter-lp-{{ section.id }} .boka-lp__hero-full-bleed .boka-lp__included-desktop .boka-lp__wrap {
      width: 100%;
      max-width: none;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__hero-full-bleed .boka-lp__included-desktop {
      padding: 54px 4%;
    }

    /* Gallery */
    #boka-starter-lp-{{ section.id }} .boka-lp__gallery-wrap {
      position: sticky;
      top: {% if section.settings.show_nav %}110px{% else %}24px{% endif %};
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__gallery-card {
      background: var(--boka-surface);
      border: var(--boka-border-soft);
      border-radius: 30px;
      overflow: hidden;
      padding: 18px;
      display: grid;
      grid-template-columns: 104px minmax(0, 1fr);
      gap: 0;
      box-shadow: var(--boka-shadow-soft);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__main-media {
      position: relative;
      min-height: 590px;
      background: var(--boka-white);
      border-radius: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      order: 2;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__main-media img {
      width: 100%;
      height: 100%;
      min-height: 560px;
      object-fit: cover;
      display: block;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__main-media--contain img {
      object-fit: contain;
      padding: 8%;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__placeholder {
      width: 100%;
      min-height: 560px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--boka-charcoal);
      letter-spacing: .22em;
      font-size: 44px;
      opacity: .25;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__media-badge {
      position: absolute;
      top: 14px;
      left: 14px;
      z-index: 2;
      background: var(--boka-cream);
      border: 1px solid var(--boka-green-mid);
      color: var(--boka-charcoal);
      border-radius: 999px;
      padding: 8px 12px;
      font-size: 10px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__thumbs {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 12px;
      background: transparent;
      border-right: 1px solid var(--boka-stone);
      max-height: 560px;
      overflow-y: auto;
      order: 1;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__thumb {
      width: 80px;
      min-height: 80px;
      border: 1px solid var(--boka-stone);
      border-radius: 16px;
      background: var(--boka-white);
      padding: 0;
      cursor: pointer;
      overflow: hidden;
      transition: border-color .2s, transform .2s, box-shadow .2s;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__thumb:hover,
    #boka-starter-lp-{{ section.id }} .boka-lp__thumb.is-active {
      border-color: var(--boka-green-deep);
      transform: translateX(1px);
      box-shadow: 0 0 0 2px var(--boka-green-light);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__thumb img,
    #boka-starter-lp-{{ section.id }} .boka-lp__thumb-placeholder {
      width: 100%;
      height: 80px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__thumb img {
      object-fit: cover;
      display: block;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__thumb-placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--boka-gray);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .06em;
      text-align: center;
      text-transform: uppercase;
      padding: 6px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__guarantees {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-top: 14px;
      background: var(--boka-surface-cream);
      border: var(--boka-border-soft);
      border-radius: 16px;
      overflow: hidden;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__guarantees div {
      min-height: 54px;
      padding: 12px 10px;
      border-right: 1px solid var(--boka-stone);
      text-align: center;
      color: var(--boka-charcoal);
      font-size: 11px;
      line-height: 1.25;
      font-weight: 850;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__guarantees div:last-child {
      border-right: 0;
    }

    /* Buy box / intro */
    #boka-starter-lp-{{ section.id }} .boka-lp__buybox {
      display: grid;
      gap: 18px;
      background: transparent;
      border: 0;
      overflow: visible;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__intro-card {
      background: transparent;
      padding: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__rating-row {
      display: flex;
      align-items: center;
      gap: 9px;
      flex-wrap: wrap;
      color: var(--boka-charcoal);
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 13px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__stars {
      color: var(--boka-green-deep);
      letter-spacing: .06em;
      font-size: 12px;
      white-space: nowrap;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__eyebrow {
      margin: 0 0 10px;
      color: var(--boka-olive);
      font-size: 12px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__product-summary-card,
    #boka-starter-lp-{{ section.id }} .boka-lp__buybox-inner {
      background: var(--boka-surface);
      border: var(--boka-border-soft);
      border-radius: 26px;
      padding: 28px;
      box-shadow: var(--boka-shadow-soft);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__product-summary-card {
      margin-top: 14px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__product-title {
      color: var(--boka-charcoal);
      font-size: clamp(30px, 4vw, 44px);
      line-height: .98;
      letter-spacing: -.055em;
      font-weight: 900;
      max-width: 12ch;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__product-title p {
      margin: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__product-description,
    #boka-starter-lp-{{ section.id }} .boka-lp__subtitle {
      margin-top: 18px;
      max-width: 560px;
      color: var(--boka-charcoal);
      font-size: 16px;
      line-height: 1.58;
      font-weight: 650;
      letter-spacing: -.01em;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__checklist,
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-features,
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-features_otp,
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-features_opt {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__checklist {
      display: grid;
      gap: 12px;
      margin-top: 20px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__checklist--product {
      padding-top: 20px;
      border-top: 1px solid var(--boka-stone);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__checklist li {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      color: var(--boka-charcoal);
      font-size: 15px;
      line-height: 1.4;
      font-weight: 750;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__checklist li::before {
      content: "✓";
      width: 25px;
      height: 25px;
      border-radius: 50%;
      background: var(--boka-green-light);
      color: var(--boka-charcoal);
      border: 1px solid var(--boka-green-mid);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 25px;
      font-size: 14px;
      font-weight: 900;
      margin-top: -2px;
    }

    /* Form steps */
    #boka-starter-lp-{{ section.id }} .boka-lp__step {
      padding: 24px 0;
      border-top: 1px solid var(--boka-stone);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__step:first-of-type {
      padding-top: 0;
      border-top: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__step-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__step-title {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--boka-charcoal);
      font-size: 21px;
      line-height: 1.2;
      font-weight: 900;
      letter-spacing: -.03em;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__step-number {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: var(--boka-charcoal);
      color: var(--boka-cream);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 26px;
      font-size: 12px;
      font-weight: 800;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-grid,
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-fallback {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-card,
    #boka-starter-lp-{{ section.id }} .boka-lp__qty-card,
    #boka-starter-lp-{{ section.id }} .boka-lp__plan-card {
      border: var(--boka-border-medium);
      background: rgba(255, 255, 255, .88);
      color: var(--boka-charcoal);
      cursor: pointer;
      transition: background .2s, border-color .2s, transform .2s, box-shadow .2s;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__goal-card {
      position: relative;
      min-height: 74px;
      border-radius: 22px;
      padding: 20px 62px 20px 22px;
      text-align: left;
    }

