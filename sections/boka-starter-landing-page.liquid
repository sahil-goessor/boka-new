    {
      "type": "text",
      "id": "offer_price",
      "label": "Variation 4 offer price",
      "default": "$19.99 today"
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Variation 4 shipping text",
      "default": "Free today"
    }
  ],
  "presets": [
    {
      "name": "Boka A/B Landing Mockups"
    }
  ]
}
{% endschema %}