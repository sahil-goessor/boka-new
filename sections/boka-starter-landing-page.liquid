{% comment %}
  Section: Boka Starter Landing Page
  File: sections/boka-starter-landing-page.liquid

  Purpose:
  - Use on a Shopify /page template.
  - Pulls a real Shopify product, variants, prices, images, and selling plans.
  - Adds one-time or subscription items to cart via Shopify Ajax using variant ID and selling_plan.

  Setup:
  - Create this section file.
  - Add it to a page JSON template.
  - In Theme Editor, select your Starter Kit product.
  - Product must have ReCharge / Shopify selling plans for subscription purchase.
{% endcomment %}

{% liquid
  assign lp_product = section.settings.product
  assign first_variant = lp_product.selected_or_first_available_variant
  assign default_selling_plan_id = blank

  if lp_product != blank and lp_product.selling_plan_groups.size > 0
    assign first_group = lp_product.selling_plan_groups | first
    assign first_plan = first_group.selling_plans | first
    assign default_selling_plan_id = first_plan.id
  endif
%}

<section id="boka-starter-lp-{{ section.id }}" class="boka-lp" data-section-id="{{ section.id }}">
  <style>
    #boka-starter-lp-{{ section.id }} {
      --boka-green-light: {{ section.settings.green_light | default: '#e6f4d4' }};
      --boka-green: {{ section.settings.green | default: '#d3e7c0' }};
      --boka-green-mid: #bfd6a5;
      --boka-green-deep: #a5bc8b;
      --boka-olive: #737c5b;
      --boka-blush-light: {{ section.settings.blush_light | default: '#f9e5db' }};
      --boka-blush: #efd5ca;
      --boka-blush-deep: #d1aa9d;
      --boka-clay: #aa7a6b;
      --boka-cream: {{ section.settings.cream | default: '#fafaf5' }};
      --boka-stone: #e2e2d9;
      --boka-taupe: #c1beb0;
      --boka-gray: #8c8773;
      --boka-charcoal: #222721;
      --boka-white: #ffffff;
      --boka-radius: 28px;
      --boka-shadow: 0 18px 50px rgba(34, 39, 33, .06);
      background: var(--boka-cream);
      color: var(--boka-charcoal);
      font-family: Helvetica, Arial, sans-serif;
      line-height: 1.55;
      overflow: hidden;
    }

    #boka-starter-lp-{{ section.id }} * { box-sizing: border-box; }
    #boka-starter-lp-{{ section.id }} button,
    #boka-starter-lp-{{ section.id }} select,
    #boka-starter-lp-{{ section.id }} input { font: inherit; }
    #boka-starter-lp-{{ section.id }} a { color: inherit; }
    #boka-starter-lp-{{ section.id }} em { font-family: Georgia, 'Times New Roman', serif; font-style: italic; font-weight: 400; }

    #boka-starter-lp-{{ section.id }} .boka-lp__announcement {
      background: var(--boka-green);
      color: var(--boka-charcoal);
      text-align: center;
      padding: 10px 16px;
      font-size: 13px;
      font-weight: 700;
      border-bottom: 1px solid var(--boka-green-mid);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__announcement a {
      color: var(--boka-charcoal);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__trust-strip {
      background: var(--boka-cream);
      border-top: 1px solid var(--boka-stone);
      border-bottom: 1px solid var(--boka-stone);
      padding: 13px 5%;
      display: flex;
      justify-content: center;
      gap: 22px 38px;
      flex-wrap: wrap;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__trust-strip span {
      color: var(--boka-gray);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .02em;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__trust-strip span:before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--boka-green-deep);
      display: inline-block;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__hero {
      max-width: 1320px;
      margin: 0 auto;
      padding: {{ section.settings.padding_top | default: 44 }}px 5% {{ section.settings.padding_bottom | default: 72 }}px;
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(400px, .95fr);
      gap: 56px;
      align-items: start;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__gallery {
      position: sticky;
      top: 24px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__image-card {
      position: relative;
      background: linear-gradient(135deg, var(--boka-green-light), var(--boka-cream));
      border: 1px solid var(--boka-stone);
      border-radius: var(--boka-radius);
      overflow: hidden;
      min-height: 560px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--boka-shadow);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__image-card img {
      width: 100%;
      height: 100%;
      min-height: 560px;
      object-fit: cover;
      display: block;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__image-card--contain img {
      object-fit: contain;
      padding: 8%;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__placeholder {
      width: 100%;
      min-height: 560px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--boka-charcoal);
      letter-spacing: .18em;
      font-size: 44px;
      font-weight: 400;
      opacity: .28;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__badge {
      position: absolute;
      top: 18px;
      left: 18px;
      z-index: 2;
      background: rgba(250,250,245,.86);
      border: 1px solid var(--boka-stone);
      color: var(--boka-charcoal);
      border-radius: 999px;
      padding: 8px 14px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .06em;
      text-transform: uppercase;
      backdrop-filter: blur(8px);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__image-note {
      position: absolute;
      left: 22px;
      right: 22px;
      bottom: 22px;
      z-index: 2;
      background: rgba(250,250,245,.88);
      border: 1px solid rgba(226,226,217,.9);
      border-radius: 22px;
      padding: 18px;
      backdrop-filter: blur(10px);
      max-width: 420px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__image-note strong {
      display: block;
      font-size: 15px;
      margin-bottom: 4px;
      color: var(--boka-charcoal);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__image-note p {
      margin: 0;
      color: var(--boka-gray);
      font-size: 13px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__micro-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-top: 12px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__micro-card {
      background: var(--boka-white);
      border: 1px solid var(--boka-stone);
      border-radius: 20px;
      padding: 16px;
      min-height: 104px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__micro-card strong {
      display: block;
      color: var(--boka-charcoal);
      font-size: 13px;
      line-height: 1.2;
      margin-bottom: 6px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__micro-card p {
      margin: 0;
      color: var(--boka-gray);
      font-size: 12px;
      line-height: 1.35;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__buybox {
      background: rgba(250,250,245,.94);
      border: 1px solid var(--boka-stone);
      border-radius: var(--boka-radius);
      padding: 32px;
      box-shadow: var(--boka-shadow);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__eyebrow {
      margin: 0 0 12px;
      color: var(--boka-olive);
      font-size: 12px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__rating {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin: 0 0 16px;
      color: var(--boka-gray);
      font-size: 13px;
      font-weight: 600;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__stars {
      color: var(--boka-olive);
      letter-spacing: .06em;
      font-size: 12px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__title {
      color: var(--boka-charcoal);
      font-size: clamp(34px, 4.2vw, 54px);
      line-height: .98;
      letter-spacing: -.055em;
      margin: 0 0 16px;
      font-weight: 700;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__title em {
      letter-spacing: -.035em;
      font-weight: 400;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__subtitle {
      color: var(--boka-gray);
      font-size: 16px;
      line-height: 1.6;
      margin: 0 0 24px;
      max-width: 520px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__benefit-box {
      background: var(--boka-green-light);
      border: 1px solid var(--boka-green-mid);
      border-radius: 22px;
      padding: 18px;
      margin: 0 0 24px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__benefits {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px 16px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__benefits li {
      display: grid;
      grid-template-columns: 18px 1fr;
      gap: 8px;
      align-items: start;
      color: var(--boka-charcoal);
      font-size: 13px;
      line-height: 1.35;
      font-weight: 600;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__check {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      border: 1.5px solid var(--boka-olive);
      position: relative;
      display: inline-block;
      margin-top: 1px;
      background: rgba(255,255,255,.3);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__check:after {
      content: '';
      position: absolute;
      left: 6px;
      top: 3px;
      width: 5px;
      height: 9px;
      border: solid var(--boka-olive);
      border-width: 0 1.5px 1.5px 0;
      transform: rotate(45deg);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__label {
      display: block;
      margin: 0 0 10px;
      color: var(--boka-gray);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__variant-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin-bottom: 22px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__variant-btn,
    #boka-starter-lp-{{ section.id }} .boka-lp__purchase-card {
      border: 1.5px solid var(--boka-stone);
      background: var(--boka-white);
      color: var(--boka-charcoal);
      border-radius: 18px;
      cursor: pointer;
      text-align: left;
      transition: border-color .2s, background .2s, transform .2s;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__variant-btn {
      padding: 14px 15px;
      min-height: 64px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__variant-btn:hover:not([disabled]),
    #boka-starter-lp-{{ section.id }} .boka-lp__purchase-card:hover:not([disabled]) {
      border-color: var(--boka-green-deep);
      transform: translateY(-1px);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__variant-btn.is-active,
    #boka-starter-lp-{{ section.id }} .boka-lp__purchase-card.is-active {
      border-color: var(--boka-green-deep);
      background: var(--boka-green-light);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__variant-btn[disabled] {
      opacity: .45;
      cursor: not-allowed;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__variant-title {
      display: block;
      color: var(--boka-charcoal);
      font-size: 14px;
      line-height: 1.2;
      font-weight: 800;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__variant-sub {
      display: block;
      margin-top: 5px;
      color: var(--boka-gray);
      font-size: 12px;
      line-height: 1.3;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__purchase-options {
      display: grid;
      gap: 10px;
      margin-bottom: 18px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__purchase-card {
      position: relative;
      padding: 18px;
      width: 100%;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__popular {
      position: absolute;
      top: 0;
      right: 0;
      background: var(--boka-charcoal);
      color: var(--boka-cream);
      padding: 6px 14px;
      border-radius: 0 16px 0 14px;
      font-size: 10px;
      line-height: 1;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__purchase-head {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: flex-start;
      margin-bottom: 5px;
      padding-right: 92px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__purchase-card:not(:has(.boka-lp__popular)) .boka-lp__purchase-head {
      padding-right: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__purchase-type {
      font-size: 15px;
      line-height: 1.25;
      font-weight: 800;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__price {
      font-size: 18px;
      line-height: 1.1;
      font-weight: 800;
      white-space: nowrap;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__compare-price {
      color: var(--boka-gray);
      font-size: 13px;
      text-decoration: line-through;
      margin-left: 6px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__purchase-note {
      display: block;
      color: var(--boka-gray);
      font-size: 13px;
      line-height: 1.4;
      margin: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__purchase-features {
      list-style: none;
      padding: 10px 0 0;
      margin: 0;
      display: grid;
      gap: 4px;
      color: var(--boka-gray);
      font-size: 12px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__purchase-features li:before {
      content: '✓';
      color: var(--boka-olive);
      font-weight: 800;
      margin-right: 6px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__frequency-wrap {
      margin: 0 0 18px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__select {
      width: 100%;
      border: 1.5px solid var(--boka-stone);
      background: var(--boka-white);
      color: var(--boka-charcoal);
      border-radius: 999px;
      padding: 13px 16px;
      font-size: 14px;
      min-height: 48px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__atc {
      width: 100%;
      border: 0;
      border-radius: 999px;
      padding: 17px 24px;
      background: var(--boka-charcoal);
      color: var(--boka-cream);
      font-size: 15px;
      line-height: 1;
      font-weight: 800;
      letter-spacing: .01em;
      cursor: pointer;
      transition: background .2s, transform .15s, box-shadow .2s;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__atc:hover:not([disabled]) {
      background: #000;
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(34, 39, 33, .16);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__atc[disabled] {
      opacity: .55;
      cursor: not-allowed;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__message {
      min-height: 20px;
      margin: 10px 0 0;
      text-align: center;
      color: var(--boka-olive);
      font-size: 13px;
      font-weight: 800;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__below-trust {
      margin-top: 16px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border: 1px solid var(--boka-stone);
      border-radius: 18px;
      overflow: hidden;
      background: var(--boka-white);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__below-trust div {
      padding: 13px 8px;
      border-right: 1px solid var(--boka-stone);
      color: var(--boka-gray);
      font-size: 11px;
      line-height: 1.25;
      text-align: center;
      font-weight: 600;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__below-trust div:last-child { border-right: 0; }

    #boka-starter-lp-{{ section.id }} .boka-lp__section {
      padding: 76px 5%;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__section--white { background: var(--boka-white); }
    #boka-starter-lp-{{ section.id }} .boka-lp__section--green { background: var(--boka-green-light); }
    #boka-starter-lp-{{ section.id }} .boka-lp__section--blush { background: var(--boka-blush-light); }

    #boka-starter-lp-{{ section.id }} .boka-lp__wrap {
      max-width: 1120px;
      margin: 0 auto;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__wrap--narrow { max-width: 900px; }

    #boka-starter-lp-{{ section.id }} .boka-lp__section-title {
      color: var(--boka-charcoal);
      font-size: clamp(30px, 4vw, 46px);
      line-height: 1.05;
      letter-spacing: -.045em;
      margin: 0 0 28px;
      font-weight: 700;
      max-width: 760px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__section-copy {
      color: var(--boka-gray);
      font-size: 16px;
      line-height: 1.65;
      margin: -12px 0 30px;
      max-width: 720px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__included-grid,
    #boka-starter-lp-{{ section.id }} .boka-lp__science-grid,
    #boka-starter-lp-{{ section.id }} .boka-lp__reviews-grid {
      display: grid;
      gap: 14px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__included-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    #boka-starter-lp-{{ section.id }} .boka-lp__science-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    #boka-starter-lp-{{ section.id }} .boka-lp__reviews-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }

    #boka-starter-lp-{{ section.id }} .boka-lp__card {
      background: var(--boka-white);
      border: 1px solid var(--boka-stone);
      border-radius: 22px;
      padding: 22px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__card-kicker {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--boka-green-light);
      border: 1px solid var(--boka-green-mid);
      margin-bottom: 18px;
      position: relative;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__card-kicker:after {
      content: '';
      position: absolute;
      width: 11px;
      height: 11px;
      border-top: 1.7px solid var(--boka-olive);
      border-right: 1.7px solid var(--boka-olive);
      transform: rotate(45deg);
      top: 10px;
      left: 9px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__card strong {
      display: block;
      color: var(--boka-charcoal);
      font-size: 16px;
      line-height: 1.2;
      margin-bottom: 8px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__card p {
      color: var(--boka-gray);
      font-size: 14px;
      line-height: 1.55;
      margin: 0;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__routine {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      align-items: stretch;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__routine-panel {
      border-radius: 26px;
      padding: 28px;
      border: 1px solid var(--boka-stone);
      background: var(--boka-white);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__routine-panel.is-green {
      background: var(--boka-green-light);
      border-color: var(--boka-green-mid);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__routine-panel h3 {
      margin: 0 0 10px;
      font-size: 22px;
      line-height: 1.15;
      letter-spacing: -.025em;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__routine-panel p,
    #boka-starter-lp-{{ section.id }} .boka-lp__routine-panel li {
      color: var(--boka-gray);
      font-size: 14px;
      line-height: 1.55;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__routine-panel ul {
      margin: 14px 0 0;
      padding-left: 18px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__compare {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      overflow: hidden;
      border: 1px solid var(--boka-stone);
      border-radius: 24px;
      background: var(--boka-white);
      font-size: 14px;
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__compare th,
    #boka-starter-lp-{{ section.id }} .boka-lp__compare td {
      padding: 16px 18px;
      border-bottom: 1px solid var(--boka-stone);
      color: var(--boka-gray);
    }

    #boka-starter-lp-{{ section.id }} .boka-lp__compare tr:last-child td { border-bottom: 0; }
