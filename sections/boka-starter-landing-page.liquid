      #boka-starter-lp-{{ section.id }} .boka-lp__thumb {
        flex: 0 0 62px;
        width: 62px;
        min-height: 62px;
        border-radius: 12px;
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__thumb img,
      #boka-starter-lp-{{ section.id }} .boka-lp__thumb-placeholder { height: 62px; }

      #boka-starter-lp-{{ section.id }} .boka-lp__guarantees { display: none; }

      #boka-starter-lp-{{ section.id }} .boka-lp__hero-full-bleed {
        order: 4;
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__included-desktop {
        padding: 36px 16px !important;
      }

      #boka-starter-lp-{{ section.id }} .boka-lp__included-desktop .boka-lp__wrap {
        max-width: none;
