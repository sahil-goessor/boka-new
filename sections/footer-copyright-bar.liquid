<style>
  .copyright-bar {
    background-color: {{ section.settings.background_color }};
    padding: 16px 20px;
    text-align: center;
  }

  .copyright-bar__text {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.font_size_desktop }}px;
    margin: 0;
    font-family: inherit;
    line-height: 1.5;
  }

  @media screen and (max-width: 768px) {
    .copyright-bar__text {
      font-size: {{ section.settings.font_size_mobile }}px;
    }
  }
</style>

<div class="copyright-bar">
  <p class="copyright-bar__text">
    &copy; {{ 'now' | date: '%Y' }} {{ section.settings.store_name }}. {{ section.settings.rights_text }}
  </p>
</div>

{% schema %}
{
  "name": "Copyright Bar",
  "tag": "section",
  "class": "copyright-section",
  "settings": [
    {
      "type": "text",
      "id": "store_name",
      "label": "Store Name",
      "default": "Boka.com"
    },
    {
      "type": "text",
      "id": "rights_text",
      "label": "Rights Text",
      "default": "All Rights Reserved"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f5f5f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Font Size - Desktop (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font Size - Mobile (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Copyright Bar"
    }
  ]
}
{% endschema %}