{%- style -%}
  .yotpo-reviews-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }

  .yotpo-reviews-container-{{ section.id }} {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .yotpo-reviews-heading-{{ section.id }} {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: {{ section.settings.heading_spacing }}px;
  }

  .yotpo-reviews-heading-{{ section.id }} h2 {
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .yotpo-reviews-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    .yotpo-reviews-heading-{{ section.id }} h2 {
      font-size: {{ section.settings.heading_size | times: 0.75 }}px;
    }
  }
{%- endstyle -%}

{% liquid
  assign selected_product = section.settings.product
  
  if selected_product == blank and section.settings.product_handle != blank
    assign selected_product = all_products[section.settings.product_handle]
  endif
%}

<div class="yotpo-reviews-section-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="yotpo-reviews-container-{{ section.id }}">
    
    {% if section.settings.show_heading and section.settings.heading_text != blank %}
      <div class="yotpo-reviews-heading-{{ section.id }}">
        <h2>{{ section.settings.heading_text }}</h2>
      </div>
    {% endif %}

    {% if selected_product != blank %}
      <div
        class="yotpo-widget-instance"
        data-yotpo-instance-id="{{ section.settings.yotpo_instance_id }}"
        data-yotpo-product-id="{{ selected_product.id }}"
        data-yotpo-name="{{ selected_product.title | escape }}"
        data-yotpo-url="{{ shop.url }}{{ selected_product.url }}"
        data-yotpo-image-url="{{ selected_product.featured_image | product_img_url: 'large' | prepend: 'https:' | replace: '?', '%3F' | replace: '&', '%26' }}"
        data-yotpo-price="{{ selected_product.price | divided_by: 100.00 }}"
        data-yotpo-currency="{{ shop.currency }}"
        data-yotpo-description="{{ selected_product.description | escape }}"
      ></div>
    {% else %}
      <div style="text-align: center; padding: 60px 20px; background: #f9f9f9; border-radius: 8px;">
        <p style="font-size: 16px; color: #666; margin: 0;">
          Please select a product in the section settings to display reviews.
        </p>
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Yotpo Reviews Widget",
  "tag": "section",
  "class": "yotpo-reviews-section",
  "settings": [
    {
      "type": "header",
      "content": "Product Selection"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Select Product",
      "info": "Choose the product to display reviews for"
    },
    {
      "type": "text",
      "id": "product_handle",
      "label": "OR Product Handle (fallback)",
      "info": "If product picker doesn't work, enter the product handle manually (e.g., 'toothpaste-mint')"
    },
    {
      "type": "header",
      "content": "Yotpo Settings"
    },
    {
      "type": "text",
      "id": "yotpo_instance_id",
      "label": "Yotpo Instance ID",
      "default": "1002005",
      "info": "Find this in your Yotpo dashboard"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading text",
      "default": "Customer Reviews"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Heading spacing",
      "default": 32
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Container width",
      "default": 1200
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Padding - Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Section Padding - Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Yotpo Reviews Widget"
    }
  ]
}
{% endschema %}