3.9347 299.996 28.6914 297.401 24.8637C295.12 21.4293 290.768 20.0136 286.94 20.0136C279.836 20.0136 273.491 23.6577 271.944 31.2082C271.63 32.8861 270.397 34.5377 268.72 34.6164L250.63 32.6763C249.109 32.3355 247.432 31.1033 247.851 28.77C252.019 6.85275 271.813 0.246094 289.536 0.246094C298.607 0.246094 310.457 2.65804 317.614 9.52685C326.685 17.9949 325.82 29.2944 325.82 41.5901V70.6383C325.82 79.3685 329.438 83.1962 332.846 87.9152C334.052 89.5931 334.314 91.6118 332.794 92.8702C328.992 96.0425 322.228 101.941 318.505 105.245L318.453 105.192Z" fill="white"/><path d="M55.2883 59.7583V55.7209C41.8128 55.7209 27.5771 58.6048 27.5771 74.4922C27.5771 82.5408 31.7456 87.9939 38.9028 87.9939C44.1461 87.9939 48.8389 84.7692 51.8015 79.5258C55.4718 73.0765 55.2883 67.0204 55.2883 59.7583ZM74.0858 105.192C72.8536 106.293 71.0708 106.372 69.6813 105.638C63.4942 100.499 62.3931 98.1136 58.9849 93.211C48.7603 103.645 41.5245 106.765 28.2587 106.765C12.581 106.765 0.364014 97.0911 0.364014 77.7169C0.364014 62.5898 8.56988 52.2865 20.2364 47.2529C30.3561 42.796 44.487 42.0095 55.2883 40.7773V38.3654C55.2883 33.9347 55.6291 28.6914 53.0337 24.8637C50.7528 21.4293 46.4008 20.0136 42.5731 20.0136C35.4684 20.0136 29.1239 23.6577 27.5771 31.2082C27.2625 32.8861 26.0303 34.5377 24.3524 34.6164L6.2628 32.6763C4.74222 32.3355 3.06434 31.1033 3.48381 28.77C7.65229 6.85275 27.446 0.246094 45.1686 0.246094C54.2396 0.246094 66.0896 2.65804 73.2468 9.52685C82.3179 17.9949 81.4527 29.2944 81.4527 41.5901V70.6383C81.4527 79.3685 85.0706 83.1962 88.4788 87.9152C89.6848 89.5931 89.947 91.6118 88.4264 92.8702C84.6249 96.0425 77.861 101.941 74.1382 105.245L74.0858 105.192Z" fill="white"/>
          </svg>
        </a>
      {% endif %}

      {% if section.settings.show_timer %}
        <div class="boka-hero__timer">
          {% if section.settings.timer_text != blank %}
            <p class="boka-hero__timer-subtext">{{ section.settings.timer_text }}</p>
          {% endif %}
          <p class="boka-hero__timer-line">
            <strong>{{ section.settings.timer_label }}</strong>&nbsp;
            <span class="boka-hero__countdown" data-deadline="{{ section.settings.timer_deadline }}"></span>
          </p>
        </div>
      {% endif %}

      {%- if section.settings.show_shipping_banner -%}
        <div class="boka-shipping">
          {%- if section.settings.shipping_icon != blank -%}
            <img src="{{ section.settings.shipping_icon | img_url: '60x' }}" alt="" style="width:36px;height:auto;flex-shrink:0;">
          {%- else -%}
            <svg width="34" height="34" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;">
              <path d="M3 14h18v9H3z" stroke="{{ section.settings.shipping_text_color }}" stroke-width="1.5" fill="none"/>
              <path d="M21 16h5l3 4v3h-8V16z" stroke="{{ section.settings.shipping_text_color }}" stroke-width="1.5" fill="none"/>
              <circle cx="8" cy="24" r="2" fill="{{ section.settings.shipping_text_color }}"/>
              <circle cx="26" cy="24" r="2" fill="{{ section.settings.shipping_text_color }}"/>
            </svg>
          {%- endif -%}
          <p>{{ section.settings.shipping_text }}</p>
        </div>
      {%- endif -%}

    </div>

    <!-- RIGHT COLUMN: Review Cards -->
    <div class="boka-hero__right">
      {% assign review_blocks = section.blocks | where: "type", "review" %}
      {% for block in review_blocks %}
        <div class="boka-hero__review-card boka-hero__review-card--{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="boka-hero__review-card-top">
            <span class="boka-hero__review-name">{{ block.settings.reviewer_name }}</span>
            <div class="boka-hero__review-stars">
              {% assign filled = block.settings.star_rating | default: 5 %}
              {% for i in (1..5) %}
                {% if i <= filled %}
                  <span class="boka-hero__rstar boka-hero__rstar--filled">★</span>
                {% else %}
                  <span class="boka-hero__rstar">★</span>
                {% endif %}
              {% endfor %}
            </div>
          </div>
          <p class="boka-hero__review-body">{{ block.settings.review_text }}</p>
        </div>
      {% endfor %}
    </div>

  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    width: 100%;
    box-sizing: border-box;
    font-family: inherit;
  }

  #shopify-section-{{ section.id }} * {
    box-sizing: border-box;
  }

  /* ── Container ── */
  #shopify-section-{{ section.id }} .boka-hero__container {
    display: flex;
    align-items: flex-start;
    gap: {{ section.settings.columns_gap }}px;
    {% comment %} max-width: 1400px; {% endcomment %}
    {% comment %} margin: 0 auto; {% endcomment %}
    padding: 48px 0px 48px 90px;
    min-height: 520px;
  }

  /* ── LEFT COLUMN ── */
  #shopify-section-{{ section.id }} .boka-hero__left {
    flex: 0 0 {{ section.settings.left_column_width }}%;
    max-width: {{ section.settings.left_column_width }}%;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-right: 0;
    padding-top: 10px;
  }

  /* Stars row */
  #shopify-section-{{ section.id }} .boka-hero__stars-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .boka-hero__stars {
    display: flex;
    gap: 3px;
  }

  #shopify-section-{{ section.id }} .boka-hero__review-count {
    font-size: 15px;
    font-weight: 500;
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .boka-hero__stars-link {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  #shopify-section-{{ section.id }} .boka-hero__stars-link:hover {
    opacity: 0.75;
  }

  #shopify-section-{{ section.id }} .boka-hero__stars-link .boka-hero__review-count {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Heading */
  #shopify-section-{{ section.id }} .boka-hero__heading {
    margin: 0;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 800;
    line-height: 1.18;
    color: {{ section.settings.heading_color }};
    letter-spacing: -0.5px;
  }

  /* Description */
  #shopify-section-{{ section.id }} .boka-hero__description {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: {{ section.settings.text_color }};
    max-width: 480px;
  }

  /* Features — 2-col grid */
  #shopify-section-{{ section.id }} .boka-hero__features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 24px;
  }

  #shopify-section-{{ section.id }} .boka-hero__feature {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .boka-hero__feature-icon {
    width: 44px;
    height: 44px;
    object-fit: contain;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .boka-hero__feature-text {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    font-weight: 400;
    letter-spacing: normal;
  }

  /* CTA Button */
  #shopify-section-{{ section.id }} .boka-hero__cta {
    display: block;
    text-align: center;
    text-decoration: none;
    padding: 12px 30px;
    background-color: {{ section.settings.cta_bg_color }};
    color: {{ section.settings.cta_text_color }} !important;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: normal;
    text-transform: uppercase;
    border-radius: 3px;
    cursor: pointer;
    transition: opacity 0.2s;
    width: 260px;
    max-width: 100%;
    line-height: 1.8;
  }

  #shopify-section-{{ section.id }} .boka-hero__cta:hover {
    opacity: 0.85;
  }

  /* Timer */
  #shopify-section-{{ section.id }} .boka-hero__timer {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  #shopify-section-{{ section.id }} .boka-hero__timer-subtext {
    margin: 0;
    font-size: 14px;
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .boka-hero__timer-line {
    margin: 0;
    font-size: 14px;
    color: {{ section.settings.text_color }};
    display: flex;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .boka-hero__countdown {
    font-size: 15px;
    font-weight: 400;
  }

  /* ── RIGHT COLUMN: Review Cards ── */
  #shopify-section-{{ section.id }} .boka-hero__right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 0;
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .boka-hero__review-card {
    background-color: {{ section.settings.card_bg_color }};
    color: {{ section.settings.card_text_color }};
    border-radius: 6px;
    padding: 8px 22px;
    position: relative;
    width: 75%;
  }

  /* Cards 1–3: full right column width, card 4: indented left to create cascade */
  #shopify-section-{{ section.id }} .boka-hero__review-card--1 { margin: -13px; }
  #shopify-section-{{ section.id }} .boka-hero__review-card--2 { margin: 20px 0px 6px 20px; }
  #shopify-section-{{ section.id }} .boka-hero__review-card--3 { margin: 0px 0px 8px 60px; }
  #shopify-section-{{ section.id }} .boka-hero__review-card--4 { margin: 0px 0px 10px 100px; }

  #shopify-section-{{ section.id }} .boka-hero__review-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .boka-hero__review-name {
    font-size: 22px;
    font-weight: 700;
    color: {{ section.settings.card_text_color }};
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .boka-hero__review-stars {
    display: flex;
    gap: 1px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .boka-hero__rstar {
    font-size: 18px;
    color: #555;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .boka-hero__rstar--filled {
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .boka-hero__review-body {
    margin: 0;
    font-size: 20px;
    line-height: 1.55;
    color: {{ section.settings.card_text_color }};
    opacity: 0.88;
  }

  #shopify-section-{{ section.id }} .boka-shipping {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background-color: {{ section.settings.shipping_banner_bg }};
      padding: 10px 14px;
      border-radius: 6px;
      margin-bottom: 12px;
      align-self: flex-start;
    }
    #shopify-section-{{ section.id }} .boka-shipping p {
      color: {{ section.settings.shipping_text_color }};
      font-size: {{ section.settings.body_font_size }}px;
      font-weight: 600;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .boka-hero__cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: none;
      cursor: pointer;
      position: relative;
    }

    #shopify-section-{{ section.id }} .boka-hero__cta:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    #shopify-section-{{ section.id }} .boka-hero__cta-loader svg {
      animation: boka-hero-spin-{{ section.id }} 1s linear infinite;
    }

    @keyframes boka-hero-spin-{{ section.id }} {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

  /* ── TABLET ── */
  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .boka-hero__container {
      padding: 48px 32px;
      gap: 32px;
    }
    #shopify-section-{{ section.id }} .boka-hero__left {
      flex: 0 0 46%;
      max-width: 46%;
      padding-right: 24px;
    }
  }

  /* ── MOBILE ── */
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .boka-hero__container {
      flex-direction: column;
      padding: 32px 20px;
      gap: 28px;
      min-height: unset;
    }

    #shopify-section-{{ section.id }} .boka-hero__left {
      flex: 1 1 100%;
      max-width: 100%;
      padding-right: 0;
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .boka-hero__heading {
      font-size: {{ section.settings.heading_size | minus: 10 }}px;
    }

    #shopify-section-{{ section.id }} .boka-hero__features {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .boka-hero__cta {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .boka-hero__right {
      width: 100%;
      gap: 10px;
    }

    /* Mobile: progressive indent from left like the screenshot */
    #shopify-section-{{ section.id }} .boka-hero__review-card--1 { margin-left: 0; }
    #shopify-section-{{ section.id }} .boka-hero__review-card--2 { margin: 10px 0px -2px 22px; }
    #shopify-section-{{ section.id }} .boka-hero__review-card--3 { margin: 0px 0px -1px 50px; }
    #shopify-section-{{ section.id }} .boka-hero__review-card--4 { margin: 0px 0px 10px 70px; }

    #shopify-section-{{ section.id }} .boka-hero__review-card {
      width: 80%;
    }

    #shopify-section-{{ section.id }} .boka-hero__review-name {
      font-size: 12px;
