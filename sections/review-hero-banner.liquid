<script>
(function () {
  // ── Countdown Timer ──
  document.querySelectorAll(
    '#shopify-section-{{ section.id }} .boka-hero__countdown'
  ).forEach(function (el) {
    var deadline = el.getAttribute('data-deadline');
    if (!deadline) return;
    var end = new Date(deadline).getTime();
    function tick() {
      var diff = end - Date.now();
      if (diff <= 0) { el.textContent = '00:00:00'; return; }
      var h = Math.floor(diff / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      el.textContent =
        String(h).padStart(2, '0') + ':' +
        String(m).padStart(2, '0') + ':' +
        String(s).padStart(2, '0');
    }
    tick();
    setInterval(tick, 1000);
  });

  // ── CTA Button / Add to Cart ──
  var ctaBtn = document.querySelector('#shopify-section-{{ section.id }} .boka-hero__cta');
  if (ctaBtn) {
    ctaBtn.addEventListener('click', async function (e) {
      e.preventDefault();

      var action    = this.dataset.buttonAction;
      var link      = this.dataset.buttonLink;
      var variantId = this.dataset.variantId;
      var quantity  = parseInt(this.dataset.productQuantity) || 1;
      var textEl    = this.querySelector('.boka-hero__cta-text');
      var loaderEl  = this.querySelector('.boka-hero__cta-loader');
      var originalText = textEl ? textEl.textContent : '';

      // Regular link — just navigate
      if (action === 'link' || !variantId) {
        if (link) window.location.href = link;
        return;
      }

      // Show loader
      if (textEl) textEl.style.display = 'none';
      if (loaderEl) loaderEl.style.display = 'inline-flex';
      this.disabled = true;

      try {
        var response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: [{ id: variantId, quantity: quantity }] })
        });

        if (!response.ok) throw new Error('Failed to add to cart');

        document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));

        if (action === 'add_and_checkout') {
          window.location.href = '/checkout';

        } else if (action === 'add_and_cart') {
          document.documentElement.dispatchEvent(new CustomEvent('cart:open', { bubbles: true }));
          document.dispatchEvent(new CustomEvent('cart:open', { bubbles: true }));
          var cartDrawer = document.querySelector('cart-drawer');
          if (cartDrawer && typeof cartDrawer.open === 'function') cartDrawer.open();
          ['[data-drawer="cart"]','[data-cart-drawer]','#cart-drawer','.cart-drawer','#CartDrawer','.CartDrawer'].forEach(function(sel) {
            var el = document.querySelector(sel);
            if (el) { el.classList.add('is-open','active','open'); el.setAttribute('aria-hidden','false'); }
          });
          if (textEl) { textEl.textContent = '✓ Added!'; textEl.style.display = 'inline'; }
          if (loaderEl) loaderEl.style.display = 'none';
          this.disabled = false;
          var btn = this;
          setTimeout(function() { if (textEl) textEl.textContent = originalText; }, 2000);

        } else if (action === 'add_and_stay') {
          if (textEl) { textEl.textContent = '✓ Added to Cart'; textEl.style.display = 'inline'; }
          if (loaderEl) loaderEl.style.display = 'none';
          this.disabled = false;
          setTimeout(function() { if (textEl) textEl.textContent = originalText; }, 2000);
        }

      } catch (err) {
        console.error('Add to cart error:', err);
        if (textEl) { textEl.textContent = 'Error – Try Again'; textEl.style.display = 'inline'; }
        if (loaderEl) loaderEl.style.display = 'none';
        this.disabled = false;
        setTimeout(function() { if (textEl) textEl.textContent = originalText; }, 2000);
      }
    });
  }
})();
</script>

