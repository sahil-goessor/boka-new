<div id="shopify-section-{{ section.id }}" class="boka-hero">
  <div class="boka-hero__container">

    <!-- LEFT COLUMN -->
    <div class="boka-hero__left">

      {% if section.settings.show_stars %}
        <div class="boka-hero__stars-row">
          {% if section.settings.reviews_anchor != blank %}
            <a href="#{{ section.settings.reviews_anchor }}" class="boka-hero__stars-link">
          {% endif %}
          <div class="boka-hero__stars">
            {% for i in (1..5) %}
              <svg width="22" height="22" viewBox="0 0 24 23" fill="{{ section.settings.star_color }}" xmlns="http://www.w3.org/2000/svg">
                <path d="M12.3388 0.532715L15.0742 8.95132H23.926L16.7647 14.1543L19.5001 22.5729L12.3388 17.3699L5.1775 22.5729L7.91287 14.1543L0.751577 8.95132H9.60343L12.3388 0.532715Z"/>
              </svg>
            {% endfor %}
          </div>
          {% if section.settings.review_text != blank %}
            <span class="boka-hero__review-count">{{ section.settings.review_text }}</span>
          {% endif %}
          {% if section.settings.reviews_anchor != blank %}
            </a>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="boka-hero__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="boka-hero__description">{{ section.settings.description }}</p>
      {% endif %}

      {% assign feature_blocks = section.blocks | where: "type", "feature" %}
      {% if feature_blocks.size > 0 %}
        <div class="boka-hero__features">
          {% for block in feature_blocks %}
            <div class="boka-hero__feature" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <img src="{{ block.settings.icon | img_url: '96x96', crop: 'center' }}" alt="" class="boka-hero__feature-icon" width="44" height="44" loading="lazy">
              {% endif %}
              {% if block.settings.feature_text != blank %}
                <p class="boka-hero__feature-text">{{ block.settings.feature_text }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.cta_text != blank %}
        <button
          type="button"
          class="boka-hero__cta"
          data-button-action="{{ section.settings.button_action }}"
          data-button-link="{{ section.settings.cta_url }}"
          data-variant-id="{{ section.settings.variant_id }}"
          data-product-quantity="{{ section.settings.product_quantity }}"
        >
          <span class="boka-hero__cta-text">{{ section.settings.cta_text }}</span>
          <span class="boka-hero__cta-loader" style="display:none;">
            <svg width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" opacity="0.25"/>
              <path d="M12 2 A10 10 0 0 1 22 12" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round"/>
            </svg>
          </span>
        </button>
      {% endif %}

      {% if section.settings.amazon_url != blank %}
        <a href="{{ section.settings.amazon_url }}" target="_blank" rel="noopener" class="boka-hero__amazon-btn">
          <strong>Buy on</strong>
          <svg fill="none" height="22" viewBox="0 0 603 182" width="73" xmlns="http://www.w3.org/2000/svg">
            <path d="M374.006 142.184C339.007 167.981 288.277 181.745 244.6 181.745C183.358 181.745 128.224 159.094 86.5126 121.42C83.2355 118.458 86.1717 114.42 90.1043 116.727C135.119 142.918 190.777 158.674 248.27 158.674C287.045 158.674 329.7 150.652 368.92 134.004C374.845 131.488 379.8 137.884 374.006 142.184Z" fill="white"/><path d="M388.557 125.536C384.1 119.821 358.984 122.836 347.711 124.173C344.277 124.593 343.752 121.604 346.846 119.454C366.849 105.376 399.673 109.439 403.5 114.158C407.328 118.903 402.504 151.806 383.707 167.509C380.823 169.921 378.07 168.637 379.355 165.438C383.576 154.899 393.04 131.278 388.557 125.536Z" fill="white"/><path d="M348.497 20.066V6.38079C348.497 4.30966 350.07 2.92017 351.958 2.92017H413.227C415.193 2.92017 416.766 4.33588 416.766 6.38079V18.0997C416.74 20.066 415.088 22.6352 412.152 26.6988L380.403 72.0278C392.201 71.7394 404.654 73.4959 415.35 79.5258C417.762 80.889 418.418 82.8815 418.601 84.8478V99.4506C418.601 101.443 416.399 103.776 414.092 102.57C395.242 92.6866 370.205 91.6117 349.362 102.675C347.239 103.829 345.01 101.522 345.01 99.5292V85.6605C345.01 83.4321 345.037 79.6306 347.265 76.2487L384.047 23.5004H352.037C350.07 23.5004 348.497 22.1109 348.497 20.066Z" fill="white"/><path d="M124.999 105.454H106.359C104.576 105.323 103.16 103.986 103.029 102.282V6.61682C103.029 4.70299 104.628 3.1824 106.621 3.1824H124.003C125.811 3.261 127.253 4.65054 127.385 6.38085V18.8863H127.725C132.261 6.80031 140.781 1.1637 152.264 1.1637C163.931 1.1637 171.219 6.80031 176.462 18.8863C180.972 6.80031 191.223 1.1637 202.207 1.1637C210.02 1.1637 218.567 4.38837 223.784 11.6242C229.683 19.6728 228.477 31.3655 228.477 41.6163L228.45 101.994C228.45 103.908 226.851 105.454 224.859 105.454H206.245C204.383 105.323 202.889 103.829 202.889 101.994V51.2903C202.889 47.2529 203.256 37.1856 202.365 33.358C200.975 26.9349 196.807 25.1259 191.406 25.1259C186.897 25.1259 182.178 28.1408 180.264 32.9647C178.35 37.7886 178.534 45.8634 178.534 51.2903V