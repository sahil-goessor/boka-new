{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    background-color: {{ section.settings.section_background_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media only screen and (min-width: 640px) and (max-width: 1024px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_tablet }}px;
      padding-bottom: {{ section.settings.padding_bottom_tablet }}px;
    }
  }

  @media screen and (min-width: 1025px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .image-headings {
    margin-bottom: 4rem;
  }

  .enhanced-cta-button-loader-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .enhanced-cta-button-loader-{{ section.id }} svg {
    animation: enhanced-cta-spin-{{ section.id }} 1s linear infinite;
  }

  @keyframes enhanced-cta-spin-{{ section.id }} {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Background media layout styles */
  .enhanced-image-with-text-bg {
    position: relative;
    min-height: 600px;
    display: flex;
    align-items: center;
    overflow: hidden;
    width: 100%;
  }
  
  .enhanced-image-with-text-bg__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .enhanced-image-with-text-bg__media-mobile {
    display: none;
  }
  
  .enhanced-image-with-text-bg__video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  
  .enhanced-image-with-text-bg__content {
    position: relative;
    z-index: 2;
    width: 100%;
    /* max-width: 1200px; */
    margin: 0 auto;
    padding: 60px 60px;
  }
  
  .enhanced-image-with-text-bg__text-wrapper {
    max-width: 600px;
    margin-bottom: 30px;
  }
  
  /* Enhanced text color controls for all elements */
  .enhanced-image-with-text-bg__text-wrapper h1,
  .enhanced-image-with-text-bg__text-wrapper h2,
  .enhanced-image-with-text-bg__text-wrapper h3,
  .enhanced-image-with-text-bg__text-wrapper h4,
  .enhanced-image-with-text-bg__text-wrapper h5,
  .enhanced-image-with-text-bg__text-wrapper h6,
  .enhanced-image-with-text-bg__text-wrapper p,
  .enhanced-image-with-text-bg__text-wrapper div {
    color: {{ section.settings.text_color }};
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  }
  
  /* Container text colors */
  .enhanced-image-with-text-bg__container,
  .enhanced-image-with-text-bg__container h1,
  .enhanced-image-with-text-bg__container h2,
  .enhanced-image-with-text-bg__container h3,
  .enhanced-image-with-text-bg__container h4,
  .enhanced-image-with-text-bg__container h5,
  .enhanced-image-with-text-bg__container h6,
  .enhanced-image-with-text-bg__container p,
  .enhanced-image-with-text-bg__container div,
  .enhanced-image-with-text-bg__container .rte,
  .enhanced-image-with-text-bg__container .image-with-text__heading,
  .enhanced-image-with-text-bg__container .image-with-text__text {
    color: {{ section.settings.container_text_color }};
  }
  
  /* Icon text specific colors */
  .enhanced-image-with-text-bg__container .icon-text-item__heading {
    color: {{ section.settings.icon_heading_color }};
  }
  
  .enhanced-image-with-text-bg__container .icon-text-item__text {
    color: {{ section.settings.icon_text_color }};
  }
  
  .enhanced-image-with-text-bg__container {
    background-color: {{ section.settings.container_background_color }};
    padding: 30px;
    border-radius: {{ section.settings.container_border_radius }}px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    backdrop-filter: blur(10px);
    max-width: 600px;
  }
  
  /* Mobile layout */
  @media screen and (max-width: 749px) {
    .enhanced-image-with-text-bg {
      flex-direction: column;
      min-height: auto;
    }

    /* Hide desktop image and show mobile image on mobile */
    .enhanced-image-with-text-bg__media {
      {% if section.settings.mobile_image != blank %}
        display: none;
      {% endif %}
    }

    .enhanced-image-with-text-bg__media-mobile {
      {% if section.settings.mobile_image != blank %}
        display: block;
        position: relative;
        height: 300px;
        margin-bottom: 20px;
        width: 100%;
        object-fit: cover;
      {% endif %}
    }

    /* If no mobile image is set, show desktop image in mobile layout */
    {% if section.settings.mobile_image == blank %}
    .enhanced-image-with-text-bg__media,
    {% endif %}
    .enhanced-image-with-text-bg__video {
      position: relative;
      height: 300px;
      margin-bottom: 20px;
    }
    
    .enhanced-image-with-text-bg__content {
      position: static;
      padding: 0 20px 20px;
    }
    
    /* Mobile text colors - override desktop colors */
    .enhanced-image-with-text-bg__text-wrapper h1,
    .enhanced-image-with-text-bg__text-wrapper h2,
    .enhanced-image-with-text-bg__text-wrapper h3,
    .enhanced-image-with-text-bg__text-wrapper h4,
    .enhanced-image-with-text-bg__text-wrapper h5,
    .enhanced-image-with-text-bg__text-wrapper h6,
    .enhanced-image-with-text-bg__text-wrapper p,
    .enhanced-image-with-text-bg__text-wrapper div {
      color: {{ section.settings.mobile_text_color }};
      text-shadow: none;
    }
    
    /* Mobile container text colors */
    .enhanced-image-with-text-bg__container,
    .enhanced-image-with-text-bg__container h1,
    .enhanced-image-with-text-bg__container h2,
    .enhanced-image-with-text-bg__container h3,
    .enhanced-image-with-text-bg__container h4,
    .enhanced-image-with-text-bg__container h5,
    .enhanced-image-with-text-bg__container h6,
    .enhanced-image-with-text-bg__container p,
    .enhanced-image-with-text-bg__container div,
    .enhanced-image-with-text-bg__container .rte,
    .enhanced-image-with-text-bg__container .image-with-text__heading,
    .enhanced-image-with-text-bg__container .image-with-text__text {
      color: {{ section.settings.mobile_container_text_color }};
    }
    
    /* Mobile icon text colors */
    .enhanced-image-with-text-bg__container .icon-text-item__heading {
      color: {{ section.settings.mobile_icon_heading_color }};
    }
    
    .enhanced-image-with-text-bg__container .icon-text-item__text {
      color: {{ section.settings.mobile_icon_text_color }};
    }
  }

  /* Icon text styles with dynamic font sizes */
  .icon-text-item {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    margin-bottom: 20px;
  }
  
  .icon-text-item:last-child {
    margin-bottom: 0;
  }
  
  .icon-text-item__icon {
    flex-shrink: 0;
    width: {{ section.settings.icon_size | default: 24 }}px;
    height: {{ section.settings.icon_size | default: 24 }}px;
    margin-top: 2px;
    /* Fix for blurry icons */
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    image-rendering: pixelated;
  }
  
  .icon-text-item__content {
    flex: 1;
  }
  
  .icon-text-item__heading {
    margin: 0 0 8px 0;
    font-weight: 400;
    line-height: 1.2;
  }
  
  .icon-text-item__text {
    margin: 0;
  }

  /* Content positioning */
  .enhanced-image-with-text-bg__content--left {
    text-align: left;
  }
  
  .enhanced-image-with-text-bg__content--center {
    text-align: center;
  }
  
  .enhanced-image-with-text-bg__content--right {
    text-align: right;
  }
  
  .enhanced-image-with-text-bg__content--center .enhanced-image-with-text-bg__text-wrapper,
  .enhanced-image-with-text-bg__content--center .enhanced-image-with-text-bg__container {
    margin-left: auto;
    margin-right: auto;
  }
  
  .enhanced-image-with-text-bg__content--right .enhanced-image-with-text-bg__text-wrapper,
  .enhanced-image-with-text-bg__content--right .enhanced-image-with-text-bg__container {
    margin-left: auto;
    margin-right: 0;
  }

  /* Video overlay for better readability */
  .enhanced-image-with-text-bg--video::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, {{ section.settings.video_overlay_opacity | divided_by: 100.0 }});
    z-index: 1;
  }

  /* Popup Modal */
  .enhanced-modal-overlay-{{ section.id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
  }

  .enhanced-modal-overlay-{{ section.id }}.is-open {
    display: flex;
  }

  .enhanced-modal-{{ section.id }} {
    background: #ffffff;
    border-radius: 16px;
    padding: 48px 40px;
    max-width: 727px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
  }

  .enhanced-modal-close-{{ section.id }} {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    line-height: 1;
    font-size: 24px;
    color: #000;
  }

  .enhanced-modal-title-{{ section.id }} {
    font-size: 40px;
    font-weight: 400;
    text-align: center;
    margin: 0 0 32px;
    line-height: 25px;
  }

  .enhanced-modal-body-{{ section.id }} {
    font-size: 14px;
    line-height: 25px;
    color: #000000;
    font-weight: 300;
  }

  @media screen and (max-width: 749px) {
    .enhanced-modal-{{ section.id }} {
      padding: 40px 24px 32px;
      border-radius: 12px;
    }

    .enhanced-modal-title-{{ section.id }} {
      font-size: 26px;
      margin-bottom: 20px;
    }

    .enhanced-modal-body-{{ section.id }} {
      font-size: 15px;
    }
  }

  /* Dynamic font size styles for headings - Desktop */
  {%- for block in section.blocks -%}
    {%- if block.type == 'heading' -%}
      .heading-block-{{ block.id }} {
        font-size: {{ block.settings.heading_font_size_desktop | default: 32 }}px;
      }

      /* Mobile font sizes for headings */
      @media screen and (max-width: 749px) {
        .heading-block-{{ block.id }} {
          font-size: {{ block.settings.heading_font_size_mobile | default: 24 }}px;
        }
      }
    {%- endif -%}

    {%- if block.type == 'icon_text' -%}
      .icon-text-block-{{ block.id }} .icon-text-item__heading {
        font-size: {{ block.settings.heading_font_size_desktop | default: 16 }}px;
      }
      
      .icon-text-block-{{ block.id }} .icon-text-item__text {
        font-size: {{ block.settings.text_font_size_desktop | default: 14 }}px;
      }

      /* Mobile font sizes */
      @media screen and (max-width: 749px) {
        .icon-text-block-{{ block.id }} .icon-text-item__heading {
          font-size: {{ block.settings.heading_font_size_mobile | default: 14 }}px;
        }
        
        .icon-text-block-{{ block.id }} .icon-text-item__text {
          font-size: {{ block.settings.text_font_size_mobile | default: 12 }}px;
        }
      }
    {%- endif -%}
  {%- endfor -%}
{%- endstyle -%}

{%- assign has_video = false -%}
{%- if section.settings.background_video != blank -%}
  {%- assign has_video = true -%}
{%- endif -%}

<div class="enhanced-image-with-text-bg{% if has_video %} enhanced-image-with-text-bg--video{% endif %} section-{{ section.id }}-padding">
  {%- if section.settings.media_type == 'video' and section.settings.background_video != blank -%}
    <video
      class="enhanced-image-with-text-bg__video"
      autoplay
      muted
      loop
      playsinline
      {% if section.settings.video_poster != blank %}
        poster="{{ section.settings.video_poster | image_url: width: 1920 }}"
      {% endif %}
    >
      <source src="{{ section.settings.background_video }}" type="video/mp4">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1920 }}"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy"
          class="enhanced-image-with-text-bg__media"
          width="1920"
          height="1080"
        />
      {%- endif -%}
    </video>
  {%- elsif section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 1920 }}"
      alt="{{ section.settings.image.alt | escape }}"
      loading="lazy"
      class="enhanced-image-with-text-bg__media"
      width="1920"
      height="1080"
    />
  {%- else -%}
    <div class="enhanced-image-with-text-bg__media" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"></div>
  {%- endif -%}

  {%- comment -%} Mobile-specific image {%- endcomment -%}
  {%- if section.settings.mobile_image != blank and section.settings.media_type != 'video' -%}
    <img
      src="{{ section.settings.mobile_image | image_url: width: 750 }}"
      alt="{{ section.settings.mobile_image.alt | escape }}"
      loading="lazy"
      class="enhanced-image-with-text-bg__media-mobile"
      width="750"
      height="400"
    />
  {%- endif -%}
  
  <div class="enhanced-image-with-text-bg__content enhanced-image-with-text-bg__content--{{ section.settings.desktop_content_alignment }}">
    <!-- Text Content Above Container -->
    <div class="enhanced-image-with-text-bg__text-wrapper">
      {%- for block in section.blocks -%}
        {% case block.type %}
          {%- when 'caption' -%}
            <p
              class="image-with-text__text image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {{ block.settings.text_style }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.caption | escape }}
            </p>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    
    <!-- Container for ALL Content: icons and buttons -->
    <div class="enhanced-image-with-text-bg__container">
      {%- for block in section.blocks -%}
        {% case block.type %}
          {%- when 'heading' -%}
            <{% if block.settings.heading_tag != 'default' %}{{ block.settings.heading_tag }}{% else %}div{% endif %}
              class="image-with-text__heading inline-richtext image-headings {{ block.settings.heading_size }} heading-block-{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.heading }}
            </{% if block.settings.heading_tag != 'default' %}{{ block.settings.heading_tag }}{% else %}div{% endif %}>
          
          {%- when 'caption' -%}
            <p
              class="image-with-text__text image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {{ block.settings.text_style }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.caption | escape }}
            </p>
          
          {%- when 'text' -%}
            <div class="image-with-text__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          
          {%- when 'icon_text' -%}
            <div class="icon-text-item icon-text-block-{{ block.id }}" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                {%- assign icon_size = section.settings.icon_size | default: 24 -%}
                {%- assign icon_size_2x = icon_size | times: 2 -%}
                <img 
                  src="{{ block.settings.icon | image_url: width: icon_size_2x }}" 
                  alt="{{ block.settings.icon_alt | escape }}" 
                  class="icon-text-item__icon"
                  width="{{ icon_size }}"
                  height="{{ icon_size }}"
                  loading="lazy"
                >
              {%- endif -%}
              <div class="icon-text-item__content">
                {%- if block.settings.heading != blank -%}
                  <div class="icon-text-item__heading">
                    {{ block.settings.heading | escape }}
                  </div>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="icon-text-item__text rte {{ block.settings.text_style }}">
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}
              </div>
            </div>
          
          {%- when 'button' -%}
            <div class="button-container">
              {%- if block.settings.button_label != blank -%}
                <button
                  type="button"
                  class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %} enhanced-cta-button-{{ section.id }}"
                  data-button-action="{{ block.settings.button_action }}"
                  data-button-link="{{ block.settings.button_link }}"
                  data-variant-id="{{ block.settings.variant_id }}"
                  data-product-quantity="{{ block.settings.product_quantity }}"
                  {{ block.shopify_attributes }}
                >
                  <span class="enhanced-cta-button-text-{{ section.id }}">{{ block.settings.button_label | escape }}</span>
                  <span class="enhanced-cta-button-loader-{{ section.id }}" style="display: none;">
                    <svg width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" opacity="0.25"/>
                      <path d="M12 2 A10 10 0 0 1 22 12" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round"/>
                    </svg>
                  </span>
                </button>
              {%- endif -%}

              {% if block.settings.second_button_label != blank %}
                <button
                  type="button"
                  class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %} enhanced-cta-button-{{ section.id }}"
                  data-button-action="{{ block.settings.second_button_action }}"
                  data-button-link="{{ block.settings.second_button_link }}"
                  data-variant-id="{{ block.settings.second_variant_id }}"
                  data-product-quantity="{{ block.settings.second_product_quantity }}"
                  {{ block.shopify_attributes }}
                >
                  <span class="enhanced-cta-button-text-{{ section.id }}">{{ block.settings.second_button_label | escape }}</span>
                  <span class="enhanced-cta-button-loader-{{ section.id }}" style="display: none;">
                    <svg width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" opacity="0.25"/>
                      <path d="M12 2 A10 10 0 0 1 22 12" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round"/>
                    </svg>
                  </span>
                </button>
              {% endif %}
            {% if block.settings.popup_button_label != blank %}
                <button
                  type="button"
                  class="button{% if block.settings.popup_button_style_secondary %} button--secondary{% else %} button--primary{% endif %} enhanced-popup-trigger-{{ section.id }}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.popup_button_label | escape }}
                </button>
              {% endif %}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
  {% for block in section.blocks %}
    {% if block.type == 'button' and block.settings.popup_button_label != blank %}
      <div class="enhanced-modal-overlay-{{ section.id }}" id="enhanced-modal-{{ section.id }}" role="dialog" aria-modal="true">
        <div class="enhanced-modal-{{ section.id }}">
          <button class="enhanced-modal-close-{{ section.id }}" aria-label="Close modal">&#x2715;</button>
          {% if block.settings.popup_title != blank %}
            <h2 class="enhanced-modal-title-{{ section.id }}">{{ block.settings.popup_title }}</h2>
          {% endif %}
          {% if block.settings.popup_content != blank %}
            <div class="enhanced-modal-body-{{ section.id }} rte">{{ block.settings.popup_content }}</div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>

<script>
  (function() {
    const buttons = document.querySelectorAll('.enhanced-cta-button-{{ section.id }}');
    
    buttons.forEach(button => {
      button.addEventListener('click', async function(e) {
        e.preventDefault();
        
        const action = this.dataset.buttonAction;
        const link = this.dataset.buttonLink;
        const variantId = this.dataset.variantId;
        const quantity = parseInt(this.dataset.productQuantity) || 1;
        
        // If action is regular link or no variant ID, just navigate
        if (action === 'link' || !variantId) {
          if (link) {
            window.location.href = link;
          }
          return;
        }
        
        // Show loader
        const textEl = this.querySelector('.enhanced-cta-button-text-{{ section.id }}');
        const loaderEl = this.querySelector('.enhanced-cta-button-loader-{{ section.id }}');
        const originalText = textEl.textContent;
        textEl.style.display = 'none';
        loaderEl.style.display = 'inline-flex';
        this.disabled = true;
        
        try {
          // Add to cart via AJAX
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({
              items: [{
                id: variantId,
                quantity: quantity
              }]
            })
          });
          
          if (!response.ok) {
            throw new Error('Failed to add to cart');
          }
          
          // Trigger cart update event
          document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', {
            bubbles: true
          }));
          
          // Redirect based on action
          if (action === 'add_and_checkout') {
            window.location.href = '/checkout';
          } else if (action === 'add_and_cart') {
            window.location.href = '/cart';
          } else if (action === 'add_and_stay') {
            textEl.textContent = '✓ Added to Cart';
            textEl.style.display = 'inline';
            loaderEl.style.display = 'none';
            this.disabled = false;
            
            setTimeout(() => {
              textEl.textContent = originalText;
            }, 2000);
          }
        } catch (error) {
          console.error('Error adding to cart:', error);
          
          textEl.textContent = 'Error - Try Again';
          textEl.style.display = 'inline';
          loaderEl.style.display = 'none';
          this.disabled = false;
          
          setTimeout(() => {
            textEl.textContent = originalText;
          }, 2000);
        }
      });
    });
    // Popup modal logic
  const popupTriggers = document.querySelectorAll('.enhanced-popup-trigger-{{ section.id }}');
  const modalOverlay = document.getElementById('enhanced-modal-{{ section.id }}');

  if (modalOverlay) {
    popupTriggers.forEach(trigger => {
      trigger.addEventListener('click', function() {
        modalOverlay.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      });
    });

    // Close on X button
    const closeBtn = modalOverlay.querySelector('.enhanced-modal-close-{{ section.id }}');
    if (closeBtn) {
      closeBtn.addEventListener('click', function() {
        modalOverlay.classList.remove('is-open');
        document.body.style.overflow = '';
      });
    }

    // Close on overlay click
    modalOverlay.addEventListener('click', function(e) {
      if (e.target === modalOverlay) {
        modalOverlay.classList.remove('is-open');
        document.body.style.overflow = '';
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modalOverlay.classList.contains('is-open')) {
        modalOverlay.classList.remove('is-open');
        document.body.style.overflow = '';
      }
    });
  }
  })();
</script>

