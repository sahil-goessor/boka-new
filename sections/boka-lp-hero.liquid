<section class="boka-lp boka-lp--hero-section">
  {% if section.settings.show_announcement %}
    <div class="boka-lp__topbar">
      {{ section.settings.announcement_text }}
      <a href="#boka-buybox">{{ section.settings.announcement_link_text }}</a>
    </div>
  {% endif %}

  <div class="boka-lp__hero" id="boka-buybox">
    <div class="boka-lp__promo-heading boka-lp__promo-banner">
      <div class="boka-lp__promo-banner-main">
        <div class="boka-lp__promo-banner-content">
          {% if section.settings.promo_banner_eyebrow != blank %}
            <p class="boka-lp__promo-eyebrow">{{ section.settings.promo_banner_eyebrow }}</p>
          {% endif %}

          {% if section.settings.promo_banner_heading != blank %}
            <h2>{{ section.settings.promo_banner_heading }}</h2>
          {% endif %}

          {% if section.settings.promo_banner_subtext != blank %}
            <p>{{ section.settings.promo_banner_subtext }}</p>
          {% endif %}

          {% if section.settings.promo_banner_button_text != blank %}
            <a
              class="boka-lp__promo-banner-button"
              href="{% if section.settings.promo_banner_button_link != blank %}{{ section.settings.promo_banner_button_link }}{% else %}#boka-subscription{% endif %}"
            >
              {{ section.settings.promo_banner_button_text }}
            </a>
          {% endif %}
        </div>

        {% if section.settings.promo_banner_image != blank %}
          <div class="boka-lp__promo-banner-image-wrap">
            {{
              section.settings.promo_banner_image
              | image_url: width: 2400
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                class: 'boka-lp__promo-banner-image',
                alt: section.settings.promo_banner_image_alt
            }}
          </div>
        {% endif %}
      </div>

      <div class="boka-lp__proof-bar-section boka-lp__proof-bar-section--banner" id="boka-proof">
        <div class="boka-lp__proof-bar" aria-label="Boka starter kit highlights">
          <div class="boka-lp__proof-stat">
            <span class="boka-lp__proof-number">n-Ha powered</span>
            <span class="boka-lp__proof-label">Modern enamel care</span>
          </div>

          <div class="boka-lp__proof-stat">
            <span class="boka-lp__proof-number">Choose your goal</span>
            <span class="boka-lp__proof-label">Whitening, sensitive, daily care & more</span>
          </div>

          <div class="boka-lp__proof-stat">
            <span class="boka-lp__proof-number">Save 50%</span>
            <span class="boka-lp__proof-label">On your first ritual kit</span>
          </div>

          <div class="boka-lp__proof-stat">
            <span class="boka-lp__proof-number">Refills every 3 months</span>
            <span class="boka-lp__proof-label">Only what you need, when you need it</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Boka LP hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": false
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "New Customer Offer:"
    },
    {
      "type": "text",
      "id": "announcement_link_text",
      "label": "Announcement link text",
      "default": "Choose your oral beauty system and start for $24.99 + free shipping"
    },
    {
      "type": "image_picker",
      "id": "promo_banner_image",
      "label": "Promo banner image"
    },
    {
      "type": "text",
      "id": "promo_banner_image_alt",
      "label": "Promo banner image alt text",
      "default": "Boka oral care starter kit with toothpaste, floss, toothbrush, and tongue cleaner"
    },
    {
      "type": "text",
      "id": "promo_banner_eyebrow",
      "label": "Promo banner eyebrow",
      "default": "New Customer Ritual Kit"
    },
    {
      "type": "text",
      "id": "promo_banner_heading",
      "label": "Promo banner heading",
      "default": "Build your oral beauty ritual around your smile goals"
    },
    {
      "type": "text",
      "id": "promo_banner_subtext",
      "label": "Promo banner subtext",
      "default": "Choose your starter system — whitening, sensitivity support, daily care, probiotics, or kids — and get a complete n-Ha powered routine with toothpaste, brush, floss, and tongue cleaner."
    },
    {
      "type": "text",
      "id": "promo_banner_button_text",
      "label": "Promo banner button text",
      "default": "Choose My System"
    },
    {
      "type": "url",
      "id": "promo_banner_button_link",
      "label": "Promo banner button link"
    },
    {
      "type": "text",
      "id": "offer_discount",
      "label": "First-order discount label",
      "default": "Save 50%"
    }
  ],
  "presets": [
    {
      "name": "Boka LP hero"
    }
  ]
}
{% endschema %}