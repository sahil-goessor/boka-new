<section
  class="boka-lp boka-lp--hero-section"
  style="
    --boka-hero-button-radius: {{ section.settings.button_corner_radius }}px;
    --boka-hero-proof-radius: {{ section.settings.proof_bar_corner_radius }}px;
    --boka-hero-proof-stat-radius: {{ section.settings.proof_stat_corner_radius }}px;
  "
>
  {% if section.settings.show_announcement %}
    <div class="boka-lp__topbar">
      {{ section.settings.announcement_text }}
      <a href="#boka-buybox">{{ section.settings.announcement_link_text }}</a>
    </div>
  {% endif %}

  <div class="boka-lp__hero" id="boka-buybox">
    <div class="boka-lp__promo-heading boka-lp__promo-banner">
      <div class="boka-lp__promo-banner-main">
        <div class="boka-lp__promo-banner-content">
          {% if section.settings.promo_banner_eyebrow != blank %}
            <p class="boka-lp__promo-eyebrow">{{ section.settings.promo_banner_eyebrow }}</p>
          {% endif %}

          {% if section.settings.promo_banner_heading != blank %}
            <h2>{{ section.settings.promo_banner_heading }}</h2>
          {% endif %}

          {% if section.settings.promo_banner_subtext != blank %}
            <div class="boka-lp__promo-banner-subtext">
              {{ section.settings.promo_banner_subtext }}
            </div>
          {% endif %}

          {% if section.settings.promo_banner_button_text != blank %}
            <a
              class="boka-lp__promo-banner-button"
              href="{% if section.settings.promo_banner_button_link != blank %}{{ section.settings.promo_banner_button_link }}{% else %}#boka-subscription{% endif %}"
            >
              {{ section.settings.promo_banner_button_text }}
            </a>
          {% endif %}
        </div>

        {% if section.settings.promo_banner_image != blank %}
          <div class="boka-lp__promo-banner-image-wrap">
            {{
              section.settings.promo_banner_image
              | image_url: width: 1200
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                class: 'boka-lp__promo-banner-image',
                alt: section.settings.promo_banner_image_alt,
                widths: '360, 480, 588, 720, 900, 1100, 1200',
                sizes: '(max-width: 749px) 92vw, (max-width: 989px) 80vw, 588px'
            }}
          </div>
        {% endif %}
      </div>

      <div class="boka-lp__proof-bar-section boka-lp__proof-bar-section--banner" id="boka-proof">
        <div class="boka-lp__proof-bar" aria-label="Boka starter kit highlights">
          <div class="boka-lp__proof-stat">
            <span class="boka-lp__proof-number">nano-hydroxyapatite</span>
            <span class="boka-lp__proof-label">Backed by science</span>
          </div>

          <div class="boka-lp__proof-stat">
            <span class="boka-lp__proof-number">4.6★</span>
            <span class="boka-lp__proof-label">Loved by 950,000+ customers</span>
          </div>

          <div class="boka-lp__proof-stat">
            <span class="boka-lp__proof-number">Save 50%</span>
            <span class="boka-lp__proof-label">On your first order</span>
          </div>

          <div class="boka-lp__proof-stat">
            <span class="boka-lp__proof-number">3 month refills</span>
            <span class="boka-lp__proof-label">Right when you need them</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Boka LP hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": false
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "New Customer Offer:"
    },
    {
      "type": "text",
      "id": "announcement_link_text",
      "label": "Announcement link text",
      "default": "Start your fluoride-free n-Ha routine for $24.99 + free shipping"
    },
    {
      "type": "image_picker",
      "id": "promo_banner_image",
      "label": "Promo banner image"
    },
    {
      "type": "text",
      "id": "promo_banner_image_alt",
      "label": "Promo banner image alt text",
      "default": "Boka starter kit products on a clean background"
    },
    {
      "type": "text",
      "id": "promo_banner_eyebrow",
      "label": "Promo banner eyebrow",
      "default": "New Customer Offer"
    },
    {
      "type": "inline_richtext",
      "id": "promo_banner_heading",
      "label": "Promo banner heading",
      "default": "Start your fluoride-free n-Ha routine for $24.99"
    },
    {
      "type": "richtext",
      "id": "promo_banner_subtext",
      "label": "Promo banner subtext",
      "default": "<p>Try Boka with toothpaste, brush, floss, tongue cleaner, and a toiletry bag — plus free shipping on your first order.</p>"
    },
    {
      "type": "text",
      "id": "promo_banner_button_text",
      "label": "Promo banner button text",
      "default": "Start My Routine"
    },
    {
      "type": "url",
      "id": "promo_banner_button_link",
      "label": "Promo banner button link"
    },
    {
      "type": "range",
      "id": "button_corner_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "proof_bar_corner_radius",
      "label": "Bottom proof bar corner radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "proof_stat_corner_radius",
      "label": "Individual proof stat corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "text",
      "id": "offer_discount",
      "label": "First-order discount label",
      "default": "Save $15"
    }
  ],
  "presets": [
    {
      "name": "Boka LP hero"
    }
  ]
}
{% endschema %}