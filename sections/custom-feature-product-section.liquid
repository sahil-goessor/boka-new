<script>
// Sticky ATC - Shows everywhere except when viewing the product section
document.addEventListener('DOMContentLoaded', function() {
  const sticky = document.getElementById('sticky-atc');
  if (!sticky) return;
  
  const section = document.querySelector('[data-product-handle="{{ product.handle }}"]');
  const mainForm = section.querySelector('form[action^="/cart/add"]');
  const atcButton = sticky.querySelector('.product-buy-buttons button, #sticky-atc__button button');
  
  const titleEl = document.getElementById('sticky-atc-title');
  const variantEl = document.getElementById('sticky-atc-variant');
  const priceEl = document.getElementById('sticky-atc-price');
  const mediaEl = document.getElementById('sticky-atc-media');
  const subEl = document.getElementById('sticky-atc-sub');

  // Store product data directly
  let currentProduct = {{ product | json }};

  function updateSticky() {
    if (!mainForm) return;
    
    const variantIdInput = mainForm.querySelector('[name="id"]');
    if (!variantIdInput) return;
    
    const variantId = variantIdInput.value;
    const variant = currentProduct.variants.find(v => v.id == variantId);
    
    if (!variant) return;

    // Update image
    const activeMediaImg = section.querySelector('.product__media-list .is-active img, .product__media img.active');
    if (activeMediaImg && activeMediaImg.src) {
      mediaEl.src = activeMediaImg.src;
      mediaEl.alt = activeMediaImg.alt || '';
    }

    // Update title and variant
    titleEl.textContent = currentProduct.title;
    
    if (variant.options && variant.options.some(opt => opt !== 'Default Title')) {
      variantEl.style.display = 'block';
      variantEl.textContent = variant.options.join(', ');
    } else {
      variantEl.style.display = 'none';
    }

    // Update price
    let priceHtml = '';
    if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
      priceHtml = Shopify.formatMoney(variant.price);
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        priceHtml += `<span class="sticky-atc__compare">${Shopify.formatMoney(variant.compare_at_price)}</span>`;
      }
    } else {
      priceHtml = `$${(variant.price / 100).toFixed(2)}`;
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        priceHtml += `<span class="sticky-atc__compare">$${(variant.compare_at_price / 100).toFixed(2)}</span>`;
      }
    }
    priceEl.innerHTML = priceHtml;
  }

  // Show/hide based on product section visibility
  function handleScroll() {
    if (!section) return;
    
    const sectionRect = section.getBoundingClientRect();
    const windowHeight = window.innerHeight;
    
    // Calculate if the product section is in viewport
    const sectionTop = sectionRect.top;
    const sectionBottom = sectionRect.bottom;
    
    // Section is visible if:
    // - Top is above viewport bottom AND
    // - Bottom is below viewport top
    const isVisible = sectionTop < windowHeight && sectionBottom > 0;
    
    if (isVisible) {
      // Product section is visible - hide sticky bar
      sticky.classList.add('hidden');
    } else {
      // Product section is NOT visible - show sticky bar
      sticky.classList.remove('hidden');
      updateSticky();
    }
  }

  window.addEventListener('scroll', handleScroll);
  
  // Initial check on page load
  handleScroll();

  // Variant change listeners
  if (mainForm) {
    mainForm.addEventListener('change', function(e) {
      if (e.target.name === 'id' || e.target.type === 'radio') {
        setTimeout(updateSticky, 50);
      }
    });
  }

  document.addEventListener('variant:change', updateSticky);
  document.addEventListener('product:variant-change', updateSticky);

  // Handle ATC button click
  if (atcButton) {
    atcButton.addEventListener('click', function(e) {
      e.preventDefault();
      
      if (!mainForm) return;

      const formData = new FormData(mainForm);
      const variantId = formData.get('id');
      const quantity = formData.get('quantity') || 1;
      
      if (!variantId) return;

      const cartData = { 
        id: parseInt(variantId), 
        quantity: parseInt(quantity)
      };

      // Disable button
      atcButton.disabled = true;
      const originalText = atcButton.innerHTML;
      atcButton.innerHTML = 'Adding...';

      // Add to cart
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(cartData)
      })
      .then(response => response.json())
      .then(data => {
        atcButton.disabled = false;
        atcButton.innerHTML = originalText;
        
        // Open cart drawer
        const cartDrawer = document.querySelector('cart-drawer');
        if (cartDrawer) {
          if (typeof cartDrawer.open === 'function') {
            cartDrawer.open();
          } else {
            cartDrawer.classList.add('animate', 'active');
            cartDrawer.setAttribute('open', '');
          }
        }
      })
      .catch(error => {
        atcButton.disabled = false;
        atcButton.innerHTML = originalText;
        alert('Error adding product to cart');
      });
    });
  }

  // Initial update
  updateSticky();
});
</script>
</section>

