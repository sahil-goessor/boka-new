<section class="boka-lp boka-lp-refill">
  <div class="boka-lp__section boka-lp__section--white">
    <div class="boka-lp__wrap boka-lp-refill__wrap">

      <div class="boka-lp-refill__header">
        <p class="boka-lp__eyebrow">Starter kit today. Easy refills later.</p>
        <h2 class="boka-lp__section-title">
          Start with the full routine. Refill only what you need.
        </h2>
        <p class="boka-lp-refill__subtext">
          Get everything you need to build your daily routine up front — then keep it going with flexible refills every 3 months.
        </p>
      </div>

      <div class="boka-lp__routine-grid">

        <div class="boka-lp__routine-panel is-featured">
          <div class="boka-lp-refill__badge">First order</div>

          <div class="boka-lp-refill__price-row">
            <div>
              <h3>Complete Starter Kit</h3>
              <p class="boka-lp-refill__value">$49.99 value</p>
            </div>
            <div class="boka-lp-refill__price">
              <span class="boka-lp-refill__compare">$49.99</span>
              <strong>$24.99</strong>
            </div>
          </div>

          <p class="boka-lp-refill__panel-copy">
            Your first box includes the essentials for a complete Boka routine, with free shipping on your first order.
          </p>

          <ul class="boka-lp-refill__list">
            <li>n-Ha toothpaste</li>
            <li>Manual toothbrush</li>
            <li>Dental floss</li>
            <li>Tongue cleaner</li>
          </ul>

          <div class="boka-lp-refill__mini-note">
            Free shipping included
          </div>
        </div>

        <div class="boka-lp__routine-panel">
          <div class="boka-lp-refill__badge is-soft">Every 3 months</div>

          <div class="boka-lp-refill__price-row">
            <div>
              <h3>Refill Essentials</h3>
              <p class="boka-lp-refill__value">Only replace what runs out</p>
            </div>
            <div class="boka-lp-refill__save">
              Save 15%
            </div>
          </div>

          <p class="boka-lp-refill__panel-copy">
            Your refill keeps your routine stocked with the consumables you actually need — no extra brush or tongue cleaner unless you want them.
          </p>

          <ul class="boka-lp-refill__list">
            <li>Toothpaste refill</li>
            <li>Floss or selected add-ons</li>
            <li>15% off recurring refills</li>
            <li>Pause, skip, or cancel anytime</li>
          </ul>

          <div class="boka-lp-refill__mini-note is-muted">
            Flexible subscription through Recharge
          </div>
        </div>

      </div>

      <p class="boka-lp-refill__footer-note">
        No long-term commitment. Update your refill schedule anytime.
      </p>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Boka LP refill plan",
  "settings": [],
  "presets": [
    {
      "name": "Boka LP refill plan"
    }
  ]
}
{% endschema %}