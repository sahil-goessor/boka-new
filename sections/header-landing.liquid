  <script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
{% endif %}
{%- if settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<{% if section.settings.sticky_header_type != 'none' %}sticky-header data-sticky-type="{{ section.settings.sticky_header_type }}"{% else %}div{% endif %} class="landing-header-wrapper{% if section.settings.sticky_header_type != 'none' %} is-sticky{% endif %}">
  <header class="landing-header" role="banner">
    <button type="button" class="landing-header__icon landing-header__drawer-toggle" data-landing-menu-open aria-label="Open menu">
      {% render 'custom-icons', name: 'hamburger' %}
    </button>

    <div class="landing-header__logo-wrap">
      <a href="{{ routes.root_url }}" class="landing-header__logo-link" aria-label="{{ shop.name | escape }} home">
        {% if section.settings.logo != blank %}
          {% assign logo_alt = section.settings.logo.alt | default: shop.name | escape %}
          {{ section.settings.logo | image_url: width: 500 | image_tag: class: 'landing-header__logo', loading: 'eager', alt: logo_alt }}
        {% elsif settings.logo != blank %}
          {% assign logo_alt = settings.logo.alt | default: shop.name | escape %}
          {{ settings.logo | image_url: width: 500 | image_tag: class: 'landing-header__logo', loading: 'eager', alt: logo_alt }}
        {% else %}
          <span class="landing-header__logo-text">BOKA</span>
        {% endif %}
      </a>
    </div>

    {% if has_menu %}
      <nav class="landing-header__nav" aria-label="Landing page navigation">
        <ul class="landing-header__menu" role="list">
          {% for link in landing_menu.links %}
            <li>
              {% if link.links != blank %}
                <details>
                  <summary>{{ link.title | escape }}</summary>
                  <ul class="landing-header__submenu" role="list">
                    {% for childlink in link.links %}
                      <li><a href="{{ childlink.url }}">{{ childlink.title | escape }}</a></li>
                    {% endfor %}
                  </ul>
                </details>
              {% else %}
                <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}

    <div class="landing-header__actions">
      {% if section.settings.show_search %}
        <a href="{{ routes.search_url }}" class="landing-header__icon landing-header__search" aria-label="Search">
          {% render 'custom-icons', name: 'search' %}
        </a>
      {% endif %}

      {% if section.settings.show_account and shop.customer_accounts_enabled %}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="landing-header__icon landing-header__account" aria-label="Account">
          {% render 'custom-icons', name: 'user' %}
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="landing-header__icon landing-header__cart" id="cart-icon-bubble" aria-label="Cart">
        {% render 'custom-icons', name: 'cart' %}
        {% if cart != empty %}
          <div class="cart-count-bubble">
            {% if cart.item_count < 100 %}<span aria-hidden="true">{{ cart.item_count }}</span>{% endif %}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {% endif %}
      </a>
    </div>
  </header>
</{% if section.settings.sticky_header_type != 'none' %}sticky-header{% else %}div{% endif %}>

<div class="landing-menu-drawer" data-landing-menu-drawer aria-hidden="true">
  <button class="landing-menu-drawer__overlay" type="button" data-landing-menu-close aria-label="Close menu"></button>
  <div class="landing-menu-drawer__panel">
    <div class="landing-menu-drawer__head">
      <a href="{{ routes.root_url }}" class="landing-header__logo-link" aria-label="{{ shop.name | escape }} home">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 300 | image_tag: class: 'landing-header__logo', loading: 'lazy', alt: shop.name }}
        {% elsif settings.logo != blank %}
          {{ settings.logo | image_url: width: 300 | image_tag: class: 'landing-header__logo', loading: 'lazy', alt: shop.name }}
        {% else %}
          <span class="landing-header__logo-text">BOKA</span>
        {% endif %}
      </a>
      <button type="button" class="landing-menu-drawer__close" data-landing-menu-close aria-label="Close menu">×</button>
    </div>

    {% if has_menu %}
      <nav aria-label="Mobile landing page navigation">
        <ul class="landing-menu-drawer__menu" role="list">
          {% for link in landing_menu.links %}
            <li>
              {% if link.links != blank %}
                <details>
                  <summary>{{ link.title | escape }} <span>+</span></summary>
                  <ul class="landing-menu-drawer__submenu" role="list">
                    {% for childlink in link.links %}
                      <li><a href="{{ childlink.url }}">{{ childlink.title | escape }}</a></li>
                    {% endfor %}
                  </ul>
                </details>
              {% else %}
                <a href="{{ link.url }}">{{ link.title | escape }}</a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}
  </div>
</div>

{% if settings.cart_type == 'notification' %}
  {% render 'cart-notification', color_scheme: 'background-1', desktop_menu_type: 'dropdown' %}
{% endif %}

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    const drawer = section.querySelector('[data-landing-menu-drawer]');
    const openButton = section.querySelector('[data-landing-menu-open]');
    const closeButtons = section.querySelectorAll('[data-landing-menu-close]');

    const openDrawer = () => {
      if (!drawer) return;
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.classList.add('overflow-hidden');
    };

    const closeDrawer = () => {
      if (!drawer) return;
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('overflow-hidden');
    };

    openButton?.addEventListener('click', openDrawer);
    closeButtons.forEach(button => button.addEventListener('click', closeDrawer));

    drawer?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeDrawer);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeDrawer();
    });
  })();
</script>

{% javascript %}
  if (!customElements.get('sticky-header')) {
    class StickyHeader extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.header = this.closest('.shopify-section') || this;
        this.headerIsAlwaysSticky = this.getAttribute('data-sticky-type') === 'always' || this.getAttribute('data-sticky-type') === 'reduce-logo-size';
        this.headerBounds = {};
        this.currentScrollTop = 0;
        this.preventReveal = false;
        this.onScrollHandler = this.onScroll.bind(this);

        if (this.headerIsAlwaysSticky) {
          this.header.classList.add('shopify-section-header-sticky');
        }

        this.createObserver();
        window.addEventListener('scroll', this.onScrollHandler, false);
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.onScrollHandler);
      }

      createObserver() {
        const observer = new IntersectionObserver((entries, observer) => {
          this.headerBounds = entries[0].intersectionRect;
          observer.disconnect();
        });
        observer.observe(this.header);
      }

      onScroll() {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        if (this.headerIsAlwaysSticky) return;

        if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
          this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
        } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
          this.header.classList.add('shopify-section-header-sticky', 'animate');
          this.header.classList.remove('shopify-section-header-hidden');
        } else if (scrollTop <= this.headerBounds.top) {
          this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
        }

        this.currentScrollTop = scrollTop;
      }
    }

    customElements.define('sticky-header', StickyHeader);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Landing Header",
  "class": "section-header section-header-landing",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Landing logo override"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 120
    },
    {
      "type": "range",
      "id": "logo_text_size",
      "min": 16,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Text logo size",
      "default": 22
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Landing menu"
    },
    {
      "type": "select",
      "id": "sticky_header_type",
      "label": "Sticky header behavior",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "on-scroll-up", "label": "On scroll up" },
        { "value": "always", "label": "Always" },
        { "value": "reduce-logo-size", "label": "Always, reduce logo size" }
      ],
      "default": "always"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "label": "Show bottom border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": false
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_cta",
      "label": "Show CTA on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "page_width",
      "min": 960,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Page width",
      "default": 1320
    },
    {
      "type": "range",
      "id": "header_height",
      "min": 56,
      "max": 110,
      "step": 2,
      "unit": "px",
      "label": "Desktop header height",
      "default": 72
    },
    {
      "type": "range",
      "id": "mobile_header_height",
      "min": 52,
      "max": 90,
      "step": 2,
      "unit": "px",
      "label": "Mobile header height",
      "default": 64
    },
    {
      "type": "range",
      "id": "side_padding",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Side padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "menu_gap",
      "min": 10,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Menu gap",
      "default": 28
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "nav_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Desktop nav font size",
      "default": 14
    },
    {
      "type": "select",
      "id": "nav_font_weight",
      "label": "Desktop nav font weight",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "mobile_nav_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Mobile nav font size",
      "default": 17
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAFAF5"
    },
