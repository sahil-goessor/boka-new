{% liquid
  assign landing_menu = section.settings.menu
  assign has_menu = false

  if landing_menu != blank and landing_menu.links.size > 0
    assign has_menu = true
  endif
%}

<style>
  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 50;
  }

  #shopify-section-{{ section.id }} .landing-header-wrapper {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    border-bottom: {% if section.settings.show_line_separator %}1px solid rgba(34, 39, 33, .14){% else %}0{% endif %};
  }

  #shopify-section-{{ section.id }} sticky-header.landing-header-wrapper,
  #shopify-section-{{ section.id }} .landing-header-wrapper.is-sticky {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  #shopify-section-{{ section.id }} .landing-header {
    min-height: {{ section.settings.header_height }}px;
    max-width: {{ section.settings.page_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.side_padding }}px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 28px;
  }

  #shopify-section-{{ section.id }} .landing-header__logo-link {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .landing-header__logo-text {
    font-size: {{ section.settings.logo_text_size }}px;
    letter-spacing: .22em;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .landing-header__logo {
    display: block;
    max-width: {{ section.settings.logo_width }}px;
    height: auto;
  }

  #shopify-section-{{ section.id }} .landing-header__nav {
    justify-self: center;
  }

  #shopify-section-{{ section.id }} .landing-header__menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: {{ section.settings.menu_gap }}px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .landing-header__menu a,
  #shopify-section-{{ section.id }} .landing-header__menu summary {
    color: inherit;
    text-decoration: none;
    font-size: {{ section.settings.nav_font_size }}px;
    font-weight: {{ section.settings.nav_font_weight }};
    letter-spacing: .02em;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .landing-header__menu details {
    position: relative;
  }

  #shopify-section-{{ section.id }} .landing-header__submenu {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 220px;
    list-style: none;
    padding: 12px;
    margin: 0;
    background: {{ section.settings.background_color }};
    border: 1px solid rgba(34, 39, 33, .14);
    border-radius: 16px;
    box-shadow: 0 16px 38px rgba(34, 39, 33, .12);
    display: grid;
    gap: 8px;
    z-index: 5;
  }

  #shopify-section-{{ section.id }} .landing-header__submenu a {
    display: block;
    padding: 8px 10px;
    border-radius: 10px;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .landing-header__submenu a:hover {
    background: {{ section.settings.hover_background }};
  }

  #shopify-section-{{ section.id }} .landing-header__actions {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }


  #shopify-section-{{ section.id }} .landing-header__icon {
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    color: inherit;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    text-decoration: none;
    cursor: pointer;
    position: relative;
  }

  #shopify-section-{{ section.id }} .landing-header__icon svg {
    width: 23px;
    height: 23px;
  }

  #shopify-section-{{ section.id }} .cart-count-bubble {
    position: absolute;
    right: 1px;
    top: 1px;
    min-width: 17px;
    height: 17px;
    border-radius: 99px;
    background: {{ section.settings.cart_bubble_background }};
    color: {{ section.settings.cart_bubble_text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 800;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .landing-header__drawer-toggle {
    display: none;
  }

  #shopify-section-{{ section.id }} .landing-menu-drawer {
    position: fixed;
    inset: 0;
    z-index: 80;
    pointer-events: none;
    visibility: hidden;
  }

  #shopify-section-{{ section.id }} .landing-menu-drawer.is-open {
    pointer-events: auto;
    visibility: visible;
  }

  #shopify-section-{{ section.id }} .landing-menu-drawer__overlay {
    position: absolute;
    inset: 0;
    background: rgba(34, 39, 33, .38);
    opacity: 0;
    transition: opacity .2s ease;
  }

  #shopify-section-{{ section.id }} .landing-menu-drawer.is-open .landing-menu-drawer__overlay {
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .landing-menu-drawer__panel {
    position: absolute;
    top: 0;
    left: 0;
    width: min(88vw, 390px);
    height: 100%;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    transform: translateX(-100%);
    transition: transform .24s ease;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    overflow-y: auto;
  }

  #shopify-section-{{ section.id }} .landing-menu-drawer.is-open .landing-menu-drawer__panel {
    transform: translateX(0);
  }

  #shopify-section-{{ section.id }} .landing-menu-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .landing-menu-drawer__close {
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .landing-menu-drawer__menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
  }

  #shopify-section-{{ section.id }} .landing-menu-drawer__menu a,
  #shopify-section-{{ section.id }} .landing-menu-drawer__menu summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 0;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(34, 39, 33, .12);
    font-size: {{ section.settings.mobile_nav_font_size }}px;
    font-weight: 800;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .landing-menu-drawer__submenu {
    list-style: none;
    margin: 0;
    padding: 0 0 8px 14px;
  }

  #shopify-section-{{ section.id }} .landing-menu-drawer__submenu a {
    font-size: 14px;
    color: rgba(34, 39, 33, .72);
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .landing-header {
      grid-template-columns: auto 1fr auto;
      padding-left: 16px;
      padding-right: 16px;
      gap: 12px;
      min-height: {{ section.settings.mobile_header_height }}px;
    }

    #shopify-section-{{ section.id }} .landing-header__drawer-toggle {
      display: inline-flex;
      justify-self: start;
    }

    #shopify-section-{{ section.id }} .landing-header__logo-wrap {
      justify-self: center;
    }

    #shopify-section-{{ section.id }} .landing-header__nav {
      display: none;
    }

    #shopify-section-{{ section.id }} .landing-header__actions {
      gap: 2px;
    }

    #shopify-section-{{ section.id }} .landing-header__cta {
      display: {% if section.settings.show_mobile_cta %}inline-flex{% else %}none{% endif %};
      min-height: 36px;
      padding: 0 12px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .landing-header__search,
    #shopify-section-{{ section.id }} .landing-header__account {
      display: none;
    }
  }
</style>

