<script>
  (function() {
    class ReviewSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-reviews-slider-track-{{ ai_gen_id }}');
        this.slides = Array.from(this.querySelectorAll('.ai-review-slide-{{ ai_gen_id }}'));
        this.prevButton = this.querySelector('.ai-slider-nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-slider-nav-next-{{ ai_gen_id }}');
        this.dotsWrapper = this.querySelector('.ai-slider-dots-wrapper-{{ ai_gen_id }}');

        if (this.slides.length === 0) return;

        this.createPagination();
        this.setupEventListeners();
        this.updateSlider();
      }

      createPagination() {
        this.dotsWrapper.innerHTML = '';
        
        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.classList.add('ai-slider-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to review ${index + 1}`);
          if (index === 0) dot.classList.add('active');
          dot.addEventListener('click', () => this.goToSlide(index));
          this.dotsWrapper.appendChild(dot);
        });
        
        this.dots = Array.from(this.querySelectorAll('.ai-slider-dot-{{ ai_gen_id }}'));
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.prevSlide());
        this.nextButton.addEventListener('click', () => this.nextSlide());
      }

      prevSlide() {
        this.currentSlide = this.currentSlide === 0 ? this.slides.length - 1 : this.currentSlide - 1;
        this.updateSlider();
      }

      nextSlide() {
        this.currentSlide = this.currentSlide === this.slides.length - 1 ? 0 : this.currentSlide + 1;
        this.updateSlider();
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateSlider();
      }

      updateSlider() {
        const offset = -this.currentSlide * 100;
        this.track.style.transform = `translateX(${offset}%)`;

        this.dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('review-slider-{{ ai_gen_id }}', ReviewSlider{{ ai_gen_id }});
  })();

    // Cart functionality for reviews CTA button only
  (function() {
    const button = document.querySelector('.ai-reviews-cta-button-{{ ai_gen_id }}');
    
    if (button) {
      button.addEventListener('click', async function(e) {
        e.preventDefault();
        
        const action = this.dataset.buttonAction;
        const link = this.dataset.buttonLink;
        const variantId = this.dataset.variantId;
        const quantity = parseInt(this.dataset.productQuantity) || 1;
        
        // If action is regular link, just navigate
        if (action === 'link' || !variantId) {
          if (link) {
            window.location.href = link;
          }
          return;
        }
        
        // Show loader
        const textEl = this.querySelector('.ai-reviews-cta-button-text-{{ ai_gen_id }}');
        const loaderEl = this.querySelector('.ai-reviews-cta-button-loader-{{ ai_gen_id }}');
        const originalText = textEl.textContent;
        textEl.style.display = 'none';
        loaderEl.style.display = 'inline-flex';
        this.disabled = true;
        
        try {
          // Add to cart via AJAX
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({
              items: [{
                id: variantId,
                quantity: quantity
              }]
            })
          });
          
          if (!response.ok) {
            throw new Error('Failed to add to cart');
          }
          
          // Trigger cart update event
          document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', {
            bubbles: true
          }));
          
          // Redirect based on action
          if (action === 'add_and_checkout') {
            window.location.href = '/checkout';
          } else if (action === 'add_and_cart') {
            // Attempt to open side cart drawer (tries common theme patterns)
            document.documentElement.dispatchEvent(new CustomEvent('cart:open', { bubbles: true }));
            document.dispatchEvent(new CustomEvent('cart:open', { bubbles: true }));

            // Dawn / common Shopify themes
            const cartDrawer = document.querySelector('cart-drawer');
            if (cartDrawer && typeof cartDrawer.open === 'function') {
              cartDrawer.open();
            }

            // Try toggling common side cart elements used by popular themes
            const sideCartSelectors = [
              '[data-drawer="cart"]',
              '[data-cart-drawer]',
              '#cart-drawer',
              '.cart-drawer',
              '#CartDrawer',
              '.CartDrawer',
              '[aria-controls="cart-drawer"]'
            ];

            sideCartSelectors.forEach(selector => {
              const el = document.querySelector(selector);
              if (el) {
                el.classList.add('is-open', 'active', 'open');
                el.setAttribute('aria-hidden', 'false');
              }
            });

            // Reset button
            textEl.textContent = '✓ Added to Cart';
            textEl.style.display = 'inline';
            loaderEl.style.display = 'none';
            this.disabled = false;

            setTimeout(() => {
              textEl.textContent = '{{ block.settings.button_text }}';
            }, 2000);
          } else if (action === 'add_and_stay') {
            textEl.textContent = '✓ Added to Cart';
            textEl.style.display = 'inline';
            loaderEl.style.display = 'none';
            this.disabled = false;
            
            setTimeout(() => {
              textEl.textContent = originalText;
            }, 2000);
          }
        } catch (error) {
          console.error('Error adding to cart:', error);
          
          textEl.textContent = 'Error - Try Again';
          textEl.style.display = 'inline';
          loaderEl.style.display = 'none';
          this.disabled = false;
          
          setTimeout(() => {
            textEl.textContent = originalText;
          }, 2000);
        }
      });
    }
  })();

  // Subheadline popups
(function() {
  const pills = document.querySelectorAll('.ai-subheadline-pill-{{ ai_gen_id }}[data-popup]');

  pills.forEach(pill => {
    pill.addEventListener('click', function(e) {
      e.stopPropagation();
      const targetId = this.dataset.popup;
      const popup = document.getElementById(targetId);
      if (!popup) return;

      const isOpen = popup.classList.contains('is-open');

      // Close all popups first
      document.querySelectorAll('.ai-subheadline-popup-{{ ai_gen_id }}').forEach(p => {
        p.classList.remove('is-open');
      });

      // Toggle the clicked one
      if (!isOpen) {
        popup.classList.add('is-open');
      }
    });
  });

  // Close popup when clicking outside
  document.addEventListener('click', function() {
    document.querySelectorAll('.ai-subheadline-popup-{{ ai_gen_id }}').forEach(p => {
      p.classList.remove('is-open');
    });
  });

  // Scroll links inside popups
  document.querySelectorAll('.ai-subheadline-popup-link-{{ ai_gen_id }}[data-scroll-target]').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      const targetId = this.dataset.scrollTarget;
      const target = document.getElementById(targetId);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      // Close popup after clicking
      document.querySelectorAll('.ai-subheadline-popup-{{ ai_gen_id }}').forEach(p => {
        p.classList.remove('is-open');
      });
    });
  });
})();
</script>

