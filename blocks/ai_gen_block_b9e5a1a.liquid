      "label": "Mobile body text size",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_media_min_height",
      "min": 200,
      "max": 600,
      "step": 50,
      "unit": "px",
      "label": "Mobile media minimum height",
      "default": 300
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 20,
      "max": 60,
      "step": 10,
      "unit": "px",
      "label": "Mobile gap",
      "default": 30
