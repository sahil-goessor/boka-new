      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Mobile padding horizontal",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
