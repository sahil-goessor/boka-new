{% doc %}
  @prompt
    Create a Hero Banner section. On the left side, include a small customer reviews rating with the text “3,700+ Reviews” below it, followed by a headline and body text. Below the text, display two small claim icons with accompanying text, aligned inline-block. Underneath the icons, include a CTA button. On the right side, provide an option to upload an image or video. The uploaded hero banner asset should automatically adapt based on its size, supporting small, medium, or tall heights as needed. The entire hero banner should have an option to update the background color and be fully responsive for both mobile and desktop views., In the media section please add option to select adopt image/video size , Please have option to update the content alignment for mobile view , On mobile view, The CTA button on mobile view should be fully responsive, automatically adjusting its width based on the screen size while maintaining appropriate margins., Please have an option to adjust the width and height of the cta button on both mobile and desktop view, Please have option to adjust the margin of the contents on both mobile and desktop view, The star ratings and the “3,700+ Reviews” text should appear on a single line, positioned just above the headline, with proper spacing to ensure a clean and balanced layout., Should have an option to adjust the margin of the star ratings section, On desktop the two claims should be in one line only , Adjust the position of 3,700+Reviews please close it enough in the headline they should be close enough, Include an option to upload separate media assets for mobile and desktop views, allowing different images or videos to be displayed depending on the device., have an option to adjust the padding on the left and right side of the whole hero banner section, On the desktop media image and video the container should adopt based on the size of the uploaded asset, Let's have a fix  media setting the height of the hero banner should be just 400px, When I upload the media image asset it should show the whole image size in the hero banner media section it should not be cropped, should have padding on the left and right side 100px for both on desktop view and 24px on mobile view, Adjust the height of the container instead of 400px make it 500px, Please have an option to adjust the font weight of the headline, The font family of the contents should be Neue Haas Unica Pro
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-banner-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 100px {{ block.settings.section_padding_bottom }}px 100px;
    font-family: 'Archivo', sans-serif;
  }

  .ai-hero-banner-container-{{ ai_gen_id }} {
    max-width: 1800px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .ai-hero-banner-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-hero-banner-reviews-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-hero-banner-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    color: {{ block.settings.star_color }};
  }

  .ai-hero-banner-stars-{{ ai_gen_id }} svg {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: currentColor;
  }

  .ai-hero-banner-review-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
    white-space: nowrap;
  }

  .ai-hero-banner-customer-badge-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .ai-hero-banner-customer-info-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-right: 5px;
  }

  .ai-hero-banner-badge-icon-{{ ai_gen_id }} {
    width: {{ block.settings.badge_icon_size }}px;
    height: 20px;
    flex-shrink: 0;
  }

  .ai-hero-banner-badge-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-hero-banner-badge-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .ai-hero-banner-badge-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-hero-banner-customer-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.customer_name_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
  }

  .ai-hero-banner-verified-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.verified_text_size }}px;
    color: {{ block.settings.verified_text_color }};
    font-weight: 400;
  }

  .ai-hero-banner-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.2;
    font-weight: {{ block.settings.headline_font_weight }};
  }

  .ai-hero-banner-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-hero-banner-claims-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: nowrap;
    gap: 20px;
  }

  .ai-hero-banner-claim-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .ai-hero-banner-claim-icon-{{ ai_gen_id }} {
    width: {{ block.settings.claim_icon_size }}px;
    height: {{ block.settings.claim_icon_size }}px;
    flex-shrink: 0;
  }

  .ai-hero-banner-claim-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-hero-banner-claim-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-hero-banner-claim-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-hero-banner-claim-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.claim_text_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-hero-banner-cta-wrapper-{{ ai_gen_id }} {
    display: inline-block;
  }

  {% comment %} .ai-hero-banner-cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.button_width }}px;
    height: {{ block.settings.button_height }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: background-color 0.3s ease;
    border: none;
    cursor: pointer;
    box-sizing: border-box;
  }

  .ai-hero-banner-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  } {% endcomment %}

  .ai-hero-banner-cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: {{ block.settings.button_width }}px;
    height: {{ block.settings.button_height }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: background-color 0.3s ease;
    border: none;
    cursor: pointer;
    box-sizing: border-box;
    position: relative;
  }

  .ai-hero-banner-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-hero-banner-cta-{{ ai_gen_id }}:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .ai-hero-banner-cta-loader-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-banner-cta-loader-{{ ai_gen_id }} svg {
    animation: ai-hero-banner-spin-{{ ai_gen_id }} 1s linear infinite;
  }

  @keyframes ai-hero-banner-spin-{{ ai_gen_id }} {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .ai-hero-banner-media-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-hero-banner-media-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 500px;
    overflow: hidden;
    border-radius: {{ block.settings.media_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-banner-media-wrapper-{{ ai_gen_id }} img,
  .ai-hero-banner-media-wrapper-{{ ai_gen_id }} video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .ai-hero-banner-media-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-banner-media-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-hero-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-hero-banner-media-desktop-{{ ai_gen_id }} {
    display: block;
  }

  .ai-hero-banner-media-mobile-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .ai-hero-banner-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-hero-banner-headline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.headline_size }}px * 0.8);
    }

    .ai-hero-banner-body-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.body_text_size }}px * 0.9);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-hero-banner-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px 24px {{ block.settings.section_padding_bottom_mobile }}px 24px;
    }

    .ai-hero-banner-content-{{ ai_gen_id }} {
      align-items: {{ block.settings.mobile_content_alignment }};
      text-align: {{ block.settings.mobile_content_alignment }};
      gap: {{ block.settings.content_gap_mobile }}px;
    }

    .ai-hero-banner-reviews-{{ ai_gen_id }} {
      {% if block.settings.mobile_content_alignment == 'center' %}
        justify-content: center;
      {% elsif block.settings.mobile_content_alignment == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
    }

    .ai-hero-banner-customer-badge-{{ ai_gen_id }} {
      {% if block.settings.mobile_content_alignment == 'center' %}
        justify-content: center;
      {% elsif block.settings.mobile_content_alignment == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
    }

    .ai-hero-banner-claims-{{ ai_gen_id }} {
      flex-wrap: wrap;
      {% if block.settings.mobile_content_alignment == 'center' %}
        justify-content: center;
      {% elsif block.settings.mobile_content_alignment == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
    }

    .ai-hero-banner-headline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.headline_size }}px * 0.65);
    }

    .ai-hero-banner-claims-{{ ai_gen_id }} {
      gap: 16px;
    }

    .ai-hero-banner-claim-icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.claim_icon_size }}px * 0.8);
      height: calc({{ block.settings.claim_icon_size }}px * 0.8);
    }

    .ai-hero-banner-cta-wrapper-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-hero-banner-cta-{{ ai_gen_id }} {
      width: {{ block.settings.button_width_mobile }}%;
      height: {{ block.settings.button_height_mobile }}px;
      max-width: 100%;
    }

    .ai-hero-banner-media-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-banner-media-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-hero-banner-media-wrapper-{{ ai_gen_id }} {
      height: 300px;
    }

    /* Mobile layout order control */
    {% if block.settings.mobile_layout_order == 'image_first' %}
      .ai-hero-banner-container-{{ ai_gen_id }} {
        display: flex;
        flex-direction: column;
      }

      .ai-hero-banner-media-{{ ai_gen_id }} {
        order: 1;
      }

      .ai-hero-banner-content-{{ ai_gen_id }} {
        order: 2;
        display: flex;
        flex-direction: column;
      }

      .ai-hero-banner-reviews-{{ ai_gen_id }} {
        order: 4;
      }

      .ai-hero-banner-customer-badge-{{ ai_gen_id }} {
        order: 5;
      }

      .ai-hero-banner-cta-wrapper-{{ ai_gen_id }} {
        order: 2;
      }

      .ai-hero-banner-headline-{{ ai_gen_id }} {
        order: 3;
      }

      .ai-hero-banner-body-{{ ai_gen_id }} {
        order: 6;
      }

      .ai-hero-banner-claims-{{ ai_gen_id }} {
        order: 7;
      }
    {% endif %}
  }
{% endstyle %}

<div class="ai-hero-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-banner-container-{{ ai_gen_id }}">
    <div class="ai-hero-banner-content-{{ ai_gen_id }}">
      {% if block.settings.show_reviews %}
        <div class="ai-hero-banner-reviews-{{ ai_gen_id }}">
          <div class="ai-hero-banner-stars-{{ ai_gen_id }}">
            {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endfor %}
          </div>
          <div class="ai-hero-banner-review-text-{{ ai_gen_id }}">
            {{ block.settings.review_text }}
          </div>
        </div>
      {% endif %}

      {% if block.settings.headline != blank %}
        <h1 class="ai-hero-banner-headline-{{ ai_gen_id }}">
          {{ block.settings.headline }}
        </h1>
      {% endif %}

      {% if block.settings.show_customer_badge %}
        <div class="ai-hero-banner-customer-badge-{{ ai_gen_id }}">
          <div class="ai-hero-banner-customer-info-{{ ai_gen_id }}">
            
            {% if block.settings.customer_name != blank %}
              <span class="ai-hero-banner-customer-name-{{ ai_gen_id }}">
                {{ block.settings.customer_name }}
              </span>
            {% endif %}
          </div>
          <div class="ai-hero-banner-badge-icon-{{ ai_gen_id }}">
              {% if block.settings.badge_icon %}
                <img
                  src="{{ block.settings.badge_icon | image_url: width: 100 }}"
                  alt="{{ block.settings.badge_icon.alt | escape }}"
                  loading="lazy"
                  width="100"
                  height="100"
                >
              {% else %}
                <div class="ai-hero-banner-badge-icon-placeholder-{{ ai_gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                  </svg>
                </div>
              {% endif %}
            </div>
          {% if block.settings.show_verified_text %}
            <span class="ai-hero-banner-verified-text-{{ ai_gen_id }}">
              {{ block.settings.verified_text }}
            </span>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.body_text != blank %}
        <div class="ai-hero-banner-body-{{ ai_gen_id }}">
          {{ block.settings.body_text }}
        </div>
      {% endif %}

      <div class="ai-hero-banner-claims-{{ ai_gen_id }}">
        {% if block.settings.show_claim_1 %}
          <div class="ai-hero-banner-claim-{{ ai_gen_id }}">
            <div class="ai-hero-banner-claim-icon-{{ ai_gen_id }}">
              {% if block.settings.claim_1_icon %}
                <img
                  src="{{ block.settings.claim_1_icon | image_url: width: 100 }}"
                  alt="{{ block.settings.claim_1_icon.alt | escape }}"
                  loading="lazy"
                  width="100"
                  height="100"
                >
              {% else %}
                <div class="ai-hero-banner-claim-icon-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            {% if block.settings.claim_1_text != blank %}
              <span class="ai-hero-banner-claim-text-{{ ai_gen_id }}">
                {{ block.settings.claim_1_text }}
              </span>
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.show_claim_2 %}
          <div class="ai-hero-banner-claim-{{ ai_gen_id }}">
            <div class="ai-hero-banner-claim-icon-{{ ai_gen_id }}">
              {% if block.settings.claim_2_icon %}
                <img
                  src="{{ block.settings.claim_2_icon | image_url: width: 100 }}"
                  alt="{{ block.settings.claim_2_icon.alt | escape }}"
                  loading="lazy"
                  width="100"
                  height="100"
                >
              {% else %}
                <div class="ai-hero-banner-claim-icon-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            {% if block.settings.claim_2_text != blank %}
              <span class="ai-hero-banner-claim-text-{{ ai_gen_id }}">
                {{ block.settings.claim_2_text }}
              </span>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% if block.settings.button_text != blank %}
        <div class="ai-hero-banner-cta-wrapper-{{ ai_gen_id }} ai_button_sticky_hide">
          <button
            type="button"
            class="ai-hero-banner-cta-{{ ai_gen_id }}"
            data-button-action="{{ block.settings.button_action }}"
            data-button-link="{{ block.settings.button_link }}"
            data-variant-id="{{ block.settings.variant_id }}"
            data-product-quantity="{{ block.settings.product_quantity }}"
          >
            <span class="ai-hero-banner-cta-text-{{ ai_gen_id }}">{{ block.settings.button_text }}</span>
            <span class="ai-hero-banner-cta-loader-{{ ai_gen_id }}" style="display: none;">
              <svg width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" opacity="0.25"/>
                <path d="M12 2 A10 10 0 0 1 22 12" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round"/>
              </svg>
            </span>
          </button>
        </div>
      {% endif %}
    </div>

    <div class="ai-hero-banner-media-{{ ai_gen_id }}">
      <div class="ai-hero-banner-media-desktop-{{ ai_gen_id }}">
        <div class="ai-hero-banner-media-wrapper-{{ ai_gen_id }}">
          {% if block.settings.hero_image %}
            <img
              src="{{ block.settings.hero_image | image_url: width: 1200 }}"
              alt="{{ block.settings.hero_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.hero_image.width }}"
              height="{{ block.settings.hero_image.height }}"
            >
          {% elsif block.settings.hero_video %}
            <video
              autoplay
              muted
              loop
              playsinline
            >
              <source src="{{ block.settings.hero_video }}" type="video/mp4">
            </video>
          {% else %}
            <div class="ai-hero-banner-media-placeholder-{{ ai_gen_id }}">
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
              <div class="ai-hero-banner-empty-state-{{ ai_gen_id }}">
                Next, add a desktop image or video
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-hero-banner-media-mobile-{{ ai_gen_id }}">
        <div class="ai-hero-banner-media-wrapper-{{ ai_gen_id }}">
          {% if block.settings.hero_image_mobile %}
            <img
              src="{{ block.settings.hero_image_mobile | image_url: width: 800 }}"
              alt="{{ block.settings.hero_image_mobile.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.hero_image_mobile.width }}"
              height="{{ block.settings.hero_image_mobile.height }}"
            >
          {% elsif block.settings.hero_video_mobile %}
            <video
              autoplay
              muted
              loop
              playsinline
            >
              <source src="{{ block.settings.hero_video_mobile }}" type="video/mp4">
            </video>
          {% elsif block.settings.hero_image %}
            <img
              src="{{ block.settings.hero_image | image_url: width: 800 }}"
              alt="{{ block.settings.hero_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.hero_image.width }}"
              height="{{ block.settings.hero_image.height }}"
            >
          {% elsif block.settings.hero_video %}
            <video
              autoplay
              muted
              loop
              playsinline
            >
              <source src="{{ block.settings.hero_video }}" type="video/mp4">
            </video>
          {% else %}
            <div class="ai-hero-banner-media-placeholder-{{ ai_gen_id }}">
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
              <div class="ai-hero-banner-empty-state-{{ ai_gen_id }}">
                Next, add a mobile image or video
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  const buttons = document.querySelectorAll('.ai-hero-banner-cta-{{ ai_gen_id }}');
  
  buttons.forEach(button => {
    button.addEventListener('click', async function(e) {
      e.preventDefault();
      
      const action = this.dataset.buttonAction;
      const link = this.dataset.buttonLink;
      const variantId = this.dataset.variantId;
      const quantity = parseInt(this.dataset.productQuantity) || 1;
      
      // If action is regular link, just navigate
      if (action === 'link' || !variantId) {
        if (link) {
          window.location.href = link;
        }
        return;
      }
      
      // Show loader
      const textEl = this.querySelector('.ai-hero-banner-cta-text-{{ ai_gen_id }}');
      const loaderEl = this.querySelector('.ai-hero-banner-cta-loader-{{ ai_gen_id }}');
      textEl.style.display = 'none';
      loaderEl.style.display = 'inline-flex';
      this.disabled = true;
      
      try {
        // Add to cart via AJAX
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            items: [{
              id: variantId,
              quantity: quantity
            }]
          })
        });
        
        if (!response.ok) {
          throw new Error('Failed to add to cart');
        }
        
        // Trigger cart update event for themes that listen to it
        document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', {
          bubbles: true
        }));
        
        // Redirect based on action
        if (action === 'add_and_checkout') {
          window.location.href = '/checkout';
        } else if (action === 'add_and_cart') {
          window.location.href = '/cart';
        } else if (action === 'add_and_stay') {
          // Just added to cart, show success briefly then reset button
          textEl.textContent = '✓ Added to Cart';
          textEl.style.display = 'inline';
          loaderEl.style.display = 'none';
          this.disabled = false;
          
          setTimeout(() => {
            textEl.textContent = '{{ block.settings.button_text }}';
          }, 2000);
        }
      } catch (error) {
        console.error('Error adding to cart:', error);
        
        // Show error state
        textEl.textContent = 'Error - Try Again';
        textEl.style.display = 'inline';
        loaderEl.style.display = 'none';
        this.disabled = false;
        
        setTimeout(() => {
          textEl.textContent = '{{ block.settings.button_text }}';
        }, 2000);
      }
    });
  });
})();
</script>

