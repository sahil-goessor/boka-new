    "custom_liquid_VrGMDc": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- liquid\n  assign card_1_image = product.metafields.custom.a_blend_of_science_flavor_1_ingredient_image.value\n  assign card_1_title = product.metafields.custom.ingredients1_a_blend_of_science_flavor.value\n  assign card_1_desc = product.metafields.custom.description_ingredients1_a_blend_of_science_flavor\n\n  assign card_2_image = product.metafields.custom.a_blend_of_science_flavor_2_ingredient_image.value\n  assign card_2_title = product.metafields.custom.a_blend_of_science_flavor_2_ingredient_title.value\n  assign card_2_desc = product.metafields.custom.a_blend_of_science_flavor_2_ingredient_desc\n\n  assign card_3_image = product.metafields.custom.a_blend_of_science_flavor_3_ingredient_image.value\n  assign card_3_title = product.metafields.custom.a_blend_of_science_flavor_3_ingredient_title.value\n  assign card_3_desc = product.metafields.custom.a_blend_of_science_flavor_3_ingredient_desc\n\n  assign card_4_image = product.metafields.custom.a_blend_of_science_flavor_4_ingredient_image.value\n  assign card_4_title = product.metafields.custom.a_blend_of_science_flavor_4_ingredient_title.value\n  assign card_4_desc = product.metafields.custom.a_blend_of_science_flavor_4_ingredient_desc\n\n  assign card_count = 0\n\n  if card_1_image != blank or card_1_title != blank or card_1_desc != blank\n    assign card_count = card_count | plus: 1\n  endif\n\n  if card_2_image != blank or card_2_title != blank or card_2_desc != blank\n    assign card_count = card_count | plus: 1\n  endif\n\n  if card_3_image != blank or card_3_title != blank or card_3_desc != blank\n    assign card_count = card_count | plus: 1\n  endif\n\n  if card_4_image != blank or card_4_title != blank or card_4_desc != blank\n    assign card_count = card_count | plus: 1\n  endif\n-%}\n\n{%- if card_count > 0 -%}\n  <style>\n    #boka-ingredient-grid-{{ product.id }} {\n      --ingredient-grid-bg: #ffffff;\n      --ingredient-grid-card-bg: #ffffff;\n      --ingredient-grid-text: #222721;\n      --ingredient-grid-muted: rgba(34, 39, 33, 0.72);\n      --ingredient-grid-border: #d9d9e3;\n      --ingredient-grid-card-count: {{ card_count }};\n      background: var(--ingredient-grid-bg);\n      color: var(--ingredient-grid-text);\n      padding: 40px 0;\n      font-family: var(--font-body-family), inherit;\n    }\n\n    #boka-ingredient-grid-{{ product.id }} * {\n      box-sizing: border-box;\n    }\n\n    #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__inner {\n      max-width: 1280px;\n      margin-inline: auto;\n      padding-inline: var(--container-gutter, 20px);\n    }\n\n    #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__header {\n      max-width: 720px;\n      margin-bottom: 28px;\n      text-align: left;\n    }\n\n    #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__heading {\n      margin: 0;\n      color: #222721;\n      font-family: var(--font-heading-family), var(--font-body-family), inherit;\n      font-size: clamp(34px, 4vw, 56px);\n      font-weight: 400;\n      line-height: 0.98;\n      letter-spacing: -0.04em;\n    }\n\n    #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__subheading {\n      max-width: 640px;\n      margin-top: 16px;\n      color: rgba(34, 39, 33, 0.72);\n      font-size: 15px;\n      line-height: 1.45;\n    }\n\n    #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__subheading p {\n      margin: 0;\n    }\n\n    #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__cards {\n      display: flex;\n      gap: 14px;\n      justify-content: flex-start;\n      align-items: stretch;\n      overflow-x: auto;\n      overflow-y: hidden;\n      scroll-snap-type: x mandatory;\n      scroll-padding-left: var(--container-gutter, 20px);\n      padding: 0 var(--container-gutter, 20px) 10px;\n      margin-inline: calc(var(--container-gutter, 20px) * -1);\n      -webkit-overflow-scrolling: touch;\n      scrollbar-width: none;\n    }\n\n    #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__cards::-webkit-scrollbar {\n      display: none;\n    }\n\n    #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__card {\n      flex: 0 0 78%;\n      max-width: 310px;\n      min-height: 330px;\n      padding: 18px;\n      border: 1px solid var(--ingredient-grid-border);\n      border-radius: 10px;\n      background: var(--ingredient-grid-card-bg);\n      color: var(--ingredient-grid-text);\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      overflow: hidden;\n      scroll-snap-align: start;\n    }\n\n    #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__image-wrap {\n      width: 100%;\n      height: 190px;\n      margin: 0 auto 18px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__image {\n      width: 116%;\n      height: 116%;\n      object-fit: contain;\n      display: block;\n      transform: scale(1.1);\n      filter: drop-shadow(0 14px 18px rgba(34, 39, 33, 0.12));\n      transition: transform 180ms ease, filter 180ms ease;\n    }\n\n    #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__content {\n      margin-top: auto;\n      text-align: center;\n    }\n\n    #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__title {\n      margin: 0;\n      color: #222721;\n      font-family: var(--font-heading-family), var(--font-body-family), inherit;\n      font-size: 20px;\n      font-weight: 400;\n      line-height: 1.12;\n      letter-spacing: -0.035em;\n    }\n\n    #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__desc {\n      max-width: 92%;\n      margin: 10px auto 0;\n      color: var(--ingredient-grid-muted);\n      font-size: 13px;\n      line-height: 1.45;\n    }\n\n    #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__desc p {\n      margin: 0;\n    }\n\n    @media screen and (min-width: 700px) and (max-width: 999px) {\n      #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__cards {\n        display: grid;\n        grid-template-columns: repeat({% if card_count > 1 %}2{% else %}1{% endif %}, minmax(0, 260px));\n        justify-content: center;\n        overflow: visible;\n        padding: 0;\n        margin-inline: 0;\n      }\n\n      #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__card {\n        flex: none;\n        max-width: none;\n      }\n    }\n\n    @media screen and (min-width: 1000px) {\n      #boka-ingredient-grid-{{ product.id }} {\n        padding: 96px 0;\n      }\n\n      #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__header {\n        margin-bottom: 40px;\n      }\n\n      #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__subheading {\n        font-size: 16px;\n      }\n\n      #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__cards {\n        display: grid;\n        grid-template-columns: repeat(var(--ingredient-grid-card-count), minmax(0, 260px));\n        gap: 22px;\n        justify-content: center;\n        align-items: stretch;\n        overflow: visible;\n        padding: 0;\n        margin-inline: 0;\n      }\n\n      #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__card {\n        flex: none;\n        max-width: none;\n        min-height: 350px;\n        padding: 18px 18px 20px;\n        transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;\n      }\n\n      #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__card:hover {\n        transform: translateY(-4px);\n        box-shadow: 0 18px 40px rgba(34, 39, 33, 0.08);\n        border-color: rgba(34, 39, 33, 0.24);\n      }\n\n      #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__image-wrap {\n        height: 220px;\n        margin-bottom: 20px;\n      }\n\n      #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__image {\n        width: 112%;\n        height: 112%;\n        transform: scale(1.08);\n      }\n\n      #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__card:hover .ingredient-grid-section__image {\n        transform: scale(1.14);\n        filter: drop-shadow(0 18px 22px rgba(34, 39, 33, 0.16));\n      }\n\n      #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__title {\n        font-size: 22px;\n      }\n\n      #boka-ingredient-grid-{{ product.id }} .ingredient-grid-section__desc {\n        font-size: 13px;\n      }\n    }\n  </style>\n\n  <div id=\"boka-ingredient-grid-{{ product.id }}\" class=\"ingredient-grid-section\">\n    <div class=\"ingredient-grid-section__inner\">\n      <div class=\"ingredient-grid-section__header\">\n        <h2 class=\"ingredient-grid-section__heading\">\n          Ingredients with integrity\n        </h2>\n\n        <div class=\"ingredient-grid-section__subheading\">\n          <p>Your health is worth more than empty words and loose claims. We research and test every single ingredient.</p>\n        </div>\n      </div>\n\n      <div class=\"ingredient-grid-section__cards\">\n        {%- if card_1_image != blank or card_1_title != blank or card_1_desc != blank -%}\n          <div class=\"ingredient-grid-section__card\">\n            {%- if card_1_image != blank -%}\n              <div class=\"ingredient-grid-section__image-wrap\">\n                {{ card_1_image | image_url: width: 700 | image_tag:\n                  class: 'ingredient-grid-section__image',\n                  loading: 'lazy',\n                  widths: '240, 320, 420, 520, 600, 700',\n                  sizes: '(max-width: 699px) 78vw, (max-width: 999px) 260px, 260px',\n                  alt: card_1_title\n                }}\n              </div>\n            {%- endif -%}\n\n            <div class=\"ingredient-grid-section__content\">\n              {%- if card_1_title != blank -%}\n                <h3 class=\"ingredient-grid-section__title\">{{ card_1_title }}</h3>\n              {%- endif -%}\n\n              {%- if card_1_desc != blank -%}\n                <div class=\"ingredient-grid-section__desc\">{{ card_1_desc | metafield_tag }}</div>\n              {%- endif -%}\n            </div>\n          </div>\n        {%- endif -%}\n\n        {%- if card_2_image != blank or card_2_title != blank or card_2_desc != blank -%}\n          <div class=\"ingredient-grid-section__card\">\n            {%- if card_2_image != blank -%}\n              <div class=\"ingredient-grid-section__image-wrap\">\n                {{ card_2_image | image_url: width: 700 | image_tag:\n                  class: 'ingredient-grid-section__image',\n                  loading: 'lazy',\n                  widths: '240, 320, 420, 520, 600, 700',\n                  sizes: '(max-width: 699px) 78vw, (max-width: 999px) 260px, 260px',\n                  alt: card_2_title\n                }}\n              </div>\n            {%- endif -%}\n\n            <div class=\"ingredient-grid-section__content\">\n              {%- if card_2_title != blank -%}\n                <h3 class=\"ingredient-grid-section__title\">{{ card_2_title }}</h3>\n              {%- endif -%}\n\n              {%- if card_2_desc != blank -%}\n                <div class=\"ingredient-grid-section__desc\">{{ card_2_desc | metafield_tag }}</div>\n              {%- endif -%}\n            </div>\n          </div>\n        {%- endif -%}\n\n        {%- if card_3_image != blank or card_3_title != blank or card_3_desc != blank -%}\n          <div class=\"ingredient-grid-section__card\">\n            {%- if card_3_image != blank -%}\n              <div class=\"ingredient-grid-section__image-wrap\">\n                {{ card_3_image | image_url: width: 700 | image_tag:\n                  class: 'ingredient-grid-section__image',\n                  loading: 'lazy',\n                  widths: '240, 320, 420, 520, 600, 700',\n                  sizes: '(max-width: 699px) 78vw, (max-width: 999px) 260px, 260px',\n                  alt: card_3_title\n                }}\n              </div>\n            {%- endif -%}\n\n            <div class=\"ingredient-grid-section__content\">\n              {%- if card_3_title != blank -%}\n                <h3 class=\"ingredient-grid-section__title\">{{ card_3_title }}</h3>\n              {%- endif -%}\n\n              {%- if card_3_desc != blank -%}\n                <div class=\"ingredient-grid-section__desc\">{{ card_3_desc | metafield_tag }}</div>\n              {%- endif -%}\n            </div>\n          </div>\n        {%- endif -%}\n\n        {%- if card_4_image != blank or card_4_title != blank or card_4_desc != blank -%}\n          <div class=\"ingredient-grid-section__card\">\n            {%- if card_4_image != blank -%}\n              <div class=\"ingredient-grid-section__image-wrap\">\n                {{ card_4_image | image_url: width: 700 | image_tag:\n                  class: 'ingredient-grid-section__image',\n                  loading: 'lazy',\n                  widths: '240, 320, 420, 520, 600, 700',\n                  sizes: '(max-width: 699px) 78vw, (max-width: 999px) 260px, 260px',\n                  alt: card_4_title\n                }}\n              </div>\n            {%- endif -%}\n\n            <div class=\"ingredient-grid-section__content\">\n              {%- if card_4_title != blank -%}\n                <h3 class=\"ingredient-grid-section__title\">{{ card_4_title }}</h3>\n              {%- endif -%}\n\n              {%- if card_4_desc != blank -%}\n                <div class=\"ingredient-grid-section__desc\">{{ card_4_desc | metafield_tag }}</div>\n              {%- endif -%}\n            </div>\n          </div>\n        {%- endif -%}\n      </div>\n    </div>\n  </div>\n{%- endif -%}",
