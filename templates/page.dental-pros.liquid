{{ 'https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,300;0,400;0,600;1,300;1,400&display=swap' | stylesheet_tag }}

<style>
  :root {
    --boka-dark:      #222721;
    --boka-forest:    #737c5b;
    --boka-sage:      #a5bc8b;
    --boka-mint:      #bfd6a5;
    --boka-pale:      #d3e7c0;
    --boka-frost:     #e6f4d4;
    --boka-cream:     #fafaf5;
    --boka-terracotta:#aa7a6b;
    --boka-blush:     #d1aa9d;
    --boka-rose:      #efd5ca;
    --boka-petal:     #f9e5db;
    --boka-warm-gray: #8c8773;
    --boka-stone:     #c1beb0;
    --boka-linen:     #e2e2d9;
    --font-sans:      'Archivo', 'Neue Haas Unica W1G', Helvetica, sans-serif;
    --font-serif:     'Times New Roman', Georgia, serif;
  }

  .dp-page * { box-sizing: border-box; margin: 0; padding: 0; }
  .dp-page { font-family: var(--font-sans); color: var(--boka-dark); background: var(--boka-cream); }

  .dp-container { max-width: 1140px; margin: 0 auto; padding: 0 32px; }
  .dp-container--narrow { max-width: 800px; margin: 0 auto; padding: 0 32px; }
  .dp-italic { font-family: var(--font-serif); font-style: italic; }
  .dp-eyebrow {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--boka-forest);
    margin-bottom: 16px;
  }
  .dp-rule {
    display: block;
    width: 40px;
    height: 1px;
    background: var(--boka-sage);
    margin: 16px 0 24px;
  }
  .dp-btn {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 14px 32px;
    border: 1.5px solid var(--boka-dark);
    color: var(--boka-dark);
    background: transparent;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .dp-btn:hover { background: var(--boka-dark); color: var(--boka-cream); }
  .dp-btn--filled {
    background: var(--boka-dark);
    color: var(--boka-cream);
    border-color: var(--boka-dark);
  }
  .dp-btn--filled:hover { background: var(--boka-forest); border-color: var(--boka-forest); color: #fff; }
  .dp-btn--green {
    background: var(--boka-forest);
    color: #fff;
    border-color: var(--boka-forest);
  }
  .dp-btn--green:hover { background: var(--boka-dark); border-color: var(--boka-dark); }

  .dp-hero {
    background: var(--boka-dark);
    color: var(--boka-cream);
    min-height: 88vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  .dp-hero__bg-accent {
    position: absolute;
    top: -80px; right: -80px;
    width: 520px; height: 520px;
    border-radius: 50%;
    background: var(--boka-forest);
    opacity: 0.18;
    pointer-events: none;
  }
  .dp-hero__bg-accent-2 {
    position: absolute;
    bottom: -120px; left: 40%;
    width: 300px; height: 300px;
    border-radius: 50%;
    background: var(--boka-terracotta);
    opacity: 0.10;
    pointer-events: none;
  }
  .dp-hero__content { padding: 96px 64px 96px 48px; position: relative; z-index: 1; }
  .dp-hero__eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--boka-sage);
    margin-bottom: 20px;
    display: block;
  }
  .dp-hero__headline {
    font-size: clamp(38px, 4.5vw, 60px);
    font-weight: 300;
    line-height: 1.12;
    color: var(--boka-cream);
    margin-bottom: 24px;
  }
  .dp-hero__headline em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    color: var(--boka-pale);
  }
  .dp-hero__body {
    font-size: 17px;
    font-weight: 300;
    line-height: 1.7;
    color: var(--boka-stone);
    max-width: 480px;
    margin-bottom: 40px;
  }
  .dp-hero__ctas { display: flex; gap: 16px; flex-wrap: wrap; }
  .dp-hero__cta-secondary {
    font-size: 13px;
    font-weight: 400;
    color: var(--boka-stone);
    text-decoration: underline;
    text-underline-offset: 4px;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dp-hero__visual {
    position: relative;
    height: 100%;
    min-height: 480px;
    background: var(--boka-forest);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .dp-hero__visual-inner {
    padding: 48px;
    text-align: center;
  }
  .dp-hero__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: rgba(255,255,255,0.1);
    position: absolute;
    bottom: 0; left: 0; right: 0;
  }
  .dp-hero__stat {
    background: rgba(34,39,33,0.7);
    padding: 24px 28px;
    text-align: center;
  }
  .dp-hero__stat-num {
    font-size: 32px;
    font-weight: 300;
    color: var(--boka-pale);
    display: block;
    line-height: 1;
    margin-bottom: 6px;
  }
  .dp-hero__stat-label {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--boka-stone);
  }
  .dp-hero__product-placeholder {
    width: 200px;
    height: 260px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
    position: relative;
  }
  .dp-hero__product-logo {
    font-family: var(--font-sans);
    font-size: 28px;
    font-weight: 300;
    letter-spacing: 0.5em;
    color: var(--boka-cream);
  }
  .dp-hero__product-sub {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--boka-sage);
    text-align: center;
  }

  .dp-what {
    padding: 120px 0;
    background: var(--boka-cream);
  }
  .dp-what__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .dp-what__headline {
    font-size: clamp(30px, 3vw, 44px);
    font-weight: 300;
    line-height: 1.2;
    margin-bottom: 24px;
  }
  .dp-what__headline em { font-family: var(--font-serif); font-style: italic; color: var(--boka-forest); }
  .dp-what__body { font-size: 16px; line-height: 1.8; color: #3a3d38; margin-bottom: 20px; }
  .dp-what__pillars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 40px;
  }
  .dp-what__pillar {
    padding: 24px;
    background: var(--boka-frost);
    border-left: 3px solid var(--boka-sage);
  }
  .dp-what__pillar-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--boka-forest);
    margin-bottom: 8px;
  }
  .dp-what__pillar-body { font-size: 14px; line-height: 1.6; color: #4a4e45; }
  .dp-what__visual {
    background: var(--boka-pale);
    padding: 56px 48px;
    position: relative;
  }
  .dp-what__ingredient-list { list-style: none; }
  .dp-what__ingredient {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--boka-mint);
  }
  .dp-what__ingredient:last-child { border-bottom: none; }
  .dp-what__ing-icon {
    width: 36px;
    height: 36px;
    background: var(--boka-sage);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .dp-what__ing-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--boka-dark);
    margin-bottom: 4px;
  }
  .dp-what__ing-desc { font-size: 13px; line-height: 1.5; color: var(--boka-forest); }

  /* ── 3. Why Hygienists ── */
  .dp-why {
    padding: 120px 0;
    background: var(--boka-dark);
    color: var(--boka-cream);
  }
  .dp-why__header { text-align: center; margin-bottom: 72px; }
  .dp-why__headline {
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 300;
    color: var(--boka-cream);
    margin-bottom: 16px;
  }
  .dp-why__headline em { font-family: var(--font-serif); font-style: italic; color: var(--boka-pale); }
  .dp-why__subhead { font-size: 16px; color: var(--boka-stone); max-width: 600px; margin: 0 auto; line-height: 1.7; }
  .dp-why__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: rgba(255,255,255,0.06);
  }
  .dp-why__card {
    background: rgba(34,39,33,0.8);
    padding: 48px 40px;
    position: relative;
  }
  .dp-why__card::before {
    content: '';
    display: block;
    width: 32px;
    height: 2px;
    background: var(--boka-sage);
    margin-bottom: 28px;
  }
  .dp-why__card-num {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--boka-forest);
    margin-bottom: 12px;
    display: block;
  }
  .dp-why__card-title {
    font-size: 22px;
    font-weight: 300;
    color: var(--boka-cream);
    line-height: 1.3;
    margin-bottom: 16px;
  }
  .dp-why__card-title em { font-family: var(--font-serif); font-style: italic; color: var(--boka-pale); }
  .dp-why__card-body { font-size: 14px; line-height: 1.7; color: var(--boka-stone); }

  /* ── 4. Advisory Video ── */
  .dp-video {
    padding: 120px 0;
    background: var(--boka-petal);
  }
  .dp-video__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
  }
  .dp-video__label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--boka-terracotta);
    margin-bottom: 16px;
    display: block;
  }
  .dp-video__headline {
    font-size: clamp(26px, 2.8vw, 38px);
    font-weight: 300;
    line-height: 1.25;
    color: var(--boka-dark);
    margin-bottom: 20px;
  }
  .dp-video__headline em { font-family: var(--font-serif); font-style: italic; color: var(--boka-terracotta); }
  .dp-video__body { font-size: 16px; line-height: 1.8; color: #4a4440; margin-bottom: 28px; }
  .dp-video__expert {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px;
    background: #fff;
    border-left: 3px solid var(--boka-terracotta);
  }
  .dp-video__avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--boka-blush);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 300;
    color: var(--boka-dark);
    flex-shrink: 0;
    font-family: var(--font-serif);
    font-style: italic;
  }
  .dp-video__expert-name { font-size: 15px; font-weight: 600; color: var(--boka-dark); margin-bottom: 3px; }
  .dp-video__expert-title { font-size: 12px; color: var(--boka-terracotta); letter-spacing: 0.04em; }
  /* Video embed placeholder */
  .dp-video__player {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background: var(--boka-dark);
    overflow: hidden;
  }
  .dp-video__player iframe,
  .dp-video__player video {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    border: none;
  }
  .dp-video__player-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #1a1f19;
  }
  .dp-video__play-btn {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--boka-terracotta);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    margin-bottom: 20px;
  }
  .dp-video__play-btn:hover { background: #8e5f52; transform: scale(1.06); }
  .dp-video__play-btn svg { width: 24px; height: 24px; fill: #fff; margin-left: 4px; }
  .dp-video__placeholder-text {
    font-size: 13px;
    color: var(--boka-stone);
    text-align: center;
    letter-spacing: 0.06em;
  }
  .dp-video__placeholder-name {
    font-size: 15px;
    color: var(--boka-cream);
    font-weight: 300;
    margin-top: 6px;
  }

  /* ── 5. How It Works ── */
  .dp-how {
    padding: 120px 0;
    background: var(--boka-cream);
  }
  .dp-how__header { text-align: center; margin-bottom: 72px; }
  .dp-how__headline {
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 300;
    margin-bottom: 16px;
  }
  .dp-how__headline em { font-family: var(--font-serif); font-style: italic; color: var(--boka-forest); }
  .dp-how__sub { font-size: 16px; color: var(--boka-warm-gray); max-width: 520px; margin: 0 auto; line-height: 1.7; }
  .dp-how__steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    position: relative;
    margin-bottom: 80px;
  }
  .dp-how__steps::before {
    content: '';
    position: absolute;
    top: 36px;
    left: 12.5%;
    right: 12.5%;
    height: 1px;
    background: var(--boka-mint);
    z-index: 0;
  }
  .dp-how__step { padding: 0 24px; text-align: center; position: relative; z-index: 1; }
  .dp-how__step-dot {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 1px solid var(--boka-mint);
    background: var(--boka-cream);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
  }
  .dp-how__step-dot--active {
    background: var(--boka-forest);
    border-color: var(--boka-forest);
  }
  .dp-how__step-num {
    font-size: 18px;
    font-weight: 300;
    color: var(--boka-forest);
  }
  .dp-how__step-dot--active .dp-how__step-num { color: #fff; }
  .dp-how__step-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--boka-dark);
    margin-bottom: 10px;
  }
  .dp-how__step-body { font-size: 14px; line-height: 1.6; color: var(--boka-warm-gray); }

  /* Commission box */
  .dp-commission {
    background: var(--boka-forest);
    color: #fff;
    padding: 56px 64px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .dp-commission__headline {
    font-size: clamp(22px, 2.5vw, 32px);
    font-weight: 300;
    line-height: 1.3;
    color: #fff;
    grid-column: 1 / 2;
  }
  .dp-commission__headline em { font-family: var(--font-serif); font-style: italic; color: var(--boka-pale); }
  .dp-commission__tiers { display: flex; flex-direction: column; gap: 16px; }
  .dp-commission__tier {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background: rgba(255,255,255,0.1);
  }
  .dp-commission__tier-label { font-size: 13px; color: rgba(255,255,255,0.7); }
  .dp-commission__tier-pct { font-size: 24px; font-weight: 300; color: var(--boka-pale); }
  .dp-commission__perks { list-style: none; }
  .dp-commission__perk {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    font-size: 14px;
    color: rgba(255,255,255,0.8);
    line-height: 1.4;
  }
  .dp-commission__perk:last-child { border-bottom: none; }
  .dp-commission__perk::before {
    content: '→';
    color: var(--boka-pale);
    font-size: 12px;
    margin-top: 2px;
    flex-shrink: 0;
  }

  /* ── 6. Testimonials ── */
  .dp-testimonials {
    padding: 100px 0;
    background: var(--boka-linen);
  }
  .dp-testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--boka-stone);
    margin-top: 48px;
  }
  .dp-testimonial {
    background: var(--boka-cream);
    padding: 40px 36px;
  }
  .dp-testimonial__quote {
    font-size: 15px;
    font-style: italic;
    font-family: var(--font-serif);
    color: var(--boka-dark);
    line-height: 1.7;
    margin-bottom: 28px;
  }
  .dp-testimonial__author { font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--boka-forest); }
  .dp-testimonial__role { font-size: 12px; color: var(--boka-warm-gray); margin-top: 3px; }

  /* ── 7. Sign-Up CTA ── */
  .dp-signup {
    padding: 120px 0;
    background: var(--boka-cream);
    text-align: center;
  }
  .dp-signup__inner { max-width: 680px; margin: 0 auto; padding: 0 32px; }
  .dp-signup__headline {
    font-size: clamp(30px, 3.5vw, 50px);
    font-weight: 300;
    line-height: 1.2;
    margin-bottom: 20px;
  }
  .dp-signup__headline em { font-family: var(--font-serif); font-style: italic; color: var(--boka-forest); }
  .dp-signup__body { font-size: 17px; color: var(--boka-warm-gray); line-height: 1.7; margin-bottom: 48px; }
  .dp-signup__form { text-align: left; }
  .dp-signup__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }
  .dp-signup__field-full { grid-column: 1 / -1; }
  .dp-signup__label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--boka-forest);
    margin-bottom: 8px;
  }
  .dp-signup__input {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 15px;
    padding: 13px 16px;
    border: 1px solid var(--boka-stone);
    background: #fff;
    color: var(--boka-dark);
    outline: none;
    transition: border-color 0.2s;
    -webkit-appearance: none;
  }
  .dp-signup__input:focus { border-color: var(--boka-forest); }
  .dp-signup__select {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 15px;
    padding: 13px 16px;
    border: 1px solid var(--boka-stone);
    background: #fff;
    color: var(--boka-dark);
    outline: none;
    -webkit-appearance: none;
    cursor: pointer;
  }
  .dp-signup__checkbox-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin: 20px 0 32px;
  }
  .dp-signup__checkbox-row input[type="checkbox"] {
    margin-top: 3px;
    accent-color: var(--boka-forest);
    width: 16px;
    height: 16px;
    cursor: pointer;
    flex-shrink: 0;
  }
  .dp-signup__checkbox-label { font-size: 13px; line-height: 1.5; color: var(--boka-warm-gray); }
  .dp-signup__checkbox-label a { color: var(--boka-forest); text-decoration: underline; }
  .dp-signup__submit-row { text-align: center; }
  .dp-signup__disclaimer { font-size: 12px; color: var(--boka-stone); margin-top: 16px; line-height: 1.5; }

  /* ── FAQ ── */
  .dp-faq {
    padding: 80px 0;
    background: var(--boka-frost);
  }
  .dp-faq__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px 72px;
    margin-top: 48px;
  }
  .dp-faq__item { border-top: 1px solid var(--boka-mint); padding-top: 24px; }
  .dp-faq__q { font-size: 16px; font-weight: 600; color: var(--boka-dark); margin-bottom: 12px; }
  .dp-faq__a { font-size: 14px; line-height: 1.7; color: #4a5245; }

  /* ── Footer strip ── */
  .dp-footer-strip {
    background: var(--boka-dark);
    color: var(--boka-stone);
    padding: 40px 0;
    text-align: center;
  }
  .dp-footer-strip p { font-size: 13px; line-height: 1.7; }
  .dp-footer-strip a { color: var(--boka-sage); text-decoration: none; }
  .dp-footer-strip a:hover { text-decoration: underline; }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .dp-hero { grid-template-columns: 1fr; min-height: auto; }
