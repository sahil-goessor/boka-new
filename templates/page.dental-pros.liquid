  <section class="dp-section dp-signup" id="signup" aria-label="Apply to the Dental Pros Program">
    <div class="dp-wrap">
      <div class="dp-form-shell">
        <div>
          <span class="dp-kicker">Apply now</span>
          <h2 class="dp-h2">Join the Boka Dental Pros Program.</h2>
          <p class="dp-copy">
            Use this form for the Shopify page draft, or replace it with your final affiliate platform form embed once the program is ready.
          </p>
          <ul class="dp-check-list">
            <li>Dental professional application review</li>
            <li>Unique referral link or code after approval</li>
            <li>Practice discount access where eligible</li>
            <li>Educational resources for patient conversations</li>
          </ul>
        </div>

        <div class="dp-form">
          {% form 'contact' %}
            {% if form.posted_successfully? %}
              <p class="dp-copy">Thank you for applying. We’ll review your information and follow up by email.</p>
            {% endif %}

            {% if form.errors %}
              <div class="dp-note" style="margin: 0 0 18px;">Please check the required fields and try again.</div>
            {% endif %}

            <input type="hidden" name="contact[form_name]" value="Dental Pros Program Application">

            <div class="dp-fields">
              <div>
                <label class="dp-label" for="dp-first-name">First name</label>
                <input class="dp-input" id="dp-first-name" name="contact[first_name]" type="text" autocomplete="given-name" required>
              </div>

              <div>
                <label class="dp-label" for="dp-last-name">Last name</label>
                <input class="dp-input" id="dp-last-name" name="contact[last_name]" type="text" autocomplete="family-name" required>
              </div>

              <div class="dp-field--full">
                <label class="dp-label" for="dp-email">Email</label>
                <input class="dp-input" id="dp-email" name="contact[email]" type="email" autocomplete="email" required>
              </div>

              <div>
                <label class="dp-label" for="dp-role">Professional role</label>
                <select class="dp-select" id="dp-role" name="contact[role]" required>
                  <option value="" disabled selected>Select one</option>
                  <option value="Dental Hygienist">Dental hygienist</option>
                  <option value="Dentist">Dentist</option>
                  <option value="Orthodontist">Orthodontist</option>
                  <option value="Practice Owner">Practice owner</option>
                  <option value="Other Dental Professional">Other dental professional</option>
                </select>
              </div>

              <div>
                <label class="dp-label" for="dp-state">State / Province</label>
                <input class="dp-input" id="dp-state" name="contact[state]" type="text" placeholder="Illinois" required>
              </div>

              <div class="dp-field--full">
                <label class="dp-label" for="dp-practice">Practice / employer name</label>
                <input class="dp-input" id="dp-practice" name="contact[practice]" type="text" placeholder="Lakeside Family Dental">
              </div>

              <div class="dp-field--full">
                <label class="dp-label" for="dp-share">How do you plan to share Boka?</label>
                <select class="dp-select" id="dp-share" name="contact[sharing_method]" required>
                  <option value="" disabled selected>Select primary method</option>
                  <option value="Chair-side recommendation">Chair-side recommendation</option>
                  <option value="Patient follow-up emails">Patient follow-up emails</option>
                  <option value="Social media">Social media</option>
                  <option value="Practice website / blog">Practice website / blog</option>
                  <option value="Multiple channels">Multiple channels</option>
                </select>
              </div>

              <div class="dp-field--full">
                <label class="dp-label" for="dp-message">Anything else we should know?</label>
                <textarea class="dp-textarea" id="dp-message" name="contact[body]" placeholder="Tell us about your patient base, practice, or interest in Boka."></textarea>
              </div>
            </div>

            <label class="dp-checkbox" for="dp-consent">
              <input type="checkbox" id="dp-consent" name="contact[consent]" value="yes" required>
              <span>I confirm I am a dental professional and agree to Boka’s program terms and privacy policy. I understand commissions apply only to qualifying purchases made through my unique referral link or code.</span>
            </label>

            <button class="dp-btn dp-btn--primary" type="submit">Apply to the program</button>
            <p class="dp-form__fine">Approval timing, commission eligibility, and payment terms should match your final affiliate program rules.</p>
          {% endform %}
        </div>
      </div>
    </div>
  </section>

  <section class="dp-section dp-faq" aria-label="Dental Pros Program FAQ">
