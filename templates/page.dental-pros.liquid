{{ 'https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap' | stylesheet_tag }}

<style>
  :root {
    --dp-ink: #222721;
    --dp-forest: #737c5b;
    --dp-sage: #a5bc8b;
    --dp-mint: #bfd6a5;
    --dp-pale: #d3e7c0;
    --dp-frost: #e6f4d4;
    --dp-cream: #fafaf5;
    --dp-porcelain: #f7f7f0;
    --dp-white: #ffffff;
    --dp-petal: #f9e5db;
    --dp-rose: #efd5ca;
    --dp-terracotta: #aa7a6b;
    --dp-stone: #c1beb0;
    --dp-warm-gray: #8c8773;
    --dp-line: rgba(34, 39, 33, 0.12);
    --dp-shadow: 0 22px 70px rgba(34, 39, 33, 0.08);
    --dp-radius: 22px;
    --dp-radius-sm: 14px;
    --dp-max: 1180px;
    --dp-font-sans: 'Archivo', 'Neue Haas Unica W1G', Helvetica, Arial, sans-serif;
    --dp-font-serif: Georgia, 'Times New Roman', serif;
  }

  .dp-page,
  .dp-page * {
    box-sizing: border-box;
  }

  .dp-page {
    margin: 0;
    overflow: hidden;
    background: var(--dp-cream);
    color: var(--dp-ink);
    font-family: var(--dp-font-sans);
    letter-spacing: -0.01em;
  }

  .dp-page a {
    color: inherit;
  }

  .dp-wrap {
    width: min(var(--dp-max), calc(100% - 40px));
    margin-inline: auto;
  }

  .dp-section {
    padding: clamp(70px, 8vw, 128px) 0;
  }

  .dp-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.17em;
    color: var(--dp-forest);
    text-transform: uppercase;
  }

  .dp-kicker::before {
    content: "";
    width: 32px;
    height: 1px;
    background: currentColor;
    opacity: 0.55;
  }

  .dp-h1,
  .dp-h2,
  .dp-h3,
  .dp-page p {
    margin-block-start: 0;
  }

  .dp-h1,
  .dp-h2,
  .dp-h3 {
    letter-spacing: -0.045em;
    font-weight: 300;
  }

  .dp-h1 {
    max-width: 780px;
    margin-bottom: 24px;
    font-size: clamp(46px, 7vw, 92px);
    line-height: 0.94;
  }

  .dp-h2 {
    margin-bottom: 18px;
    font-size: clamp(34px, 4.2vw, 62px);
    line-height: 1;
  }

  .dp-h3 {
    margin-bottom: 12px;
    font-size: clamp(22px, 2.2vw, 34px);
    line-height: 1.08;
  }

  .dp-em {
    font-family: var(--dp-font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.055em;
  }

  .dp-copy {
    max-width: 650px;
    margin-bottom: 24px;
    color: rgba(34, 39, 33, 0.72);
    font-size: clamp(16px, 1.3vw, 18px);
    font-weight: 300;
    line-height: 1.72;
  }

  .dp-copy--sm {
    font-size: 14px;
    line-height: 1.62;
  }

  .dp-btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .dp-btn {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid var(--dp-ink);
    border-radius: 999px;
    padding: 14px 24px;
    background: transparent;
    color: var(--dp-ink);
    font-family: var(--dp-font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.11em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 160ms ease, background 160ms ease, color 160ms ease, border-color 160ms ease;
  }

  .dp-btn:hover {
    transform: translateY(-1px);
    background: var(--dp-ink);
    color: var(--dp-cream);
  }

  .dp-btn--primary {
    border-color: var(--dp-forest);
    background: var(--dp-forest);
    color: var(--dp-white);
  }

  .dp-btn--primary:hover {
    border-color: var(--dp-ink);
    background: var(--dp-ink);
    color: var(--dp-white);
  }

  .dp-btn--light {
    border-color: rgba(255, 255, 255, 0.7);
    color: var(--dp-white);
  }

  .dp-btn--light:hover {
    border-color: var(--dp-white);
    background: var(--dp-white);
    color: var(--dp-ink);
  }

  .dp-pill {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    border: 1px solid var(--dp-line);
    border-radius: 999px;
    padding: 8px 13px;
    background: rgba(255,255,255,0.58);
    color: rgba(34, 39, 33, 0.72);
    font-size: 12px;
    line-height: 1;
  }

  .dp-card {
    border: 1px solid var(--dp-line);
    border-radius: var(--dp-radius);
    background: rgba(255,255,255,0.66);
    box-shadow: var(--dp-shadow);
  }

  /* HERO */
  .dp-hero {
    position: relative;
    min-height: 760px;
    padding: clamp(52px, 7vw, 96px) 0;
    background:
      radial-gradient(circle at 78% 14%, rgba(191, 214, 165, 0.70), transparent 34%),
      linear-gradient(135deg, var(--dp-cream) 0%, var(--dp-frost) 55%, var(--dp-petal) 100%);
  }

  .dp-hero::before,
  .dp-hero::after {
    content: "";
    position: absolute;
    z-index: 0;
    border: 1px solid rgba(115, 124, 91, 0.22);
    border-radius: 999px 999px 999px 24px;
    pointer-events: none;
  }

  .dp-hero::before {
    width: 470px;
    height: 470px;
    top: 8%;
    right: -150px;
    transform: rotate(18deg);
  }

  .dp-hero::after {
    width: 280px;
    height: 280px;
    left: -115px;
    bottom: 12%;
    transform: rotate(-16deg);
  }

  .dp-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(360px, 0.78fr);
    gap: clamp(34px, 5vw, 72px);
    align-items: center;
  }

  .dp-hero__content {
    padding-top: 34px;
  }

  .dp-hero__sub {
    max-width: 680px;
    margin-bottom: 28px;
    color: rgba(34, 39, 33, 0.76);
    font-size: clamp(17px, 1.55vw, 21px);
    font-weight: 300;
    line-height: 1.58;
  }

  .dp-hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 30px 0 0;
  }

  .dp-hero__visual {
    position: relative;
  }

  .dp-hero__media-card {
  position: relative;
  overflow: hidden;
  min-height: 560px;
  border-radius: 34px;
  background:
    radial-gradient(circle at 50% 30%, rgba(255,255,255,0.55), rgba(255,255,255,0.12) 52%, rgba(255,255,255,0) 78%),
    var(--dp-sage);
  box-shadow: 0 38px 90px rgba(34, 39, 33, 0.16);
}

  .dp-hero__image {
  width: 100%;
  height: 100%;
  min-height: 560px;
  display: block;
  object-fit: contain;
  object-position: center center;
  padding: 24px;
}

  .dp-hero__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 38px;
    text-align: center;
  }

  .dp-logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: min(75%, 310px);
    aspect-ratio: 1 / 1;
    border: 1px solid rgba(255,255,255,0.48);
    border-radius: 42% 58% 48% 52% / 56% 44% 56% 44%;
    background: rgba(250, 250, 245, 0.18);
    color: var(--dp-white);
    font-size: clamp(34px, 4vw, 54px);
    font-weight: 300;
    letter-spacing: 0.36em;
    text-indent: 0.36em;
  }

  .dp-hero__note {
    position: absolute;
    right: 22px;
    bottom: 22px;
    width: min(310px, calc(100% - 44px));
    border: 1px solid rgba(255,255,255,0.5);
    border-radius: 22px;
    padding: 20px;
    background: rgba(250,250,245,0.80);
    backdrop-filter: blur(14px);
  }

  .dp-hero__note-title {
    margin: 0 0 7px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--dp-forest);
    text-transform: uppercase;
  }

  .dp-hero__note-copy {
    margin: 0;
    color: rgba(34, 39, 33, 0.72);
    font-size: 13px;
    line-height: 1.55;
  }

  /* INTRO STRIP */
.dp-strip {
  position: relative;
  z-index: 2;
  margin-top: -54px;
  padding-bottom: 42px;
  background: transparent;
  color: var(--dp-ink);
}

.dp-strip__grid {
  display: grid;
  grid-template-columns: 1.1fr repeat(3, 0.9fr);
  gap: 12px;
  padding: 12px;
  border: 1px solid rgba(115, 124, 91, 0.16);
  border-radius: 30px;
  background: rgba(250, 250, 245, 0.72);
  box-shadow: 0 28px 80px rgba(34, 39, 33, 0.10);
  backdrop-filter: blur(14px);
}

.dp-strip__cell {
  min-height: 150px;
  padding: 26px;
  border: 1px solid rgba(34, 39, 33, 0.08);
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.58);
}

.dp-strip__cell--lead {
  background:
    radial-gradient(circle at 90% 10%, rgba(211, 231, 192, 0.95), transparent 42%),
    var(--dp-forest);
  color: var(--dp-white);
}

.dp-strip__num {
  display: block;
  margin-bottom: 12px;
  color: var(--dp-forest);
  font-family: var(--dp-font-serif);
  font-size: 38px;
  font-style: italic;
  line-height: 1;
}

.dp-strip__cell--lead .dp-strip__num {
  color: var(--dp-pale);
}

.dp-strip__label {
  margin: 0;
  color: rgba(34, 39, 33, 0.68);
  font-size: 13px;
  line-height: 1.55;
}

.dp-strip__cell--lead .dp-strip__label {
  color: rgba(255, 255, 255, 0.82);
}

  /* CONTENT GRIDS */
  .dp-split {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: clamp(36px, 6vw, 92px);
    align-items: center;
  }

  .dp-split--reverse {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  }

  .dp-ingredient-card {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 4vw, 54px);
    background: var(--dp-pale);
  }

  .dp-ingredient-card::after {
    content: "";
    position: absolute;
    width: 230px;
    height: 230px;
    right: -70px;
    bottom: -70px;
    border: 1px solid rgba(115,124,91,0.25);
    border-radius: 44% 56% 42% 58%;
    transform: rotate(20deg);
  }

  .dp-check-list {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dp-check-list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    color: rgba(34, 39, 33, 0.76);
    font-size: 14px;
    line-height: 1.55;
  }

  .dp-check-list li::before {
    content: "";
    flex: 0 0 9px;
    width: 9px;
    height: 9px;
    margin-top: 7px;
    border-radius: 999px;
    background: var(--dp-forest);
  }

  .dp-mini-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 28px;
  }

  .dp-mini {
    border: 1px solid var(--dp-line);
    border-radius: 18px;
    padding: 22px;
    background: rgba(255,255,255,0.62);
  }

  .dp-mini__title {
    margin: 0 0 8px;
    color: var(--dp-ink);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .dp-mini__copy {
    margin: 0;
    color: rgba(34, 39, 33, 0.70);
    font-size: 13px;
    line-height: 1.55;
  }

  /* WHY HYGIENISTS */
  .dp-why {
    background:
      radial-gradient(circle at top left, rgba(191,214,165,0.56), transparent 28%),
      var(--dp-porcelain);
  }

  .dp-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 44px;
  }

  .dp-info-card {
    padding: clamp(24px, 3vw, 34px);
    border-radius: var(--dp-radius);
    background: rgba(255,255,255,0.68);
    border: 1px solid var(--dp-line);
  }

  .dp-info-card__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-bottom: 20px;
    border-radius: 999px;
    background: var(--dp-frost);
    color: var(--dp-forest);
    font-family: var(--dp-font-serif);
    font-style: italic;
    font-size: 22px;
  }

  .dp-info-card__title {
    margin: 0 0 11px;
    font-size: 20px;
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .dp-info-card__copy {
    margin: 0;
    color: rgba(34, 39, 33, 0.68);
    font-size: 14px;
    line-height: 1.62;
  }

  /* VIDEO */
  .dp-video {
    background: var(--dp-petal);
  }

  .dp-video-card {
    position: relative;
    overflow: hidden;
    border-radius: 34px;
    background: var(--dp-ink);
    box-shadow: var(--dp-shadow);
  }

  .dp-video-card::before {
    content: "";
    display: block;
    padding-bottom: 56.25%;
  }

  .dp-video-card iframe,
  .dp-video-card video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .dp-video-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 28px;
    background:
      linear-gradient(180deg, rgba(34,39,33,0.15), rgba(34,39,33,0.72)),
      var(--dp-sage);
    text-align: center;
  }

  .dp-play {
    display: grid;
    place-items: center;
    width: 78px;
    height: 78px;
    margin: 0 auto 20px;
    border-radius: 999px;
    background: rgba(250,250,245,0.88);
    color: var(--dp-forest);
  }

  .dp-play svg {
    width: 28px;
    height: 28px;
    margin-left: 4px;
    fill: currentColor;
  }

  .dp-video-placeholder p {
    max-width: 360px;
    margin: 0 auto;
    color: var(--dp-cream);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.5;
  }

  .dp-advisor {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-top: 26px;
    border: 1px solid rgba(170,122,107,0.20);
    border-radius: 20px;
    padding: 16px;
    background: rgba(255,255,255,0.56);
  }

  .dp-advisor__avatar {
    display: grid;
    place-items: center;
    flex: 0 0 52px;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    background: var(--dp-rose);
    color: var(--dp-terracotta);
    font-family: var(--dp-font-serif);
    font-style: italic;
  }

  .dp-advisor__name {
    margin: 0 0 3px;
    font-size: 14px;
    font-weight: 600;
  }

  .dp-advisor__role {
    margin: 0;
    color: rgba(34,39,33,0.62);
    font-size: 12px;
    line-height: 1.4;
  }

  /* HOW IT WORKS */
  .dp-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: 44px;
  }

  .dp-step {
    position: relative;
    min-height: 250px;
    border: 1px solid var(--dp-line);
    border-radius: var(--dp-radius);
    padding: 24px;
    background: rgba(255,255,255,0.66);
  }

  .dp-step__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    margin-bottom: 28px;
    border-radius: 999px;
    background: var(--dp-frost);
    color: var(--dp-forest);
    font-family: var(--dp-font-serif);
    font-size: 19px;
    font-style: italic;
  }

  .dp-step__title {
    margin: 0 0 10px;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.18;
  }

  .dp-step__copy {
    margin: 0;
    color: rgba(34,39,33,0.68);
    font-size: 13px;
    line-height: 1.58;
  }

  .dp-commission {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 24px;
    margin-top: 24px;
    border-radius: 34px;
    padding: clamp(28px, 4vw, 52px);
    background: var(--dp-forest);
    color: var(--dp-white);
    overflow: hidden;
    position: relative;
  }

  .dp-commission::after {
    content: "";
    position: absolute;
    right: -120px;
    bottom: -140px;
    width: 340px;
    height: 340px;
    border-radius: 48% 52% 44% 56%;
    border: 1px solid rgba(255,255,255,0.22);
    transform: rotate(18deg);
  }

  .dp-commission__copy {
    color: rgba(255,255,255,0.78);
  }

  .dp-rates {
    display: grid;
    gap: 10px;
    position: relative;
    z-index: 1;
  }

  .dp-rate {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 18px;
    padding: 18px 20px;
    background: rgba(255,255,255,0.09);
  }

  .dp-rate span:first-child {
    color: rgba(255,255,255,0.72);
    font-size: 13px;
  }

  .dp-rate span:last-child {
    color: var(--dp-pale);
    font-family: var(--dp-font-serif);
    font-size: 32px;
    font-style: italic;
    line-height: 1;
    white-space: nowrap;
  }

  /* CURRENT B2B INFO */
  .dp-b2b {
    background: var(--dp-frost);
  }

  .dp-b2b-box {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(26px, 5vw, 70px);
    align-items: start;
    border-radius: 34px;
    padding: clamp(28px, 5vw, 60px);
    background: rgba(250,250,245,0.78);
    border: 1px solid rgba(115,124,91,0.20);
  }

  .dp-process {
    display: grid;
    gap: 12px;
    counter-reset: prostep;
  }

  .dp-process__item {
    position: relative;
    min-height: 70px;
    border: 1px solid var(--dp-line);
    border-radius: 18px;
    padding: 20px 20px 20px 72px;
    background: rgba(255,255,255,0.62);
    counter-increment: prostep;
  }

  .dp-process__item::before {
    content: counter(prostep, decimal-leading-zero);
    position: absolute;
    top: 18px;
    left: 18px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--dp-pale);
    color: var(--dp-forest);
    font-family: var(--dp-font-serif);
    font-style: italic;
    font-size: 15px;
  }

  .dp-process__title {
    margin: 0 0 5px;
    font-size: 15px;
    font-weight: 600;
  }

  .dp-process__copy {
    margin: 0;
    color: rgba(34,39,33,0.66);
    font-size: 13px;
    line-height: 1.5;
  }

  .dp-note {
    margin-top: 18px;
    border-left: 1px solid var(--dp-terracotta);
    padding-left: 18px;
    color: rgba(34,39,33,0.64);
    font-size: 12px;
    line-height: 1.58;
  }

  /* TESTIMONIALS */
  .dp-testimonials {
    background: var(--dp-porcelain);
  }

  .dp-quote-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 40px;
  }

  .dp-quote {
    padding: clamp(24px, 3vw, 38px);
    border: 1px solid var(--dp-line);
    border-radius: var(--dp-radius);
    background: rgba(255,255,255,0.70);
  }

  .dp-quote__text {
    margin: 0 0 24px;
    color: rgba(34,39,33,0.82);
    font-family: var(--dp-font-serif);
    font-size: 20px;
    font-style: italic;
    line-height: 1.5;
    letter-spacing: -0.025em;
  }

  .dp-quote__name {
    margin: 0 0 4px;
    color: var(--dp-forest);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .dp-quote__role {
    margin: 0;
    color: rgba(34,39,33,0.56);
    font-size: 12px;
  }

  /* FORM */
  .dp-signup {
    background:
      radial-gradient(circle at 90% 0%, rgba(191,214,165,0.50), transparent 28%),
      var(--dp-cream);
  }

  .dp-form-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(30px, 5vw, 72px);
    align-items: start;
  }

  .dp-form {
    border: 1px solid var(--dp-line);
    border-radius: 34px;
    padding: clamp(24px, 4vw, 46px);
    background: rgba(255,255,255,0.72);
    box-shadow: var(--dp-shadow);
  }

  .dp-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .dp-field--full {
    grid-column: 1 / -1;
  }

  .dp-label {
    display: block;
    margin-bottom: 8px;
    color: var(--dp-forest);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .dp-input,
  .dp-select,
  .dp-textarea {
    width: 100%;
    border: 1px solid rgba(34,39,33,0.18);
    border-radius: 14px;
    padding: 14px 15px;
    background: var(--dp-white);
    color: var(--dp-ink);
    font-family: var(--dp-font-sans);
    font-size: 15px;
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease;
    -webkit-appearance: none;
  }

  .dp-textarea {
    min-height: 108px;
    resize: vertical;
  }

  .dp-input:focus,
  .dp-select:focus,
  .dp-textarea:focus {
    border-color: var(--dp-forest);
    box-shadow: 0 0 0 4px rgba(115,124,91,0.12);
  }

  .dp-checkbox {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin: 22px 0 28px;
    color: rgba(34,39,33,0.66);
    font-size: 13px;
    line-height: 1.55;
  }

  .dp-checkbox input {
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--dp-forest);
  }

  .dp-form .dp-btn {
    width: 100%;
  }

  .dp-form__fine {
    margin: 14px 0 0;
    color: rgba(34,39,33,0.48);
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
  }

  /* FAQ */
  .dp-faq {
    background: var(--dp-pale);
  }

  .dp-faq-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 18px;
    margin-top: 38px;
  }

  .dp-faq-item {
    border-top: 1px solid rgba(34,39,33,0.14);
    padding-top: 20px;
  }

  .dp-faq-item h3 {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .dp-faq-item p {
    margin: 0;
    color: rgba(34,39,33,0.66);
    font-size: 14px;
    line-height: 1.62;
  }

  .dp-final {
    padding: 74px 0;
    background: var(--dp-ink);
    color: var(--dp-cream);
    text-align: center;
  }

  .dp-final .dp-copy {
    margin-inline: auto;
    color: rgba(250,250,245,0.70);
  }

  @media (max-width: 990px) {
    .dp-hero {
      min-height: auto;
    }

    .dp-hero__grid,
    .dp-split,
    .dp-split--reverse,
    .dp-b2b-box,
    .dp-form-shell,
    .dp-commission {
      grid-template-columns: 1fr;
    }

    .dp-hero__media-card,
    .dp-hero__image {
      min-height: 430px;
      height: 430px;
    }

    .dp-strip__grid,
    .dp-card-grid,
    .dp-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .dp-wrap {
      width: min(100% - 28px, var(--dp-max));
    }

    .dp-h1 {
      font-size: clamp(42px, 15vw, 64px);
    }

    .dp-btn-row,
    .dp-btn {
      width: 100%;
    }

    .dp-strip__grid,
    .dp-card-grid,
    .dp-mini-grid,
    .dp-steps,
    .dp-quote-grid,
    .dp-fields,
    .dp-faq-grid {
      grid-template-columns: 1fr;
    }

    .dp-strip__cell {
      min-height: auto;
      padding: 24px;
    }

    .dp-hero__media-card,
    .dp-hero__image {
      min-height: 360px;
      height: 360px;
      border-radius: 26px;
    }

    .dp-logo-mark {
      font-size: 34px;
    }

    .dp-hero__note {
      position: static;
      width: auto;
      margin: 14px;
    }

    .dp-section {
      padding: 64px 0;
    }
  }
</style>

