    "custom_collapsible_content_p9cV6M": {
      "type": "custom-collapsible-content",
      "blocks": {
        "collapsible_row_giWPe8": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What makes Boka Ela Mint Toothpaste different from regular toothpaste?",
            "row_content": "<p>Boka Ela Mint is a fluoride-free toothpaste powered by nano-hydroxyapatite (n-Ha), a breakthrough material that mimics tooth enamel. n-Ha is inspired by nature, backed by science, and has been the subject of significant research for decades.</p>",
            "page": ""
          }
        },
        "collapsible_row_3brPNJ": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is this toothpaste safe for sensitive teeth?",
            "row_content": "<p>Yes, it’s appropriate for sensitive teeth. Our formula is thoughtfully designed to freshen breath and deliver the benefits of n-Ha in a gentle, daily-use paste.</p>",
            "page": ""
          }
        },
        "collapsible_row_xnRnWY": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Does Boka Ela Mint contain fluoride?",
            "row_content": "<p>No, it’s fluoride-free. This makes it an excellent choice for those seeking gentle care or those exploring fluoride-free toothpaste options.</p>",
            "page": ""
          }
        },
        "collapsible_row_9VYexg": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can kids use Boka Ela Mint Toothpaste?",
            "row_content": "<p>Yes. Since Boka Ela Mint toothpaste is biocompatible and non-toxic when used as directed, it’s a great choice for children. It’s free of harsh ingredients like sulfates, parabens, and artificial colors.</p>",
            "page": ""
          }
        },
        "collapsible_row_zy7XFj": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is it cruelty-free and vegan?",
            "row_content": "<p>Yes! Boka Ela Mint toothpaste is PETA cruelty-free certified and vegan.</p>",
            "page": ""
          }
        },
        "collapsible_row_APpybE": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How often should I use Boka Ela Mint Toothpaste?",
            "row_content": "<p>For best results, we recommend brushing for two minutes, twice daily. Safe for daily use, this routine supports enamel care and overall oral care.</p>",
            "page": ""
          }
        },
        "collapsible_row_PbXL77": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What does Boka Ela Mint Toothpaste taste like?",
            "row_content": "<p>Ela Mint features a refreshing, mild flavor that combines mint, green tea, and a subtle hint of cardamom. It is not intense or spicy, making it pleasant to use.</p>",
            "page": ""
          }
        },
        "collapsible_row_dXKLmM": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Processing and Shipping Times",
            "row_content": "<p>For orders placed with standard shipping, please allow 1-2 business days for processing and up to 5 business days for delivery. Exact timing can vary depending on size of the order and delivery destination. Orders placed after 1 p.m. EST on Fridays, over the weekend, or on major U.S. holidays will likely not be processed until the following business day. </p><p>Expedited orders placed after 10 a.m. EST may be shipped the following business day.</p>",
            "page": ""
          }
        },
        "collapsible_row_aiKqmd": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Returns and Refunds",
            "row_content": "<p><strong>Returns</strong><br/></p><p>If you decide that you'd like to return your Boka product, please contact us to initiate a return within 30 days of purchase. We offer a full product cost refund (less any incurred shipping costs) within 30 days of your purchase.<br/><br/>To be eligible for a return, your item must be unused and in the same condition that you received it. It must also be in the original packaging.<br/><br/><strong>Refunds</strong><br/></p><p>Once your return is received and inspected, we will send you an email to confirm status of your return and refund.<br/><br/>If approved, your refund will be processed, and a credit will automatically be applied to your credit card or original method of payment, within a certain amount of days.</p>",
            "page": ""
          }
        },
