            "custom_liquid": "<div class=\"icon-text-container\">\n  <div class=\"icon-text\">\n    <img src=\"https://cdn.shopify.com/s/files/1/2656/6094/files/icon_3.avif?v=1765793186\" alt=\"Icon 1\">\n    <span>Fluoride Free Care</span>\n  </div>\n  <div class=\"icon-text\">\n    <img src=\"https://cdn.shopify.com/s/files/1/2656/6094/files/icon_2_534f46da-868d-4985-bed9-a528d00ebea3.webp?v=1765793186\" alt=\"Icon 2\">\n    <span>Freshens Breath</span>\n  </div>\n  <div class=\"icon-text\">\n    <img src=\"https://cdn.shopify.com/s/files/1/2656/6094/files/icon_1.png?v=1765793186\" alt=\"Icon 3\">\n    <span>Fresh Mint Clean</span>\n  </div>\n</div>\n\n<style>\n  .icon-text-container {\n    display: flex;\n    justify-content: space-between; /* Spread evenly on desktop */\n    align-items: center;\n    gap: 40px;\n    flex-wrap: nowrap; /* Keep one line on desktop */\n  }\n\n  .icon-text {\n    display: flex;\n    align-items: center;\n    gap: 8px; /* Space between icon and text */\n    white-space: nowrap; /* Keep each icon + text inline */\n  }\n\n  .icon-text img {\n    width: 24px;\n    height: 24px;\n  }\n\n  .icon-text span {\n    font-family: 'Neue Haas Unica Pro', Helvetica, Arial, sans-serif;\n    font-size: 16px;\n    color: #000;\n  }\n\n  /* Mobile: allow wrapping container into 2 lines and align left */\n  @media screen and (max-width: 768px) {\n    .icon-text-container {\n      flex-wrap: wrap; /* Container can wrap to 2 lines */\n      justify-content: flex-start; /* Align left on mobile */\n      gap: 20px;\n    }\n\n    .icon-text img {\n      width: 20px;\n      height: 20px;\n    }\n\n    .icon-text span {\n      font-size: 14px;\n    }\n  }\n</style>"
