e: 20px; \n        }\n\n        .steps-content p {\n            font-size: 16px; \n        }\n    }\n\n    @media (max-width: 480px) {\n        .steps-headline {\n            font-size: 26px; \n        }\n\n        .steps-content h3 {\n            font-size: 16px;\n            font-weight: bold;\n        }\n\n        .steps-content p {\n            font-size: 16px;\n        }\n    }\n</style>",
