    "custom_liquid_9nizYJ": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign subscription_collection = collections['subscription-favs'] %}\n\n<section id=\"subscription-favorites\" class=\"boka-subscription-favorites\">\n  <div class=\"boka-subscription-favorites__inner\">\n    <div class=\"boka-subscription-favorites__header\">\n      <p class=\"boka-subscription-favorites__eyebrow\">Subscriber Favorites</p>\n\n      <h2 class=\"boka-subscription-favorites__heading\">\n        Build Your Boka Routine\n      </h2>\n\n      <p class=\"boka-subscription-favorites__text\">\n        Save 15% on your favorite Boka essentials when you subscribe.\n      </p>\n\n      <a href=\"/collections/subscription-favs\" class=\"boka-subscription-favorites__header-button\">\n        Shop All Subscription Favs\n      </a>\n    </div>\n\n    {% if subscription_collection != blank and subscription_collection.products_count > 0 %}\n      <div class=\"boka-subscription-favorites__grid\">\n        {% for product in subscription_collection.products limit: 8 %}\n          <a href=\"{{ product.url }}\" class=\"boka-subscription-favorites__card\">\n            <div class=\"boka-subscription-favorites__image-wrap\">\n              {% if product.featured_image %}\n                <img\n                  src=\"{{ product.featured_image | image_url: width: 700 }}\"\n                  alt=\"{{ product.featured_image.alt | default: product.title | escape }}\"\n                  loading=\"lazy\"\n                  width=\"700\"\n                  height=\"{{ 700 | divided_by: product.featured_image.aspect_ratio | round }}\"\n                >\n              {% endif %}\n\n              <span class=\"boka-subscription-favorites__badge\">\n                Subscribe & Save\n              </span>\n            </div>\n\n            <div class=\"boka-subscription-favorites__content\">\n              <h3 class=\"boka-subscription-favorites__title\">\n                {{ product.title }}\n              </h3>\n\n              {% if product.metafields.custom.short_description != blank %}\n                <p class=\"boka-subscription-favorites__desc\">\n                  {{ product.metafields.custom.short_description | strip_html | truncate: 90 }}\n                </p>\n              {% endif %}\n\n              <div class=\"boka-subscription-favorites__price-row\">\n                <span class=\"boka-subscription-favorites__price\">\n                  {{ product.price | money }}\n                </span>\n\n                {% if product.compare_at_price_max > product.price %}\n                  <span class=\"boka-subscription-favorites__compare\">\n                    {{ product.compare_at_price_max | money }}\n                  </span>\n                {% endif %}\n              </div>\n\n              <span class=\"boka-subscription-favorites__button\">\n                Shop Now\n              </span>\n            </div>\n          </a>\n        {% endfor %}\n      </div>\n    {% else %}\n      <p class=\"boka-subscription-favorites__empty\">\n        No products found. Make sure your collection handle is <strong>subscription-favs</strong>.\n      </p>\n    {% endif %}\n  </div>\n</section>\n\n<style>\n  #subscription-favorites {\n    scroll-margin-top: 90px;\n  }\n\n  .boka-subscription-favorites {\n    background: #fafaf5;\n    color: rgb(34 39 33);\n    padding: clamp(44px, 6vw, 84px) 20px;\n  }\n\n  .boka-subscription-favorites__inner {\n    width: 100%;\n    max-width: 1180px;\n    margin-inline: auto;\n  }\n\n  .boka-subscription-favorites__header {\n    max-width: 760px;\n    margin: 0 auto clamp(28px, 4vw, 48px);\n    text-align: center;\n  }\n\n  .boka-subscription-favorites__eyebrow {\n    margin: 0 0 12px;\n    color: rgb(34 39 33 / 0.68);\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    line-height: 1.2;\n    text-transform: uppercase;\n  }\n\n  .boka-subscription-favorites__heading {\n    margin: 0;\n    color: rgb(34 39 33);\n    font-size: clamp(34px, 4vw, 58px);\n    line-height: 0.98;\n    letter-spacing: -0.045em;\n    font-weight: 400;\n  }\n\n  .boka-subscription-favorites__text {\n    max-width: 520px;\n    margin: 18px auto 0;\n    color: rgb(34 39 33 / 0.76);\n    font-size: clamp(16px, 1vw, 18px);\n    line-height: 1.45;\n  }\n\n  .boka-subscription-favorites__header-button {\n    appearance: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 52px;\n    margin-top: 24px;\n    padding: 15px 24px;\n    border: 1px solid rgb(34 39 33);\n    border-radius: 10px;\n    background: transparent;\n    color: rgb(34 39 33) !important;\n    -webkit-text-fill-color: rgb(34 39 33) !important;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 0.075em;\n    line-height: 1;\n    text-align: center;\n    text-decoration: none !important;\n    text-transform: uppercase;\n    transition:\n      background 0.2s ease,\n      color 0.2s ease,\n      border-color 0.2s ease;\n  }\n\n  .boka-subscription-favorites__header-button:hover {\n    background: rgb(34 39 33);\n    color: #ffffff !important;\n    -webkit-text-fill-color: #ffffff !important;\n    border-color: rgb(34 39 33);\n  }\n\n  .boka-subscription-favorites__grid {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 18px;\n  }\n\n  .boka-subscription-favorites__card {\n    display: flex;\n    flex-direction: column;\n    min-width: 0;\n    overflow: hidden;\n    border: 1px solid rgb(34 39 33 / 0.12);\n    border-radius: 22px;\n    background: #ffffff;\n    color: rgb(34 39 33) !important;\n    text-decoration: none !important;\n    transition:\n      transform 0.2s ease,\n      border-color 0.2s ease;\n  }\n\n  .boka-subscription-favorites__card:hover {\n    transform: translateY(-2px);\n    border-color: rgb(34 39 33 / 0.28);\n  }\n\n  .boka-subscription-favorites__image-wrap {\n    position: relative;\n    overflow: hidden;\n    aspect-ratio: 1 / 1;\n    background: #f4f1e8;\n  }\n\n  .boka-subscription-favorites__image-wrap img {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: transform 0.25s ease;\n  }\n\n  .boka-subscription-favorites__card:hover .boka-subscription-favorites__image-wrap img {\n    transform: scale(1.03);\n  }\n\n  .boka-subscription-favorites__badge {\n    position: absolute;\n    top: 12px;\n    left: 12px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 30px;\n    padding: 8px 11px;\n    border-radius: 999px;\n    background: #f9e5db;\n    color: rgb(34 39 33);\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    line-height: 1;\n    text-transform: uppercase;\n  }\n\n  .boka-subscription-favorites__content {\n    display: flex;\n    flex-direction: column;\n    flex: 1;\n    padding: 18px;\n  }\n\n  .boka-subscription-favorites__title {\n    margin: 0;\n    color: rgb(34 39 33);\n    font-size: 17px;\n    line-height: 1.2;\n    letter-spacing: -0.02em;\n    font-weight: 700;\n  }\n\n  .boka-subscription-favorites__desc {\n    margin: 10px 0 0;\n    color: rgb(34 39 33 / 0.7);\n    font-size: 14px;\n    line-height: 1.35;\n  }\n\n  .boka-subscription-favorites__price-row {\n    display: flex;\n    align-items: baseline;\n    gap: 8px;\n    margin-top: 14px;\n  }\n\n  .boka-subscription-favorites__price {\n    color: rgb(34 39 33);\n    font-size: 16px;\n    font-weight: 700;\n  }\n\n  .boka-subscription-favorites__compare {\n    color: rgb(34 39 33 / 0.48);\n    font-size: 14px;\n    text-decoration: line-through;\n  }\n\n  .boka-subscription-favorites__button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 46px;\n    margin-top: auto;\n    padding: 14px 18px;\n    border: 1px solid rgb(34 39 33);\n    border-radius: 10px;\n    background: rgb(34 39 33);\n    color: #ffffff;\n    -webkit-text-fill-color: #ffffff;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 0.075em;\n    line-height: 1;\n    text-align: center;\n    text-transform: uppercase;\n  }\n\n  .boka-subscription-favorites__empty {\n    text-align: center;\n    font-size: 16px;\n  }\n\n  @media screen and (max-width: 989px) {\n    .boka-subscription-favorites__grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 14px;\n    }\n  }\n\n  @media screen and (max-width: 549px) {\n    #subscription-favorites {\n      scroll-margin-top: 72px;\n    }\n\n    .boka-subscription-favorites {\n      padding: 40px 14px;\n    }\n\n    .boka-subscription-favorites__header {\n      text-align: left;\n      margin-bottom: 26px;\n    }\n\n    .boka-subscription-favorites__text {\n      margin-inline: 0;\n    }\n\n    .boka-subscription-favorites__header-button {\n      width: 100%;\n      min-height: 50px;\n      margin-top: 22px;\n    }\n\n    .boka-subscription-favorites__grid {\n      grid-template-columns: 1fr;\n    }\n\n    .boka-subscription-favorites__content {\n      padding: 16px;\n    }\n  }\n</style>",
