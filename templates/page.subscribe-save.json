      "settings": {
        "custom_liquid": "<section class=\"boka-subscribe-hero\">\n  <div class=\"boka-subscribe-hero__inner\">\n    <div class=\"boka-subscribe-hero__image\">\n      <img \n        src=\"https://cdn.shopify.com/s/files/1/2656/6094/files/HP_Banner_Mobile.webp?v=1748860280\" \n        alt=\"Happy smiles, big savings subscription image\" \n        loading=\"eager\"\n      >\n    </div>\n\n    <div class=\"boka-subscribe-hero__content\">\n      <p class=\"boka-subscribe-hero__eyebrow\">Subscribe & Save</p>\n\n      <h1 class=\"boka-subscribe-hero__heading\">\n        Keep Your Routine <em>Stocked</em> and Save 15%\n      </h1>\n\n      <p class=\"boka-subscribe-hero__text\">\n        Get your Boka essentials delivered right when you need them. Save 15% on every shipment, enjoy subscriber perks, and easily swap, pause, skip, or cancel anytime.\n      </p>\n\n      <div class=\"boka-subscribe-hero__benefits\">\n        <div class=\"boka-subscribe-hero__benefit\">\n          <img \n            src=\"https://cdn.shopify.com/s/files/1/2656/6094/files/Icon_1.webp?v=1763703368\" \n            alt=\"Save 15%\" \n            loading=\"lazy\"\n          >\n          <span>Save 15% every order</span>\n        </div>\n\n        <div class=\"boka-subscribe-hero__benefit\">\n          <img \n            src=\"https://cdn.shopify.com/s/files/1/2656/6094/files/Icon_2.webp?v=1763703368\" \n            alt=\"Subscriber rewards\" \n            loading=\"lazy\"\n          >\n          <span>Exclusive subscriber rewards</span>\n        </div>\n\n        <div class=\"boka-subscribe-hero__benefit\">\n          <img \n            src=\"https://cdn.shopify.com/s/files/1/2656/6094/files/Icon_3.webp?v=1763703368\" \n            alt=\"Manage subscription\" \n            loading=\"lazy\"\n          >\n          <span>Swap, pause, skip, or cancel anytime</span>\n        </div>\n      </div>\n\n      <div class=\"boka-subscribe-hero__actions\">\n        <a href=\"#subscription-favorites\" class=\"boka-subscribe-hero__button\">\n          <span>Shop Subscriptions</span>\n        </a>\n\n        <a href=\"https://www.boka.com/tools/recurring/get-subscription-access\" class=\"boka-subscribe-hero__login-button\">\n          <span>Already a Subscriber? Login</span>\n        </a>\n\n        <span class=\"boka-subscribe-hero__note\">\n          Flexible deliveries. No commitment.\n        </span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<style>\n  html {\n    scroll-behavior: smooth;\n  }\n\n  #subscription-favorites {\n    scroll-margin-top: 90px;\n  }\n\n  .shopify-section:has(.boka-subscribe-hero) {\n    margin-top: 0 !important;\n    padding-top: 0 !important;\n  }\n\n  .boka-subscribe-hero {\n    background: #fafaf5;\n    color: rgb(34 39 33);\n    padding: 0 20px clamp(28px, 4vw, 56px);\n  }\n\n  .boka-subscribe-hero__inner {\n    width: 100%;\n    max-width: 1180px;\n    margin-inline: auto;\n    display: grid;\n    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);\n    align-items: center;\n    gap: clamp(32px, 4vw, 64px);\n    padding: clamp(28px, 4vw, 56px);\n    border-radius: 28px;\n    background: #fafaf5;\n  }\n\n  .boka-subscribe-hero__image {\n    order: 2;\n    overflow: hidden;\n    border-radius: 24px;\n    background: #f4f1e8;\n  }\n\n  .boka-subscribe-hero__image img {\n    display: block;\n    width: 100%;\n    max-height: 620px;\n    height: auto;\n    object-fit: cover;\n  }\n\n  .boka-subscribe-hero__content {\n    order: 1;\n    max-width: 600px;\n    text-align: left;\n  }\n\n  .boka-subscribe-hero__eyebrow {\n    margin: 0 0 16px;\n    color: rgb(34 39 33 / 0.68);\n    font-size: clamp(12px, 0.78vw, 14px);\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    line-height: 1.2;\n    text-transform: uppercase;\n  }\n\n  .boka-subscribe-hero__heading {\n    margin: 0;\n    color: rgb(34 39 33);\n    font-size: clamp(40px, 4.4vw, 66px);\n    line-height: 0.96;\n    letter-spacing: -0.05em;\n    font-weight: 400;\n  }\n\n  .boka-subscribe-hero__heading em {\n    font-style: italic;\n    font-weight: inherit;\n  }\n\n  .boka-subscribe-hero__text {\n    max-width: 540px;\n    margin: 22px 0 0;\n    color: rgb(34 39 33 / 0.82);\n    font-size: clamp(16px, 1vw, 19px);\n    line-height: 1.45;\n  }\n\n  .boka-subscribe-hero__benefits {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 12px;\n    margin-top: 30px;\n  }\n\n  .boka-subscribe-hero__benefit {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 10px;\n    min-width: 0;\n    padding: 15px;\n    border: 1px solid rgb(34 39 33 / 0.14);\n    border-radius: 18px;\n    background: rgb(255 255 255 / 0.5);\n  }\n\n  .boka-subscribe-hero__benefit img {\n    width: 40px;\n    height: 40px;\n    object-fit: contain;\n  }\n\n  .boka-subscribe-hero__benefit span {\n    color: rgb(34 39 33);\n    font-size: 14px;\n    line-height: 1.25;\n    font-weight: 700;\n    letter-spacing: -0.01em;\n  }\n\n  .boka-subscribe-hero__actions {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 12px;\n    margin-top: 32px;\n  }\n\n  .boka-subscribe-hero__button,\n  .boka-subscribe-hero__login-button {\n    appearance: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 56px;\n    padding: 16px 26px;\n    border: 1px solid rgb(34 39 33);\n    border-radius: 10px;\n    font-size: clamp(12px, 0.8vw, 14px);\n    font-weight: 700;\n    letter-spacing: 0.075em;\n    line-height: 1;\n    text-align: center;\n    text-decoration: none !important;\n    text-transform: uppercase;\n    transition:\n      background 0.2s ease,\n      color 0.2s ease,\n      border-color 0.2s ease;\n  }\n\n  .boka-subscribe-hero__actions a.boka-subscribe-hero__button,\n  .boka-subscribe-hero__actions a.boka-subscribe-hero__button:link,\n  .boka-subscribe-hero__actions a.boka-subscribe-hero__button:visited,\n  .boka-subscribe-hero__actions a.boka-subscribe-hero__button:active,\n  .boka-subscribe-hero__actions a.boka-subscribe-hero__button:focus,\n  .boka-subscribe-hero__actions a.boka-subscribe-hero__button span {\n    min-width: 220px;\n    background: rgb(34 39 33) !important;\n    color: #ffffff !important;\n    -webkit-text-fill-color: #ffffff !important;\n    border-color: rgb(34 39 33) !important;\n    text-decoration: none !important;\n  }\n\n  .boka-subscribe-hero__actions a.boka-subscribe-hero__button:hover {\n    background: transparent !important;\n    color: rgb(34 39 33) !important;\n    -webkit-text-fill-color: rgb(34 39 33) !important;\n    border-color: rgb(34 39 33) !important;\n    transform: none;\n  }\n\n  .boka-subscribe-hero__actions a.boka-subscribe-hero__button:hover span {\n    color: rgb(34 39 33) !important;\n    -webkit-text-fill-color: rgb(34 39 33) !important;\n    background: transparent !important;\n  }\n\n  .boka-subscribe-hero__login-button {\n    min-width: 250px;\n    background: transparent !important;\n    color: rgb(34 39 33) !important;\n    -webkit-text-fill-color: rgb(34 39 33) !important;\n  }\n\n  .boka-subscribe-hero__login-button span {\n    color: rgb(34 39 33) !important;\n    -webkit-text-fill-color: rgb(34 39 33) !important;\n  }\n\n  .boka-subscribe-hero__login-button:hover {\n    background: rgb(34 39 33) !important;\n    color: #ffffff !important;\n    -webkit-text-fill-color: #ffffff !important;\n    border-color: rgb(34 39 33);\n    transform: none;\n  }\n\n  .boka-subscribe-hero__login-button:hover span {\n    color: #ffffff !important;\n    -webkit-text-fill-color: #ffffff !important;\n  }\n\n  .boka-subscribe-hero__note {\n    width: 100%;\n    color: rgb(34 39 33 / 0.68);\n    font-size: 14px;\n    line-height: 1.35;\n  }\n\n  @media screen and (max-width: 999px) {\n    .boka-subscribe-hero {\n      padding: 0 16px 40px;\n    }\n\n    .boka-subscribe-hero__inner {\n      grid-template-columns: 1fr;\n      gap: 28px;\n      padding: 0;\n      border-radius: 22px;\n      background: transparent;\n    }\n\n    .boka-subscribe-hero__image {\n      order: 1;\n      border-radius: 22px;\n    }\n\n    .boka-subscribe-hero__content {\n      order: 2;\n      max-width: 100%;\n    }\n\n    .boka-subscribe-hero__heading {\n      font-size: clamp(38px, 10vw, 56px);\n    }\n\n    .boka-subscribe-hero__benefits {\n      grid-template-columns: 1fr;\n      gap: 10px;\n      margin-top: 28px;\n    }\n\n    .boka-subscribe-hero__benefit {\n      flex-direction: row;\n      align-items: center;\n      padding: 14px;\n    }\n\n    .boka-subscribe-hero__benefit img {\n      width: 38px;\n      height: 38px;\n      flex-shrink: 0;\n    }\n\n    .boka-subscribe-hero__actions {\n      align-items: stretch;\n      gap: 12px;\n      margin-top: 28px;\n    }\n\n    .boka-subscribe-hero__button,\n    .boka-subscribe-hero__login-button {\n      width: 100%;\n      min-width: 0;\n      min-height: 52px;\n      padding: 15px 20px;\n      font-size: 12px;\n    }\n\n    .boka-subscribe-hero__actions a.boka-subscribe-hero__button,\n    .boka-subscribe-hero__actions a.boka-subscribe-hero__button span {\n      min-width: 0;\n    }\n\n    .boka-subscribe-hero__note {\n      width: 100%;\n      text-align: center;\n    }\n  }\n\n  @media screen and (max-width: 420px) {\n    .boka-subscribe-hero {\n      padding: 0 14px 40px;\n    }\n\n    .boka-subscribe-hero__heading {\n      font-size: 38px;\n    }\n\n    .boka-subscribe-hero__text {\n      margin-top: 18px;\n      font-size: 16px;\n    }\n  }\n</style>",
