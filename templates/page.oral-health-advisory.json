      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"boka-ohac\">\n  <section class=\"boka-ohac__section\">\n    <div class=\"boka-ohac__container\">\n      <div class=\"boka-ohac__section-header\">\n        <p class=\"boka-ohac__eyebrow\">Meet the members</p>\n        <h2>Experts helping shape what’s next in <em>oral care</em>.</h2>\n        <p>\n          Our advisory committee combines clinical, scientific, research, and consumer health experience to help guide Boka’s work.\n        </p>\n      </div>\n\n      <div class=\"boka-ohac__members-grid\">\n        <article class=\"boka-ohac__member\">\n          <div class=\"boka-ohac__member-image\">\n            <img src=\"//www.boka.com/cdn/shop/files/Dianne_1.webp?v=1751443023&width=900\" alt=\"Diane Cummins\" loading=\"lazy\">\n          </div>\n          <div class=\"boka-ohac__member-body\">\n            <h3 class=\"boka-ohac__member-name\">Diane Cummins</h3>\n            <p class=\"boka-ohac__member-role\">Oral health researcher and industry consultant</p>\n            <p class=\"boka-ohac__member-quote\">“Boka is transforming oral health and wellness by offering consumers real choice.”</p>\n            <details>\n              <summary>Read bio</summary>\n              <div class=\"boka-ohac__member-bio\">\n                Diane is an independent consultant to oral health researchers and the oral care industry. She is an internationally respected scientist and accomplished business leader with deep experience in clinical and laboratory study design, marketing, regulatory, and legal matters. Her work has contributed to the development and validation of novel toothpastes for plaque, gingivitis, and periodontitis.\n              </div>\n            </details>\n          </div>\n        </article>\n\n        <article class=\"boka-ohac__member\">\n          <div class=\"boka-ohac__member-image\">\n            <img src=\"//www.boka.com/cdn/shop/files/Foti_1.webp?v=1751443023&width=900\" alt=\"Dr. Foti Panagakos\" loading=\"lazy\">\n          </div>\n          <div class=\"boka-ohac__member-body\">\n            <h3 class=\"boka-ohac__member-name\">Dr. Foti Panagakos</h3>\n            <p class=\"boka-ohac__member-role\">Founding Dean, School of Dental Medicine</p>\n            <p class=\"boka-ohac__member-quote\">“It is all in the science. Boka utilizes nano-hydroxyapatite technology.”</p>\n            <details>\n              <summary>Read bio</summary>\n              <div class=\"boka-ohac__member-bio\">\n                Dr. Panagakos has extensive experience across dental research, education, and innovation. Since May 2022, he has served as the Founding Dean of the School of Dental Medicine at Pacific Northwest University of Health Sciences in Yakima, Washington.\n                <a class=\"boka-ohac__member-link\" href=\"https://www.pnwu.edu/academics/school-of-dental-medicine/\" target=\"_blank\" rel=\"noopener noreferrer\">Learn more</a>\n              </div>\n            </details>\n          </div>\n        </article>\n\n        <article class=\"boka-ohac__member\">\n          <div class=\"boka-ohac__member-image\">\n            <img src=\"//www.boka.com/cdn/shop/files/Raj_1.webp?v=1751443023&width=900\" alt=\"Raj Kohli, PhD\" loading=\"lazy\">\n          </div>\n          <div class=\"boka-ohac__member-body\">\n            <h3 class=\"boka-ohac__member-name\">Raj Kohli, PhD</h3>\n            <p class=\"boka-ohac__member-role\">Former EVP, Global R&amp;D and Technology Strategy</p>\n            <p class=\"boka-ohac__member-quote\">“Boka products provide consumers a choice that they find pleasurable to use.”</p>\n            <details>\n              <summary>Read bio</summary>\n              <div class=\"boka-ohac__member-bio\">\n                Raj Kohli is an accomplished senior executive with forty years of R&amp;D experience in the consumer packaged goods industry. He recently retired from Colgate-Palmolive as Executive Vice President of Global R&amp;D and Technology Strategy, leading teams and programs across oral care, personal care, skin health, and home care.\n              </div>\n            </details>\n          </div>\n        </article>\n\n        <article class=\"boka-ohac__member\">\n          <div class=\"boka-ohac__member-image\">\n            <img src=\"//www.boka.com/cdn/shop/files/Allan_1.webp?v=1751443023&width=900\" alt=\"Alan Wolpert\" loading=\"lazy\">\n          </div>\n          <div class=\"boka-ohac__member-body\">\n            <h3 class=\"boka-ohac__member-name\">Alan Wolpert</h3>\n            <p class=\"boka-ohac__member-role\">Consumer brands and oral care leader</p>\n            <p class=\"boka-ohac__member-quote\">“Boka blends cultural relevance, deep consumer insight, and clinical credibility.”</p>\n            <details>\n              <summary>Read bio</summary>\n              <div class=\"boka-ohac__member-bio\">\n                Alan Wolpert is the former President of Consumer Brands at Henkel in North America and has held leadership roles at Colgate-Palmolive. He brings deep experience in innovation, brand acceleration, business transformation, and organizational change.\n              </div>\n            </details>\n          </div>\n        </article>\n\n        <article class=\"boka-ohac__member\">\n          <div class=\"boka-ohac__member-image\">\n            <img src=\"//www.boka.com/cdn/shop/files/Victoria.webp?v=1759263916&width=900\" alt=\"Dr. Victoria Sampson\" loading=\"lazy\">\n          </div>\n          <div class=\"boka-ohac__member-body\">\n            <h3 class=\"boka-ohac__member-name\">Dr. Victoria Sampson</h3>\n            <p class=\"boka-ohac__member-role\">Functional dentist and oral microbiome researcher</p>\n            <p class=\"boka-ohac__member-quote\">“Oral health is the gateway to overall well-being.”</p>\n            <details>\n              <summary>Read bio</summary>\n              <div class=\"boka-ohac__member-bio\">\n                Dr. Victoria Sampson is a functional dentist and researcher based in central London. She is known for her work in salivary diagnostics and microbiome testing, has advised dental companies globally, and has been involved with the European Space Agency and NASA. Her work focuses on connecting oral health, the oral microbiome, and full-body health.\n                <a class=\"boka-ohac__member-link\" href=\"https://www.thehealthsociety.co.uk/\" target=\"_blank\" rel=\"noopener noreferrer\">Learn more</a>\n              </div>\n            </details>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n</div>",
