    "custom_liquid_DhygK4": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"boka-ohac\">\n  <section class=\"boka-ohac__section boka-ohac__section--soft\">\n    <div class=\"boka-ohac__container\">\n      <div class=\"boka-ohac__section-header\">\n        <p class=\"boka-ohac__eyebrow\">Why it exists</p>\n        <h2>Built to keep Boka rooted in <em>science and care</em>.</h2>\n        <p>\n          Oral care should be effective, enjoyable, and responsibly formulated. Our committee brings together experts across dentistry, research, product innovation, and consumer health to support Boka’s approach.\n        </p>\n      </div>\n\n      <div class=\"boka-ohac__trust-grid\">\n        <article class=\"boka-ohac__trust-card\">\n          <span class=\"boka-ohac__trust-number\">01</span>\n          <h3>Scientific integrity</h3>\n          <p>Guidance on ingredients, research standards, formulation priorities, and the evidence behind product claims.</p>\n        </article>\n\n        <article class=\"boka-ohac__trust-card\">\n          <span class=\"boka-ohac__trust-number\">02</span>\n          <h3>Product quality</h3>\n          <p>Support for evaluating product experience, performance, consistency, and quality from concept through launch.</p>\n        </article>\n\n        <article class=\"boka-ohac__trust-card\">\n          <span class=\"boka-ohac__trust-number\">03</span>\n          <h3>Consumer trust</h3>\n          <p>Responsible education around oral health, innovation, and how Boka products fit into everyday routines.</p>\n        </article>\n      </div>\n    </div>\n  </section>\n</div>",
