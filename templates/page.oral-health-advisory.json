      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"boka-ohac\">\n  <section class=\"boka-ohac__hero\">\n    <div class=\"boka-ohac__container\">\n      <div class=\"boka-ohac__hero-grid\">\n        <div class=\"boka-ohac__hero-copy\">\n          <p class=\"boka-ohac__eyebrow\">Oral Health Advisory Committee</p>\n          <h1>Science-backed oral care, guided by <em>leading experts</em>.</h1>\n          <p class=\"boka-ohac__hero-text\">\n            The Boka Oral Health Advisory Committee helps ensure every product is backed by legitimate science, crafted with high-quality ingredients, and reviewed for safety, performance, and consumer experience.\n          </p>\n\n          <div class=\"boka-ohac__proof\">\n            <span class=\"boka-ohac__proof-pill\">120+ years combined experience</span>\n            <span class=\"boka-ohac__proof-pill\">Clinical + scientific oversight</span>\n            <span class=\"boka-ohac__proof-pill\">Ingredient and product review</span>\n          </div>\n        </div>\n\n        <div class=\"boka-ohac__hero-card\">\n          <img\n  src=\"https://cdn.shopify.com/s/files/1/2656/6094/files/Boka-Oral-Health-Advisory-Logo.jpg?v=1781204097\"\n  alt=\"Boka Oral Health Advisory Committee\"\n  loading=\"eager\"\n>\n        </div>\n      </div>\n    </div>\n  </section>\n</div>",
