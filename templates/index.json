    "custom_liquid_Pw6kPw": {
      "type": "custom-liquid",
      "custom_css": [
        ".subscribe-btn {color: #ffffff !important; background-color: #000000 !important;}"
      ],
      "name": "Custom Liquid - Subscriptions",
      "settings": {
        "custom_liquid": "<section class=\"boka-subscribe-hero\">\n  <div class=\"boka-subscribe-hero__inner\">\n    <div class=\"boka-subscribe-hero__image\">\n      <img \n        src=\"https://cdn.shopify.com/s/files/1/2656/6094/files/Happy_Smiles-Big_Savings.webp?v=1763703089\" \n        alt=\"Happy smiles, big savings subscription image\" \n        loading=\"lazy\"\n      >\n    </div>\n\n    <div class=\"boka-subscribe-hero__content\">\n      <p class=\"boka-subscribe-hero__eyebrow\">Subscribe &amp; Save</p>\n\n      <h2 class=\"boka-subscribe-hero__heading\">\n        Keep Your Routine <em>Stocked</em> and Save 15%\n      </h2>\n\n      <p class=\"boka-subscribe-hero__text\">\n        Get your Boka essentials delivered right when you need them. Save 15% on every shipment, enjoy subscriber perks, and easily swap, pause, or cancel anytime.\n      </p>\n\n      <div class=\"boka-subscribe-hero__benefits\">\n        <div class=\"boka-subscribe-hero__benefit\">\n          <img \n            src=\"https://cdn.shopify.com/s/files/1/2656/6094/files/Icon_1.webp?v=1763703368\" \n            alt=\"Save 15%\" \n            loading=\"lazy\"\n          >\n          <span>Save 15% every order</span>\n        </div>\n\n        <div class=\"boka-subscribe-hero__benefit\">\n          <img \n            src=\"https://cdn.shopify.com/s/files/1/2656/6094/files/Icon_2.webp?v=1763703368\" \n            alt=\"Subscriber rewards\" \n            loading=\"lazy\"\n          >\n          <span>Exclusive subscriber rewards</span>\n        </div>\n\n        <div class=\"boka-subscribe-hero__benefit\">\n          <img \n            src=\"https://cdn.shopify.com/s/files/1/2656/6094/files/Icon_3.webp?v=1763703368\" \n            alt=\"Manage subscription\" \n            loading=\"lazy\"\n          >\n          <span>Swap, pause, or cancel anytime</span>\n        </div>\n      </div>\n\n      <div class=\"boka-subscribe-hero__actions\">\n        <a href=\"/collections/subscription-favs\" class=\"boka-subscribe-hero__button\">\n          Shop Subscriptions\n        </a>\n\n        <span class=\"boka-subscribe-hero__note\">\n          Flexible deliveries. No commitment.\n        </span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<style>\n  .boka-subscribe-hero {\n    background: #e6f4d4;\n    color: rgb(34 39 33);\n    padding: 0;\n  }\n\n  .boka-subscribe-hero__inner {\n    width: min(1200px, calc(100% - 40px));\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);\n    align-items: center;\n    gap: clamp(36px, 5vw, 76px);\n    padding: clamp(42px, 6vw, 88px) 0;\n  }\n\n  .boka-subscribe-hero__image {\n    order: 2;\n    overflow: hidden;\n    border-radius: 28px;\n    background: #f4f1e8;\n  }\n\n  .boka-subscribe-hero__image img {\n    display: block;\n    width: 100%;\n    height: auto;\n    object-fit: cover;\n  }\n\n  .boka-subscribe-hero__content {\n    order: 1;\n    max-width: 640px;\n    text-align: left;\n  }\n\n  .boka-subscribe-hero__eyebrow {\n    margin: 0 0 16px;\n    color: rgb(34 39 33 / 0.68);\n    font-size: clamp(12px, 0.78vw, 14px);\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    line-height: 1.2;\n    text-transform: uppercase;\n  }\n\n  .boka-subscribe-hero__heading {\n    margin: 0;\n    color: rgb(34 39 33);\n    font-size: clamp(44px, 5vw, 76px);\n    line-height: 0.95;\n    letter-spacing: -0.05em;\n    font-weight: 400;\n  }\n\n  .boka-subscribe-hero__heading em {\n    font-style: italic;\n    font-weight: inherit;\n  }\n\n  .boka-subscribe-hero__text {\n    max-width: 560px;\n    margin: 24px 0 0;\n    color: rgb(34 39 33 / 0.82);\n    font-size: clamp(16px, 1.08vw, 20px);\n    line-height: 1.45;\n  }\n\n  .boka-subscribe-hero__benefits {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 12px;\n    margin-top: 34px;\n  }\n\n  .boka-subscribe-hero__benefit {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 10px;\n    min-width: 0;\n    padding: 16px;\n    border: 1px solid rgb(34 39 33 / 0.14);\n    border-radius: 18px;\n    background: rgb(255 255 255 / 0.42);\n  }\n\n  .boka-subscribe-hero__benefit img {\n    width: 42px;\n    height: 42px;\n    object-fit: contain;\n  }\n\n  .boka-subscribe-hero__benefit span {\n    color: rgb(34 39 33);\n    font-size: 14px;\n    line-height: 1.25;\n    font-weight: 700;\n    letter-spacing: -0.01em;\n  }\n\n  .boka-subscribe-hero__actions {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 18px;\n    margin-top: 34px;\n  }\n\n  .boka-subscribe-hero__button,\n  .boka-subscribe-hero__button:link,\n  .boka-subscribe-hero__button:visited,\n  .boka-subscribe-hero__button:hover,\n  .boka-subscribe-hero__button:focus,\n  .boka-subscribe-hero__button:active {\n    appearance: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 230px;\n    min-height: 58px;\n    padding: 16px 28px;\n    border: 1px solid #000000 !important;\n    border-radius: 10px;\n    background: #000000 !important;\n    color: #ffffff !important;\n    -webkit-text-fill-color: #ffffff !important;\n    font-size: clamp(12px, 0.8vw, 14px);\n    font-weight: 700;\n    letter-spacing: 0.075em;\n    line-height: 1;\n    text-align: center;\n    text-decoration: none !important;\n    text-transform: uppercase;\n    opacity: 1 !important;\n    box-shadow: none !important;\n  }\n\n  .boka-subscribe-hero__button::before,\n  .boka-subscribe-hero__button::after {\n    display: none !important;\n    content: none !important;\n  }\n\n  .boka-subscribe-hero__note {\n    color: rgb(34 39 33 / 0.68);\n    font-size: 14px;\n    line-height: 1.35;\n  }\n\n  @media screen and (max-width: 989px) {\n    .boka-subscribe-hero__inner {\n      width: min(100% - 32px, 720px);\n      grid-template-columns: 1fr;\n      gap: 30px;\n      padding: 44px 0 52px;\n    }\n\n    .boka-subscribe-hero__image {\n      order: 1;\n      border-radius: 22px;\n    }\n\n    .boka-subscribe-hero__content {\n      order: 2;\n      max-width: 100%;\n      text-align: left;\n    }\n\n    .boka-subscribe-hero__heading {\n      font-size: clamp(38px, 10vw, 56px);\n    }\n\n    .boka-subscribe-hero__benefits {\n      grid-template-columns: 1fr;\n      gap: 10px;\n      margin-top: 28px;\n    }\n\n    .boka-subscribe-hero__benefit {\n      flex-direction: row;\n      align-items: center;\n      padding: 14px;\n    }\n\n    .boka-subscribe-hero__benefit img {\n      width: 38px;\n      height: 38px;\n      flex-shrink: 0;\n    }\n\n    .boka-subscribe-hero__actions {\n      align-items: stretch;\n      gap: 12px;\n      margin-top: 28px;\n    }\n\n    .boka-subscribe-hero__button,\n    .boka-subscribe-hero__button:link,\n    .boka-subscribe-hero__button:visited,\n    .boka-subscribe-hero__button:hover,\n    .boka-subscribe-hero__button:focus,\n    .boka-subscribe-hero__button:active {\n      width: 100%;\n      min-height: 52px;\n      padding: 15px 20px;\n      font-size: 12px;\n    }\n\n    .boka-subscribe-hero__note {\n      width: 100%;\n      text-align: center;\n    }\n  }\n\n  @media screen and (max-width: 420px) {\n    .boka-subscribe-hero__inner {\n      width: calc(100% - 28px);\n      padding: 38px 0 44px;\n    }\n\n    .boka-subscribe-hero__heading {\n      font-size: 38px;\n    }\n\n    .boka-subscribe-hero__text {\n      margin-top: 18px;\n      font-size: 16px;\n    }\n  }\n</style>",
