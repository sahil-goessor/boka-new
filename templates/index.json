      "name": "Collection list - toothpastes",
      "settings": {
        "title": "<p><strong>Say hello</strong><em><strong> </strong></em><strong>to Nano-hydroxyapatite toothpaste.</strong></p>",
        "heading_alignment": "center",
        "heading_size": "h1",
        "heading_tag": "h2",
        "description": "<p>Shop Boka’s fluoride-free, Nano-hydroxyapatite toothpaste in refreshing flavors for everyday brushing, freshening breath, and enamel care. Hydroxyapatite is the primary foundation of teeth and bones. Known for its long-standing use in oral care, it's been studied for decades in relation to enamel.</p>",
        "image_ratio": "square",
        "columns_desktop": 3,
        "color_scheme": "custom",
        "custom_background_color": "#fafaf5",
        "custom_text_color": "#212529",
        "show_view_all": false,
