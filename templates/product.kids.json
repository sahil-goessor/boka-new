      "settings": {
        "custom_liquid": "{%- liquid\n  assign clean_feel_id = section.id\n  assign heading = 'A clean you can feel good about'\n  assign heading_tag = 'h2'\n  assign heading_size_class = 'h1'\n\n  assign layout = 'image_first'\n  assign desktop_image_width = 'medium'\n  assign desktop_content_position = 'center'\n  assign desktop_text_alignment = 'left'\n  assign mobile_text_alignment = 'left'\n\n  assign use_clean_feel_image_metafield = false\n  assign fallback_image_url = ''\n\n  assign show_fallback_claims = false\n  assign fallback_claim_1 = ''\n  assign fallback_claim_1_icon_url = ''\n  assign fallback_claim_2 = ''\n  assign fallback_claim_2_icon_url = ''\n  assign fallback_claim_3 = ''\n  assign fallback_claim_3_icon_url = ''\n\n  assign button_label = ''\n  assign button_link = ''\n  assign second_button_label = ''\n  assign second_button_link = ''\n\n  assign section_background_color = '#DAE9CF'\n  assign text_background_color = '#DAE9CF'\n  assign image_background_color = '#F8F7F2'\n  assign text_color = '#222721'\n  assign heading_color = '#222721'\n  assign description_color = '#222721'\n  assign claim_text_color = '#222721'\n\n  assign button_background = '#222721'\n  assign button_text_color = '#FFFFFF'\n  assign second_button_background = '#FFFFFF'\n  assign second_button_text_color = '#222721'\n\n  assign desktop_min_height = 580\n  assign mobile_image_min_height = 340\n  assign desktop_corner_radius = 0\n  assign mobile_corner_radius = 0\n  assign desktop_content_padding = 72\n  assign mobile_content_padding = 32\n  assign description_size_desktop = 16\n  assign description_size_mobile = 15\n  assign claim_text_size_desktop = 16\n  assign claim_text_size_mobile = 15\n  assign claim_gap_desktop = 16\n  assign claim_gap_mobile = 14\n  assign claim_icon_size_desktop = 38\n  assign claim_icon_size_mobile = 34\n\n  assign padding_top_desktop = 96\n  assign padding_bottom_desktop = 96\n  assign padding_top_tablet = 48\n  assign padding_bottom_tablet = 48\n  assign padding_top_mobile = 40\n  assign padding_bottom_mobile = 40\n\n  comment\n    -----------------------------\n    PRODUCT CONTENT\n    -----------------------------\n  endcomment\n\n  assign second_product_media = product.media[1]\n  assign second_product_image = blank\n\n  if second_product_media != blank\n    assign second_product_image = second_product_media.preview_image\n  endif\n\n  assign clean_feel_image_metafield = product.metafields.custom.a_clean_you_can_feel_good_about_image.value\n\n  if use_clean_feel_image_metafield and clean_feel_image_metafield != blank\n    assign section_image = clean_feel_image_metafield\n  else\n    assign section_image = second_product_image\n  endif\n\n  assign product_claims = product.metafields.custom.new_claims.value\n\n  assign section_image_alt = product.title\n  if section_image != blank and section_image.alt != blank\n    assign section_image_alt = section_image.alt\n  endif\n\n  assign default_description = 'Boka ' | append: product.title | append: ' is designed for daily care, combining n-Ha and science-backed ingredients with a crisp, refreshing taste.'\n\n  assign has_claims = false\n  if product_claims != blank\n    assign has_claims = true\n  endif\n\n  assign has_fallback_claims = false\n  if show_fallback_claims\n    if fallback_claim_1 != blank or fallback_claim_2 != blank or fallback_claim_3 != blank\n      assign has_fallback_claims = true\n    endif\n  endif\n\n  case desktop_image_width\n    when 'small'\n      assign desktop_columns = '0.85fr 1.15fr'\n    when 'large'\n      assign desktop_columns = '1.15fr 0.85fr'\n    else\n      assign desktop_columns = '1fr 1fr'\n  endcase\n\n  case mobile_text_alignment\n    when 'center'\n      assign mobile_button_alignment = 'center'\n    when 'right'\n      assign mobile_button_alignment = 'flex-end'\n    else\n      assign mobile_button_alignment = 'flex-start'\n  endcase\n\n  case desktop_text_alignment\n    when 'center'\n      assign desktop_button_alignment = 'center'\n    when 'right'\n      assign desktop_button_alignment = 'flex-end'\n    else\n      assign desktop_button_alignment = 'flex-start'\n  endcase\n-%}\n\n{%- if product != blank -%}\n  <style>\n    #clean-feel-{{ clean_feel_id }} {\n      --clean-section-bg: {{ section_background_color }};\n      --clean-panel-bg: {{ text_background_color }};\n      --clean-image-bg: {{ image_background_color }};\n      --clean-text: {{ text_color }};\n      --clean-heading: {{ heading_color }};\n      --clean-description: {{ description_color }};\n      --clean-claim-text: {{ claim_text_color }};\n      --clean-desktop-columns: {{ desktop_columns }};\n      --clean-desktop-min-height: {{ desktop_min_height }}px;\n      --clean-mobile-image-min-height: {{ mobile_image_min_height }}px;\n      --clean-desktop-radius: {{ desktop_corner_radius }}px;\n      --clean-mobile-radius: {{ mobile_corner_radius }}px;\n      --clean-desktop-padding: {{ desktop_content_padding }}px;\n      --clean-mobile-padding: {{ mobile_content_padding }}px;\n      --clean-description-desktop: {{ description_size_desktop }}px;\n      --clean-description-mobile: {{ description_size_mobile }}px;\n      --clean-claim-size-desktop: {{ claim_text_size_desktop }}px;\n      --clean-claim-size-mobile: {{ claim_text_size_mobile }}px;\n      --clean-claim-gap-desktop: {{ claim_gap_desktop }}px;\n      --clean-claim-gap-mobile: {{ claim_gap_mobile }}px;\n      --clean-icon-size-desktop: {{ claim_icon_size_desktop }}px;\n      --clean-icon-size-mobile: {{ claim_icon_size_mobile }}px;\n\n      background: var(--clean-section-bg);\n      color: var(--clean-text);\n      padding-top: {{ padding_top_mobile }}px;\n      padding-bottom: {{ padding_bottom_mobile }}px;\n    }\n\n    #clean-feel-{{ clean_feel_id }} * {\n      box-sizing: border-box;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__inner {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr);\n      gap: 0;\n      width: 100%;\n      max-width: var(--container-max-width, 1600px);\n      margin-inline: auto;\n      padding-inline: var(--container-gutter, 20px);\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__media-wrap {\n      min-width: 0;\n      overflow: hidden;\n      background: var(--clean-image-bg);\n      border-radius: var(--clean-mobile-radius) var(--clean-mobile-radius) 0 0;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__media {\n      position: relative;\n      width: 100%;\n      min-height: var(--clean-mobile-image-min-height);\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__media img,\n    #clean-feel-{{ clean_feel_id }} .clean-feel__placeholder {\n      display: block;\n      width: 100%;\n      height: 100%;\n      min-height: var(--clean-mobile-image-min-height);\n      object-fit: cover;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__content {\n      display: flex;\n      min-width: 0;\n      flex-direction: column;\n      justify-content: {{ desktop_content_position }};\n      padding: var(--clean-mobile-padding);\n      background: var(--clean-panel-bg);\n      color: var(--clean-text);\n      border-radius: 0 0 var(--clean-mobile-radius) var(--clean-mobile-radius);\n      text-align: {{ mobile_text_alignment }};\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__heading {\n      margin: 0;\n      color: var(--clean-heading);\n      line-height: 0.98;\n      letter-spacing: -0.04em;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__description {\n      margin-top: 16px;\n      color: var(--clean-description);\n      font-size: var(--clean-description-mobile);\n      line-height: 1.45;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__description > *:first-child {\n      margin-top: 0;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__description > *:last-child {\n      margin-bottom: 0;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__description p {\n      margin-block: 0;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__claims {\n      margin-top: 30px;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__claims .boka-claims,\n    #clean-feel-{{ clean_feel_id }} .clean-feel__fallback-list {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr);\n      gap: var(--clean-claim-gap-mobile);\n      margin: 0 !important;\n      padding: 0 !important;\n      list-style: none !important;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__claims .boka-claim,\n    #clean-feel-{{ clean_feel_id }} .clean-feel__fallback-claim {\n      margin: 0 !important;\n      list-style: none !important;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__claims .boka-claim::marker,\n    #clean-feel-{{ clean_feel_id }} .clean-feel__fallback-claim::marker {\n      content: \"\" !important;\n      font-size: 0 !important;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__claims .boka-claim::before,\n    #clean-feel-{{ clean_feel_id }} .clean-feel__claims .boka-claim::after,\n    #clean-feel-{{ clean_feel_id }} .clean-feel__fallback-claim::before,\n    #clean-feel-{{ clean_feel_id }} .clean-feel__fallback-claim::after {\n      display: none !important;\n      content: none !important;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__claims .boka-claim,\n    #clean-feel-{{ clean_feel_id }} .clean-feel__fallback-claim {\n      display: flex;\n      min-width: 0;\n      align-items: center;\n      gap: 14px;\n      padding: 14px 16px;\n      border: 1px solid rgb(34 39 33 / 14%);\n      border-radius: 14px;\n      background: rgb(255 255 255 / 32%);\n      color: var(--clean-claim-text);\n      text-align: left;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__claims .boka-claim__image,\n    #clean-feel-{{ clean_feel_id }} .clean-feel__fallback-icon {\n      display: block;\n      width: var(--clean-icon-size-mobile);\n      height: var(--clean-icon-size-mobile);\n      flex: 0 0 var(--clean-icon-size-mobile);\n      object-fit: contain;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__claims .boka-claim__text,\n    #clean-feel-{{ clean_feel_id }} .clean-feel__fallback-text {\n      display: block;\n      min-width: 0;\n      color: var(--clean-claim-text);\n      font-size: var(--clean-claim-size-mobile);\n      font-weight: 700;\n      line-height: 1.25;\n      letter-spacing: -0.01em;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__claims img {\n      max-width: 100%;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__buttons {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: {{ mobile_button_alignment }};\n      gap: 12px;\n      margin-top: 34px;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__button {\n      display: inline-flex;\n      min-height: 48px;\n      align-items: center;\n      justify-content: center;\n      padding: 12px 24px;\n      border: 1px solid transparent;\n      border-radius: var(--button-border-radius, 999px);\n      text-decoration: none;\n      font: inherit;\n      font-weight: 700;\n      line-height: 1.2;\n      transition: opacity 180ms ease, transform 180ms ease;\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__button:hover {\n      opacity: 0.88;\n      transform: translateY(-1px);\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__button--primary {\n      background: {{ button_background }};\n      color: {{ button_text_color }};\n    }\n\n    #clean-feel-{{ clean_feel_id }} .clean-feel__button--secondary {\n      background: {{ second_button_background }};\n      color: {{ second_button_text_color }};\n    }\n\n    @media only screen and (min-width: 640px) and (max-width: 999px) {\n      #clean-feel-{{ clean_feel_id }} {\n        padding-top: {{ padding_top_tablet }}px;\n        padding-bottom: {{ padding_bottom_tablet }}px;\n      }\n    }\n\n    @media screen and (min-width: 1000px) {\n      #clean-feel-{{ clean_feel_id }} {\n        padding-top: {{ padding_top_desktop }}px;\n        padding-bottom: {{ padding_bottom_desktop }}px;\n      }\n\n      #clean-feel-{{ clean_feel_id }} .clean-feel__inner {\n        grid-template-columns: var(--clean-desktop-columns);\n        align-items: stretch;\n      }\n\n      #clean-feel-{{ clean_feel_id }} .clean-feel__inner--text-first .clean-feel__media-wrap {\n        order: 2;\n      }\n\n      #clean-feel-{{ clean_feel_id }} .clean-feel__inner--text-first .clean-feel__content {\n        order: 1;\n      }\n\n      #clean-feel-{{ clean_feel_id }} .clean-feel__media-wrap {\n        border-radius:\n          {% if layout == 'text_first' %}\n            0 var(--clean-desktop-radius) var(--clean-desktop-radius) 0\n          {% else %}\n            var(--clean-desktop-radius) 0 0 var(--clean-desktop-radius)\n          {% endif %};\n      }\n\n      #clean-feel-{{ clean_feel_id }} .clean-feel__content {\n        min-height: var(--clean-desktop-min-height);\n        padding: var(--clean-desktop-padding);\n        border-radius:\n          {% if layout == 'text_first' %}\n            var(--clean-desktop-radius) 0 0 var(--clean-desktop-radius)\n          {% else %}\n            0 var(--clean-desktop-radius) var(--clean-desktop-radius) 0\n          {% endif %};\n        text-align: {{ desktop_text_alignment }};\n      }\n\n      #clean-feel-{{ clean_feel_id }} .clean-feel__media,\n      #clean-feel-{{ clean_feel_id }} .clean-feel__media img,\n      #clean-feel-{{ clean_feel_id }} .clean-feel__placeholder {\n        min-height: var(--clean-desktop-min-height);\n      }\n\n      #clean-feel-{{ clean_feel_id }} .clean-feel__description {\n        font-size: var(--clean-description-desktop);\n      }\n\n      #clean-feel-{{ clean_feel_id }} .clean-feel__claims .boka-claims,\n      #clean-feel-{{ clean_feel_id }} .clean-feel__fallback-list {\n        gap: var(--clean-claim-gap-desktop);\n      }\n\n      #clean-feel-{{ clean_feel_id }} .clean-feel__claims .boka-claim,\n      #clean-feel-{{ clean_feel_id }} .clean-feel__fallback-claim {\n        padding: 16px 18px;\n      }\n\n      #clean-feel-{{ clean_feel_id }} .clean-feel__claims .boka-claim__image,\n      #clean-feel-{{ clean_feel_id }} .clean-feel__fallback-icon {\n        width: var(--clean-icon-size-desktop);\n        height: var(--clean-icon-size-desktop);\n        flex-basis: var(--clean-icon-size-desktop);\n      }\n\n      #clean-feel-{{ clean_feel_id }} .clean-feel__claims .boka-claim__text,\n      #clean-feel-{{ clean_feel_id }} .clean-feel__fallback-text {\n        font-size: var(--clean-claim-size-desktop);\n      }\n\n      #clean-feel-{{ clean_feel_id }} .clean-feel__buttons {\n        justify-content: {{ desktop_button_alignment }};\n      }\n    }\n  </style>\n\n  <section id=\"clean-feel-{{ clean_feel_id }}\" class=\"clean-feel\" aria-labelledby=\"clean-feel-heading-{{ clean_feel_id }}\">\n    <div class=\"clean-feel__inner{% if layout == 'text_first' %} clean-feel__inner--text-first{% endif %}\">\n      <div class=\"clean-feel__media-wrap\">\n        <div class=\"clean-feel__media\">\n          {%- if section_image != blank -%}\n            {{-\n              section_image\n              | image_url: width: 1600\n              | image_tag:\n                loading: 'lazy',\n                sizes: '(max-width: 999px) 100vw, 50vw',\n                widths: '300,400,500,600,800,1000,1200,1400,1600',\n                alt: section_image_alt\n            -}}\n          {%- elsif fallback_image_url != blank -%}\n            <img\n              src=\"{{ fallback_image_url | escape }}\"\n              alt=\"{{ product.title | escape }}\"\n              width=\"1600\"\n              height=\"1600\"\n              loading=\"lazy\"\n            >\n          {%- else -%}\n            {{ 'image' | placeholder_svg_tag: 'clean-feel__placeholder' }}\n          {%- endif -%}\n        </div>\n      </div>\n\n      <div class=\"clean-feel__content\">\n        {%- if heading != blank -%}\n          <{{ heading_tag }} id=\"clean-feel-heading-{{ clean_feel_id }}\" class=\"clean-feel__heading {{ heading_size_class }}\">\n            {{ heading }}\n          </{{ heading_tag }}>\n        {%- endif -%}\n\n        <div class=\"clean-feel__description\">\n          <p>{{ default_description }}</p>\n        </div>\n\n        {%- if has_claims -%}\n          <div class=\"clean-feel__claims\">\n            {{ product_claims }}\n          </div>\n        {%- elsif has_fallback_claims -%}\n          <div class=\"clean-feel__claims\">\n            <ul class=\"clean-feel__fallback-list\">\n              {%- if fallback_claim_1 != blank -%}\n                <li class=\"clean-feel__fallback-claim\">\n                  {%- if fallback_claim_1_icon_url != blank -%}\n                    <img class=\"clean-feel__fallback-icon\" src=\"{{ fallback_claim_1_icon_url | escape }}\" alt=\"\" width=\"120\" height=\"120\" loading=\"lazy\">\n                  {%- endif -%}\n                  <span class=\"clean-feel__fallback-text\">{{ fallback_claim_1 }}</span>\n                </li>\n              {%- endif -%}\n\n              {%- if fallback_claim_2 != blank -%}\n                <li class=\"clean-feel__fallback-claim\">\n                  {%- if fallback_claim_2_icon_url != blank -%}\n                    <img class=\"clean-feel__fallback-icon\" src=\"{{ fallback_claim_2_icon_url | escape }}\" alt=\"\" width=\"120\" height=\"120\" loading=\"lazy\">\n                  {%- endif -%}\n                  <span class=\"clean-feel__fallback-text\">{{ fallback_claim_2 }}</span>\n                </li>\n              {%- endif -%}\n\n              {%- if fallback_claim_3 != blank -%}\n                <li class=\"clean-feel__fallback-claim\">\n                  {%- if fallback_claim_3_icon_url != blank -%}\n                    <img class=\"clean-feel__fallback-icon\" src=\"{{ fallback_claim_3_icon_url | escape }}\" alt=\"\" width=\"120\" height=\"120\" loading=\"lazy\">\n                  {%- endif -%}\n                  <span class=\"clean-feel__fallback-text\">{{ fallback_claim_3 }}</span>\n                </li>\n              {%- endif -%}\n            </ul>\n          </div>\n        {%- endif -%}\n\n        {%- if button_label != blank or second_button_label != blank -%}\n          <div class=\"clean-feel__buttons\">\n            {%- if button_label != blank -%}\n              <a class=\"clean-feel__button clean-feel__button--primary\" href=\"{{ button_link | default: '#' }}\">\n                {{ button_label }}\n              </a>\n            {%- endif -%}\n\n            {%- if second_button_label != blank -%}\n              <a class=\"clean-feel__button clean-feel__button--secondary\" href=\"{{ second_button_link | default: '#' }}\">\n                {{ second_button_label }}\n              </a>\n            {%- endif -%}\n          </div>\n        {%- endif -%}\n      </div>\n    </div>\n  </section>\n{%- endif -%}",
