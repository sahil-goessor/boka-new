    "custom_liquid_VrGMDc": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- assign ingredient_cards_html = product.metafields.custom.new_ingredients_card.value -%}\n\n{%- if ingredient_cards_html != blank -%}\n  <div class=\"ingredient-grid-section\">\n    <div class=\"ingredient-grid-section__inner\">\n      {{ ingredient_cards_html }}\n    </div>\n  </div>\n\n  <style>\n    .ingredient-grid-section {\n      padding: 40px 0;\n      background: #fff;\n      color: #222721;\n    }\n\n    .ingredient-grid-section__inner {\n      max-width: 1280px;\n      margin: 0 auto;\n      padding: 0 20px;\n    }\n\n    .ingredient-grid-section__cards {\n      display: flex;\n      gap: 14px;\n      overflow-x: auto;\n      padding-bottom: 10px;\n      scrollbar-width: none;\n    }\n\n    .ingredient-grid-section__cards::-webkit-scrollbar {\n      display: none;\n    }\n\n    .ingredient-grid-section__card {\n      flex: 0 0 78%;\n      max-width: 310px;\n      min-height: 330px;\n      padding: 18px;\n      border: 1px solid #D9D9E3;\n      border-radius: 14px;\n      background: #fff;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n    }\n\n    .ingredient-grid-section__image-wrap {\n      height: 190px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      margin-bottom: 18px;\n    }\n\n    .ingredient-grid-section__image {\n      width: 116%;\n      height: 116%;\n      object-fit: contain;\n      filter: drop-shadow(0 14px 18px rgba(34, 39, 33, 0.12));\n    }\n\n    .ingredient-grid-section__content {\n      margin-top: auto;\n      text-align: center;\n    }\n\n    .ingredient-grid-section__title {\n      margin: 0;\n      color: #222721;\n      font-size: 22px;\n      line-height: 1.12;\n      letter-spacing: -0.035em;\n    }\n\n    .ingredient-grid-section__desc {\n      max-width: 92%;\n      margin: 10px auto 0;\n      color: #222721;\n      font-size: 13px;\n      line-height: 1.45;\n    }\n\n    .ingredient-grid-section__desc p {\n      margin: 0;\n    }\n\n    @media screen and (min-width: 1000px) {\n      .ingredient-grid-section {\n        padding: 80px 0;\n      }\n\n      .ingredient-grid-section__cards {\n        display: grid;\n        grid-template-columns: repeat(auto-fit, minmax(220px, 260px));\n        justify-content: center;\n        gap: 22px;\n        overflow: visible;\n        padding-bottom: 0;\n      }\n\n      .ingredient-grid-section__card {\n        flex: none;\n        max-width: none;\n        min-height: 350px;\n      }\n\n      .ingredient-grid-section__image-wrap {\n        height: 220px;\n      }\n\n      .ingredient-grid-section__image {\n        width: 112%;\n        height: 112%;\n      }\n\n      .ingredient-grid-section__title {\n        font-size: 24px;\n      }\n    }\n  </style>\n{%- endif -%}",
